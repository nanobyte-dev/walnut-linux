# Walnut Games screenshots (JPEG, and PNG under a game's rating/) live in Git LFS; thumb.png stays a normal
# file: the site and the app read it, and at 256x144 it is small.
gamedb/games/**/*.jpg filter=lfs diff=lfs merge=lfs -text
gamedb/games/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
gamedb/games/**/rating/**/*.png filter=lfs diff=lfs merge=lfs -text
