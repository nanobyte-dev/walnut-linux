+/*
+
+Game controllers: a fixed, built-in scheme next to the keyboard.
+
+Controller N (the N-th one connected, N = 1..4) plays local player N. Nothing
+is bound by hand and nothing is written to the configuration. The buttons are
+read through SDL2's game controller API (a DualShock 3 is "PS3 Controller"
+there, whatever its raw button numbers), because SDL 1.2's joystick API only
+knows the raw numbers. SDL 1.2 here is sdl12-compat on top of SDL2: its
+library is already loaded, so the few SDL2 functions needed are looked up at
+run time. Without them the controllers are just not there.
+
+This program is free software; you can redistribute it and/or modify it
+under the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 2 of the License, or (at your option)
+any later version.
+
+*/
+
+#ifndef ArmageTron_GAMEPAD_H
+#define ArmageTron_GAMEPAD_H
+
+#include "rSDL.h"
+#include "defs.h"
+
+//! the controller buttons that do something; see the table in uGamepad.cpp
+#define uPAD_INPUTS 14
+
+//! Fills e with the next input made from the controllers' state (a key event),
+//! false if there is none. In a menu the d-pad, Cross, Circle and Start are the
+//! menu keys; in the game they are keys of a range beyond the keyboard's that
+//! su_GamepadAct knows.
+bool su_GamepadEvent(SDL_Event &e);
+
+//! true for a keysym su_GamepadEvent made for the game
+bool su_GamepadSym(int sym);
+
+//! does what the game key sym does; x > 0 pressed, x < 0 released
+bool su_GamepadAct(int sym, REAL x);
+
+//! the scheme as a read-only menu
+void su_GamepadMenu();
+
+#endif
