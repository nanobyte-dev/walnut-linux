+    stfd  %f16, 216(%r1)
+    stfd  %f17, 224(%r1)
+    stfd  %f18, 232(%r1)
+    stfd  %f19, 240(%r1)
+    stfd  %f20, 248(%r1)
+    stfd  %f21, 256(%r1)
+    stfd  %f22, 264(%r1)
+    stfd  %f23, 272(%r1)
+    stfd  %f24, 280(%r1)
