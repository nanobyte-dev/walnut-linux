+    stfd  %f31, 336(%r1)
+    mffs  %f0
+    stfd  %f0, 344(%r1)
+    # save V20-V31 (callee-saved with the AltiVec ABI)
+    li    %r31, 360
+    stvx  %v20, %r1, %r31
+    li    %r31, 376
+    stvx  %v21, %r1, %r31
+    li    %r31, 392
+    stvx  %v22, %r1, %r31
