+    stvx  %v27, %r1, %r31
+    li    %r31, 488
+    stvx  %v28, %r1, %r31
+    li    %r31, 504
+    stvx  %v29, %r1, %r31
+    li    %r31, 520
+    stvx  %v30, %r1, %r31
+    li    %r31, 536
     stvx  %v31, %r1, %r31
 
     # store RSP (pointing to context-data) in R6
@@ -151,9 +205,52 @@ jump_fcontext:
     ld  %r2,  0(%r1)  # restore TOC
 #endif
 
-    # Restore VS63
-    li    %r31, 184
+    # restore V20-V31
+    li    %r31, 360
+    lvx   %v20, %r1, %r31
+    li    %r31, 376
