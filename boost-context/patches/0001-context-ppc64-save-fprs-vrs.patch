+    lfd   %f20, 248(%r1)
+    lfd   %f21, 256(%r1)
+    lfd   %f22, 264(%r1)
+    lfd   %f23, 272(%r1)
+    lfd   %f24, 280(%r1)
+    lfd   %f25, 288(%r1)
+    lfd   %f26, 296(%r1)
+    lfd   %f27, 304(%r1)
+    lfd   %f28, 312(%r1)
+    lfd   %f29, 320(%r1)
+    lfd   %f30, 328(%r1)
+    lfd   %f31, 336(%r1)
 
     ld  %r14, 8(%r1)  # restore R14
     ld  %r15, 16(%r1)  # restore R15
@@ -190,7 +287,7 @@ jump_fcontext:
