+// sky boxes and cube maps: use a .dds next to the .jpg or .png when there is one (the data ships
+// them at 256x256), instead of decoding six images of 2048x2048 (12 MB each) at every load
+VAR(skydds, 0, 1, 1);
 VAR(scaledds, 0, 2, 4);
 
+// "name.jpg" or "name.png" -> "name.dds" when that file exists and skydds is on
+bool skyddsname(const char *name, char *dds, size_t len)
+{
+    if(!skydds || !usedds || !hasS3TC) return false;
+    size_t n = strlen(name);
+    if(n < 5 || n + 1 > len || name[n-4] != '.') return false;
+    memcpy(dds, name, n-3);
+    memcpy(dds + n-3, "dds", 4);
+    return canloadsurface(dds);
+}
+
