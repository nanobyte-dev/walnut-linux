diff --git a/engine/speqskin.h b/engine/speqskin.h
new file mode 100644
--- /dev/null
+++ b/engine/speqskin.h
@@ -0,0 +1,86 @@
+// PS3 (Cell): CPU skinning through libspeq (ps3-spu: speq_skin_*_v1), which moves each skeletal
+// mesh group's vertices on the SPEs (or with its own vector code on the PPE) into a buffer of its
+// own that the engine then uploads instead of vdata. Loaded at run time with dlopen: the engine
+// doesn't depend on it, and without it, when it declines (SPEQ_SKIN=off, small meshes, the SPEs
+// busy or late) or with speqskin 0, skelmeshgroup::render skins as before. All policy (which
+// unit, sizes, timeouts, SPEQ_SKIN=auto|spu|ppe|off, SPEQ_DEBUG) lives in libspeq.
+
+#ifdef __linux__
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+
+VAR(speqskin, 0, 1, 1);
+
+// libspeq's speq.h, the part this uses: SPEQ_SKIN_ABI 1, frozen (a change is a _v2)
+#define SPEQ_SKIN_ABI 1
+#define SPEQ_SKIN_NONE 0xffff
+enum { SPEQ_SKIN_DQ, SPEQ_SKIN_MAT };
+enum { SPEQ_SKIN_IDX_S32, SPEQ_SKIN_IDX_U16, SPEQ_SKIN_IDX_U8, SPEQ_SKIN_W4 };
+enum { SPEQ_SKIN_TAN_NONE, SPEQ_SKIN_TAN_VEC4, SPEQ_SKIN_TAN_QUAT };
+enum { SPEQ_SKIN_OUT_F32, SPEQ_SKIN_OUT_S16 };
+
+struct speq_skin_field
+{
+    uint16_t off;
+    uint8_t stream, pad;
+};
+
+struct speq_skin_mesh
+{
+    uint32_t nverts;
+    uint8_t palette_fmt, influence, tan_in, tan_out;
+    const void *palette[2];
+    uint32_t npal[2];
+    const void *src[2];
+    uint32_t src_stride[2];
+    speq_skin_field pos, norm, tan, index, weights;
+    const void *tmpl;
+    uint32_t dst_offset;
+    uint32_t dst_stride;
+    uint16_t dst_pos, dst_norm, dst_tan;
+    uint16_t pad;
+};
+
+struct speq_skin;
+
+static struct
+{
+    int (*open)(speq_skin **, unsigned, unsigned);
+    int (*begin)(speq_skin *, uint32_t, uint32_t);
+    int (*add)(speq_skin *, const speq_skin_mesh *);
+    int (*end)(speq_skin *, void **);
+    void (*close)(speq_skin *);
+    speq_skin *s;
+    int state; // 0: not tried yet, 1: open, -1: none
+} speqskinlib = { NULL, NULL, NULL, NULL, NULL, NULL, 0 };
+
+static void speqskinclose()
+{
+    if(speqskinlib.s) { speqskinlib.close(speqskinlib.s); speqskinlib.s = NULL; }
+    speqskinlib.state = -1;
+}
+
+// The process's speq_skin, opened at the first skinned frame; NULL: skin here
+static speq_skin *speqskinget()
+{
+    if(!speqskin) return NULL;
+    if(!speqskinlib.state)
+    {
+        speqskinlib.state = -1;
+        void *h = dlopen("libspeq.so.0", RTLD_NOW | RTLD_LOCAL);
+        if(!h) return NULL;
+        speqskinlib.open = (int (*)(speq_skin **, unsigned, unsigned))dlsym(h, "speq_skin_open_v1");
+        speqskinlib.begin = (int (*)(speq_skin *, uint32_t, uint32_t))dlsym(h, "speq_skin_begin_v1");
+        speqskinlib.add = (int (*)(speq_skin *, const speq_skin_mesh *))dlsym(h, "speq_skin_add_v1");
+        speqskinlib.end = (int (*)(speq_skin *, void **))dlsym(h, "speq_skin_end_v1");
+        speqskinlib.close = (void (*)(speq_skin *))dlsym(h, "speq_skin_close_v1");
+        if(!speqskinlib.open || !speqskinlib.begin || !speqskinlib.add || !speqskinlib.end || !speqskinlib.close) return NULL;
+        if(speqskinlib.open(&speqskinlib.s, SPEQ_SKIN_ABI, sizeof(speq_skin_mesh))) { speqskinlib.s = NULL; return NULL; }
+        speqskinlib.state = 1;
+        atexit(speqskinclose); // its SPEQ_DEBUG counters at the end
+    }
+    return speqskinlib.state > 0 ? speqskinlib.s : NULL;
+}
+#endif
