+    // gluniformcache: a value equal to the one the shaders have already been given is not a change,
+    // so no program uploads it again
+    GlobalShaderParamState *resolvecmp(const void *val, size_t size)
+    {
+        extern int gluniformcache;
+        GlobalShaderParamState *g = lookup();
+        if(gluniformcache && !memcmp(g->buf, val, size)) return NULL;
+        g->changed();
+        return g;
+    }
+
     void setf(float x = 0, float y = 0, float z = 0, float w = 0)
