     }
 
diff --git a/engine/world.h b/engine/world.h
--- a/engine/world.h
+++ b/engine/world.h
@@ -56,4 +56,8 @@ enum
 #define TEX_SCALE 8.0f
 
 struct vertex { vec pos; bvec4 norm; vec2 tc; svec2 lm; bvec4 tangent; };
+// the world vertex as uploaded with vanormalshort 1: normal and tangent as 16-bit signed normalized
+// (norm[3] is padding), which every GL 2 GPU fetches; signed bytes are converted on the CPU by some
+// (nv30), 40 bytes against 32
+struct svertex { vec pos; short norm[4]; vec2 tc; svec2 lm; short tangent[4]; };
 
