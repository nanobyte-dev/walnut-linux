@@ -1082,6 +1082,21 @@ static void changevbuf(renderstate &cur, int pass, vtxarray *va)
     gle::bindebo(va->ebuf);
     cur.vbuf = va->vbuf;
 
+    if(vanormalshort)
+    {
+        svertex *vdata = (svertex *)0;
+        gle::vertexpointer(sizeof(svertex), vdata->pos.v);
+
+        if(pass==RENDERPASS_LIGHTMAP)
+        {
+            gle::normalpointer(sizeof(svertex), vdata->norm, GL_SHORT);
+            gle::texcoord0pointer(sizeof(svertex), vdata->tc.v);
+            gle::texcoord1pointer(sizeof(svertex), vdata->lm.v, GL_SHORT);
+            gle::tangentpointer(sizeof(svertex), vdata->tangent, GL_SHORT);
+        }
+        return;
+    }
+
     vertex *vdata = (vertex *)0;
     gle::vertexpointer(sizeof(vertex), vdata->pos.v);
 
@@ -1888,7 +1903,7 @@ void renderskyva(vtxarray *va, bool explicitonly = false)
         gle::bindvbo(va->vbuf);
         gle::bindebo(va->skybuf);
         const vertex *ptr = 0;
-        gle::vertexpointer(sizeof(vertex), ptr->pos.v);
+        gle::vertexpointer(vavertsize(), ptr->pos.v);
