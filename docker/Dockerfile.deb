# Debian packaging tools on top of the builder (its own image, so the kernel/rootfs tags don't
# change): source packages (devscripts, quilt, dpkg-dev), the kernel's packaging helpers
# (kernel-wedge, python3-dacite/jinja2), config-package-dev, ccache, and aptly for the repository.
# deb-src entries for the main-archive snapshot: debian-ports publishes no sources, Debian's are the
# same versions (sid for most packages, trixie/trixie-security for the 6.12 kernel).
ARG BUILDER
FROM ${BUILDER}
ARG SNAPSHOT

RUN echo "deb-src [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} unstable main" >> /etc/apt/sources.list && \
    echo "deb-src [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} trixie main" >> /etc/apt/sources.list && \
    echo "deb-src [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${SNAPSHOT} trixie-security main" >> /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-utils build-essential dpkg-dev devscripts quilt git fakeroot debhelper dh-exec sudo librsvg2-bin \
        kernel-wedge python3-dacite python3-jinja2 config-package-dev \
        ccache aptly gnupg debian-archive-keyring && \
    rm -rf /var/lib/apt/lists/*
