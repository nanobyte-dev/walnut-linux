diff --git a/netsurf/content/handlers/javascript/duktape/HTMLElement.bnd b/netsurf/content/handlers/javascript/duktape/HTMLElement.bnd
index b3de9c8..257ba44 100644
--- a/netsurf/content/handlers/javascript/duktape/HTMLElement.bnd
+++ b/netsurf/content/handlers/javascript/duktape/HTMLElement.bnd
@@ -160,3 +160,34 @@ getter HTMLElement::style()
 	}
 	return 1;
 %}
+
+getter HTMLElement::hidden()
+%{
+	dom_exception exc;
+	bool has = false;
+
+	exc = dom_element_has_attribute(priv->parent.parent.node,
+					corestring_dom_hidden, &has);
+	if (exc != DOM_NO_ERR) return 0;
+	duk_push_boolean(ctx, has);
+	return 1;
+%}
+
+setter HTMLElement::hidden()
+%{
+	dom_exception exc;
+
+	if (duk_to_boolean(ctx, 0)) {
+		dom_string *empty = NULL;
+		exc = dom_string_create((const uint8_t *) "", 0, &empty);
+		if (exc != DOM_NO_ERR) return 0;
+		exc = dom_element_set_attribute(priv->parent.parent.node,
+						corestring_dom_hidden, empty);
+		dom_string_unref(empty);
+	} else {
+		exc = dom_element_remove_attribute(priv->parent.parent.node,
+						   corestring_dom_hidden);
+	}
+	(void)exc;
+	return 0;
+%}
