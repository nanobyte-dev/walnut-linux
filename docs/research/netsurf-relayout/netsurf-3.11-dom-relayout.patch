+/** Clear the per-node data a box tree leaves on the DOM: box and libcss data. */
+static void html_dom_forget_boxes(dom_node *root)
+{
+	dom_node *n = dom_node_ref(root);
+	dom_node *next;
+	dom_node_type type;
+	void *old;
+
+	while (n != NULL) {
+		if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+				type == DOM_ELEMENT_NODE) {
+			dom_node_set_user_data(n,
+					corestring_dom___ns_key_box_node_data,
+					NULL, NULL, &old);
+			nscss_dom_node_restyle(n);
+
+			next = NULL;
+			if (dom_node_get_first_child(n, &next) == DOM_NO_ERR &&
+					next != NULL) {
+				dom_node_unref(n);
+				n = next;
+				continue;
+			}
+		}
+
+		/* next sibling, else climb until an ancestor has one */
+		while (n != NULL) {
+			if (n == root) {
+				dom_node_unref(n);
+				n = NULL;
+				break;
+			}
+			next = NULL;
+			if (dom_node_get_next_sibling(n, &next) == DOM_NO_ERR &&
+					next != NULL) {
+				dom_node_unref(n);
+				n = next;
+				break;
+			}
+			next = NULL;
+			dom_node_get_parent_node(n, &next);
+			dom_node_unref(n);
+			n = next;
+		}
+	}
+}
+
+/** Forget the gadgets' links into a box tree that is about to go. */
+static void html_box_detach_gadgets(struct box *box)
+{
+	struct box *child;
+
+	if (box->gadget != NULL && box->gadget->box == box)
+		box->gadget->box = NULL;
+
+	for (child = box->children; child != NULL; child = child->next)
+		html_box_detach_gadgets(child);
+}
+
+static bool html_rebuild_ok;
+
+static void html_box_rebuild_done(html_content *c, bool success)
+{
+	html_rebuild_ok = success;
+}
+
+static void html_dom_relayout(void *p);
+
+/* exported function documented in html/private.h */
+void html__dom_changed(html_content *htmlc)
+{
+	if (htmlc->relayout_pending || htmlc->rebuilding)
+		return;
+
+	/* Before the first box conversion has begun the DOM is read anyway */
+	if (htmlc->layout == NULL && htmlc->box_conversion_context == NULL)
+		return;
+
+	htmlc->relayout_pending = true;
+	htmlc->relayout_retries = 0;
+	/* debounce: a script usually changes many nodes in one go */
+	guit->misc->schedule(10, html_dom_relayout, htmlc);
+}
+
+/**
+ * Rebuild the box tree from the DOM and reflow: the simplest dynamic layout.
+ *
+ * Scheduled by html__dom_changed().  The old tree stays in place (and drawable)
+ * until the new one is complete; objects, gadgets and focus are moved over.
+ */
+static void html_dom_relayout(void *p)
+{
+	html_content *htmlc = p;
+	struct content_html_object *old_objects, *o, *next;
+	struct box *old_layout;
+	int *old_bctx;
+	dom_node *html = NULL;
+	dom_node *focus_node = NULL;
+	content_status status;
+	uint64_t ms_before, ms_after;
+	nserror err;
+
+	htmlc->relayout_pending = false;
+
+	if (htmlc->aborted || htmlc->document == NULL)
+		return;
+
+	status = content__get_status(&htmlc->base);
+	if (htmlc->box_conversion_context != NULL || htmlc->layout == NULL ||
+			htmlc->reflowing || htmlc->base.locked ||
+			htmlc->drag_type != HTML_DRAG_NONE ||
+			(status != CONTENT_STATUS_READY &&
+			 status != CONTENT_STATUS_DONE)) {
+		/* not now: try again shortly */
+		if (htmlc->relayout_retries++ < 100) {
+			htmlc->relayout_pending = true;
+			guit->misc->schedule(100, html_dom_relayout, htmlc);
+		}
+		return;
+	}
+
+	if (htmlc->frameset != NULL || htmlc->iframe != NULL) {
+		NSLOG(netsurf, INFO, "DOM changed; frames present, not rebuilt");
+		return;
+	}
+
+	if (dom_document_get_document_element(htmlc->document,
+			(void *) &html) != DOM_NO_ERR || html == NULL)
+		return;
+
+	nsu_getmonotonic_ms(&ms_before);
+
+	/* State that points into the old tree */
+	if (htmlc->focus_type == HTML_FOCUS_TEXTAREA &&
+			htmlc->focus_owner.textarea != NULL &&
+			htmlc->focus_owner.textarea->node != NULL)
+		focus_node = dom_node_ref(htmlc->focus_owner.textarea->node);
+	htmlc->focus_type = HTML_FOCUS_SELF;
+	htmlc->focus_owner.self = true;
+	htmlc->selection_type = HTML_SELECTION_NONE;
+	htmlc->selection_owner.none = true;
+	selection_clear(htmlc->sel, false);
+	html_box_detach_gadgets(htmlc->layout);
+
+	html_dom_forget_boxes(html);
+
+	/* Build the new tree beside the old one */
+	old_layout = htmlc->layout;
+	old_bctx = htmlc->bctx;
+	old_objects = htmlc->object_list;
+	htmlc->object_list = NULL;
+	htmlc->bctx = NULL;
+
+	htmlc->rebuild_objects = old_objects;
+	htmlc->rebuilding = true;
+	html_rebuild_ok = false;
+	err = dom_to_box_sync(html, htmlc, html_box_rebuild_done);
+	htmlc->rebuilding = false;
+	/* what the new tree did not take over */
+	old_objects = htmlc->rebuild_objects;
+	htmlc->rebuild_objects = NULL;
+	dom_node_unref(html);
+
+	if (err != NSERROR_OK || html_rebuild_ok == false ||
+			htmlc->layout == old_layout) {
+		NSLOG(netsurf, ERROR, "box tree rebuild failed");
+		/* keep showing the old tree */
+		if (htmlc->bctx != NULL)
+			talloc_free(htmlc->bctx);
+		htmlc->bctx = old_bctx;
+		htmlc->layout = old_layout;
+		while (htmlc->object_list != NULL) {
+			o = htmlc->object_list;
+			htmlc->object_list = o->next;
+			if (o->content != NULL)
+				hlcache_handle_release(o->content);
+			free(o);
+		}
+		htmlc->object_list = old_objects;
+		if (focus_node != NULL)
+			dom_node_unref(focus_node);
+		return;
+	}
+
+	/* Release the old tree's objects; objects without a box stay */
+	for (o = old_objects; o != NULL; o = next) {
+		next = o->next;
+		if (o->box == NULL) {
+			o->next = htmlc->object_list;
+			htmlc->object_list = o;
+			continue;
+		}
+		if (o->content != NULL) {
+			content_status ostatus = content_get_status(o->content);
+			if (ostatus != CONTENT_STATUS_DONE &&
+					ostatus != CONTENT_STATUS_ERROR) {
+				hlcache_handle_abort(o->content);
+				htmlc->base.active--;
+			}
+			hlcache_handle_release(o->content);
+		}
+		htmlc->num_objects--;
+		free(o);
+	}
+
+	talloc_free(old_bctx);
+
+	if (focus_node != NULL) {
+		struct box *b = box_for_node(focus_node);
+		if (b != NULL && b->gadget != NULL &&
+				(b->gadget->type == GADGET_TEXTBOX ||
+				 b->gadget->type == GADGET_TEXTAREA ||
+				 b->gadget->type == GADGET_PASSWORD)) {
+			htmlc->focus_type = HTML_FOCUS_TEXTAREA;
+			htmlc->focus_owner.textarea = b;
+		}
+		dom_node_unref(focus_node);
+	}
+
+	{
+		uint64_t ms_built;
+		nsu_getmonotonic_ms(&ms_built);
+
+		content__reformat(&htmlc->base, false,
+				htmlc->base.available_width,
+				htmlc->base.available_height);
+
+		nsu_getmonotonic_ms(&ms_after);
+		NSLOG(netsurf, INFO, "DOM changed: box tree rebuilt in %d ms, reflowed in %d ms",
+				(int)(ms_built - ms_before),
+				(int)(ms_after - ms_built));
+	}
+}
+
