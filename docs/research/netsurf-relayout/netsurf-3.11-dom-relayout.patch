diff --git a/netsurf/content/handlers/html/object.c b/netsurf/content/handlers/html/object.c
index a1f020b..9b342d4 100644
--- a/netsurf/content/handlers/html/object.c
+++ b/netsurf/content/handlers/html/object.c
@@ -722,6 +722,32 @@ html_fetch_object(html_content *c,
 	if (c->aborted)
 		return true;
 
+	/* Box tree rebuild: take over the old box's object for this node */
+	if (c->rebuilding && box != NULL && box->node != NULL) {
+		struct content_html_object **pp = &c->rebuild_objects;
+		struct content_html_object *o;
+
+		while ((o = *pp) != NULL) {
+			if (o->box != NULL && o->box->node == box->node &&
+					o->background == background &&
+					o->content != NULL &&
+					nsurl_compare(hlcache_handle_get_url(
+						o->content), url,
+						NSURL_COMPLETE)) {
+				*pp = o->next;
+				o->next = c->object_list;
+				c->object_list = o;
+				o->box = box;
+				if (content_get_status(o->content) ==
+						CONTENT_STATUS_DONE)
+					html_object_done(box, o->content,
+							background);
+				return true;
+			}
+			pp = &o->next;
+		}
+	}
+
 	child.charset = c->encoding;
 	child.quirks = c->base.quirks;
 
