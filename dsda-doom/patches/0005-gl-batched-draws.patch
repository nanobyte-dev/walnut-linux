+// HUD patch atlas (DSDA_GL_HUD, gl_batch.c): the indexed patches of the status
+// bar and the HUD fonts in one texture, so that consecutive patches drawn by
+// gld_DrawNumPatch_f become one batched draw. A patch keeps its own texture's
+// texels (2 bytes each, as gld_BuildTexture uploads them), framed by a copy of
+// its edge texels, which is what GL_CLAMP_TO_EDGE of its own texture gives a
+// sample on or past the edge; filtering is GL_NEAREST like every patch.
+#define ATLAS_SLOTS 1024
+static GLuint atlas_texid;
+static int atlas_x, atlas_y, atlas_rowh, atlas_full;
+static struct { int lump, cm, x, y; } atlas_slot[ATLAS_SLOTS];
+static int atlas_used;
+
+void gld_ResetPatchAtlas(dboolean lost)
+{
+  int i;
+
+  if (lost)
+    atlas_texid = 0;
+  if (last_glTexID == &atlas_texid)
+    last_glTexID = NULL;
+  for (i = 0; i < ATLAS_SLOTS; i++)
+    atlas_slot[i].lump = -1;
+  atlas_used = 0;
+  atlas_x = atlas_y = atlas_rowh = 0;
+  atlas_full = false;
+}
+
+// binds the atlas and gives the patch's texel origin in it; false: the patch
+// isn't in the atlas (not indexed, too large, invulnerability colormap, full)
+dboolean gld_AtlasPatch(GLTexture *gltexture, int cm, int *ax, int *ay)
+{
+  unsigned int h, i;
+  int w, ht, tex_format;
+
+  if (!gltexture || gltexture->textype != GLDT_PATCH ||
+      !(gltexture->flags & GLTEXTURE_INDEXED))
+    return false;
+
+  gld_GetTextureTexID(gltexture, cm);
+  if (gltexture->player_cm == INVULN_PLAYER_CM)
+    return false;
+  if (cm == CR_LIMIT)
+    cm = CR_DEFAULT;
+
+  w = gltexture->buffer_width;
+  ht = gltexture->buffer_height;
+  if (w > 320 || ht > 64 || w <= 0 || ht <= 0)
+    return false;
+
+  tex_format = gl_arb_texture_rg ? GL_RG : GL_LUMINANCE_ALPHA;
+
+  h = ((unsigned int)gltexture->index * 31u + (unsigned int)cm) % ATLAS_SLOTS;
+  for (i = 0; i < ATLAS_SLOTS; i++, h = (h + 1) % ATLAS_SLOTS)
+  {
+    if (atlas_slot[h].lump == -1 ||
+        (atlas_slot[h].lump == gltexture->index && atlas_slot[h].cm == cm))
+      break;
+  }
+  if (i == ATLAS_SLOTS)
+    return false;
+
+  if (atlas_slot[h].lump == -1)
+  {
+    const rpatch_t *patch;
+    unsigned char *buffer, *framed;
+    int x, y;
+
+    if (atlas_full || atlas_used >= ATLAS_SLOTS / 2)
+      return false;
+    if (atlas_x + w + 2 > GLD_ATLAS_SIZE)
+    {
+      atlas_y += atlas_rowh;
+      atlas_x = 0;
+      atlas_rowh = 0;
+    }
+    if (atlas_y + ht + 2 > GLD_ATLAS_SIZE)
+    {
+      atlas_full = true;
+      return false;
+    }
+
+    if (!atlas_texid)
+    {
+      buffer = Z_Calloc(GLD_ATLAS_SIZE * GLD_ATLAS_SIZE, 2);
+      glGenTextures(1, &atlas_texid);
+      glBindTexture(GL_TEXTURE_2D, atlas_texid);
+      glTexParameteri(GL_TEXTURE_2D, GL_GENERATE_MIPMAP, GL_FALSE);
+      glTexImage2D(GL_TEXTURE_2D, 0, tex_format, GLD_ATLAS_SIZE, GLD_ATLAS_SIZE,
+                   0, tex_format, GL_UNSIGNED_BYTE, buffer);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+      Z_Free(buffer);
+      last_glTexID = &atlas_texid;
+    }
+
+    patch = R_PatchByNum(gltexture->index);
+    buffer = Z_Calloc(gltexture->buffer_size, 1);
+    gld_AddPatchToTexture(gltexture, buffer, patch, 0, 0, cm);
+    framed = Z_Malloc((w + 2) * (ht + 2) * 2);
+    for (y = 0; y < ht + 2; y++)
+    {
+      const unsigned char *row = buffer + BETWEEN(0, ht - 1, y - 1) * w * 2;
+
+      for (x = 0; x < w + 2; x++)
+      {
+        const unsigned char *t = row + BETWEEN(0, w - 1, x - 1) * 2;
+
+        framed[(y * (w + 2) + x) * 2] = t[0];
+        framed[(y * (w + 2) + x) * 2 + 1] = t[1];
+      }
+    }
+    if (last_glTexID != &atlas_texid)
+    {
+      glBindTexture(GL_TEXTURE_2D, atlas_texid);
+      last_glTexID = &atlas_texid;
+    }
+    glTexSubImage2D(GL_TEXTURE_2D, 0, atlas_x, atlas_y, w + 2, ht + 2,
+                    tex_format, GL_UNSIGNED_BYTE, framed);
+    Z_Free(framed);
+    Z_Free(buffer);
+
+    atlas_slot[h].lump = gltexture->index;
+    atlas_slot[h].cm = cm;
+    atlas_slot[h].x = atlas_x + 1;
+    atlas_slot[h].y = atlas_y + 1;
+    atlas_used++;
+    atlas_x += w + 2;
+    atlas_rowh = MAX(atlas_rowh, ht + 2);
+  }
+
+  if (last_glTexID != &atlas_texid)
+  {
+    glBindTexture(GL_TEXTURE_2D, atlas_texid);
+    last_glTexID = &atlas_texid;
+    glsl_SetTextureDims(0, GLD_ATLAS_SIZE, GLD_ATLAS_SIZE);
+  }
+
+  *ax = atlas_slot[h].x;
+  *ay = atlas_slot[h].y;
+  return true;
+}
