diff --git a/prboom2/src/gl_batch.c b/prboom2/src/gl_batch.c
new file mode 100644
--- /dev/null
+++ b/prboom2/src/gl_batch.c
@@ -0,0 +1,395 @@
+/*
+ * gl_batch.c: fewer, larger draws for the GL renderer.
+ *
+ * Inside a batched pass of gld_DrawScene (floors, ceilings, walls, mid walls,
+ * opaque sprites) every wall fan, sprite quad and flat loop is appended to one
+ * client vertex array as GL_TRIANGLES, and drawn with one glDrawArrays when the
+ * GL state the pending triangles depend on changes: a texture bind or texture
+ * parameter (gl_texture.c flushes first), the colour, the light level (unless
+ * it travels per vertex, glsl_vlight), or a draw that isn't batched (flooded
+ * walls, fuzz sprites, flats with a texture transform), which breaks the
+ * batch. The draw order stays the same, and the triangles are the ones the
+ * fans and strips decompose into, vertex order included.
+ *
+ * Switches (environment, read once):
+ *   DSDA_GL_BATCH=0  walls and sprites drawn one by one in immediate mode
+ *   DSDA_GL_FLATS=0  flats drawn per loop from the flats VBO, with a matrix
+ *                    translation per flat
+ *   DSDA_GL_HUD=0    HUD patches (status bar, fonts) from a texture each, one
+ *                    draw each, instead of from an atlas (gl_texture.c) in
+ *                    batches
+ *   DSDA_GL_VLIGHT=0 (gl_shader.c) the light level as a uniform per draw
+ *   DSDA_GL_STATS=1  every 350 frames: batched draws and items per frame
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "gl_opengl.h"
+#include "gl_intern.h"
+#include "lprintf.h"
+
+int gld_batch_walls = 1;
+int gld_batch_flats = 1;
+int gld_batch_stats = 0;
+int gld_batch_hud = 1;
+int gld_batch_region = 0;
+int gld_batch_known = 0;
+float gld_batch_alpha;
+float gld_batch_light;
+int gld_batch_count = 0;
+
+typedef struct
+{
+  float x, y, z;
+  float u, v;
+  float l;
+} gld_bvert_t;
+
+static gld_bvert_t *bv;
+static int bv_max;
+static gld_bvert_t *fan;
+static int fan_n, fan_max;
+static int arrays_mine;
+static const gld_bvert_t *arrays_base;
+
+// the flats' vertices on the CPU (the VBO copy is not readable)
+static vbo_xyz_uv_t *flats_cpu;
+static int flats_cpu_n;
+
+static struct
+{
+  unsigned long frames, draws, verts, walls, flats, sprites, breaks, ui, uidraws;
+} st;
+
+static int env_flag(const char *name, int def)
+{
+  const char *s = getenv(name);
+
+  if (!s || !*s)
+    return def;
+  return atoi(s) != 0;
+}
+
+void gld_BatchInit(void)
+{
+  gld_batch_walls = env_flag("DSDA_GL_BATCH", 1);
+  gld_batch_flats = env_flag("DSDA_GL_FLATS", 1);
+  gld_batch_hud = env_flag("DSDA_GL_HUD", 1);
+  gld_batch_stats = env_flag("DSDA_GL_STATS", 0);
+  lprintf(LO_INFO, "gld_BatchInit: walls/sprites %s, flats %s, HUD patches %s, light %s\n",
+          gld_batch_walls ? "batched" : "immediate",
+          gld_batch_flats ? "batched" : "per loop",
+          gld_batch_hud ? "atlas, batched" : "one texture each",
+          glsl_vlight ? "per vertex" : "uniform");
+
+  // a new GL context: nothing pending, no arrays or atlas of the old one
+  gld_batch_count = 0;
+  gld_batch_region = 0;
+  arrays_mine = 0;
+  gld_ResetPatchAtlas(true);
+}
+
+void gld_BatchSetFlats(const vbo_xyz_uv_t *verts, int count)
+{
+  if (!gld_batch_flats)
+    return;
+  if (count > flats_cpu_n)
+  {
+    flats_cpu = realloc(flats_cpu, count * sizeof(flats_cpu[0]));
+    if (!flats_cpu)
+      I_Error("gld_BatchSetFlats: out of memory");
+  }
+  memcpy(flats_cpu, verts, count * sizeof(flats_cpu[0]));
+  flats_cpu_n = count;
+}
+
+static gld_bvert_t *batch_reserve(int n)
+{
+  if (gld_batch_count + n > bv_max)
+  {
+    bv_max = (gld_batch_count + n) * 2 + 1024;
+    bv = realloc(bv, bv_max * sizeof(bv[0]));
+    if (!bv)
+      I_Error("gld_Batch: out of memory");
+  }
+  return bv + gld_batch_count;
+}
+
+// 2D (gld_DrawNumPatch_f): no vertex arrays enabled there, so they are set
+// up and switched off again around the draw
+static void batch_draw_ui(void)
+{
+  if (gl_ext_arb_vertex_buffer_object)
+    GLEXT_glBindBufferARB(GL_ARRAY_BUFFER, 0);
+  glEnableClientState(GL_VERTEX_ARRAY);
+  glEnableClientState(GL_TEXTURE_COORD_ARRAY);
+  glVertexPointer(3, GL_FLOAT, sizeof(bv[0]), &bv[0].x);
+  glTexCoordPointer(2, GL_FLOAT, sizeof(bv[0]), &bv[0].u);
+  if (glsl_vlight)
+  {
+    GLEXT_glVertexAttribPointerARB(GLSL_LIGHT_ATTR, 1, GL_FLOAT, GL_FALSE, sizeof(bv[0]), &bv[0].l);
+    GLEXT_glEnableVertexAttribArrayARB(GLSL_LIGHT_ATTR);
+  }
+
+  glDrawArrays(GL_TRIANGLES, 0, gld_batch_count);
+
+  glDisableClientState(GL_VERTEX_ARRAY);
+  glDisableClientState(GL_TEXTURE_COORD_ARRAY);
+  if (glsl_vlight)
+  {
+    GLEXT_glDisableVertexAttribArrayARB(GLSL_LIGHT_ATTR);
+    glsl_LightArrayUsed();
+    glsl_SyncLight();
+  }
+
+  st.uidraws++;
+  st.verts += gld_batch_count;
+  gld_batch_count = 0;
+}
+
+void gld_BatchDraw(void)
+{
+  if (!gld_batch_count)
+    return;
+
+  if (!gld_batch_region)
+  {
+    batch_draw_ui();
+    return;
+  }
+
+  if (!arrays_mine || arrays_base != bv)
+  {
+    if (!arrays_mine && gl_ext_arb_vertex_buffer_object)
+      GLEXT_glBindBufferARB(GL_ARRAY_BUFFER, 0);
+    glVertexPointer(3, GL_FLOAT, sizeof(bv[0]), &bv[0].x);
+    glTexCoordPointer(2, GL_FLOAT, sizeof(bv[0]), &bv[0].u);
+    if (glsl_vlight)
+    {
+      GLEXT_glVertexAttribPointerARB(GLSL_LIGHT_ATTR, 1, GL_FLOAT, GL_FALSE, sizeof(bv[0]), &bv[0].l);
+      if (!arrays_mine)
+        GLEXT_glEnableVertexAttribArrayARB(GLSL_LIGHT_ATTR);
+      glsl_LightArrayUsed();
+    }
+    arrays_mine = 1;
+    arrays_base = bv;
+  }
+
+  glDrawArrays(GL_TRIANGLES, 0, gld_batch_count);
+
+  st.draws++;
+  st.verts += gld_batch_count;
+  gld_batch_count = 0;
+}
+
+// back to what the code that doesn't batch expects: nothing pending, the
+// flats VBO as the vertex arrays, the light level and colour set in GL
+void gld_BatchBreak(void)
+{
+  gld_BatchDraw();
+
+  if (arrays_mine)
+  {
+    if (gl_ext_arb_vertex_buffer_object)
+      GLEXT_glBindBufferARB(GL_ARRAY_BUFFER, flats_vbo_id);
+    glVertexPointer(3, GL_FLOAT, sizeof(flats_vbo[0]), flats_vbo_x);
+    glTexCoordPointer(2, GL_FLOAT, sizeof(flats_vbo[0]), flats_vbo_u);
+    if (glsl_vlight)
+      GLEXT_glDisableVertexAttribArrayARB(GLSL_LIGHT_ATTR);
+    arrays_mine = 0;
+  }
+
+  if (glsl_vlight)
+    glsl_SyncLight();
+
+  if (gld_batch_region)
+    st.breaks++;
+  gld_batch_known = 0;
+}
+
+int gld_BatchBegin(int flats)
+{
+  gld_batch_region = flats ? gld_batch_flats && flats_cpu : gld_batch_walls;
+  gld_batch_known = 0;
+  return gld_batch_region;
+}
+
+// the end of a batched pass: the batch's vertex arrays stay set (the next
+// pass or gld_BatchBreak replaces them)
+void gld_BatchEnd(void)
+{
+  if (!gld_batch_region)
+    return;
+  gld_BatchDraw();
+  if (glsl_vlight)
+    glsl_SyncLight();
+  gld_batch_region = 0;
+  gld_batch_known = 0;
+}
+
+void gld_BatchFanBegin(void)
+{
+  fan_n = 0;
+}
+
+void gld_BatchFanVertex(float x, float y, float z, float u, float v)
+{
+  gld_bvert_t *p;
+
+  if (fan_n == fan_max)
+  {
+    fan_max = fan_max * 2 + 16;
+    fan = realloc(fan, fan_max * sizeof(fan[0]));
+    if (!fan)
+      I_Error("gld_BatchFanVertex: out of memory");
+  }
+  p = &fan[fan_n++];
+  p->x = x; p->y = y; p->z = z;
+  p->u = u; p->v = v;
+  p->l = glsl_light;
+}
+
+// a GL_TRIANGLE_FAN as GL_TRIANGLES: (0, i + 1, i + 2), as Mesa decomposes it
+// with the last vertex provoking
+void gld_BatchFanEnd(void)
+{
+  int i;
+  gld_bvert_t *p;
+
+  if (fan_n < 3)
+    return;
+  p = batch_reserve((fan_n - 2) * 3);
+  for (i = 0; i + 2 < fan_n; i++)
+  {
+    *p++ = fan[0];
+    *p++ = fan[i + 1];
+    *p++ = fan[i + 2];
+  }
+  gld_batch_count += (fan_n - 2) * 3;
+  st.walls++;
+}
+
+// a 4-vertex GL_TRIANGLE_STRIP (sprites): (0, 1, 2), (2, 1, 3)
+void gld_BatchQuad(const float *xyz, const float *uv)
+{
+  static const int order[6] = { 0, 1, 2, 2, 1, 3 };
+  gld_bvert_t *p = batch_reserve(6);
+  int i;
+
+  for (i = 0; i < 6; i++, p++)
+  {
+    int k = order[i];
+
+    p->x = xyz[k * 3]; p->y = xyz[k * 3 + 1]; p->z = xyz[k * 3 + 2];
+    p->u = uv[k * 2]; p->v = uv[k * 2 + 1];
+    p->l = glsl_light;
+  }
+  gld_batch_count += 6;
+  st.sprites++;
+}
+
+// a 2D patch (gld_DrawNumPatch_f's strip) at z = 0
+void gld_BatchUIQuad(float x1, float y1, float x2, float y2,
+                     float u1, float u2, float v1, float v2)
+{
+  const float xyz[12] = { x1, y1, 0.0f, x1, y2, 0.0f, x2, y1, 0.0f, x2, y2, 0.0f };
+  const float uv[8] = { u1, v1, u1, v2, u2, v1, u2, v2 };
+
+  gld_BatchQuad(xyz, uv);
+  st.sprites--;
+  st.ui++;
+}
+
+static void flat_vertex(gld_bvert_t *p, int index, float y)
+{
+  const vbo_xyz_uv_t *s = &flats_cpu[index];
+
+  p->x = s->x; p->y = s->y + y; p->z = s->z;
+  p->u = s->u; p->v = s->v;
+  p->l = glsl_light;
+}
+
+int gld_BatchLoopOK(GLenum mode, int first, int count)
+{
+  return (mode == GL_TRIANGLES || mode == GL_TRIANGLE_FAN || mode == GL_TRIANGLE_STRIP) &&
+         first >= 0 && count >= 0 && first + count <= flats_cpu_n;
+}
+
+// one flat loop (a tesselator fan, strip or triangle list) raised to height y
+void gld_BatchLoop(GLenum mode, int first, int count, float y)
+{
+  int i, n;
+  gld_bvert_t *p;
+
+  if (count < 3)
+    return;
+
+  switch (mode)
+  {
+  case GL_TRIANGLES:
+    n = count / 3 * 3;
+    p = batch_reserve(n);
+    for (i = 0; i < n; i++)
+      flat_vertex(p++, first + i, y);
+    break;
+  case GL_TRIANGLE_FAN:
+    n = (count - 2) * 3;
+    p = batch_reserve(n);
+    for (i = 0; i + 2 < count; i++)
+    {
+      flat_vertex(p++, first, y);
+      flat_vertex(p++, first + i + 1, y);
+      flat_vertex(p++, first + i + 2, y);
+    }
+    break;
+  case GL_TRIANGLE_STRIP:
+    n = (count - 2) * 3;
+    p = batch_reserve(n);
+    for (i = 0; i + 2 < count; i++)
+    {
+      if (i & 1)
+      {
+        flat_vertex(p++, first + i + 1, y);
+        flat_vertex(p++, first + i, y);
+      }
+      else
+      {
+        flat_vertex(p++, first + i, y);
+        flat_vertex(p++, first + i + 1, y);
+      }
+      flat_vertex(p++, first + i + 2, y);
+    }
+    break;
+  default:
+    return;
+  }
+  gld_batch_count += n;
+}
+
+void gld_BatchCountFlat(void)
+{
+  st.flats++;
+}
+
+void gld_BatchFrame(void)
+{
+  if (!gld_batch_stats)
+    return;
+  if (++st.frames == 350)
+  {
+    double f = st.frames;
+
+    lprintf(LO_INFO, "gl batch: per frame %.1f batched draws in the scene and "
+            "%.1f in 2D (%.0f vertices), %.1f walls, %.1f flats, %.1f sprites, "
+            "%.1f HUD patches batched, %.1f breaks\n",
+            st.draws / f, st.uidraws / f, st.verts / f, st.walls / f, st.flats / f,
+            st.sprites / f, st.ui / f, st.breaks / f);
+    memset(&st, 0, sizeof(st));
+  }
+}
diff --git a/prboom2/src/gl_batchflush.h b/prboom2/src/gl_batchflush.h
new file mode 100644
--- /dev/null
+++ b/prboom2/src/gl_batchflush.h
@@ -0,0 +1,82 @@
+/*
+ * gl_batchflush.h: included last by every source that calls GL, except
+ * gl_batch.c. Each GL call that draws or changes state draws the batched
+ * triangles still pending first (gl_batch.c), so a batch only grows while
+ * nothing else touches GL. Calls that only read state, the active texture
+ * unit (binds on it flush), and the light level attribute (the batched
+ * vertices carry it) are left alone.
+ */
+
+#ifndef GL_BATCHFLUSH_H
+#define GL_BATCHFLUSH_H
+
+extern int gld_batch_count;
+void gld_BatchDraw(void);
+
+#define GLD_BATCH_FLUSH_EXPR ((void)(gld_batch_count && (gld_BatchDraw(), 1)))
+
+#define glBegin(a0) (GLD_BATCH_FLUSH_EXPR, glBegin((a0)))
+#define glBindTexture(a0, a1) (GLD_BATCH_FLUSH_EXPR, glBindTexture((a0), (a1)))
+#define glBlendFunc(a0, a1) (GLD_BATCH_FLUSH_EXPR, glBlendFunc((a0), (a1)))
+#define glAlphaFunc(a0, a1) (GLD_BATCH_FLUSH_EXPR, glAlphaFunc((a0), (a1)))
+#define glClear(a0) (GLD_BATCH_FLUSH_EXPR, glClear((a0)))
+#define glClearColor(a0, a1, a2, a3) (GLD_BATCH_FLUSH_EXPR, glClearColor((a0), (a1), (a2), (a3)))
+#define glClearDepth(a0) (GLD_BATCH_FLUSH_EXPR, glClearDepth((a0)))
+#define glColor3f(a0, a1, a2) (GLD_BATCH_FLUSH_EXPR, glColor3f((a0), (a1), (a2)))
+#define glColor4f(a0, a1, a2, a3) (GLD_BATCH_FLUSH_EXPR, glColor4f((a0), (a1), (a2), (a3)))
+#define glColor4fv(a0) (GLD_BATCH_FLUSH_EXPR, glColor4fv((a0)))
+#define glColorMask(a0, a1, a2, a3) (GLD_BATCH_FLUSH_EXPR, glColorMask((a0), (a1), (a2), (a3)))
+#define glColorPointer(a0, a1, a2, a3) (GLD_BATCH_FLUSH_EXPR, glColorPointer((a0), (a1), (a2), (a3)))
+#define glCopyTexSubImage2D(a0, a1, a2, a3, a4, a5, a6, a7) (GLD_BATCH_FLUSH_EXPR, glCopyTexSubImage2D((a0), (a1), (a2), (a3), (a4), (a5), (a6), (a7)))
+#define glCullFace(a0) (GLD_BATCH_FLUSH_EXPR, glCullFace((a0)))
+#define glDeleteTextures(a0, a1) (GLD_BATCH_FLUSH_EXPR, glDeleteTextures((a0), (a1)))
+#define glDepthFunc(a0) (GLD_BATCH_FLUSH_EXPR, glDepthFunc((a0)))
+#define glDepthMask(a0) (GLD_BATCH_FLUSH_EXPR, glDepthMask((a0)))
+#define glDisable(a0) (GLD_BATCH_FLUSH_EXPR, glDisable((a0)))
+#define glDisableClientState(a0) (GLD_BATCH_FLUSH_EXPR, glDisableClientState((a0)))
+#define glDrawArrays(a0, a1, a2) (GLD_BATCH_FLUSH_EXPR, glDrawArrays((a0), (a1), (a2)))
+#define glEnable(a0) (GLD_BATCH_FLUSH_EXPR, glEnable((a0)))
+#define glEnableClientState(a0) (GLD_BATCH_FLUSH_EXPR, glEnableClientState((a0)))
+#define glFlush() (GLD_BATCH_FLUSH_EXPR, glFlush())
+#define glHint(a0, a1) (GLD_BATCH_FLUSH_EXPR, glHint((a0), (a1)))
+#define glLoadIdentity() (GLD_BATCH_FLUSH_EXPR, glLoadIdentity())
+#define glLoadMatrixf(a0) (GLD_BATCH_FLUSH_EXPR, glLoadMatrixf((a0)))
+#define glMatrixMode(a0) (GLD_BATCH_FLUSH_EXPR, glMatrixMode((a0)))
+#define glOrtho(a0, a1, a2, a3, a4, a5) (GLD_BATCH_FLUSH_EXPR, glOrtho((a0), (a1), (a2), (a3), (a4), (a5)))
