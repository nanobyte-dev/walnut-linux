From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 22:18:16 +0300
Subject: timedemo: DSDA_BENCH_LOOPS=N repeats the demo N times, one Timed line
 per pass

diff --git a/prboom2/src/g_game.c b/prboom2/src/g_game.c
--- a/prboom2/src/g_game.c
+++ b/prboom2/src/g_game.c
@@ -4031,12 +4031,23 @@ dboolean G_CheckDemoStatus (void)
     int endtime = dsda_GetTickRealTime();
     // killough -- added fps information and made it work for longer demos:
     unsigned realtics = endtime-starttime;
+    // DSDA_BENCH_LOOPS=N: N passes of the demo, each timed from its own start
+    static int bench_pass, bench_tic0;
+    unsigned passtics = (unsigned) (gametic - bench_tic0);
 
     M_SaveDefaults();
 
     lprintf(LO_INFO, "Timed %u gametics in %u realtics = %-.1f frames per second\n",
-             (unsigned) gametic,realtics,
-             (unsigned) gametic * (double) TICRATE / realtics);
+             passtics,realtics,
+             passtics * (double) TICRATE / realtics);
+
+    if (getenv("DSDA_BENCH_LOOPS") && ++bench_pass < atoi(getenv("DSDA_BENCH_LOOPS")))
+    {
+      bench_tic0 = gametic;
+      starttime = endtime;
+      G_DeferedPlayDemo(defdemoname);
+      return true;
+    }
 
     if (dsda_IntConfig(dsda_config_demo_end_quit))
       I_SafeExit(0);
