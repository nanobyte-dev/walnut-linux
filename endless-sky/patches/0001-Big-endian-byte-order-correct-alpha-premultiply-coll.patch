From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@zoho.eu>
Date: Mon, 19 Oct 2026 18:42:15 +0300
Subject: Big-endian: byte-order-correct alpha (premultiply, collision masks,
 font kerning)

Pixels are R, G, B, A bytes in memory. Premultiply, Mask::Trace and
Font::CalculateAdvances read them as little-endian uint32_t with alpha in the top
byte, which on a big-endian machine is the red channel: every PNG came out
wrongly premultiplied, masks and glyph advances were wrong. Premultiply works on
the bytes now and the other two take ImageBuffer::ALPHA_MASK / ALPHA_SHIFT.

diff --git a/source/image/ImageBuffer.cpp b/source/image/ImageBuffer.cpp
--- a/source/image/ImageBuffer.cpp
+++ b/source/image/ImageBuffer.cpp
@@ -537,24 +537,20 @@ namespace {
 	{
 		for(int y = 0; y < buffer.Height(); ++y)
 		{
-			uint32_t *it = buffer.Begin(y, frame);
+			// The pixels are R, G, B, A bytes in memory, whatever the byte order of the machine.
+			uint8_t *it = reinterpret_cast<uint8_t *>(buffer.Begin(y, frame));
 
-			for(uint32_t *end = it + buffer.Width(); it != end; ++it)
+			for(uint8_t *end = it + 4 * buffer.Width(); it != end; it += 4)
 			{
-				uint64_t value = *it;
-				uint64_t alpha = (value & 0xFF000000) >> 24;
+				unsigned alpha = it[3];
 
-				uint64_t red = (((value & 0xFF0000) * alpha) / 255) & 0xFF0000;
-				uint64_t green = (((value & 0xFF00) * alpha) / 255) & 0xFF00;
-				uint64_t blue = (((value & 0xFF) * alpha) / 255) & 0xFF;
+				it[0] = (it[0] * alpha) / 255;
+				it[1] = (it[1] * alpha) / 255;
+				it[2] = (it[2] * alpha) / 255;
 
-				value = red | green | blue;
 				if(blend == BlendingMode::HALF_ADDITIVE)
 					alpha >>= 2;
-				if(blend != BlendingMode::ADDITIVE)
-					value |= (alpha << 24);
-
-				*it = static_cast<uint32_t>(value);
+				it[3] = (blend == BlendingMode::ADDITIVE) ? 0 : alpha;
 			}
 		}
 	}
diff --git a/source/image/ImageBuffer.h b/source/image/ImageBuffer.h
--- a/source/image/ImageBuffer.h
+++ b/source/image/ImageBuffer.h
@@ -15,6 +15,7 @@ this program. If not, see <https://www.gnu.org/licenses/>.
 
 #pragma once
 
+#include <bit>
 #include <cstdint>
 #include <set>
 #include <string>
@@ -31,6 +32,12 @@ class ImageFileData;
 // some sort of special format.
 class ImageBuffer {
 public:
+	// Pixels are four bytes in memory, in the order R, G, B, A. Read as one uint32_t, the alpha
+	// channel is the top byte on a little-endian machine and the bottom byte on a big-endian one.
+	static constexpr bool IS_LITTLE_ENDIAN = std::endian::native == std::endian::little;
+	static constexpr int ALPHA_SHIFT = IS_LITTLE_ENDIAN ? 24 : 0;
+	static constexpr uint32_t ALPHA_MASK = uint32_t{0xFF} << ALPHA_SHIFT;
+
 	// The supported image extensions, in lower case and with a leading period.
 	static const std::set<std::string> &ImageExtensions();
 	// Image extensions that signify image sequences. This is a subset of ImageExtensions().
