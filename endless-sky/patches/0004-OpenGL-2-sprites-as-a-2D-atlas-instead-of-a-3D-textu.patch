+	// The largest texture the atlas may use; nv30 and nv40 stop at 4096.
+	int MaxAtlasSize()
+	{
+		static int size = 0;
+		if(!size)
+		{
+			GLint max = 0;
+			glGetIntegerv(GL_MAX_TEXTURE_SIZE, &max);
+			size = max > 0 ? min<int>(max, 4096) : 2048;
+		}
+		return size;
+	}
+
+	int NextPowerOfTwo(int n)
+	{
+		int result = 1;
+		while(result < n)
+			result <<= 1;
+		return result;
+	}
+
+	// Frames in a grid, columns first, in a texture of power-of-two size (the Mesa patch that
+	// compresses textures on the PS3 only takes those). The shaders compute the number of columns
+	// themselves as floor(width / frame width), so that is what this uses.
+	struct AtlasLayout {
+		int columns = 0;
+		int rows = 0;
+		int width = 0;
+		int height = 0;
+	};
+
+	// Find the layout with the least padded area, or one with no columns if the frames don't fit.
+	AtlasLayout ChooseLayout(int frameWidth, int frameHeight, int frames, int maxSize)
+	{
+		AtlasLayout best;
+		for(int wanted = 1; wanted <= frames; ++wanted)
+		{
+			int width = NextPowerOfTwo(wanted * frameWidth);
+			if(width > maxSize)
+				break;
+			AtlasLayout layout;
+			layout.width = width;
+			layout.columns = width / frameWidth;
+			layout.rows = (frames + layout.columns - 1) / layout.columns;
+			layout.height = NextPowerOfTwo(layout.rows * frameHeight);
+			if(layout.height > maxSize)
+				continue;
+			if(!best.columns || layout.width * layout.height < best.width * best.height)
+				best = layout;
+		}
+		return best;
+	}
+
+	void AddBuffer(ImageBuffer &buffer, uint32_t *target, float *atlas, bool noReduction)
 	{
