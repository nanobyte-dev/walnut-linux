+uniform vec2 center;
+uniform vec2 angle;
+uniform vec2 size;
+uniform float offset;
+
+attribute vec2 vert;
+varying vec2 coord;
+
+void main() {
+	coord = vert * size.x;
+	vec2 base = center + angle * (offset - size.y * (vert.x + vert.y));
