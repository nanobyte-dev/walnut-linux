+uniform vec2 position;
+uniform mat2 transform;
+uniform vec2 blur;
+uniform float clip;
+
+attribute vec2 vert;
+varying vec2 fragTexCoord;
+
+void main() {
+	vec2 blurOff = 2.0 * vec2(vert.x * abs(blur.x), vert.y * abs(blur.y));
