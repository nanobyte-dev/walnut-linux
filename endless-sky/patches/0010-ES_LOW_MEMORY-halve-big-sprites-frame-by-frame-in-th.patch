+#ifdef ES_LOW_MEMORY
+	// Decoded pixels waiting for the main thread to upload them. The loader threads are faster than
+	// the main thread (on the PS3 much faster), so they wait before decoding the next image while
+	// more than this is queued; the decoded images were piling up to hundreds of MB.
+	constexpr size_t PENDING_LIMIT = 16 << 20;
+	mutex pendingMutex;
+	condition_variable pendingCond;
+	size_t pendingBytes = 0;
+
+	void WaitForRoom()
+	{
+		unique_lock lock(pendingMutex);
+		// Not for ever: a main thread that stops uploading (quitting during the load) must not
+		// leave the workers stuck.
+		pendingCond.wait_for(lock, chrono::milliseconds(500), [] { return pendingBytes < PENDING_LIMIT; });
+	}
+
+	void AddPending(size_t bytes)
+	{
+		lock_guard lock(pendingMutex);
+		pendingBytes += bytes;
+	}
+
+	void RemovePending(size_t bytes)
+	{
+		{
+			lock_guard lock(pendingMutex);
+			pendingBytes -= bytes;
+		}
+		pendingCond.notify_all();
+	}
+#endif
