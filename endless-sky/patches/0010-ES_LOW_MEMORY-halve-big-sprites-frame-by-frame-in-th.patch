From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@zoho.eu>
Date: Tue, 20 Oct 2026 07:11:22 +0300
Subject: ES_LOW_MEMORY: halve big sprites frame by frame in the loader thread,
 limit the decoded pixels waiting for upload to 16 MB

ps3.589 still ran out of memory in the sprite load (the PS3 load takes 100+ s). Decoded sprites are
full size until the main thread uploads and halves them: the biggest are 90, 64, 54, 54 and
45 MB (ember tear vortex, milky way, tachytia, astral, jd detainer), and 6 or 100 chains of them
waiting for a slow main thread peaked at 124 / 287 MB of pending pixels on the PC (with a 20 ms
upload delay for the PS3's slow main thread).
- ImageSet::Load applies the "reduce large graphics" setting itself: each frame is decoded alone,
  its collision mask made from the full frame, and a half-size copy stored (ImageBuffer::
  AddHalvedFrame). The sprite keeps the full size (FullWidth/FullHeight) and Sprite::AddBuffer
  does not halve again. Same box filter, so the textures are identical.
- The loader threads wait (at most 500 ms at a time) while 16 MB of decoded pixels are queued;
  12 chains keep the main thread supplied. With both: peak pending 24 MB.

diff --git a/source/image/ImageBuffer.cpp b/source/image/ImageBuffer.cpp
--- a/source/image/ImageBuffer.cpp
+++ b/source/image/ImageBuffer.cpp
@@ -86,6 +86,7 @@ void ImageBuffer::Clear(int frames)
 {
 	delete [] pixels;
 	pixels = nullptr;
+	fullWidth = fullHeight = 0;
 	this->frames = frames;
 }
 
@@ -156,6 +157,54 @@ uint32_t *ImageBuffer::Begin(int y, int frame)
 
 
 
+bool ImageBuffer::IsReduced() const
+{
+	return fullWidth != 0;
+}
+
+
+
+int ImageBuffer::FullWidth() const
+{
+	return fullWidth ? fullWidth : width;
+}
+
+
+
+int ImageBuffer::FullHeight() const
+{
+	return fullWidth ? fullHeight : height;
+}
+
+
+
+void ImageBuffer::AddHalvedFrame(const ImageBuffer &full, int frame)
+{
+	if(!pixels)
+	{
+		Allocate(full.width / 2, full.height / 2);
+		fullWidth = full.width;
+		fullHeight = full.height;
+	}
+	if(!pixels || frame < 0 || frame >= frames || full.width != fullWidth || full.height != fullHeight)
+		return;
+
+	const unsigned char *begin = reinterpret_cast<const unsigned char *>(full.pixels);
+	unsigned char *out = reinterpret_cast<unsigned char *>(Begin(0, frame));
+	for(int y = 0; y < height; ++y)
+	{
+		const unsigned char *aIt = begin + (4 * full.width) * (2 * y);
+		const unsigned char *aEnd = aIt + 4 * 2 * width;
+		const unsigned char *bIt = begin + (4 * full.width) * (2 * y + 1);
+		for( ; aIt != aEnd; aIt += 4, bIt += 4)
+			for(int channel = 0; channel < 4; ++channel, ++aIt, ++bIt, ++out)
+				*out = (static_cast<unsigned>(aIt[0]) + static_cast<unsigned>(bIt[0])
+					+ static_cast<unsigned>(aIt[4]) + static_cast<unsigned>(bIt[4]) + 2) / 4;
+	}
+}
+
+
+
 void ImageBuffer::ShrinkToHalfSize()
 {
 	ImageBuffer result(frames);
