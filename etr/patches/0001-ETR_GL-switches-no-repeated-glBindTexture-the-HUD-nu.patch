 void TTexture::Bind() {
+	// the same texture again: SFML would bind it and load the texture matrix once more
+	if (GlFastOn(GLF_BIND) && !Winsys.SFMLRenders()) {
+		if (GlFastIsBound(&texture)) return;
+		GlFastSetBound(&texture);
+	} else {
+		GlFastForgetBind();
+	}
 	sf::Texture::bind(&texture);
 }
 
+void TTexture::GetSize(GLint& w, GLint& h) {
+	if (GlFastOn(GLF_HUD)) {
+		if (size_w == 0) {
+			glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &size_w);
+			glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &size_h);
+		}
+		w = size_w;
+		h = size_h;
+		return;
+	}
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+}
