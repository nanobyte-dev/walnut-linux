new file mode 100644
--- /dev/null
+++ b/src/glfast.cpp
@@ -0,0 +1,118 @@
+/* --------------------------------------------------------------------
+Fewer, larger OpenGL submissions: see glfast.h.
+---------------------------------------------------------------------*/
+
+#ifdef HAVE_CONFIG_H
+#include <etr_config.h>
+#endif
+
+#include "glfast.h"
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+
+static bool features[GLF_COUNT];
+static bool features_read = false;
+
+static const char* const feature_names[GLF_COUNT] = {
+	"TERRAIN", "TUX", "SHADOW", "TRACKS", "TREES", "PARTICLES", "SNOW", "HUD", "BIND"
+};
+
+static bool EnvOff(const char* name) {
+	const char* v = std::getenv(name);
+	return v && v[0] == '0';
+}
+
+static bool EnvSet(const char* name) {
+	return std::getenv(name) != nullptr;
+}
+
+static void ReadFeatures() {
+	features_read = true;
+	bool master = !EnvOff("ETR_GL");
+	std::string on;
+	for (int i = 0; i < GLF_COUNT; i++) {
+		std::string name = std::string("ETR_GL_") + feature_names[i];
+		// ETR_GL=0 turns all off, a variable of its own decides for its change
+		features[i] = EnvSet(name.c_str()) ? !EnvOff(name.c_str()) : master;
+		if (features[i]) on += std::string(" ") + feature_names[i];
+	}
+	std::cout << "GL submission changes on:" << (on.empty() ? " none" : on) << std::endl;
+}
+
+bool GlFastOn(GlFastFeature f) {
+	if (!features_read) ReadFeatures();
+	return features[f];
+}
+
+bool GlFastEnv(const char* name, bool def) {
+	return EnvSet(name) ? !EnvOff(name) : def;
+}
+
+static PFNGLGENBUFFERSPROC p_glGenBuffers = nullptr;
+static PFNGLDELETEBUFFERSPROC p_glDeleteBuffers = nullptr;
+static PFNGLBINDBUFFERPROC p_glBindBuffer = nullptr;
+static PFNGLBUFFERDATAPROC p_glBufferData = nullptr;
+static GLuint bound_array_buffer = 0;
+
+void GlFastInit() {
+	if (!features_read) ReadFeatures();
+	p_glGenBuffers = (PFNGLGENBUFFERSPROC)sf::Context::getFunction("glGenBuffers");
+	p_glDeleteBuffers = (PFNGLDELETEBUFFERSPROC)sf::Context::getFunction("glDeleteBuffers");
+	p_glBindBuffer = (PFNGLBINDBUFFERPROC)sf::Context::getFunction("glBindBuffer");
+	p_glBufferData = (PFNGLBUFFERDATAPROC)sf::Context::getFunction("glBufferData");
+	if (!GlFastHaveVBO()) {
+		std::cout << "no buffer objects: the terrain stays on client arrays" << std::endl;
+		p_glGenBuffers = nullptr;
+	}
+}
+
+bool GlFastHaveVBO() {
+	return p_glGenBuffers && p_glDeleteBuffers && p_glBindBuffer && p_glBufferData;
+}
+
+GLuint GlFastGenBuffer() {
+	GLuint b = 0;
+	p_glGenBuffers(1, &b);
+	return b;
+}
+
+void GlFastDeleteBuffer(GLuint buf) {
+	if (buf && p_glDeleteBuffers) p_glDeleteBuffers(1, &buf);
+}
+
+void GlFastBindArrayBuffer(GLuint buf) {
+	if (buf == bound_array_buffer) return;
+	p_glBindBuffer(GL_ARRAY_BUFFER, buf);
+	bound_array_buffer = buf;
+}
+
+void GlFastBufferData(GLsizeiptr size, const void* data) {
+	p_glBufferData(GL_ARRAY_BUFFER, size, data, GL_STATIC_DRAW);
+}
+
+static const void* bound_texture = nullptr;
+
+void GlFastForgetBind() {
+	bound_texture = nullptr;
+}
+
+bool GlFastIsBound(const void* tex) {
+	return bound_texture == tex;
+}
+
+void GlFastSetBound(const void* tex) {
+	bound_texture = tex;
+}
+
+static int generation = 0;
+
+void GlFastReset() {
+	bound_texture = nullptr;
+	bound_array_buffer = 0;
+	generation++;
+}
+
+int GlFastGeneration() {
+	return generation;
+}
diff --git a/src/glfast.h b/src/glfast.h
new file mode 100644
--- /dev/null
+++ b/src/glfast.h
@@ -0,0 +1,55 @@
+/* --------------------------------------------------------------------
+Fewer, larger OpenGL submissions (Ps3Stuff patches): which of them are on,
+and the buffer object functions they use (OpenGL 1.5, loaded at run time
+like glLockArraysEXT).
+Each change has an environment variable: "0" turns it off, "1" on. ETR_GL=0
+turns all off (the game then draws as before) except the ones whose own
+variable is 1:
+  ETR_GL_TERRAIN    the terrain from buffer objects, one quadtree walk
+  ETR_GL_TUX        Tux's spheres from one vertex array each
+  ETR_GL_SHADOW     Tux's shadow in one draw
+  ETR_GL_TRACKS     the track marks as arrays, only what the camera sees
+  ETR_GL_TREES      trees and items: one draw per texture
+  ETR_GL_PARTICLES  the snow Tux throws up: one draw
+  ETR_GL_SNOW       falling snow and snow curtains: one draw each
+  ETR_GL_HUD        the numbers of the hud: one draw per string
+  ETR_GL_BIND       no glBindTexture and texture matrix for a bound texture
+---------------------------------------------------------------------*/
+
+#ifndef GLFAST_H
+#define GLFAST_H
+
+#include "bh.h"
+
+enum GlFastFeature {
+	GLF_TERRAIN,
+	GLF_TUX,
+	GLF_SHADOW,
+	GLF_TRACKS,
+	GLF_TREES,
+	GLF_PARTICLES,
+	GLF_SNOW,
+	GLF_HUD,
+	GLF_BIND,
+	GLF_COUNT
+};
+
+bool GlFastOn(GlFastFeature f);
+bool GlFastEnv(const char* name, bool def);	// a variable of its own: def when not set, else not "0"
+void GlFastInit();	// the context exists
+void GlFastReset();	// the context is a new one: buffers made before are not to be used
+int GlFastGeneration();	// counts the resets
+bool GlFastHaveVBO();
+
+// buffer objects (GL 1.5)
+GLuint GlFastGenBuffer();
+void GlFastDeleteBuffer(GLuint buf);
+void GlFastBindArrayBuffer(GLuint buf);
+void GlFastBufferData(GLsizeiptr size, const void* data);	// GL_ARRAY_BUFFER, GL_STATIC_DRAW
+
+// the texture bound last (TTexture::Bind); forgotten whenever SFML may bind its own
+void GlFastForgetBind();
+bool GlFastIsBound(const void* tex);
+void GlFastSetBound(const void* tex);
+
+#endif
