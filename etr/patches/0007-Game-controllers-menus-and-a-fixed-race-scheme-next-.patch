+// ---------------------------------------------------------------------
+// Game controllers. SFML 3 on Linux reads /dev/input/js*, so a button number is the
+// joydev index. For the DualShock 3 (hid-sony; the codes in order, which is how joydev
+// numbers them):
+//   0 Cross  1 Circle  2 Triangle  3 Square  4 L1  5 R1  6 L2  7 R2  8 Select  9 Start
+//   10 PS  11 L3  12 R3  13 d-pad up  14 down  15 left  16 right
+// axes: X, Y = left stick (-100..100, Y down is positive); Z, R = right stick; PovX/PovY
+// = a hat, if a pad has one instead of the d-pad buttons. L2/R2 are buttons here (hid-sony
+// has no trigger axes). A pad with no buttons (the DS3's motion sensors) is no controller.
+// Controller N is not tied to a player: ETR has one player, any pad plays it.
+static bool padHeldNow[sf::Joystick::Count][State::PAD_COUNT];
+
+bool State::padHeld(int button) {
+	for (unsigned int i = 0; i < sf::Joystick::Count; i++)
+		if (padHeldNow[i][button]) return true;
+	return false;
+}
+
+static void PadSet(unsigned int id, int button, bool down) {
+	if (id >= sf::Joystick::Count || sf::Joystick::getButtonCount(id) == 0) return;
+	if (padHeldNow[id][button] == down) return;
+	padHeldNow[id][button] = down;
+	if (State::manager.CurrentState()) State::manager.CurrentState()->Pad(button, down);
+}
+
+static void PadButtonEvent(unsigned int id, unsigned int number, bool down) {
+	static const signed char map[] = {
+		State::PAD_CROSS, State::PAD_CIRCLE, State::PAD_TRIANGLE, State::PAD_SQUARE,
+		State::PAD_L1, State::PAD_R1, State::PAD_L2, State::PAD_R2,
+		-1, State::PAD_START, -1, -1, -1,
+		State::PAD_UP, State::PAD_DOWN, State::PAD_LEFT, State::PAD_RIGHT
+	};
+	if (number < sizeof(map) && map[number] >= 0) PadSet(id, map[number], down);
+}
+
+static void PadAxis(const sf::Event::JoystickMoved& m) {
+	unsigned int id = m.joystickId;
+	if (id >= sf::Joystick::Count || sf::Joystick::getButtonCount(id) == 0) return;
+	float v = m.position;
+	switch (m.axis) {
+		case sf::Joystick::Axis::X:
+			PadSet(id, State::PAD_LEFT, v < -50 || (padHeldNow[id][State::PAD_LEFT] && v < -30));
+			PadSet(id, State::PAD_RIGHT, v > 50 || (padHeldNow[id][State::PAD_RIGHT] && v > 30));
+			if (State::manager.CurrentState()) State::manager.CurrentState()->Jaxis(0, v / 100.f);
+			break;
+		case sf::Joystick::Axis::Y:
+			PadSet(id, State::PAD_UP, v < -50 || (padHeldNow[id][State::PAD_UP] && v < -30));
+			PadSet(id, State::PAD_DOWN, v > 50 || (padHeldNow[id][State::PAD_DOWN] && v > 30));
+			break;
+		case sf::Joystick::Axis::PovX:
+			PadSet(id, State::PAD_LEFT, v < -50);
+			PadSet(id, State::PAD_RIGHT, v > 50);
+			break;
+		case sf::Joystick::Axis::PovY:	// SFML: up is positive on the hat
+			PadSet(id, State::PAD_UP, v > 50);
+			PadSet(id, State::PAD_DOWN, v < -50);
+			break;
+		default:
+			break;
+	}
+}
+
+// In a menu a press is the key the screen already understands: d-pad and left stick are
+// the arrow keys, Cross and Start Enter, Circle Escape.
+void State::Pad(int button, bool pressed) {
+	if (!pressed) return;
+	sf::Keyboard::Key key;
+	switch (button) {
+		case PAD_UP: key = sf::Keyboard::Key::Up; break;
+		case PAD_DOWN: key = sf::Keyboard::Key::Down; break;
+		case PAD_LEFT: key = sf::Keyboard::Key::Left; break;
+		case PAD_RIGHT: key = sf::Keyboard::Key::Right; break;
+		case PAD_CROSS:
+		case PAD_START: key = sf::Keyboard::Key::Enter; break;
+		case PAD_CIRCLE: key = sf::Keyboard::Key::Escape; break;
+		default: return;
+	}
+	Keyb(key, false, sf::Mouse::getPosition().x, sf::Mouse::getPosition().y);
+	Keyb(key, true, sf::Mouse::getPosition().x, sf::Mouse::getPosition().y);
+}
