+    fluid_speq_close(mixer->speq);
+#endif
+
 #if ENABLE_MIXER_THREADS
     delete_rvoice_mixer_threads(mixer);
 
@@ -1754,6 +1942,13 @@ fluid_rvoice_mixer_render(fluid_rvoice_mixer_t *mixer, int blockcount)
         fluid_render_loop_multithread(mixer, blockcount);
     }
     else
+#endif
+#if FLUID_SPEQ
+    if(mixer->speq != NULL && mixer->active_voices > 0)
+    {
+        fluid_render_loop_speq(mixer, blockcount);
+    }
+    else
 #endif
     {
         fluid_render_loop_singlethread(mixer, blockcount);
diff --git a/src/rvoice/fluid_rvoice_speq.c b/src/rvoice/fluid_rvoice_speq.c
new file mode 100644
--- /dev/null
+++ b/src/rvoice/fluid_rvoice_speq.c
@@ -0,0 +1,337 @@
+/* FluidSynth - A Software Synthesizer
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public License
+ * as published by the Free Software Foundation; either version 2.1 of
+ * the License, or (at your option) any later version.
+ */
+
+/*
+ * The voice DSP through libspeq.so.0 (ps3-spu: speq_synth_*_v1), loaded with dlopen: FluidSynth
+ * doesn't depend on it. libspeq runs fluid_rvoice_write_dsp() and fluid_rvoice_buffers_mix()
+ * for a block of voices on the Cell's SPEs; FluidSynth keeps the control part
+ * (fluid_rvoice_write_ctl()) and copies each voice's DSP state to libspeq and back. All policy
+ * (which unit, sizes, timeouts, SPEQ_SYNTH=auto|spu|ppe|off) lives in libspeq.
+ */
+
+#include "fluid_rvoice_speq.h"
+
+#if FLUID_SPEQ
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdint.h>
+
+/* libspeq's speq.h, the part this uses: SPEQ_SYNTH_ABI 1, frozen (a change is a _v2) */
+#define SPEQ_SYNTH_ABI 1
+#define SPEQ_SYNTH_BUFS 4
+#define SPEQ_SYNTH_PPE (-2)
+enum { SPEQ_SYNTH_NONE, SPEQ_SYNTH_LINEAR, SPEQ_SYNTH_CUBIC };
+enum { SPEQ_SYNTH_IIR_OFF, SPEQ_SYNTH_IIR_LOWPASS, SPEQ_SYNTH_IIR_HIGHPASS };
+#define SPEQ_SYNTH_IIR_NO_GAIN 1u
+
+struct speq_synth_filter
+{
+    double hist1, hist2;
+    double last_fres, fres_incr;
+    double last_q, q_incr;
+    double amp, amp_incr;
+    float b02, b1, a1, a2;
+    int32_t fres_incr_count, q_incr_count;
+    uint32_t type, flags;
+};
+
+struct speq_synth_voice
+{
+    uint64_t data;
+    uint64_t phase;
+    double phase_incr;
+    uint32_t start, end, loopstart, loopend;
+    uint8_t interp, looping;
+    uint8_t has_looped, pad0;
+    int8_t line[SPEQ_SYNTH_BUFS];
+    double cur_amp[SPEQ_SYNTH_BUFS], tgt_amp[SPEQ_SYNTH_BUFS];
+    struct speq_synth_filter custom, res;
+    int32_t count;
+    uint32_t priv[19];
+} __attribute__((aligned(16)));
+
+struct speq_synth_params
+{
+    uint32_t abi;
+    uint32_t voice_size;
+    uint32_t lines;
+    uint32_t max_voices;
+    const double *cubic;
+    const double *linear;
+};
+
+struct speq_synth_block
+{
+    struct speq_synth_voice *voice;
+    unsigned cap, lines;
+    const double *out;
+    const void *sincos;
+    uint32_t sincos_n;
+};
+
+struct speq_synth;
+
+typedef char speq_voice_is_384[sizeof(struct speq_synth_voice) == 384 ? 1 : -1];
+typedef char speq_bufs_match[FLUID_RVOICE_MAX_BUFS == SPEQ_SYNTH_BUFS ? 1 : -1];
+
+static struct
+{
+    int (*open)(struct speq_synth **, const struct speq_synth_params *);
+    struct speq_synth_block *(*begin)(struct speq_synth *);
+    int (*submit)(struct speq_synth *, struct speq_synth_block *, unsigned);
+    int (*wait)(struct speq_synth *, struct speq_synth_block *);
+    void (*close)(struct speq_synth *);
+} speq;
+static pthread_once_t speq_once = PTHREAD_ONCE_INIT;
+
+extern const fluid_real_t *const interp_coeff;
+extern const fluid_real_t *const interp_coeff_linear;
+
+struct _fluid_speq_t
+{
+    struct speq_synth *s;
+    struct speq_synth_block *blk;
+    unsigned n;
+};
+
+static void speq_load(void)
+{
+    void *h = dlopen("libspeq.so.0", RTLD_NOW | RTLD_LOCAL);
+
+    if(h == NULL)
+    {
+        return;
+    }
+
+    speq.open = (int (*)(struct speq_synth **, const struct speq_synth_params *))dlsym(h, "speq_synth_open_v1");
+    speq.begin = (struct speq_synth_block * (*)(struct speq_synth *))dlsym(h, "speq_synth_begin_v1");
+    speq.submit = (int (*)(struct speq_synth *, struct speq_synth_block *, unsigned))dlsym(h, "speq_synth_submit_v1");
+    speq.wait = (int (*)(struct speq_synth *, struct speq_synth_block *))dlsym(h, "speq_synth_wait_v1");
+    speq.close = (void (*)(struct speq_synth *))dlsym(h, "speq_synth_close_v1");
+
+    if(!speq.open || !speq.begin || !speq.submit || !speq.wait || !speq.close)
+    {
+        speq.open = NULL;
+    }
+}
+
+fluid_speq_t *fluid_speq_open(int lines, int max_voices)
+{
+    struct speq_synth_params p;
+    fluid_speq_t *sp;
+
+    pthread_once(&speq_once, speq_load);
+
+    if(speq.open == NULL || lines <= 0)
+    {
+        return NULL;
+    }
+
+    sp = FLUID_NEW(fluid_speq_t);
+
+    if(sp == NULL)
+    {
+        return NULL;
+    }
+
+    FLUID_MEMSET(sp, 0, sizeof(*sp));
+    p.abi = SPEQ_SYNTH_ABI;
+    p.voice_size = sizeof(struct speq_synth_voice);
+    p.lines = lines;
+    p.max_voices = max_voices;
+    p.cubic = interp_coeff;
+    p.linear = interp_coeff_linear;
+
+    if(speq.open(&sp->s, &p) != 0)
+    {
+        FLUID_FREE(sp);
+        return NULL;
+    }
+
+    FLUID_LOG(FLUID_DBG, "Voice DSP through libspeq");
+    return sp;
+}
+
+void fluid_speq_close(fluid_speq_t *sp)
+{
+    if(sp != NULL)
+    {
+        speq.close(sp->s);
+        FLUID_FREE(sp);
+    }
+}
+
+int fluid_speq_begin(fluid_speq_t *sp)
+{
+    sp->n = 0;
+    sp->blk = speq.begin(sp->s);
+    return sp->blk != NULL ? 0 : -1;
+}
+
+static void filter_in(struct speq_synth_filter *f, const fluid_iir_filter_t *iir)
+{
+    f->hist1 = iir->hist1;
+    f->hist2 = iir->hist2;
+    f->last_fres = iir->last_fres;
+    f->fres_incr = iir->fres_incr;
+    f->last_q = iir->last_q;
+    f->q_incr = iir->q_incr;
+    f->amp = iir->amp;
+    f->amp_incr = iir->amp_incr;
+    f->b02 = iir->b02;
+    f->b1 = iir->b1;
+    f->a1 = iir->a1;
+    f->a2 = iir->a2;
+    f->fres_incr_count = iir->fres_incr_count;
+    f->q_incr_count = iir->q_incr_count;
+    f->type = iir->type == FLUID_IIR_LOWPASS ? SPEQ_SYNTH_IIR_LOWPASS :
+              iir->type == FLUID_IIR_HIGHPASS ? SPEQ_SYNTH_IIR_HIGHPASS : SPEQ_SYNTH_IIR_OFF;
+    f->flags = (iir->flags & FLUID_IIR_NO_GAIN_AMP) ? SPEQ_SYNTH_IIR_NO_GAIN : 0;
+}
+
+/* what fluid_iir_filter_apply() changes */
+static void filter_out(fluid_iir_filter_t *iir, const struct speq_synth_filter *f)
+{
+    iir->hist1 = f->hist1;
+    iir->hist2 = f->hist2;
+    iir->last_fres = f->last_fres;
+    iir->fres_incr_count = f->fres_incr_count;
+    iir->last_q = f->last_q;
+    iir->q_incr_count = f->q_incr_count;
+    iir->amp = f->amp;
+    iir->b02 = f->b02;
+    iir->b1 = f->b1;
+    iir->a1 = f->a1;
+    iir->a2 = f->a2;
+}
+
+int fluid_speq_add(fluid_speq_t *sp, fluid_rvoice_t *rvoice, int is_looping,
+                   fluid_real_t **dest_bufs, int dest_bufcount)
+{
+    struct speq_synth_voice *v;
+    const fluid_sample_t *sample = rvoice->dsp.sample;
+    const void *sincos = rvoice->resonant_filter.sincos_table;
+    unsigned int i;
+    int interp;
+
+    if(sp->blk == NULL || sp->n >= sp->blk->cap || sample == NULL || sample->data == NULL
+            || sample->data24 != NULL || rvoice->resonant_custom_filter.sincos_table != sincos
+            || (sp->n > 0 && sincos != sp->blk->sincos))
+    {
+        return -1;
+    }
+
+    switch(rvoice->dsp.interp_method)
+    {
+    case FLUID_INTERP_NONE:
+        interp = SPEQ_SYNTH_NONE;
+        break;
+
+    case FLUID_INTERP_LINEAR:
+        interp = SPEQ_SYNTH_LINEAR;
+        break;
+
+    case FLUID_INTERP_MID:
+    case FLUID_INTERP_HIGH:
+    case FLUID_INTERP_HIGHEST:
+        return -1; /* sinc: here */
+
+    default:
+        interp = SPEQ_SYNTH_CUBIC; /* as fluid_rvoice_dsp_interpolate() */
+        break;
+    }
+
+    v = &sp->blk->voice[sp->n];
+    v->data = (uintptr_t)sample->data;
+    v->phase = rvoice->dsp.phase;
+    v->phase_incr = rvoice->dsp.phase_incr;
+    v->start = rvoice->dsp.start;
+    v->end = rvoice->dsp.end;
+    v->loopstart = rvoice->dsp.loopstart;
+    v->loopend = rvoice->dsp.loopend;
+    v->interp = interp;
+    v->looping = is_looping != 0;
+    v->has_looped = rvoice->dsp.has_looped != 0;
+
+    for(i = 0; i < SPEQ_SYNTH_BUFS; i++)
+    {
+        int j = i < rvoice->buffers.count ? rvoice->buffers.bufs[i].mapping : -1;
+
+        /* get_dest_buf(): an unmapped or absent buffer isn't mixed */
+        v->line[i] = (j >= 0 && j < dest_bufcount && dest_bufs[j] != NULL) ? j : -1;
+        v->cur_amp[i] = i < rvoice->buffers.count ? rvoice->buffers.bufs[i].current_amp : 0;
+        v->tgt_amp[i] = i < rvoice->buffers.count ? rvoice->buffers.bufs[i].target_amp : 0;
+    }
+
+    filter_in(&v->custom, &rvoice->resonant_custom_filter);
+    filter_in(&v->res, &rvoice->resonant_filter);
+
+    if(sp->n == 0)
+    {
+        sp->blk->sincos = sincos;
+        sp->blk->sincos_n = SINCOS_TAB_SIZE;
+    }
+
+    sp->n++;
+    return 0;
+}
+
+int fluid_speq_submit(fluid_speq_t *sp)
+{
+    int ret = speq.submit(sp->s, sp->blk, sp->n);
+
+    if(ret != 0)
+    {
+        sp->blk = NULL;
+    }
+
+    return ret;
+}
+
+int fluid_speq_refused(fluid_speq_t *sp, int k)
+{
+    return sp->blk->voice[k].count == SPEQ_SYNTH_PPE;
+}
+
+int fluid_speq_wait(fluid_speq_t *sp)
+{
+    int ret = speq.wait(sp->s, sp->blk);
+
+    if(ret != 0)
+    {
+        sp->blk = NULL;
+    }
+
+    return ret;
+}
+
+int fluid_speq_result(fluid_speq_t *sp, int k, fluid_rvoice_t *rvoice)
+{
+    const struct speq_synth_voice *v = &sp->blk->voice[k];
+    unsigned int i;
+
+    rvoice->dsp.phase = v->phase;
+    rvoice->dsp.has_looped = v->has_looped;
+    filter_out(&rvoice->resonant_custom_filter, &v->custom);
+    filter_out(&rvoice->resonant_filter, &v->res);
+
+    for(i = 0; i < rvoice->buffers.count && i < SPEQ_SYNTH_BUFS; i++)
+    {
+        rvoice->buffers.bufs[i].current_amp = v->cur_amp[i];
+    }
+
+    return v->count;
+}
+
+const fluid_real_t *fluid_speq_out(fluid_speq_t *sp)
+{
+    return sp->blk->out;
+}
+
+#endif
