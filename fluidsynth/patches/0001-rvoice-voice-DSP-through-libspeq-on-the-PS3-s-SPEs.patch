+#if FLUID_SPEQ
+/* One voice's block here: fluid_rvoice_write() after its control part */
+static FLUID_INLINE void
+fluid_speq_render_here(fluid_rvoice_t *rvoice, int is_looping, fluid_real_t *local_buf, int b,
+                       fluid_real_t **bufs, int bufcount, char *done)
+{
+    int s = fluid_rvoice_write_dsp(rvoice, &local_buf[b * FLUID_BUFSIZE], is_looping);
+
+    fluid_rvoice_buffers_mix(&rvoice->buffers, local_buf, b, s, bufs, bufcount);
+
+    if(s < FLUID_BUFSIZE)
+    {
+        *done = 1;
+    }
+}
+
+/*
+ * fluid_render_loop_singlethread() block by block, the voices' DSP through libspeq: for each
+ * block, every voice's control part here (fluid_rvoice_write_ctl()), then one libspeq call for
+ * the DSP and the mix of all of them while the voices it declines render here. Each block is
+ * mixed as fluid_mixer_buffers_render_one() mixes a run of blocks (its ramp: the first block;
+ * after it current_amp == target_amp), finished voices are finished in voice order.
+ */
+static void
+fluid_render_loop_speq(fluid_rvoice_mixer_t *mixer, int blockcount)
+{
+    fluid_speq_t *sp = mixer->speq;
+    int active = mixer->active_voices;
+    int i, k, b, n, j;
+    FLUID_DECLARE_VLA(fluid_real_t *, bufs,
+                      mixer->buffers.buf_count * 2 + mixer->buffers.fx_buf_count * 2);
+    FLUID_DECLARE_VLA(char, done, active + 1);
+    FLUID_DECLARE_VLA(int, idx, active + 1);
+    FLUID_DECLARE_VLA(char, looping, active + 1);
+    int bufcount = fluid_mixer_buffers_prepare(&mixer->buffers, bufs);
+    fluid_real_t *local_buf = fluid_align_ptr(mixer->buffers.local_buf, FLUID_DEFAULT_ALIGNMENT);
+
+    FLUID_MEMSET(done, 0, active + 1);
+
+    for(b = 0; b < blockcount; b++)
+    {
+        int queued = fluid_speq_begin(sp) == 0;
+
+        n = 0;
+
+        for(i = 0; i < active; i++)
+        {
+            fluid_rvoice_t *rvoice = mixer->rvoices[i];
+            int is_looping, r;
+
+            if(done[i])
+            {
+                continue;
+            }
+
+            r = fluid_rvoice_write_ctl(rvoice, &is_looping);
+
+            if(r == 0)
+            {
+                done[i] = 1; /* finished */
+                continue;
+            }
+
+            if(r == FLUID_RVOICE_CTL_SILENT)
+            {
+                int s = fluid_rvoice_dsp_silence(rvoice, &local_buf[b * FLUID_BUFSIZE], is_looping);
+
+                fluid_rvoice_buffers_mix(&rvoice->buffers, local_buf, b, s, bufs, bufcount);
+
+                if(s < FLUID_BUFSIZE)
+                {
+                    done[i] = 1;
+                }
+
+                continue;
+            }
+
+            if(r != FLUID_RVOICE_CTL_RENDER)
+            {
+                continue; /* quiet */
+            }
+
+            if(queued && fluid_speq_add(sp, rvoice, is_looping, bufs, bufcount) == 0)
+            {
+                idx[n] = i;
+                looping[n] = is_looping;
+                n++;
+            }
+            else
+            {
+                fluid_speq_render_here(rvoice, is_looping, local_buf, b, bufs, bufcount, &done[i]);
+            }
+        }
+
+        if(!queued)
+        {
+            continue;
+        }
+
+        if(fluid_speq_submit(sp) != 0)
+        {
+            for(k = 0; k < n; k++)
+            {
+                fluid_speq_render_here(mixer->rvoices[idx[k]], looping[k], local_buf, b, bufs,
+                                       bufcount, &done[idx[k]]);
+            }
+
+            continue;
+        }
+
+        for(k = 0; k < n; k++)
+        {
+            if(fluid_speq_refused(sp, k))
+            {
+                fluid_speq_render_here(mixer->rvoices[idx[k]], looping[k], local_buf, b, bufs,
+                                       bufcount, &done[idx[k]]);
+                idx[k] = -1 - idx[k];
+            }
+        }
+
+        if(fluid_speq_wait(sp) != 0)
+        {
+            for(k = 0; k < n; k++)
+            {
+                if(idx[k] >= 0)
+                {
+                    fluid_speq_render_here(mixer->rvoices[idx[k]], looping[k], local_buf, b, bufs,
+                                           bufcount, &done[idx[k]]);
+                }
+            }
+
+            continue;
+        }
+
+        for(k = 0; k < n; k++)
+        {
+            if(idx[k] >= 0 && fluid_speq_result(sp, k, mixer->rvoices[idx[k]]) < FLUID_BUFSIZE)
+            {
+                done[idx[k]] = 1;
+            }
+        }
+
+        {
+            const fluid_real_t *out = fluid_speq_out(sp);
+
+            for(j = 0; out != NULL && j < bufcount; j++, out += FLUID_BUFSIZE)
+            {
+                fluid_real_t *FLUID_RESTRICT buf = bufs[j];
+
+                if(buf != NULL)
+                {
+                    for(i = 0; i < FLUID_BUFSIZE; i++)
+                    {
+                        buf[b * FLUID_BUFSIZE + i] += out[i];
+                    }
+                }
+            }
+        }
+    }
+
+    for(i = 0; i < active; i++)
+    {
+        if(done[i])
+        {
+            fluid_finish_rvoice(&mixer->buffers, mixer->rvoices[i]);
+        }
+    }
+}
+#endif
+
 static void
 fluid_render_loop_singlethread(fluid_rvoice_mixer_t *mixer, int blockcount)
 {
@@ -883,6 +1058,15 @@ new_fluid_rvoice_mixer(int buf_count, int fx_buf_count, int fx_units,
         goto error_recovery;
     }
 
+#if FLUID_SPEQ
+    /* the single-thread render loop only: with extra mixer threads the voices are theirs */
+    if(extra_threads == 0)
+    {
+        mixer->speq = fluid_speq_open(mixer->buffers.buf_count * 2 + mixer->buffers.fx_buf_count,
+                                      mixer->polyphony);
+    }
+#endif
+
 #if ENABLE_MIXER_THREADS
     mixer->thread_ready = new_fluid_cond();
     mixer->wakeup_threads = new_fluid_cond();
@@ -928,6 +1112,10 @@ void delete_fluid_rvoice_mixer(fluid_rvoice_mixer_t *mixer)
 
     fluid_return_if_fail(mixer != NULL);
 
