+
+/*
+ * The voice DSP through libspeq (the PS3's Cell SPEs): fluid_rvoice_mixer renders each block's
+ * voices with fluid_rvoice_write_ctl() here and their DSP (fluid_rvoice_write_dsp() and the mix)
+ * in libspeq, loaded at run time. Without libspeq, or when it declines, the mixer is stock.
+ */
+
+#ifndef _FLUID_RVOICE_SPEQ_H
+#define _FLUID_RVOICE_SPEQ_H
+
+#include "fluidsynth_priv.h"
+#include "fluid_rvoice.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* libspeq's interface takes double samples */
+#if defined(__linux__) && !defined(WITH_FLOAT)
+#define FLUID_SPEQ 1
+#else
+#define FLUID_SPEQ 0
+#endif
+
+typedef struct _fluid_speq_t fluid_speq_t;
+
+#if FLUID_SPEQ
+/* NULL: render everything here (no libspeq, SPEQ_SYNTH=off, no SPEs) */
+fluid_speq_t *fluid_speq_open(int lines, int max_voices);
+void fluid_speq_close(fluid_speq_t *sp);
+
+/* One block: begin, add each voice after fluid_rvoice_write_ctl() (0: libspeq has it, else
+ * render it yourself), submit (0: queued; else render all added), refused(k) for each added
+ * voice (render it yourself now), wait (0: result(k) copies voice k's new state back and
+ * returns its sample count, out() the sum of their mix; else render the not refused ones) */
+int fluid_speq_begin(fluid_speq_t *sp);
+int fluid_speq_add(fluid_speq_t *sp, fluid_rvoice_t *rvoice, int is_looping,
+                   fluid_real_t **dest_bufs, int dest_bufcount);
+int fluid_speq_submit(fluid_speq_t *sp);
+int fluid_speq_refused(fluid_speq_t *sp, int k);
+int fluid_speq_wait(fluid_speq_t *sp);
+int fluid_speq_result(fluid_speq_t *sp, int k, fluid_rvoice_t *rvoice);
+const fluid_real_t *fluid_speq_out(fluid_speq_t *sp);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+#endif
