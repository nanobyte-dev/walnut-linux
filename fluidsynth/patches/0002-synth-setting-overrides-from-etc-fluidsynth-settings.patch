From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Mon, 19 Oct 2026 08:15:03 +0300
Subject: synth: setting overrides from /etc/fluidsynth/settings and
 FLUIDSYNTH_SETTINGS

Programs that embed libfluidsynth decide its settings themselves, and most expose none of them:
OpenTTD's music driver leaves reverb and chorus at their defaults (on), so the only way to
switch them, system-wide or for one benchmark run, is in the library. new_fluid_synth() now
applies overrides to the settings before it reads any of them, so they win over what the program
set: first the file /etc/fluidsynth/settings (lines "name value" or "name=value", '#' starts a
comment), then the environment variable FLUIDSYNTH_SETTINGS ("name=value" pairs separated by
commas and/or whitespace), e.g.

    FLUIDSYNTH_SETTINGS=synth.reverb.active=0,synth.chorus.active=0

Each value takes its setting's type (integers, also on/off, yes/no, true/false; numbers;
strings). Unknown names and values out of range are warned about and skipped; what was applied
is logged once at FLUID_INFO ("settings overridden: ..."). Without the file and the variable
nothing changes.

Forwarded: no

diff --git a/src/synth/fluid_synth.c b/src/synth/fluid_synth.c
--- a/src/synth/fluid_synth.c
+++ b/src/synth/fluid_synth.c
@@ -694,6 +694,149 @@ static FLUID_INLINE int fluid_synth_reinitialize_tuning(fluid_synth_t *synth)
     return res;
 }
 
+/*
+ * PS3: setting overrides that win over the program's own (the program sets its settings, then
+ * calls new_fluid_synth(), which applies these first). So reverb, chorus and the like can be
+ * switched system-wide, or for one run of a benchmark, in programs that don't expose them.
+ *   /etc/fluidsynth/settings  lines "name value" or "name=value", '#' starts a comment
+ *   FLUIDSYNTH_SETTINGS       "name=value" pairs separated by commas and/or whitespace, read after
+ *                             the file (so they win over it), e.g.
+ *                             FLUIDSYNTH_SETTINGS=synth.reverb.active=0,synth.chorus.active=0
+ * Values take the setting's type: integers (also on/off, yes/no, true/false), numbers, strings.
+ * Unknown names and bad values are warned about and skipped; what was applied is logged once at
+ * FLUID_INFO ("fluidsynth: settings overridden: ...").
+ */
+#define FLUID_SETTINGS_OVERRIDE_FILE "/etc/fluidsynth/settings"
+
+static void
+fluid_synth_override_setting(fluid_settings_t *settings, const char *from, char *name, char *value,
+                             char *done, size_t donesz)
+{
+    char *end = NULL;
+    int ok = FLUID_FAILED;
+    long l;
+    double d;
+    size_t len;
+
+    switch(fluid_settings_get_type(settings, name))
+    {
+    case FLUID_INT_TYPE:
+        if(!FLUID_STRCASECMP(value, "on") || !FLUID_STRCASECMP(value, "yes") || !FLUID_STRCASECMP(value, "true"))
+        {
+            l = 1;
+        }
+        else if(!FLUID_STRCASECMP(value, "off") || !FLUID_STRCASECMP(value, "no") || !FLUID_STRCASECMP(value, "false"))
+        {
+            l = 0;
+        }
+        else
+        {
+            l = FLUID_STRTOL(value, &end, 0);
+            if(end == value || *end != '\0')
+            {
+                break;
+            }
+        }
+        ok = fluid_settings_setint(settings, name, (int)l);
+        break;
+
+    case FLUID_NUM_TYPE:
+        d = strtod(value, &end);
+        if(end != value && *end == '\0')
+        {
+            ok = fluid_settings_setnum(settings, name, d);
+        }
+        break;
+
+    case FLUID_STR_TYPE:
+        ok = fluid_settings_setstr(settings, name, value);
+        break;
+
+    default:
+        FLUID_LOG(FLUID_WARN, "%s: no setting '%s', ignored", from, name);
+        return;
+    }
+
+    if(ok != FLUID_OK)
+    {
+        FLUID_LOG(FLUID_WARN, "%s: bad value '%s' for '%s', ignored", from, value, name);
+        return;
+    }
+
+    len = FLUID_STRLEN(done);
+    FLUID_SNPRINTF(done + len, donesz - len, "%s%s=%s", len ? " " : "", name, value);
+}
+
+/* one "name=value" or "name value" item (trimmed, comments removed by the caller) */
+static void
+fluid_synth_override_item(fluid_settings_t *settings, const char *from, char *item, char *done, size_t donesz)
+{
+    char *v = FLUID_STRCHR(item, '=');
+
+    if(v == NULL)
+    {
+        v = item + strcspn(item, " \t");
+    }
+    if(*v == '\0' || v == item)
+    {
+        FLUID_LOG(FLUID_WARN, "%s: '%s' is not name=value, ignored", from, item);
+        return;
+    }
+    *v++ = '\0';
+    v += strspn(v, " \t=");
+    item[strcspn(item, " \t")] = '\0';
+    fluid_synth_override_setting(settings, from, item, v, done, donesz);
+}
+
+static void
+fluid_synth_override_settings(fluid_settings_t *settings)
+{
+    char done[1024] = "";
+    char line[512];
+    char *env, *copy, *tok, *save = NULL;
+    FILE *f = fopen(FLUID_SETTINGS_OVERRIDE_FILE, "r");
+
+    if(f != NULL)
+    {
+        while(fgets(line, sizeof(line), f) != NULL)
+        {
+            char *s = line, *e;
+
+            s[strcspn(s, "#\r\n")] = '\0';
+            s += strspn(s, " \t");
+            for(e = s + FLUID_STRLEN(s); e > s && (e[-1] == ' ' || e[-1] == '\t'); e--)
+            {
+                *(e - 1) = '\0';
+            }
+            if(*s != '\0')
+            {
+                fluid_synth_override_item(settings, FLUID_SETTINGS_OVERRIDE_FILE, s, done, sizeof(done));
+            }
+        }
+        fclose(f);
+    }
+
+    env = getenv("FLUIDSYNTH_SETTINGS");
+    if(env != NULL && *env != '\0' && (copy = FLUID_STRDUP(env)) != NULL)
+    {
+        for(tok = strtok_r(copy, ", \t\n", &save); tok != NULL; tok = strtok_r(NULL, ", \t\n", &save))
+        {
+            if(FLUID_STRCHR(tok, '=') == NULL)
+            {
+                FLUID_LOG(FLUID_WARN, "FLUIDSYNTH_SETTINGS: '%s' is not name=value, ignored", tok);
+                continue;
+            }
+            fluid_synth_override_item(settings, "FLUIDSYNTH_SETTINGS", tok, done, sizeof(done));
+        }
+        FLUID_FREE(copy);
+    }
+
+    if(done[0] != '\0')
+    {
+        FLUID_LOG(FLUID_INFO, "settings overridden: %s", done);
+    }
+}
+
 /**
  * Create new FluidSynth instance.
  * @param settings Configuration parameters to use (used directly).
@@ -741,6 +884,9 @@ new_fluid_synth(fluid_settings_t *settings)
 
     FLUID_MEMSET(synth, 0, sizeof(fluid_synth_t));
 
+    /* PS3: the system's and the environment's overrides, before anything is read */
+    fluid_synth_override_settings(settings);
+
     fluid_rec_mutex_init(synth->mutex);
     fluid_settings_getint(settings, "synth.threadsafe-api", &synth->use_mutex);
     synth->public_api_count = 0;
