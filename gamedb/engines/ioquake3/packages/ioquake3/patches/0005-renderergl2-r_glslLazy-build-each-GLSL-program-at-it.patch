+
+static int GLSL_InitGPUShader(shaderProgram_t * program, const char *name,
+	int attribs, qboolean fragmentShader, const GLchar *extra, qboolean addHeader,
+	const char *fallback_vp, const char *fallback_fp)
+{
+	char vpCode[GLSL_CODE_SIZE];
+	char fpCode[GLSL_CODE_SIZE];
+	int result;
+	uint64_t hash;
+
+	if (!GLSL_BuildSource(name, fragmentShader, extra, addHeader, fallback_vp, fallback_fp, vpCode, fpCode))
+		return 0;
+
 	hash = GLSL_HashProgram(name, attribs, vpCode, fragmentShader ? fpCode : NULL);
 
 	if (GLSL_TakeKeptProgram(program, name, attribs, hash))
 		return 1;
 
+	if (glslDeferring)
+	{
+		size_t len = extra ? strlen(extra) : 0;
+		glslDeferred_t *d = ri.Malloc(sizeof(*d) + len);
+
+		Com_Memset(d, 0, sizeof(*d));
+		d->attribs = attribs;
+		d->fragmentShader = fragmentShader;
+		d->addHeader = addHeader;
+		d->fallback_vp = fallback_vp;
+		d->fallback_fp = fallback_fp;
+		if (len)
+			Com_Memcpy(d->extra, extra, len);
+		d->extra[len] = '\0';
+
+		Q_strncpyz(program->name, name, sizeof(program->name));
+		program->attribs = attribs;
+		program->sourceHash = hash;
+		program->deferred = d;
+		numProgramsDeferred++;
+		return 1;
+	}
+
 	result = GLSL_InitGPUShader2(program, name, attribs, vpCode, fragmentShader ? fpCode : NULL);
 	program->sourceHash = hash;
 
 	return result;
 }
 
+void GLSL_InitUniforms(shaderProgram_t *program);
+void GLSL_FinishGPUShader(shaderProgram_t *program);
+void GLSL_SetUniformInt(shaderProgram_t *program, int uniformNum, GLint value);
+
+/*
+Builds a deferred program, from the backend at its first use: one compile and link, a short
+stall instead of compiling every variant at start.
+*/
+static void GLSL_BuildDeferred(shaderProgram_t *program)
+{
+	glslDeferred_t *d = program->deferred;
+	char vpCode[GLSL_CODE_SIZE];
+	char fpCode[GLSL_CODE_SIZE];
+	char name[MAX_QPATH];
+	int i, startTime = ri.Milliseconds();
+
+	program->deferred = NULL;
+	Q_strncpyz(name, program->name, sizeof(name));
+
+	if (!GLSL_BuildSource(name, d->fragmentShader, d->extra, d->addHeader, d->fallback_vp, d->fallback_fp, vpCode, fpCode)
+		|| !GLSL_InitGPUShader2(program, name, d->attribs, vpCode, d->fragmentShader ? fpCode : NULL))
+	{
+		ri.Error(ERR_FATAL, "Could not build the %s GLSL program", name);
+	}
+
+	program->sourceHash = GLSL_HashProgram(name, d->attribs, vpCode, d->fragmentShader ? fpCode : NULL);
+
+	GLSL_InitUniforms(program);
+	for (i = 0; i < d->numInts; i++)
+		GLSL_SetUniformInt(program, d->intUniforms[i], d->intValues[i]);
+	GLSL_FinishGPUShader(program);
+
+	ri.Free(d);
+	numProgramsBuiltLater++;
+	ri.Printf(PRINT_DEVELOPER, "built GLSL program %s at its first use in %i ms, %i so far\n", name,
+		ri.Milliseconds() - startTime, numProgramsBuiltLater);
+}
+
+static GLint *GLSL_ProgramUniforms(shaderProgram_t *program)
+{
+	if (program->deferred && !glslDeferring)
+		GLSL_BuildDeferred(program);
+
+	return program->uniforms;
+}
