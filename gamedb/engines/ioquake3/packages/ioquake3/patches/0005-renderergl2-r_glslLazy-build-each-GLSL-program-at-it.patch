+static qboolean glslDeferring;
+static int numProgramsDeferred;
+static int numProgramsBuiltLater;
+
+static int GLSL_BuildSource(const char *name, qboolean fragmentShader, const GLchar *extra, qboolean addHeader,
+	const char *fallback_vp, const char *fallback_fp, char *vpCode, char *fpCode)
 {
-	char vpCode[32000];
-	char fpCode[32000];
 	char *postHeader;
