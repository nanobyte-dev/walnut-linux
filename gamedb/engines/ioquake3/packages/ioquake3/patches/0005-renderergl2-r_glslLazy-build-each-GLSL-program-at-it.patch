-	int result;
-	uint64_t hash;
 
-	size = sizeof(vpCode);
+	size = GLSL_CODE_SIZE;
 	if (addHeader)
 	{
 		GLSL_GetShaderHeader(GL_VERTEX_SHADER, extra, vpCode, size);
@@ -736,7 +754,7 @@ static int GLSL_InitGPUShader(shaderProgram_t * program, const char *name,
 
