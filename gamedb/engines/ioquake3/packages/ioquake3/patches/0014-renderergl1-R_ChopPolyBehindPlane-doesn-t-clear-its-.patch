From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sat, 17 Oct 2026 17:07:28 +0300
Subject: renderergl1: R_ChopPolyBehindPlane doesn't clear its two work arrays

dists and sides were initialized to zero (a later "= { 0 }" that silences a compiler warning), two
272-byte memsets for each plane every triangle of a decal (bullet and explosion marks, blood) is
clipped against: 970000 memset calls, 45% of the function's instructions, in OpenArena's demo.
Every element read is written first. r_markClear 1 brings the clearing back.

diff --git a/code/renderergl1/tr_init.c b/code/renderergl1/tr_init.c
--- a/code/renderergl1/tr_init.c
+++ b/code/renderergl1/tr_init.c
@@ -161,6 +161,7 @@ cvar_t	*r_debugLight;
 cvar_t	*r_debugSort;
 cvar_t	*r_printShaders;
 cvar_t	*r_shaderTextScan;
+cvar_t	*r_markClear;
 cvar_t	*r_saveFontData;
 
 cvar_t	*r_marksOnTriangleMeshes;
@@ -1118,6 +1119,8 @@ void R_Register( void )
 	r_debugSort = ri.Cvar_Get( "r_debugSort", "0", CVAR_CHEAT );
 	r_printShaders = ri.Cvar_Get( "r_printShaders", "0", 0 );
 	r_shaderTextScan = ri.Cvar_Get( "r_shaderTextScan", "0", 0 );
+	r_markClear = ri.Cvar_Get( "r_markClear", "0", 0 );
+	ri.Cvar_SetDescription( r_markClear, "1: clear the arrays R_ChopPolyBehindPlane fills before it reads them, as upstream (two memsets for every plane a decal triangle is clipped against)" );
 	ri.Cvar_SetDescription( r_shaderTextScan, "1: after a miss in the shader script hash table, scan all the script text for the name, as upstream (the same answer, the cost of parsing every script)" );
 	r_saveFontData = ri.Cvar_Get( "r_saveFontData", "0", 0 );
 
diff --git a/code/renderergl1/tr_local.h b/code/renderergl1/tr_local.h
--- a/code/renderergl1/tr_local.h
+++ b/code/renderergl1/tr_local.h
@@ -1078,6 +1078,7 @@ extern	cvar_t	*r_debugSort;
 
 extern	cvar_t	*r_printShaders;
 extern	cvar_t	*r_shaderTextScan;
+extern	cvar_t	*r_markClear;
 
 extern cvar_t	*r_marksOnTriangleMeshes;
 
diff --git a/code/renderergl1/tr_marks.c b/code/renderergl1/tr_marks.c
--- a/code/renderergl1/tr_marks.c
+++ b/code/renderergl1/tr_marks.c
@@ -41,8 +41,8 @@ Out must have space for two more vertexes than in
 static void R_ChopPolyBehindPlane( int numInPoints, vec3_t inPoints[MAX_VERTS_ON_POLY],
 								   int *numOutPoints, vec3_t outPoints[MAX_VERTS_ON_POLY], 
 							vec3_t normal, vec_t dist, vec_t epsilon) {
-	float		dists[MAX_VERTS_ON_POLY+4] = { 0 };
-	int			sides[MAX_VERTS_ON_POLY+4] = { 0 };
+	float		dists[MAX_VERTS_ON_POLY+4];
+	int			sides[MAX_VERTS_ON_POLY+4];
 	int			counts[3];
 	float		dot;
 	int			i, j;
@@ -55,6 +55,14 @@ static void R_ChopPolyBehindPlane( int numInPoints, vec3_t inPoints[MAX_VERTS_ON
 		return;
 	}
 
+	// Both arrays are filled for 0..numInPoints (the last one with the first) before they are
+	// read, so clearing them (a memset of 544 bytes for every plane every triangle of a
+	// decal is clipped against) only serves compilers that can't see that.
+	if ( r_markClear->integer ) {
+		Com_Memset( dists, 0, sizeof( dists ) );
+		Com_Memset( sides, 0, sizeof( sides ) );
+	}
+
 	counts[0] = counts[1] = counts[2] = 0;
 
 	// determine sides for each point
