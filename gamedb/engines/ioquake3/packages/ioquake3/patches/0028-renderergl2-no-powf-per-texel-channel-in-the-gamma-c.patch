@@ -1470,6 +1471,7 @@ void R_Register( void )
 
 	r_vaoCache = ri.Cvar_Get("r_vaoCache", "0", CVAR_ARCHIVE | CVAR_LATCH);
 	r_vaoSnormColor = ri.Cvar_Get("r_vaoSnormColor", "1", CVAR_ARCHIVE | CVAR_LATCH);
