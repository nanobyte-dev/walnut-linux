diff --git a/src/sysfunc.c b/src/sysfunc.c
--- a/src/sysfunc.c
+++ b/src/sysfunc.c
@@ -27,11 +27,104 @@ s_delay (int ms)
 };
 
 
+/* Walnut: a game pad works the menus too. The joystick events of the pads keyb_init opened become
+ * the keys the menus read: a hat or the first stick the arrow keys, the first button Return and the
+ * second Escape (Cross and Circle on a DualShock 3, which also drop and use in a match), and on a
+ * DualShock 3 its D-pad buttons the arrow keys and Start Return. The menus and screens that wait for
+ * a key read events through here; a match reads the pads itself (keyb_loop: there Start is Escape,
+ * the game menu) and hands its events to s_padevent while the game menu is up (game_loop). */
+int
+s_ds3 (int pad)
+{
+	const char *name = SDL_JoystickName (pad);
+	return name && (strstr (name, "PLAYSTATION(R)3") || strstr (name, "PS3"));
+}
+
+static void
+s_padkey (SDL_Event *event, SDLKey sym, int down)
+{
+	event->type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	event->key.which = 0;
+	event->key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	event->key.keysym.scancode = 0;
+	event->key.keysym.sym = sym;
+	event->key.keysym.mod = KMOD_NONE;
+	event->key.keysym.unicode = sym == SDLK_RETURN ? '\r' : sym == SDLK_ESCAPE ? 27 : 0;
+}
+
+/* the key a pad event stands for, the event changed into it; SDLK_UNKNOWN: none */
+SDLKey
+s_padevent (SDL_Event *event)
+{
+	static SDLKey held[8][2];	/* per pad: the key its stick holds on X and on Y */
+	static Uint8 hat[8];
+	SDLKey sym = SDLK_UNKNOWN;
+	int pad, down = 1, i;
+
+	switch (event->type) {
+	case SDL_JOYBUTTONDOWN:
+	case SDL_JOYBUTTONUP:
+		down = event->type == SDL_JOYBUTTONDOWN;
+		switch (event->jbutton.button) {
+		case 0: sym = SDLK_RETURN; break;
+		case 1: sym = SDLK_ESCAPE; break;
+		default:
+			if (!s_ds3 (event->jbutton.which))
+				break;
+			switch (event->jbutton.button) {
+			case 9: sym = SDLK_RETURN; break;
+			case 13: sym = SDLK_UP; break;
+			case 14: sym = SDLK_DOWN; break;
+			case 15: sym = SDLK_LEFT; break;
+			case 16: sym = SDLK_RIGHT; break;
+			}
+		}
+		break;
+	case SDL_JOYHATMOTION:
+		pad = event->jhat.which & 7;
+		/* the direction that came on (a press), else the one that went off (a release) */
+		for (i = 0; i < 2 && sym == SDLK_UNKNOWN; i++) {
+			Uint8 v = i == 0 ? event->jhat.value & ~hat[pad] : hat[pad] & ~event->jhat.value;
+			down = i == 0;
+			if (v & SDL_HAT_UP) sym = SDLK_UP;
+			else if (v & SDL_HAT_DOWN) sym = SDLK_DOWN;
+			else if (v & SDL_HAT_LEFT) sym = SDLK_LEFT;
+			else if (v & SDL_HAT_RIGHT) sym = SDLK_RIGHT;
+		}
+		hat[pad] = event->jhat.value;
+		break;
+	case SDL_JOYAXISMOTION:
+		if (event->jaxis.axis > 1)
+			break;
+		pad = event->jaxis.which & 7;
+		i = event->jaxis.axis;
+		if (event->jaxis.value < -16000)
+			sym = i ? SDLK_UP : SDLK_LEFT;
+		else if (event->jaxis.value > 16000)
+			sym = i ? SDLK_DOWN : SDLK_RIGHT;
+		if (sym == held[pad][i])
+			return SDLK_UNKNOWN;	/* no change past the dead zone */
+		if (sym == SDLK_UNKNOWN) {	/* back to the middle: the release */
+			sym = held[pad][i];
+			down = 0;
+			held[pad][i] = SDLK_UNKNOWN;
+		}
+		else
+			held[pad][i] = sym;
+		break;
+	}
+	if (sym != SDLK_UNKNOWN)
+		s_padkey (event, sym, down);
+	return sym;
+}
+
 int
 s_fetchevent (SDL_Event *event)
 {
-	if (SDL_PollEvent (event))
+	if (SDL_PollEvent (event)) {
+		s_padevent (event);
 		return 1;
+	}
   	s_delay (20);
 	return 0;
 }
