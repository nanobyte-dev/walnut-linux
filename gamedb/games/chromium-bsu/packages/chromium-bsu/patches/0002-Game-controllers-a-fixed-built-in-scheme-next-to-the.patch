+#if SDL_VERSION_ATLEAST(2,0,0)
+//----------------------------------------------------------
+// Game controllers: a fixed built-in scheme next to the keyboard and mouse. The first
+// controller SDL knows (a DualShock 3 is "PS3 Controller") plays; its buttons become the
+// keys the game already reads, so the menus and every game state work as with the keyboard:
+//   left stick              move the ship (as the mouse)
+//   D-pad                   move (the arrow keys); in the menus up/down/left/right
+//   Cross, R1               fire (Space); in the menus select
+//   Square, L1              use the item (Return)
+//   Triangle                next item (')
+//   Start                   the menu, and back to the game from it (Escape)
+//   Circle                  back to the game from the menu (Escape)
+void MainSDL::padOpen()
+{
+	Config	*config = Config::instance();
+	for(int i = 0; i < SDL_NumJoysticks() && !pad; i++)
+		if(SDL_IsGameController(i))
+			pad = SDL_GameControllerOpen(i);
+	if( config->debug() ) fprintf(stderr, "game controller: %s\n", pad ? SDL_GameControllerName(pad) : "none");
+}
+
+void MainSDL::padButton(SDL_Event *event, bool down)
+{
+	Global	*game = Global::getInstance();
+	if(!pad || event->cbutton.which != SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pad)))
+		return;
+	SDL_Keycode sym;
+	switch(event->cbutton.button)
+	{
+		case SDL_CONTROLLER_BUTTON_A:
+		case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER:	sym = SDLK_SPACE;	break;
+		case SDL_CONTROLLER_BUTTON_X:
+		case SDL_CONTROLLER_BUTTON_LEFTSHOULDER:	sym = SDLK_RETURN;	break;
+		case SDL_CONTROLLER_BUTTON_Y:		sym = SDLK_QUOTE;	break;
+		case SDL_CONTROLLER_BUTTON_START:	sym = SDLK_ESCAPE;	break;
+		case SDL_CONTROLLER_BUTTON_B:
+			if(game->gameMode != Global::Menu)
+				return;
+			sym = SDLK_ESCAPE;	break;
+		case SDL_CONTROLLER_BUTTON_DPAD_UP:	sym = SDLK_UP;	break;
+		case SDL_CONTROLLER_BUTTON_DPAD_DOWN:	sym = SDLK_DOWN;	break;
+		case SDL_CONTROLLER_BUTTON_DPAD_LEFT:	sym = SDLK_LEFT;	break;
+		case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:	sym = SDLK_RIGHT;	break;
+		default:
+			return;
+	}
+	SDL_Event key;
+	memset(&key, 0, sizeof(key));
+	key.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	key.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	key.key.keysym.sym = sym;
+	if(down)
+		keyDown(&key);
+	else
+		keyUp(&key);
+}
+#endif
