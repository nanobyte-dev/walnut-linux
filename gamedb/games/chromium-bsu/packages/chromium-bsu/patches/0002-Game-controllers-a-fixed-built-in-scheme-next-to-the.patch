 void MainSDL::joystickMove()
 {
+#if SDL_VERSION_ATLEAST(2,0,0)
+	// the pad's left stick moves the ship as the mouse does (the old joystick code's smoothing)
+	if(pad)
+	{
+		Global	*game = Global::getInstance();
+		static const int dead = 8000, div = 32768/16;
+		int ax = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTX);
+		int ay = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTY);
+		xjoy = (ax > dead || ax < -dead) ? (float)ax/div : 0;
+		yjoy = (ay > dead || ay < -dead) ? (float)ay/div : 0;
+		xjNow = 0.8*xjNow + 0.2*xjoy;
+		yjNow = 0.8*yjNow + 0.2*yjoy;
+		if(game->gameMode == Global::Game && !game->game_pause && ((int)xjNow || (int)yjNow))
+			game->hero->moveEvent((int)xjNow, (int)yjNow);
+		return;
+	}
+#endif
