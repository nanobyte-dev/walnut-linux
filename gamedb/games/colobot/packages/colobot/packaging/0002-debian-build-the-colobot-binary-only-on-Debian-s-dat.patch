diff --git a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -30,6 +30,15 @@ override_dh_auto_configure:
 	                     -DOPENAL_SOUND:BOOL=True \
 	                     -DCMAKE_VERBOSE_MAKEFILE=True
 
+# Walnut: only the colobot binary is built (debian/control); the data stays in debian/tmp for
+# colobot.install to pick from, as with Debian's several packages
+override_dh_auto_install:
+	dh_auto_install --destdir=debian/tmp
+
+# the data's files stay behind in debian/tmp on purpose (Debian's arch:all packages carry them)
+override_dh_missing:
+	dh_missing --list-missing
+
 override_dh_auto_build-arch:
 	dh_auto_build -a
 
