[Desktop Entry]
Type=Application
Name=Doom (DSDA-Doom)
Comment=The Ultimate Doom from your own DOOM.WAD, DSDA-Doom's OpenGL renderer at 1920x1080
Exec=ps3-game dsda-doom -iwad /usr/share/games/doom/doom.wad -vidmode gl -width 1920 -height 1080 -fullscreen
Icon=dsda-doom
Terminal=false
Categories=Game;ActionGame;
Keywords=first;person;shooter;doom;
NoDisplay=true
X-Walnut-Requires=/usr/share/games/doom/doom.wad
