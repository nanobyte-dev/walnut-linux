+		        mat->specular != material_specular || mat->exp != material_exp) {
+			set_material(mat->diffuse, mat->specular, mat->exp);
+			material_diffuse = mat->diffuse;
+			material_specular = mat->specular;
+			material_exp = mat->exp;
+			material_valid = true;
+		}
 
 		DrawCharSphere(node->divisions);
 	}
