-	TVector3d nml = Course.FindCourseNormal(pt.x, pt.z);
+	TVector3d nml;
+	if (!shadow_batch) nml = Course.FindCourseNormal(pt.x, pt.z);
 	pt.y = Course.FindYCoord(pt.x, pt.z) + SHADOW_HEIGHT;
 	if (pt.y > old_y) pt.y = old_y;
+	if (shadow_batch) {
+		shadow_prim.push_back((GLfloat)pt.x);
+		shadow_prim.push_back((GLfloat)pt.y);
+		shadow_prim.push_back((GLfloat)pt.z);
+		return;
+	}
 	glNormal3(nml);
 	glVertex3(pt);
 }
