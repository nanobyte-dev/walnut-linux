@@ -638,13 +804,68 @@ bool CCharShape::Collision(const TVector3d& pos, const TPolyhedron& ph) {
 //				shadow
 // --------------------------------------------------------------------
 
+// --------------------------------------------------------------------
+// ETR_GL_SHADOW: the shadow is made of the primitives of ~15 small
+// spheres, each vertex a glNormal3d (unused: the lighting is off) and a
+// glVertex3d. Here the vertices of all the fans and strips go into one list
+// of triangles (a strip's odd triangles with their first two vertices swapped,
+// so that they keep their winding) and are drawn at once.
+// --------------------------------------------------------------------
+
+namespace {
+
+bool shadow_batch = false;
+GLenum shadow_mode;
+std::vector<GLfloat> shadow_prim;	// the vertices of the primitive in the making
+std::vector<GLfloat> shadow_tris;	// all the triangles
+
+void ShadowBegin(GLenum mode) {
+	if (!shadow_batch) {
+		glBegin(mode);
+		return;
+	}
+	shadow_mode = mode;
+	shadow_prim.clear();
+}
+
+void ShadowEnd() {
+	if (!shadow_batch) {
+		glEnd();
+		return;
+	}
+	const std::size_t n = shadow_prim.size() / 3;
+	const GLfloat* v = shadow_prim.data();
+	auto tri = [](const GLfloat* a, const GLfloat* b, const GLfloat* c) {
+		shadow_tris.insert(shadow_tris.end(), a, a + 3);
+		shadow_tris.insert(shadow_tris.end(), b, b + 3);
+		shadow_tris.insert(shadow_tris.end(), c, c + 3);
+	};
+	if (shadow_mode == GL_TRIANGLE_FAN) {
+		for (std::size_t i = 1; i + 1 < n; i++) tri(v, v + 3 * i, v + 3 * (i + 1));
+	} else {
+		for (std::size_t i = 0; i + 2 < n; i++) {
+			if (i % 2 == 0) tri(v + 3 * i, v + 3 * (i + 1), v + 3 * (i + 2));
+			else tri(v + 3 * (i + 1), v + 3 * i, v + 3 * (i + 2));
+		}
+	}
+}
+
+}
