[Desktop Entry]
Type=Application
Name=Hexen (DSDA-Doom)
Comment=Hexen: Beyond Heretic from your own HEXEN.WAD, DSDA-Doom's OpenGL renderer at 1920x1080
Exec=ps3-game dsda-hexen -iwad /usr/share/games/doom/hexen.wad -vidmode gl -width 1920 -height 1080 -fullscreen
Icon=dsda-doom
Terminal=false
Categories=Game;ActionGame;
Keywords=first;person;shooter;hexen;
NoDisplay=true
X-Walnut-Requires=/usr/share/games/doom/hexen.wad
