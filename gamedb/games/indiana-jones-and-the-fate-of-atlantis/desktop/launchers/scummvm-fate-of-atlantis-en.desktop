[Desktop Entry]
Type=Application
Name=Indiana Jones and the Fate of Atlantis
Comment=Indiana Jones and the Fate of Atlantis from your own copy (the English CD release, package fate-of-atlantis-en-data), in ScummVM fullscreen
Exec=ps3-game sh -c "mkdir -p ~/.config/scummvm/walnut && exec scummvm -c ~/.config/scummvm/walnut/atlantis.ini -i /usr/share/ps3-games/scummvm/atlantis.ini -p /usr/share/games/fate-of-atlantis-en atlantis"
Icon=org.scummvm.scummvm
Terminal=false
Categories=Game;AdventureGame;
Keywords=adventure;lucasarts;scumm;indiana;jones;indy;
NoDisplay=true
X-Walnut-Requires=/usr/share/games/fate-of-atlantis-en/atlantis.000
