diff --git a/src/openrct2/rct12/RCT12.h b/src/openrct2/rct12/RCT12.h
index 779d6dafb..46ddaf44e 100644
--- a/src/openrct2/rct12/RCT12.h
+++ b/src/openrct2/rct12/RCT12.h
@@ -779,8 +779,15 @@ private:
             // - Bits 7 and 8 are never set
             // - Bits 5 and 6 are set when a vehicle triggers the on-ride photo and act like a countdown from 3.
             // - If any of the bits 5-8 are set, the game counts it as a photo being taken.
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+            // Sequence is the low byte of MazeEntry on every host: the importers swap bytes 5/6 of every
+            // track element on big-endian hosts
+            uint8_t Colour;   // 5 here, 6 in the file
+            uint8_t Sequence; // 6 here, 5 in the file
+#else
             uint8_t Sequence; // 5.
             uint8_t Colour;   // 6
+#endif
         };
         uint16_t MazeEntry; // 5
     };
@@ -1190,12 +1197,21 @@ struct RCT12ResearchItem
     union
     {
         uint32_t RawValue;
+        // RawValue = EntryIndex | BaseRideType << 8 | Type << 16 | Flags << 24 on every host (the importers
+        // swap RawValue to host order, and also build items from host-order values)
         struct
         {
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+            uint8_t Flags;
+            uint8_t Type; // 0: scenery entry, 1: ride entry
+            uint8_t BaseRideType;
+            RCT12ObjectEntryIndex EntryIndex;
+#else
             RCT12ObjectEntryIndex EntryIndex;
             uint8_t BaseRideType;
             uint8_t Type; // 0: scenery entry, 1: ride entry
             uint8_t Flags;
+#endif
         };
     };
     uint8_t Category;
