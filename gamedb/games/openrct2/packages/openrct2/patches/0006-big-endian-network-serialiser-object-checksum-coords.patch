index be585c76d..1741388c7 100644
--- a/src/openrct2/core/IStream.hpp
+++ b/src/openrct2/core/IStream.hpp
@@ -164,7 +164,17 @@ namespace OpenRCT2
         template<typename T>
         static T LittleEndianToHost(T value)
         {
-            if constexpr (!kHostIsBigEndian)
+            if constexpr (RawCoordinates<T>)
+            {
+                // the coordinate structs (Coords/TileCoords XY, XYZ, XYZD) are written raw by the serialisers
+                // (WriteValue writes their members only, with zero padding)
+                value.x = LittleEndianToHost(value.x);
+                value.y = LittleEndianToHost(value.y);
+                if constexpr (requires { value.z; })
+                    value.z = LittleEndianToHost(value.z);
+                return value;
+            }
+            else if constexpr (!kHostIsBigEndian)
             {
                 return value;
             }
@@ -183,14 +193,6 @@ namespace OpenRCT2
                 raw = ByteSwapT<sizeof(T)>::SwapBE(raw);
                 std::memcpy(&value, &raw, sizeof(T));
             }
-            else if constexpr (RawCoordinates<T>)
-            {
-                // the coordinate structs (Coords/TileCoords XY, XYZ, XYZD) are written raw by the serialisers
-                value.x = LittleEndianToHost(value.x);
-                value.y = LittleEndianToHost(value.y);
-                if constexpr (requires { value.z; })
-                    value.z = LittleEndianToHost(value.z);
-            }
             else if constexpr (sizeof(T) == 1 || requires { T::kByteOrderNeutral; })
             {
             }
@@ -249,6 +251,25 @@ namespace OpenRCT2
         template<typename T>
         void WriteValue(const T& valueIn)
         {
+            if constexpr (RawCoordinates<T>)
+            {
+                // members only, little-endian, padding zero (a struct copy need not carry its padding)
+                uint8_t buf[sizeof(T)]{};
+                const T le = LittleEndianToHost(valueIn);
+                const auto* base = reinterpret_cast<const uint8_t*>(&le);
+                auto put = [&](const auto& member) {
+                    const auto* m = reinterpret_cast<const uint8_t*>(&member);
+                    std::memcpy(buf + (m - base), m, sizeof(member));
+                };
+                put(le.x);
+                put(le.y);
+                if constexpr (requires { le.z; })
+                    put(le.z);
+                if constexpr (requires { le.direction; })
+                    put(le.direction);
+                Write(buf, sizeof(T));
+                return;
+            }
             const T value = LittleEndianToHost(valueIn);
             // Selects the best path at compile time
             if constexpr (sizeof(T) == 1)
