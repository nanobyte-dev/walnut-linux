Subject: Big-endian: object entry checksum and coordinate structs in the network serialiser

DataSerialiser wrote RCTObjectEntry's checksum as part of the raw nameWOC
bytes (host order), and the coordinate structs (TileCoordsXYZD etc.) as
raw struct copies, padding included: track designs as serialised for
TrackDesignAction and replays differed from x86's. The checksum now goes
little-endian; WriteValue writes a coordinate struct's members (little-
endian) into a zeroed buffer, so the padding is zero on every host.
Found by comparing RCT2's 169 TD6 designs (import, serialise, TD6 export)
on both hosts: identical now.

---
 src/openrct2/core/DataSerialiserTraits.h |  9 ++++--
 src/openrct2/core/IStream.hpp            | 39 ++++++++++++++++++------
 2 files changed, 37 insertions(+), 11 deletions(-)

diff --git a/src/openrct2/core/DataSerialiserTraits.h b/src/openrct2/core/DataSerialiserTraits.h
index 8d4c8c142..85c38e821 100644
--- a/src/openrct2/core/DataSerialiserTraits.h
+++ b/src/openrct2/core/DataSerialiserTraits.h
@@ -807,7 +807,11 @@ namespace OpenRCT2
                 auto tmp = ByteSwapBE(val.flags);
                 stream->Write(&tmp, sizeof(tmp));
             } // network order as raw bytes on every host
-            stream->WriteArray(val.nameWOC, 12);
+            // nameWOC is the name and the checksum: the checksum goes little-endian, as x86 hosts write it
+            char nameWOC[12];
+            memcpy(nameWOC, val.nameWOC, 8);
+            StoreLE32(nameWOC + 8, val.checksum);
+            stream->WriteArray(nameWOC, 12);
         }
         static void decode(IStream* stream, RCTObjectEntry& val)
         {
@@ -817,7 +821,8 @@ namespace OpenRCT2
                 val.flags = ByteSwapBE(tmp);
             }
             auto str = stream->ReadArray<char>(12);
-            memcpy(val.nameWOC, str.get(), 12);
+            memcpy(val.nameWOC, str.get(), 8);
+            val.checksum = LoadLE32(str.get() + 8);
         }
         static void log(IStream* stream, const RCTObjectEntry& val)
         {
