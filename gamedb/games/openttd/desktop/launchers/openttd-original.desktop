[Desktop Entry]
Type=Application
Name=OpenTTD (original graphics)
Comment=Transport simulation with Transport Tycoon Deluxe's own graphics and sounds (your imported data); it keeps its own settings file (openttd-original.cfg), so the other OpenTTD entries keep their graphics
Exec=ps3-game sh -c "exec openttd -v sdl-opengl -r 1920x1080 -c ~/.config/openttd/openttd-original.cfg -I original_windows -S original_windows"
Icon=openttd
Terminal=false
Categories=Game;Simulation;
Keywords=game;simulation;transport;tycoon;
NoDisplay=true
X-Walnut-Requires=/usr/share/games/openttd/baseset/trg1r.grf
