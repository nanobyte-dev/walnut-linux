[Desktop Entry]
Type=Application
Name=The Secret of Monkey Island
Comment=The Secret of Monkey Island from your own copy (the Italian CD release, package secret-of-monkey-island-it-data), in ScummVM fullscreen
Exec=ps3-game sh -c "mkdir -p ~/.config/scummvm/walnut && exec scummvm -c ~/.config/scummvm/walnut/monkey.ini -i /usr/share/ps3-games/scummvm/monkey.ini -p /usr/share/games/secret-of-monkey-island-it monkey"
Icon=org.scummvm.scummvm
Terminal=false
Categories=Game;AdventureGame;
Keywords=adventure;lucasarts;scumm;monkey;island;pirate;
NoDisplay=true
X-Walnut-Requires=/usr/share/games/secret-of-monkey-island-it/monkey.000
