+void PApp::padButtonEvent(int button, bool down)
+{
+  button = button; down = down;
+}
+
+/// Opens the first game controller when none is open (the built-in pad scheme).
+void PApp::padOpen()
+{
+  if (sdl_pad != nullptr)
+    return;
+
+  for (int i = 0; i < SDL_NumJoysticks() && sdl_pad == nullptr; i++)
+    if (SDL_IsGameController(i))
+      sdl_pad = SDL_GameControllerOpen(i);
+
+  if (sdl_pad != nullptr) {
+    const char *name = SDL_GameControllerName(sdl_pad);
+    PUtil::outLog() << "Game controller: " << (name ? name : "(no name)") << std::endl;
+  }
+}
+
+int PApp::joyIndex(SDL_JoystickID id) const
+{
+  for (unsigned int i = 0; i < sdl_joy.size(); i++)
+    if (sdl_joy[i].sdl_joystick != nullptr &&
+      SDL_JoystickInstanceID(sdl_joy[i].sdl_joystick) == id)
+      return i;
+  return -1;
+}
