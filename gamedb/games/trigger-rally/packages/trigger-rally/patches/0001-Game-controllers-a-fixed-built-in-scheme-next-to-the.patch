+///
+/// @brief Puts the pad's focus on a new screen: on the button pressed last, if the new
+///   screen has it at the same place (the prev/next arrows), else the screen's pad start,
+///   its default widget or its topmost clickable widget.
+///
+void Gui::focusStart()
+{
+  int pick = -1;
+
+  if (padkeep) {
+    padkeep = false;
+    for (unsigned int i = 0; i < widget.size(); i++)
+      if (widget[i].clickable && widget[i].type == GWT_GRAPHIC &&
+        fabsf(widget[i].pos.x - padkeeppos.x) < 1.0f &&
+        fabsf(widget[i].pos.y - padkeeppos.y) < 1.0f)
+        pick = i;
+  }
+
+  if (pick == -1 && padstart != -1 && widget[padstart].clickable)
+    pick = padstart;
+
+  if (pick == -1 && defwidget != -1 && widget[defwidget].clickable)
+    pick = defwidget;
+
+  for (unsigned int i = 0; pick == -1 && i < widget.size(); i++) {
+    if (!widget[i].clickable) continue;
+    float top = widget[i].pos.y + widget[i].dims_min.y;
+    bool better = true;
+    for (unsigned int k = 0; k < widget.size(); k++) {
+      if (k == i || !widget[k].clickable) continue;
+      float ktop = widget[k].pos.y + widget[k].dims_min.y;
+      if (ktop > top || (ktop == top && widget[k].pos.x < widget[i].pos.x)) {
+        better = false;
+        break;
+      }
+    }
+    if (better) pick = i;
+  }
+
+  highlight = pick;
+}
+
+///
+/// @brief Moves the pad's focus to the nearest clickable widget in a direction
+///   (dx, dy: -1, 0 or 1; y up, as the menu's coordinates).
+///
+void Gui::moveFocus(int dx, int dy)
+{
+  if (highlight == -1 || !widget[highlight].clickable) {
+    focusStart();
+    return;
+  }
+
+  const vec2f from = widget[highlight].pos + widget[highlight].dims_min * 0.5f;
+  int best = -1;
+  float bestscore = 0.0f;
+
+  for (unsigned int i = 0; i < widget.size(); i++) {
+    if ((int)i == highlight || !widget[i].clickable) continue;
+
+    const vec2f d = widget[i].pos + widget[i].dims_min * 0.5f - from;
+    const float along = dx != 0 ? d.x * dx : d.y * dy;
+    const float across = dx != 0 ? fabsf(d.y) : fabsf(d.x);
+
+    if (along < 1.0f) continue;
+
+    // straight ahead first: a widget off to the side counts as farther
+    const float score = along + across * 2.0f;
+    if (best == -1 || score < bestscore) {
+      best = i;
+      bestscore = score;
+    }
+  }
+
+  if (best != -1)
+    highlight = best;
+}
+
+///
+/// @brief The action of the widget the pad's focus is on.
+///
+bool Gui::getFocusAction(int &data1, int &data2)
+{
+  if (highlight == -1 || !widget[highlight].clickable) return false;
+
+  data1 = widget[highlight].d1;
+  data2 = widget[highlight].d2;
+
+  padkeep = widget[highlight].type == GWT_GRAPHIC;
+  padkeeppos = widget[highlight].pos;
+
+  return true;
+}
