+///
+/// @brief The pad's d-pad and left stick in the menus and the car choice: a direction
+///   acts when it is pressed, and again while held (after 0.4 s, every 0.12 s).
+///
+void MainApp::padMenuTick(float delta)
+{
+  int dx = 0, dy = 0;
+
+  if (havePad()) {
+    const float lx = getPadAxis(SDL_CONTROLLER_AXIS_LEFTX);
+    const float ly = getPadAxis(SDL_CONTROLLER_AXIS_LEFTY);
+
+    if (getPadButton(SDL_CONTROLLER_BUTTON_DPAD_UP) || ly < -0.5f) dy = 1;
+    else if (getPadButton(SDL_CONTROLLER_BUTTON_DPAD_DOWN) || ly > 0.5f) dy = -1;
+    if (getPadButton(SDL_CONTROLLER_BUTTON_DPAD_LEFT) || lx < -0.5f) dx = -1;
+    else if (getPadButton(SDL_CONTROLLER_BUTTON_DPAD_RIGHT) || lx > 0.5f) dx = 1;
+
+    // one direction at a time: the stronger one of the stick, else up/down
+    if (dx != 0 && dy != 0) {
+      if (fabsf(lx) > fabsf(ly)) dy = 0;
+      else dx = 0;
+    }
+  }
+
+  if (dx != pad_dir_x || dy != pad_dir_y) {
+    pad_dir_x = dx;
+    pad_dir_y = dy;
+    pad_dir_repeat = 0.4f;
+    if (dx != 0 || dy != 0)
+      padDirection(dx, dy);
+  } else if (dx != 0 || dy != 0) {
+    pad_dir_repeat -= delta;
+    if (pad_dir_repeat <= 0.0f) {
+      pad_dir_repeat += 0.12f;
+      padDirection(dx, dy);
+    }
+  }
+}
+
+void MainApp::padDirection(int dx, int dy)
+{
+  switch (appstate) {
+  case AS_LEVEL_SCREEN:
+    pad_menu = true;
+    if (!gui.hasFocus())
+      gui.focusStart(); // the first press shows where the focus is
+    else
+      gui.moveFocus(dx, dy);
+    break;
+
+  case AS_CHOOSE_VEHICLE:
+    if (dx < 0 && --choose_type < 0)
+      choose_type = (int)game->vehiclechoices.size() - 1;
+    if (dx > 0 && ++choose_type >= (int)game->vehiclechoices.size())
+      choose_type = 0;
+    break;
+  }
+}
