+///
+/// @brief The built-in pad scheme's buttons (PApp's game controller, pad 1), next to the
+///   keyboard and a configured joystick; nothing of it is in the config file.
+///   In the race: Start pauses, Triangle recovers the car, R3 puts it back at the
+///   checkpoint, L1 changes the camera, Select shows or hides the map, and while paused
+///   Circle leaves the race. Driving is read in tickStateGame, the menus in padMenuButton.
+///
+void MainApp::padButtonEvent(int button, bool down)
+{
+  if (!down) return;
+
+  switch (appstate) {
+  case AS_LOAD_3:
+    levelScreenAction(AA_INIT, 0);
+    return;
+
+  case AS_LEVEL_SCREEN:
+    padMenuButton(button);
+    return;
+
+  case AS_CHOOSE_VEHICLE:
+    switch (button) {
+    case SDL_CONTROLLER_BUTTON_A:
+    case SDL_CONTROLLER_BUTTON_START:
+      padMenuKey(SDLK_RETURN);
+      break;
+    case SDL_CONTROLLER_BUTTON_B:
+      padMenuKey(SDLK_ESCAPE);
+      break;
+    }
+    return;
+
+  case AS_IN_GAME:
+    switch (button) {
+    case SDL_CONTROLLER_BUTTON_START:
+      toggleSounds(pauserace);
+      pauserace = !pauserace;
+      break;
+    case SDL_CONTROLLER_BUTTON_B:
+      if (pauserace)
+        padMenuKey(SDLK_ESCAPE); // leave the race
+      break;
+    case SDL_CONTROLLER_BUTTON_Y:
+      game->vehicle[0]->doReset();
+      break;
+    case SDL_CONTROLLER_BUTTON_RIGHTSTICK:
+      game->resetAtCheckpoint(game->vehicle[0]);
+      break;
+    case SDL_CONTROLLER_BUTTON_LEFTSHOULDER:
+      cameraview = (cameraview + 1) % 5;
+      camera_user_angle = 0.0f;
+      break;
+    case SDL_CONTROLLER_BUTTON_BACK:
+      showmap = !showmap;
+      break;
+    }
+    return;
+
+  case AS_END_SCREEN:
+    requestExit();
+    return;
+  }
+}
+
+/// A key press for the pad: what the keyboard does with that key in this state.
+void MainApp::padMenuKey(SDL_Keycode sym)
+{
+  SDL_KeyboardEvent ke = SDL_KeyboardEvent();
+
+  ke.type = SDL_KEYDOWN;
+  ke.state = SDL_PRESSED;
+  ke.keysym.sym = sym;
+  ke.keysym.scancode = SDL_GetScancodeFromKey(sym);
+  keyEvent(ke);
+}
