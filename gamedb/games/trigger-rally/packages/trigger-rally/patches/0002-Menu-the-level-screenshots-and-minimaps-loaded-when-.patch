+///
+/// @brief The level picture the menu shows in a slot (0 the screenshot, 1 the minimap),
+///   loaded when the menu shows it, as loadLevel did for every level at the start
+///   (the same texture, mipmapped): one level's pair is in memory, not all ~190 levels'.
+///   The fallback when the level has none or it fails to load.
+///
+PTexture *MainApp::menuThumb(int slot, const std::string &path, PTexture *fallback)
+{
+  if (path.empty())
+    return fallback;
+
+  if (path != thumb_path[slot]) {
+    // the menu's widgets were cleared before the screen is made again: the old one is unused
+    delete thumb_tex[slot];
+    thumb_tex[slot] = nullptr;
+    thumb_path[slot] = path;
+
+    try
+    {
+      thumb_tex[slot] = new PTexture(path, true, false);
+    }
+    catch (PException &e)
+    {
+      if (PUtil::isDebugLevel(DEBUGLEVEL_ENDUSER))
+        PUtil::outLog() << "Failed to load " << path << ": " << e.what() << std::endl;
+    }
+  }
+
+  return thumb_tex[slot] != nullptr ? thumb_tex[slot] : fallback;
+}
+
+void MainApp::menuThumbsFree()
+{
+  for (int i = 0; i < 2; i++) {
+    delete thumb_tex[i];
+    thumb_tex[i] = nullptr;
+    thumb_path[i].clear();
+  }
+}
