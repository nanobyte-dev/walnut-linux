+
+/* block polygons as the triangles Mesa draws for GL_POLYGON (in the same
+   order, so the pixels are the same), edges as they are (GL_QUADS) */
+static void appendGeom(std::vector<float> &o_data, Geom *i_geom, bool i_quads) {
+  i_geom->bufFirst = o_data.size() / 4;
+  for (unsigned int j = 0; j < i_geom->Polys.size(); j++) {
+    GeomPoly *pPoly = i_geom->Polys[j];
+    int n = pPoly->nNumVertices;
+    std::vector<int> v_idx;
+    if (i_quads) {
+      /* whole quads only, so the next ones stay aligned */
+      for (int i = 0; i < n - n % 4; i++) {
+        v_idx.push_back(i);
+      }
+    } else {
+      for (int i = 0; i + 2 < n; i++) {
+        v_idx.push_back(i + 1);
+        v_idx.push_back(i + 2);
+        v_idx.push_back(0);
+      }
+    }
+    for (unsigned int k = 0; k < v_idx.size(); k++) {
+      o_data.push_back(pPoly->pVertices[v_idx[k]].x);
+      o_data.push_back(pPoly->pVertices[v_idx[k]].y);
+      o_data.push_back(pPoly->pTexCoords[v_idx[k]].x);
+      o_data.push_back(pPoly->pTexCoords[v_idx[k]].y);
+    }
+  }
+  i_geom->bufCount = o_data.size() / 4 - i_geom->bufFirst;
+}
+
+void LevelGeoms::buildBuffer(bool i_useVBO) {
+  if (m_bufBuilt) {
+    return;
+  }
+  m_bufBuilt = true;
+
+  /* each block, then its edges, in the order they are drawn: edges of the
+     same texture follow each other, so they are one draw */
+  m_bufData.clear();
+  for (unsigned int i = 0; i < m_savedBlockGeoms.size(); i++) {
+    if (m_savedBlockGeoms[i].gmain != NULL &&
+        m_savedBlockGeoms[i].gmain->bufFirst < 0) {
+      appendGeom(m_bufData, m_savedBlockGeoms[i].gmain, false);
+    }
+    for (unsigned int j = 0; j < m_savedBlockGeoms[i].gedges.size(); j++) {
+      if (m_savedBlockGeoms[i].gedges[j]->bufFirst < 0) {
+        appendGeom(m_bufData, m_savedBlockGeoms[i].gedges[j], true);
+      }
+    }
+  }
+  for (unsigned int i = 0; i < m_blockGeoms.size(); i++) {
+    if (m_blockGeoms[i]->bufFirst < 0) {
+      appendGeom(m_bufData, m_blockGeoms[i], false);
+    }
+  }
+  for (unsigned int i = 0; i < m_edgeGeoms.size(); i++) {
+    if (m_edgeGeoms[i]->bufFirst < 0) {
+      appendGeom(m_bufData, m_edgeGeoms[i], true);
+    }
+  }
+
+  int v_nVertices = m_bufData.size() / 4;
+  const float *v_base = m_bufData.size() > 0 ? &m_bufData[0] : NULL;
+#ifdef ENABLE_OPENGL
+  if (i_useVBO && m_bufData.size() > 0) {
+    glGenBuffersARB(1, (GLuint *)&m_bufId);
+    glBindBufferARB(GL_ARRAY_BUFFER_ARB, m_bufId);
+    glBufferDataARB(GL_ARRAY_BUFFER_ARB,
+                    m_bufData.size() * sizeof(float),
+                    v_base,
+                    GL_STATIC_DRAW_ARB);
+    glBindBufferARB(GL_ARRAY_BUFFER_ARB, 0);
+    v_base = NULL; /* offsets into the buffer */
+  }
+#endif
+  for (unsigned int i = 0; i < m_blockGeoms.size(); i++) {
+    m_blockGeoms[i]->bufId = m_bufId;
+    m_blockGeoms[i]->bufBase = v_base;
+  }
+  for (unsigned int i = 0; i < m_edgeGeoms.size(); i++) {
+    m_edgeGeoms[i]->bufId = m_bufId;
+    m_edgeGeoms[i]->bufBase = v_base;
+  }
+  if (m_bufId != 0) {
+    /* the data is in the buffer object */
+    std::vector<float>().swap(m_bufData);
+  }
+
+  LogInfo("GL: level buffer of %d blocks and %d edges, %d vertices (%s)",
+          (int)m_blockGeoms.size(),
+          (int)m_edgeGeoms.size(),
+          v_nVertices,
+          m_bufId != 0 ? "VBO" : "client memory");
 }
 
