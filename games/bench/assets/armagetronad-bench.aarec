CONFIG LARENA_AXES 4                                          # sets the number of possible driving directions (used only when map is axes-independent)

CONFIG LMAP_FILE    Anonymous/polygon/regular/square-1.0.1.aamap.xml   # sets the file path for the map, and if required, the URI to download the map from, in parenthesis

CONFIG LBACKWARD_COMPATIBILITY 1000 # Maximum number of network protocol versions backward compatibility ( will be clamped to maximal supported value; set to zero to not accept logins from older clients )

CONFIG LNEW_FEATURE_DELAY 0         # Disable features that only came in during the last X protocol versions.

CONFIG LMIN_PROTOCOL_VERSION 0      # Minimum protocol version allowed to play.

CONFIG LMAX_PROTOCOL_VERSION 0      # If > 0, maximum protocol version allowed to play; features not supported by this version are going to be permanently disabled.

CONFIG LMAX_CLIENTS 16              # maximum number of clients that can connect to this machine

CONFIG LMAX_CLIENTS_SAME_IP_SOFT 4  # maximum number of clients from the same IP (soft limit, more users from the same IP will be kicked when the server is full and someone new connects)

CONFIG LMAX_CLIENTS_SAME_IP_HARD 8  # maximum number of clients from the same IP (hard limit, more logins will be ignored)

CONFIG LMAX_PLAYERS_SAME_IP      4  # maximum number of players from the same IP (note that each client can legally host up to four players)

CONFIG LNETWORK_MIN_BAN          120 # when a banned client tries to connect, update the remaining ban-time to be at least this many seconds 

CONFIG LNETWORK_AUTOBAN_FACTOR   10  

CONFIG LNETWORK_AUTOBAN_OFFSET   5

CONFIG LNETWORK_AUTOBAN_MAX_KPH  30  # maximal value the kicks per hour can actually have (influences the measurement process )

CONFIG LNETWORK_SPECTATOR_TIME  0    # if > 0, this is the maximal time in seconds a client without players is tolerated

CONFIG LALLOW_ENEMIES_SAME_IP     0  # if set to 1, this allows two players that apparently come from the same machine to fight for points with each other

CONFIG LALLOW_ENEMIES_SAME_CLIENT 0  # if set to 1, this allows two players that play on the same client to fight for points with each other

CONFIG LALLOW_CONTROL_DURING_CHAT 0  # if set to 1, this allows a player to issue cycle and camera control commands during chat (losing the chatbot and the yellow chat pyramid). This feature was buggy and has been disabled for 0.2.8.0.

CONFIG LALLOW_IMPOSTERS 0            # allow two players to have the same name

CONFIG LTIMEBOT_SENSITIVITY 1.0      # The sensitivity of the timebot detection code. 1.0 is the default and you 

CONFIG LTIMEBOT_KICK_SEVERITY .5     # If players get kicked by the timebot detection, it's done with this severity level.

CONFIG LTIMEBOT_ACTION_MEDIUM 1      # Action to take on a medium suspicion of timebottery. 0: do nothing, 1: log it, 2: message moderators, 3: message all players, 4: kick the offending player.

CONFIG LTIMEBOT_ACTION_HIGH 1        # Action to take on a high suspicion of timebottery. 0: do nothing, 1: log it, 2: message moderators, 3: message all players, 4: kick the offending player.

CONFIG LTIMEBOT_ACTION_MAX 1         # Action to take on a very high suspicion of timebottery. 0: do nothing, 1: log it, 2: message moderators, 3: message all players, 4: kick the offending player.

CONFIG LCYCLE_TURN_MEMORY 3         # number of pending turn commands a cycle memorizes before opposing turns cancel each other

CONFIG LCYCLE_SPEED 30.0            # basic cycle speed (m/s)

CONFIG LCYCLE_SPEED_MIN .25         # minimal cycle speed as ratio to CYCLE_SPEED

CONFIG LCYCLE_SPEED_DECAY_BELOW 5.0 # rate of cycle speed approaching the value of CYCLE_SPEED from below

CONFIG LCYCLE_SPEED_DECAY_ABOVE .1  # rate of cycle speed approaching the value of CYCLE_SPEED from above

CONFIG LCYCLE_START_SPEED 20.0      # speed at startup

CONFIG LCYCLE_ACCEL 10.0            # wall acceleration multiplicator

CONFIG LCYCLE_ACCEL_SELF 1.0        # multiplicator to CYCLE_ACCEL for your own wall

CONFIG LCYCLE_ACCEL_TEAM 1.0        # multiplicator to CYCLE_ACCEL for your temmates' walls

CONFIG LCYCLE_ACCEL_ENEMY 1.0       # multiplicator to CYCLE_ACCEL for your enemies' walls

CONFIG LCYCLE_ACCEL_RIM 0.0         # multiplicator to CYCLE_ACCEL for the rim walls

CONFIG LCYCLE_ACCEL_SLINGSHOT 1.0   # multiplicator to CYCLE_ACCEL if you're between your wall and another wall

CONFIG LCYCLE_ACCEL_TUNNEL 1.0      # multiplicator to CYCLE_ACCEL if you're between two walls that are not your own

CONFIG LCYCLE_ACCEL_OFFSET 2.0      # acceleration offset. Must be positive or smaller than -CYCLE_WALL_NEAR, otherwise there is a risk of a division by zero.

CONFIG LCYCLE_WALL_NEAR 6.0         # the distance from a wall below which wall-acceleration kicks in

CONFIG LCYCLE_SOUND_SPEED 30.0      # sound speed divisor 

CONFIG LCYCLE_BRAKE 30.0            # deceleration by braking (set to zero to disable brakes and to a negative value to turn brakes into a turbo)

CONFIG LCYCLE_BOOST_SELF     0.0      # Speed boost when breaking from your own wall

CONFIG LCYCLE_BOOST_TEAM     0.0      # Speed boost when breaking from a teammate's wall

CONFIG LCYCLE_BOOST_ENEMY    0.0      # Speed boost when breaking from an enemy wall

CONFIG LCYCLE_BOOST_RIM      0.0      # Speed boost when breaking from the rim wall

CONFIG LCYCLE_BOOSTFACTOR_SELF   1.0  # Factor your speed is multiplied with when breaking from your own wall

CONFIG LCYCLE_BOOSTFACTOR_TEAM   1.0  # Factor your speed is multiplied with when breaking from a teammate's wall

CONFIG LCYCLE_BOOSTFACTOR_ENEMY  1.0  # Factor your speed is multiplied with when breaking from an enemy wall

CONFIG LCYCLE_BOOSTFACTOR_RIM    1.0  # Factor your speed is multiplied with when breaking from the rim wall

CONFIG LCYCLE_DELAY  .1             # minimum time between turns in seconds. Never enable the topology police if this is set lower than 0.001. Only values bigger than zero are supported.

CONFIG LCYCLE_DELAY_TIMEBASED 1.0   # turn delays will be based on the time since the last turn if this is set to 1 (default) and the distance if this is set to 0. Intermediate values and values out of these bounds are supported as well.

CONFIG LCYCLE_TURN_SPEED_FACTOR .95 # at every turn a cycle's speed is multiplied by this value

CONFIG LCYCLE_RUBBER  1.0          # niceness when hitting a wall

CONFIG LCYCLE_PING_RUBBER 3.0      # niceness when hitting a wall: bonus for higher ping players

CONFIG LCYCLE_RUBBER_TIMEBASED 0.0 # rubber usage is based on distance travelled if this is set to 0 (default) and the time passed if this is set to 1. Intermediate values and values out of these bounds are supported as well.

CONFIG LCYCLE_RUBBER_SPEED 40.0                  # logarithmic speed of wall approximation when rubber is in effect ( every second, you get closer to the wall by a factor of ~0.4^{this value} )

CONFIG LCYCLE_RUBBER_MINDISTANCE .001            # The minimal distance rubber code keeps cycles from walls

CONFIG LCYCLE_RUBBER_MINDISTANCE_RATIO .0001     # Additional distance for every length unit of the wall you have in front of you

CONFIG LCYCLE_RUBBER_MINDISTANCE_RESERVOIR .005  # Additional distance if you have an empty rubber meter (gets faded out gradually as you use up all your rubber)

CONFIG LCYCLE_RUBBER_MINDISTANCE_UNPREPARED .005 # Additional distance for unprepared grinds; it gets applied when the cycle's last turn was just a fraction of a second ago and faded out preparation times larger than CYCLE_RUBBER_MINDISTANCE_PREPARATION.

CONFIG LCYCLE_RUBBER_MINDISTANCE_PREPARATION .2  # Timescale in seconds a cycle's last turn time is compared with to determine the effect of CYCLE_RUBBER_MINDISTANCE_UNPREPARED.

CONFIG LCYCLE_RUBBER_MINADJUST .05               # when adjusting to or 180ing into a wall, allow going closer by at least this amount ( relative to the last distance ). A value of zero may lead to cycles ending up on the wrong side of their own walls.

CONFIG LCYCLE_RUBBER_LEGACY 0                    # fallback to old, frame-dependant rubber code when old clients are present if this is 1

CONFIG LCYCLE_RUBBER_TIME 10.0                   # Timescale rubber is restored on

CONFIG LCYCLE_RUBBER_DELAY 0.0                   # during this fraction of the cycle delay time, rubber efficiency will be multiplied...

CONFIG LCYCLE_RUBBER_DELAY_BONUS .5              # by this factor ( meaning that rubber usage goes up by the inverse; a value of zero means rubber is completely disabled )

CONFIG LCYCLE_RUBBER_WALL_SHRINK 0               # With finite length trails, the used rubber is multiplied with this value and subtracted from the wall length. A value of 1 lets the trail recede at constant speed. All values are supported, but negative values may degrade performance and cause false positives from the topology police if that is enabled.

CONFIG LCYCLE_RUBBER_MINDISTANCE_GAP 0           # If > 0, CYCLE_RUBBER_MINDISTANCE effectively is never taken to be bigger than this value times the size of any detected gaps the cycle can squeeze through.

CONFIG LCYCLE_RUBBER_MINDISTANCE_GAP_BACKDOOR  0 # As above, but this value is applied only to 'backdoor' gaps, gaps that lead you away from an enemy. If = 0, CYCLE_RUBBER_MINDISTANCE_GAP applies to backdoors, too. If you want to discourage backdooring, set this to something bigger than 1, 1.5 would be recommended.

CONFIG LCYCLE_RUBBER_MINDISTANCE_GAP_SIDE .5     # Gap detection only sees gaps that the cycle may reach in no less than this many seconds.

CONFIG LCYCLE_BRAKE_REFILL .1    # refill rate of brake reservoir

CONFIG LCYCLE_BRAKE_DEPLETE 1.0  # depletion rate of brake reservoir ( set to 0 to reenable pre 0.2.5 behaviour of infinite brakes )

CONFIG LCYCLE_WIDTH 0            # the width of a cycle in meters. If set, a cycle will take damage (=use up rubber or explode) if it drives through a tunnel narrower than this.

CONFIG LCYCLE_WIDTH_SIDE 0       # the minimal distance a cycle needs to have from every wall. If set, a cycle will take damage (=use up rubber or explode) if it drives closer.

CONFIG LCYCLE_WIDTH_RUBBER_MIN 1 # minimum rubber usage when a cycle is found in a situation illegal by the two above settings. The minimal value is applied if the space is almost enough.

CONFIG LCYCLE_WIDTH_RUBBER_MAX 1 # maximum rubber usage when a cycle is found in a situation illegal by the two above settings. This value is applied if there truly is no space left.

CONFIG LCYCLE_DIST_WALL_SHRINK        0.0  # Distance multiplier in wall length calculation. All values are legal.

CONFIG LCYCLE_DIST_WALL_SHRINK_OFFSET 0.0  # Distance offset in wall length calculation.

CONFIG LCYCLE_INVULNERABLE_TIME 0.0        # Time in seconds a cycle is invulnerable after a respawn.

CONFIG LCYCLE_WALL_TIME 0.0                # Time in seconds a cycle does not make a wall after a respawn.

CONFIG LCYCLE_FIRST_SPAWN_PROTECTION 0     # Set to 1 if the invulnerability and wall delay should already be active on the initial spawn at the beginning of a round.

CONFIG LCYCLE_SYNC_INTERVAL_ENEMY 1.0           # Time in seconds between server-client updates of enemy cycles

CONFIG LCYCLE_SYNC_INTERVAL_SELF  0.1           # Time in seconds between server-client updates of enemy cycles owned by the client itself

CONFIG LCYCLE_AVOID_OLDCLIENT_BAD_SYNC 0        # If set to 1, old clients will not get sync messages in situations that are known to confuse them

CONFIG LCYCLE_FAIR_ANTILAG 1                    # If set to 1, this deactivates the anti lag-sliding code when old clients are connected

CONFIG LCYCLE_TIME_TOLERANCE .1                 # Maximum time difference of execution of turns on server and client ( for clients that send timing information )

CONFIG LCYCLE_PACKETLOSS_TOLERANCE 0.0          # Cycle death is prevented as long as the player's failure to turn can be explained by the loss of this many network packets. Enabling this allows cheating with modified clients.

CONFIG LCYCLE_SYNC_FF 10.0                      # Speed of simulation of the extrapolating sync; decrease for lower CPU load, but higher effective ping

CONFIG LCYCLE_SYNC_FF_STEPS 1                   # Number of extrapolation simulation timesteps each real timestep; increase for better accuracy

CONFIG LCYCLE_SMOOTH_TIME .3                    # Timescale for smoothing options. Increasing this will make interpolation smoother, but less accurate. Decreasing it will make network synchronization jumpy.

CONFIG LCYCLE_SMOOTH_MIN_SPEED .2               # Minimum speed of smooth correction relative to cycle speed

CONFIG LCYCLE_SMOOTH_THRESHOLD .2               # Only syncs that differ from your position by less than this amount ( measured in speed ) will be smoothed slowly, bigger deviations will get faster handling.

CONFIG LCYCLE_MAX_REFCOUNT 30000                # Maximum allowed reference count on cycles before they self destruct.

CONFIG LTOPOLOGY_POLICE 0       # the topology police is your last defense against tunneling players. It tries to

CONFIG LTOPOLOGY_POLICE_PARALLEL 1 # if TOPOLOGY_POLICE is set to 1, this flag can be disabled to disable checks for parallel walls.

CONFIG LCHATBOT_ALWAYS_ACTIVE 0            # if set to 1, the chatbot is active all of the time

CONFIG LCHATBOT_NEW_WALL_BLINDNESS .3      # the chatbot won't see walls that were built less than this many seconds ago

CONFIG LCHATBOT_MIN_TIMESTEP .3            # minimal time in seconds between chatbot thoughts

CONFIG LCHATBOT_DELAY .5                   # time between entering chat and chatbot activation

CONFIG LCHATBOT_RANGE 1.0                  # time in seconds the bot is capable of planning ahead

CONFIG LCHATBOT_DECAY .02                  # rate at which the quality of the chatbot decays over time

CONFIG LHISTORY_SIZE_CONSOLE 10     # number of lines kept in the console history

CONFIG LHISTORY_SIZE_CHAT 10        # number of lines kept in the chat history

CONFIG LRECORDING_DEBUGLEVEL 0        # level of additional debug only information in recording file.

CONFIG Linclude settings_visual.cfg

CONFIG LGRID_SIZE 1.0            # grid size

CONFIG LFADEOUT_NAME_DELAY 5.0   # Time the player names are shown. Set to 0 if you don't want to show them at all or -1 if you want to show them always.

CONFIG LSHOW_OWN_NAME   0    # Should your own name be shown above your cycle, too? 

CONFIG LPLAYER_RANDOM_COLOR 0     # if set to 1, a random generator will try to pick a color for you that

CONFIG LCYCLE_BLINK_FREQUENCY  10          # Frequency in Hz an invulnerable cycle blinks with.

CONFIG LHUD_CACHE_THRESHOLD    0.0001      # Update threshold for HUD gauges, only in effect when display lists are activated: if the relative change times the amount of time since the last update is bigger than this, the gauge gets updated.

CONFIG LCAMERA_FOLLOW_START_X -30 # fixed external camera start position

CONFIG LCAMERA_FOLLOW_START_Y -30 # ( relative to cycle )

CONFIG LCAMERA_FOLLOW_START_Z  80

CONFIG LCAMERA_SMART_START_X   10 # smart camera start position

CONFIG LCAMERA_SMART_START_Y   30 # ( relative to cycle )

CONFIG LCAMERA_SMART_START_Z   2

CONFIG LCAMERA_FREE_START_X    10 # free camera start position

CONFIG LCAMERA_FREE_START_Y   -70 # ( relative to cycle )

CONFIG LCAMERA_FREE_START_Z    100

CONFIG LCAMERA_CUSTOM_BACK    6         # how much the custom camera is moved back

CONFIG LCAMERA_CUSTOM_RISE    4         # the height of the custom camera above the cycle

CONFIG LCAMERA_CUSTOM_BACK_FROMSPEED .5 # how much the camera is moved back for every m/s speed

CONFIG LCAMERA_CUSTOM_RISE_FROMSPEED .4 # the height of the camera above the cycle for every m/s speed

CONFIG LCAMERA_CUSTOM_PITCH   -.58      # inclination of the camera

CONFIG LCAMERA_CUSTOM_ZOOM    0         # how much the camera zooms in your cycle at the beginning of the round (to show the team's formation)

CONFIG LCAMERA_CUSTOM_TURN_SPEED     4  # speed the custom camera turns with

CONFIG LCAMERA_CUSTOM_TURN_SPEED_180 4  # factor to the turn speed after a quick reversal

CONFIG LCAMERA_GLANCE_BACK    6         # how much the glance camera is moved back

CONFIG LCAMERA_GLANCE_RISE    4         # the height of the glance camera above the cycle

CONFIG LCAMERA_GLANCE_BACK_FROMSPEED .5 # how much the camera is moved back for every m/s speed

CONFIG LCAMERA_GLANCE_RISE_FROMSPEED .4 # the height of the camera above the cycle for every m/s speed

CONFIG LCAMERA_GLANCE_PITCH   -.58      # inclination of the camera

CONFIG LCAMERA_IN_TURN_SPEED         40        # speed the internal camera turns with

CONFIG LCAMERA_VISIBILITY_LOWER_WALL       1   # if set, walls are lowered when they block the view and the camera is not moved

CONFIG LCAMERA_VISIBILITY_LOWER_WALL_SMART 0   # like CAMERA_VISIBILITY_LOWER_WALL, but special setting for the smart camera

CONFIG LBUG_TRANSPARENCY 0                     # unsupported: make all rim walls semi-transparent by rendering them without occlusion tests

CONFIG LBUG_TRANSPARENCY_DEMAND 0              # unsupported: use transparency instead of lowering walls

CONFIG LFONT_MIN_R .5

CONFIG LFONT_MIN_G .5

CONFIG LFONT_MIN_B .5

CONFIG LFONT_MIN_TOTAL .7

CONFIG LFONT_BIG_THRESHOLD_WIDTH  10

CONFIG LFONT_BIG_THRESHOLD_HEIGHT 20

CONFIG LCAMERA_VISIBILITY_RECOVERY_SPEED 1  # the speed the external visibility targets recovers from wall hits

CONFIG LCAMERA_VISIBILITY_WALL_DISTANCE  .5 # the distance the visibility targets keep from walls

CONFIG LCAMERA_VISIBILITY_CLIP_SPEED     40 # speed with which the visibility targets is brought into view

CONFIG LCAMERA_VISIBILITY_EXTENSION      1  # distance (measured in seconds, gets multiplied by speed) of the visibility targets from the watched object

CONFIG LCAMERA_VISIBILITY_SIDESKEW      .5  # extra forward component of the sideways visibility targets

CONFIG LARENA_WALL_SHADOW_SIZE 0.1      # maximal size of the arena wall shadow compared to the camera/wall height

CONFIG LARENA_WALL_SHADOW_SIDEDIST 10.0 # shadows are drawn when the cycle gets closer to the line the wall follows than this

CONFIG LARENA_WALL_SHADOW_DIST 30.0     # shadows are drawn when the cycle's path gets closer to the wall than this

CONFIG LARENA_WALL_SHADOW_NEAR 1.0      # getting closer to the wall than this distance does not increase the shadow much

CONFIG LCAMERA_SMART_DISTANCE 4.0               # typical distance the camera keeps from the cycle

CONFIG LCAMERA_SMART_HEIGHT 2.0                 # typical height in speed units

CONFIG LCAMERA_SMART_TURN_GRINDING 5.0          # Amount of turning from grinding walls

CONFIG LCAMERA_SMART_MIN_DISTANCE 10.0          # minimal distance of the camera to the cycle in .3 meters

CONFIG LCAMERA_SMART_HEIGHT_EXTRA .5            # extra factor for height. Either this or the previous setting is redundant :)

CONFIG LCAMERA_SMART_HEIGHT_TURNING .5          # influence of turning on camera height

CONFIG LCAMERA_SMART_HEIGHT_GRINDING 0.0        # influence of grinding on camera height. In 0.2.7.1, this was set to 2, causing the camera to tilt down too far.

CONFIG LCAMERA_SMART_HEIGHT_OBSTACLE 1.0        # influence of obstacles in front of the cycle

CONFIG LCAMERA_SMART_CENTER_POS_SMOOTH 6.0      # speed of cycle position smoothing

CONFIG LCAMERA_SMART_CENTER_DIR_SMOOTH 3.0      # speed of cycle direction smoothing

CONFIG LCAMERA_SMART_CENTER_LOOKAHEAD .5        # amount of lookahead on top of smoothing, relative to speed

CONFIG LCAMERA_SMART_CENTER_MAX_LOOKAHEAD 5     # maximal amount of lookahead on top of smoothing

CONFIG LCAMERA_SMART_AVOID_FRONT 10.0           # factor moving the camera to the side if it is in front of the cycle

CONFIG LCAMERA_SMART_AVOID_FRONT2 0.1           # another factor moving the camera to the side if it is in front of the cycle

CONFIG LCAMERA_SMART_CYCLESPEED 20.0            # typical cycle speed

CONFIG LCAMERA_SMART_DISTANCESCALE .2           # distance scale measured relative to cycle speed

CONFIG LCAMERA_SMART_MIN_DISTANCESCALE 5.0      # minimal distance scale in meters

INCLUDE_END
CONFIG LCAMERA_FORBID_SMART 0           # forbid smart camera

CONFIG LCAMERA_FORBID_IN    0           # forbid internal camera

CONFIG LCAMERA_FORBID_FREE 0            # forbid free camera

CONFIG LCAMERA_FORBID_FOLLOW 0          # forbid fixed external camera

CONFIG LCAMERA_FORBID_CUSTOM 0          # forbid custom external camera

CONFIG LCAMERA_FORBID_SERVER_CUSTOM 1   # forbid server defined custom external camera

CONFIG LCAMERA_FORBID_CUSTOM_GLANCE 0   # forbid use of special glance camera settings

CONFIG LCAMERA_OVERRIDE_CUSTOM_GLANCE 0 # override custom glance settings with values from the server

CONFIG LCAMERA_OVERRIDE_CUSTOM_GLANCE_SERVER_CUSTOM 0 # the same, but only affects the server custom camera

CONFIG LCAMERA_SERVER_CUSTOM_BACK    30           # how much the camera is moved back

CONFIG LCAMERA_SERVER_CUSTOM_RISE    20           # the height of the camera above the cycle

CONFIG LCAMERA_SERVER_CUSTOM_BACK_FROMSPEED    0  # how much the camera is moved back for every m/s speed

CONFIG LCAMERA_SERVER_CUSTOM_RISE_FROMSPEED    0  # the height of the camera above the cycle for every m/s speed

CONFIG LCAMERA_SERVER_CUSTOM_PITCH   -.7          # inclination of the camera

CONFIG LCAMERA_SERVER_GLANCE_BACK    30           # how much the camera is moved back

CONFIG LCAMERA_SERVER_GLANCE_RISE    20           # the height of the camera above the cycle

CONFIG LCAMERA_SERVER_GLANCE_BACK_FROMSPEED    0  # how much the camera is moved back for every m/s speed

CONFIG LCAMERA_SERVER_GLANCE_RISE_FROMSPEED    0  # the height of the camera above the cycle for every m/s speed

CONFIG LCAMERA_SERVER_GLANCE_PITCH   -.7          # inclination of the camera

CONFIG LCAMERA_SERVER_CUSTOM_TURN_SPEED     -1    # speed the custom camera turns with

CONFIG LCAMERA_SERVER_CUSTOM_TURN_SPEED_180 4     # factor to the turn speed after a quick reversal

CONFIG LSCORE_WIN 10       # points you gain for being last one alive

CONFIG LSCORE_SUICIDE -4   # points you gain for every stupid death (race

CONFIG LSCORE_KILL 3       # points you gain for everyone racing into your wall

CONFIG LSCORE_DIE  -2      # points you gain for every time you race into

CONFIG LLIMIT_SCORE 100    # score limit (all limits for one match)

CONFIG LLIMIT_ROUNDS 10    # max number of rounds to play

CONFIG LLIMIT_TIME  30     # max time (in minutes)

CONFIG LSPAWN_WINGMEN_BACK 2.202896 # determines how much each wingman is placed backwards

CONFIG LSPAWN_WINGMEN_SIDE 2.75362  # determines how much each wingman is placed sidewards

CONFIG LENEMY_TEAMMATE_PENALTY 2500.0   # Penalty on the effective time in seconds if the influence is from a teammate

CONFIG LENEMY_DEAD_PENALTY 0.0          # Penalty on the effective time in seconds if the influence comes from a dead player

CONFIG LENEMY_CHATBOT_PENALTY 30.0      # Penalty in seconds if the victim is in chatbot state and the influence is just the chatbot evading a wall

CONFIG LENEMY_CURRENTTIME_INFLUENCE 0.0 # If set to 1, not the build time of the encountered wall, but the current time enters the comparison. Arbitrary blending values are allowed.

CONFIG LENEMY_SUICIDE_TIMEOUT 10000.0   # If no enemy influence can be found for the last this many seconds, the death counts as a suicide.

CONFIG LSP_SCORE_WIN 10       # points you gain for being last one alive

CONFIG LSP_LIMIT_SCORE 100000 # score limit (all limits for one match)

CONFIG LSP_LIMIT_ROUNDS 10     # max number of rounds to play

CONFIG LSP_LIMIT_TIME   30    # max time (in minutes)

CONFIG LCOLOR_STRINGS 1             # Generate strings that will be rendered with color effects.

CONFIG LFILTER_COLOR_STRINGS 0      # Filter color codes from all strings coming in over the network.

CONFIG LFILTER_COLOR_NAMES 0        # Filter color codes from player names.

CONFIG LFILTER_NAME_ENDS 1          # Filter whitespace from beginning and end of player names.

CONFIG LFILTER_NAME_MIDDLE 1        # Filter excess whitespace and other junk from the middle of player names.

CONFIG LFILTER_COLOR_SERVER_NAMES 0 # Filter color codes from server names in the server browser. Only affects the client.

CONFIG LSILENCE_DEFAULT 0  # silence new players by default?

CONFIG LENABLE_CHAT 1      # allow public messages?

CONFIG LLADDER_PERCENT_BET 10 # percentage of your score to be put in the pot

CONFIG LLADDER_MIN_BET 1      # minimum credits to be put in the pot

CONFIG LLADDER_TAX 1          # percentage the IRS takes from the pot

CONFIG LLADDER_LOSE_PERCENT_ON_LOAD .2   # you lose this percentage of your

CONFIG LLADDER_LOSE_MIN_ON_LOAD .2       # but minimum this value

CONFIG LLADDER_GAIN_EXTRA 1              # the winner gets his ping+ping charity

CONFIG LGAME_TIMEOUT 10.0       # base for game synchronization timeouts. 

CONFIG LLAST_CHAT_BREAK_TIME -1.0      # Last round time a player in chat mode is able to pause the timer

CONFIG LEXTRA_ROUND_TIME 0.0           # Length of an extra pause at the beginning of the round

CONFIG LPLAYER_CHAT_WAIT_MAX 0.0       # Maximum time in seconds to wait for a single player to stop chatting.

CONFIG LPLAYER_CHAT_WAIT_FRACTION 0.0  # Maximum fraction of time to wait for a single player to stop chatting.

CONFIG LPLAYER_CHAT_WAIT_SINGLE 0      # Set to 1 if only one player should get his chat wait time reduced at any given time.

CONFIG LPLAYER_CHAT_WAIT_TEAMLEADER 1  # Set to 0 if all players, not just team leaders, should be allowed to pause the timer.

CONFIG LCHATTER_REMOVE_TIME 180  # Time in seconds after which a permanent chatter is removed from the game

CONFIG LIDLE_REMOVE_TIME 0       # Time in seconds after which an inactive player is removed from the game

CONFIG LIDLE_KICK_TIME 0         # Time in seconds after which an inactive player is kicked

CONFIG LKEEP_PLAYER_SLOT 0       # Set to 1 if spectators should be auto-removed if the server gets full so potential 

CONFIG LDOUBLEBIND_TIME -10.0   # Time in seconds during which no two different keyboard events can 

CONFIG LWIN_ZONE_RANDOMNESS .8  # randomness factor of the initial position. Set it to 0 to fix the winzone in the center of the area, 1 to spread it all over the arena.

CONFIG LWIN_ZONE_EXPANSION   1  # expansion speed of the winzone in m/s

CONFIG LWIN_ZONE_INITIAL_SIZE 5 # radius in m the win zone starts with

CONFIG LWIN_ZONE_DEATHS 0       # set to 1 to turn the winzone into a deathzone

CONFIG LFORTRESS_CONQUEST_RATE .5        # the number of enemies inside the fortress zone is counted, multiplied with this value and added to the "conquered" variable. Increase this to make conquering easier.

CONFIG LFORTRESS_DEFEND_RATE .25         # the number of owners inside the fortress zone is counted, multiplied with this value and subtracted from the "conquered" variable. Increase to make defending easier.

CONFIG LFORTRESS_CONQUEST_DECAY_RATE .1  # this value is subtracted. Increase to make defending easier.

CONFIG LFORTRESS_CONQUEST_TIMEOUT 0      # timeouts for enemy contacts with the zone. If a zone would collapse without a defender (as on Sumo), the zone will collapse harmlessly after all enemy contacts timed out.

CONFIG LFORTRESS_CONQUERED_SCORE 0        # the conquering party gets this many points (divided among the conquerors)

CONFIG LFORTRESS_HELD_SCORE 0             # points a team owning a zone gets at the end of the round if both team and zone survived

CONFIG LFORTRESS_CONQUERED_WIN 0          # if set to 1, the conquering party wins the round

CONFIG LFORTRESS_CONQUERED_KILL_MIN 0     # the closest X players of the owning team get killed at least

CONFIG LFORTRESS_CONQUERED_KILL_RATIO 0.0 # this fraction of the players of the owning team get killed

CONFIG LFORTRESS_SURVIVE_WIN 1            # if set to 1, the last team with an unconquered zone wins the round

CONFIG LFORTRESS_MAX_PER_TEAM 0           # if > 0, this is the maximal number of fortress zones ownable by a team. Closer zones are preferred. Use this to prune non-inhabited zones in multi-team maps.

CONFIG LSPAWN_POINT_GROUP_SIZE 0          # if > 2, this is interpreted as the number of spawn points in a spawn point group. AA then tries not to spawn one player alone in one spawn point group by redistributing them slightly.

CONFIG LFORTRESS_COLLAPSE_SPEED .5        # speed (units: 1/s) at which a collapsing fortress vanishes. The inverse of this value is the time between the conquest and the time the zone vanishes (and potentially kills its owners)

CONFIG LSETTING_LEGACY_BEHAVIOR_BREAKING     2  # For settings that absolutely break the client and make play impossible. Example of an affected setting: MAP_FILE

CONFIG LSETTING_LEGACY_BEHAVIOR_BUMPY        2  # For settings that allow play on old clients in principle, but with severe limitations (cycles bouncing around, player commands not executed on time). Example: CYCLE_DELAY_TIMEBASED

CONFIG LSETTING_LEGACY_BEHAVIOR_ANNOYING     0  # For settings that only cause minor annoyances on old clients, like enemy cycles stopping for .1 seconds after each turn. Example: CYCLE_RUBBER_MINDISTANCE

CONFIG LSETTING_LEGACY_BEHAVIOR_CHEATING     2  # For settings where the default behavior could be considered cheating if non-default was set. Example: DOUBLEBIND_TIME

CONFIG LSETTING_LEGACY_BEHAVIOR_VISUAL       0  # For settings that only affect status displays and visuals, not game physics. Example: CYCLE_RUBBER_* (the client displays the rubber meter, but it's not used for anything)

CONFIG LMAP_FILE_OVERRIDE    3

CONFIG LBROWSER_QUERY_FILTER         1     # query filter. Set to 0 to poll all servers, 1 to query servers with nonnegative score bias, 2 to query only those with positive bias and 3 to not query at all. Non-queried servers will appear to have ping 999; the player info comes indirectly from the master server.

CONFIG LBROWSER_QUERIES_SIMULTANEOUS 20    # max. number of simultaneous query messages that are sent

CONFIG LBROWSER_QUERY_DELAY_SINGLE   0.5   # time delay between queries of the same server

CONFIG LBROWSER_QUERY_DELAY_GLOBAL   0.025 # time delay between all queries

CONFIG LBROWSER_NUM_QUERIES          3     # number of queries per try

CONFIG LBROWSER_CONTACTLOSS          4     # number of failed contact attempts before a server can be considered lost

CONFIG LCULL_DELAY_END         3

CONFIG LCULL_DELAY_PER_SECOND  3

CONFIG LCULL_DELAY_MIN         10

CONFIG LCYCLE_MIN_WALLDROP_INTERVAL .05

CONFIG LTIMESTEP_MAX .2       # the maximal size of the small timesteps

