From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sat, 17 Oct 2026 17:23:26 +0300
Subject: debian: build with libdeflate

Build-Depends on libdeflate-dev and -DUSE_LIBDEFLATE=ON, for the engine's and the server's pk3 reads
(the previous commit); the binary packages get libdeflate0, which the PS3 image has already.

diff --git a/debian/control b/debian/control
--- a/debian/control
+++ b/debian/control
@@ -11,6 +11,7 @@ Build-Depends:
  dpkg-build-api (= 1),
  cmake,
  libcurl4-openssl-dev,
+ libdeflate-dev,
  libjpeg-dev,
  libopenal-dev,
  libopus-dev,
diff --git a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -36,6 +36,7 @@ OPTIONS = \
 	-DCMAKE_INSTALL_PREFIX=/usr/lib/ioquake3 \
 	-DPRODUCT_VERSION="$(DEB_VERSION)/$(DEB_VENDOR)" \
 	-DUSE_CODEC_VORBIS=ON \
+	-DUSE_LIBDEFLATE=ON \
 	-DUSE_FREETYPE=OFF \
 	-DUSE_HTTP=ON \
 	-DUSE_INTERNAL_LIBS=OFF \
