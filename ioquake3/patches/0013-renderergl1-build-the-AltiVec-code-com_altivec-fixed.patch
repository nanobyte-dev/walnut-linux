From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 17:07:08 +0300
Subject: renderergl1: build the AltiVec code (com_altivec), fixed for vec4
 normals

q_platform.h only knows the PowerPC compiler macros of the 2000s (powerpc, ppc, __ppc__), none of
which GCC defines on Linux today, so idppc_altivec was 0 and the renderer's AltiVec versions of
MD3 vertex interpolation, diffuse lighting and dynamic lights never made it into the binary
(no vector instruction in Debian's renderer_opengl1.so). Take __powerpc__ with __VEC__ for
idppc_altivec (idppc, with the PowerPC assembly of Q_rsqrt and friends, stays 0), build the
renderer with -maltivec on PowerPC, and keep the AltiVec path off CPUs without it.

Tested against the scalar functions in a qemu-ppc64 970fx (AltiVec, no VSX) harness with random
data, 200 rounds of up to 900 vertices:
- LerpMeshVertexes_altivec: same vertices and normals.
- RB_CalcDiffuseColor_altivec read the normals at the wrong offset (it steps by 12 bytes, the
  normals are vec4_t since 2006) and truncated where ri.ftol (lrintf) rounds: rewritten, now
  byte for byte the scalar colors. The scalar version converts every channel through ri.ftol,
  an indirect call into libm that stores and reloads the value.
- ProjectDlightTexture_altivec leaves the texture coordinates of back-facing vertices unset
  that triangles with other lit vertices still use: not dispatched to any more.
com_altivec 0 selects the scalar functions again.

diff --git a/cmake/renderer_gl1.cmake b/cmake/renderer_gl1.cmake
--- a/cmake/renderer_gl1.cmake
+++ b/cmake/renderer_gl1.cmake
@@ -51,6 +51,11 @@ if(USE_RENDERER_DLOPEN)
     target_compile_options(     ${RENDERER_GL1_BINARY} PRIVATE ${RENDERER_COMPILE_OPTIONS})
     target_link_options(        ${RENDERER_GL1_BINARY} PRIVATE ${RENDERER_LINK_OPTIONS})
 
+    # tr_altivec.c and the code that calls it (com_altivec) are only compiled with AltiVec on
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ppc|powerpc)")
+        target_compile_options(${RENDERER_GL1_BINARY} PRIVATE -maltivec)
+    endif()
+
     set_output_dirs(${RENDERER_GL1_BINARY})
 endif()
 
diff --git a/code/qcommon/q_platform.h b/code/qcommon/q_platform.h
--- a/code/qcommon/q_platform.h
+++ b/code/qcommon/q_platform.h
@@ -56,6 +56,14 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 #else
 #define idppc_altivec 0
 #endif
+#elif defined(__powerpc__) && defined(__VEC__) && !defined(C_ONLY)
+// GCC on Linux defines __powerpc__ and none of the names above, so idppc stays 0 (and with it
+// the PowerPC assembly versions of Q_rsqrt and friends), but the AltiVec renderer code, built
+// with -maltivec, doesn't depend on those.
+#define idppc 0
+#define idppc_altivec 1
+#define VECCONST_UINT8(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p) \
+	(vector unsigned char) {a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p}
 #else
 #define idppc 0
 #define idppc_altivec 0
