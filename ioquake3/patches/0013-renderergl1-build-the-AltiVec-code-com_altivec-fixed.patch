diff --git a/code/renderergl1/tr_init.c b/code/renderergl1/tr_init.c
--- a/code/renderergl1/tr_init.c
+++ b/code/renderergl1/tr_init.c
@@ -22,6 +22,9 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 // tr_init.c -- functions that are not called every frame
 
 #include "tr_local.h"
+#if idppc_altivec
+#include <sys/auxv.h>
+#endif
 
 glconfig_t  glConfig;
 qboolean    textureFilterAnisotropic = qfalse;
@@ -1014,6 +1017,12 @@ void R_Register( void )
 	#ifdef USE_RENDERER_DLOPEN
 	com_altivec = ri.Cvar_Get("com_altivec", "1", CVAR_ARCHIVE);
 	#endif	
+	#if idppc_altivec
+	// the engine only checks the CPU where idppc is set, which GCC on Linux doesn't do
+	if ( com_altivec->integer && !( getauxval( AT_HWCAP ) & 0x10000000 /* PPC_FEATURE_HAS_ALTIVEC */ ) ) {
+		ri.Cvar_Set( "com_altivec", "0" );
+	}
+	#endif
 
 	//
 	// latched and archived variables
diff --git a/code/renderergl1/tr_shade.c b/code/renderergl1/tr_shade.c
--- a/code/renderergl1/tr_shade.c
+++ b/code/renderergl1/tr_shade.c
@@ -557,13 +557,9 @@ static void ProjectDlightTexture_scalar( void ) {
 }
 
 static void ProjectDlightTexture( void ) {
-#if idppc_altivec
