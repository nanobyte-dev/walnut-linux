 } file_in_zip_read_info_s;
 
 
@@ -1233,6 +1243,90 @@ extern int ZEXPORT unzOpenCurrentFile2 (file,method,level,raw)
     return unzOpenCurrentFile3(file, method, level, raw, NULL);
 }
 
+#ifdef USE_LIBDEFLATE
+#define UNZ_FAST_MAX (16 << 20)		/* entries up to this size are inflated at once */
+#define UNZ_FAST_NOT_HANDLED (-1000)
+
+/*
+  Inflate a whole deflated entry with libdeflate on the first read from it: the compressed bytes
+  in one read, the output straight into the caller's buffer if that is as long as the entry,
+  else into a buffer the reads are served from. About 40% fewer instructions than zlib's
+  inflate on PowerPC. Returns UNZ_FAST_NOT_HANDLED where zlib has to do it (the stream and the
+  file position then are as they were, bar the position, which every zlib read sets itself).
+*/
+local int unzFastRead(unz_s *s, file_in_zip_read_info_s *info, voidp buf, unsigned len)
+{
+    unsigned char *comp, *out;
+    struct libdeflate_decompressor *dec;
+    enum libdeflate_result res;
+    size_t actual = 0, usize = info->rest_read_uncompressed;
+    uLong csize = info->rest_read_compressed;
+
+    if (info->whole)
+    {
+        uLong n = usize;
+        if (n > len)
+            n = len;
+        memcpy(buf, info->whole + info->whole_pos, n);
+        info->whole_pos += n;
+        info->rest_read_uncompressed -= n;
+        info->stream.total_out += n;
+        return (int)n;
+    }
+
+    if (info->fast || info->compression_method != Z_DEFLATED || info->raw || s->encrypted ||
+        info->stream.total_out != 0 || info->stream.avail_in != 0 ||
+        usize == 0 || usize > UNZ_FAST_MAX || csize == 0 || csize > UNZ_FAST_MAX)
+    {
+        info->fast = 1;
+        return UNZ_FAST_NOT_HANDLED;
+    }
+    info->fast = 1;			/* one try */
+
+    comp = (unsigned char *)malloc(csize);
+    if (!comp)
+        return UNZ_FAST_NOT_HANDLED;
+    if (ZSEEK(info->z_filefunc, info->filestream,
+              info->pos_in_zipfile + info->byte_before_the_zipfile,
+              ZLIB_FILEFUNC_SEEK_SET) != 0 ||
+        ZREAD(info->z_filefunc, info->filestream, comp, csize) != csize)
+    {
+        free(comp);
+        return UNZ_FAST_NOT_HANDLED;
+    }
+
+    if (len >= usize)
+        out = (unsigned char *)buf;
+    else
+        out = (unsigned char *)malloc(usize);
+    dec = out ? libdeflate_alloc_decompressor() : NULL;
+    res = dec ? libdeflate_deflate_decompress(dec, comp, csize, out, usize, &actual) : LIBDEFLATE_INSUFFICIENT_SPACE;
+    if (dec)
+        libdeflate_free_decompressor(dec);
+    free(comp);
+    if (res != LIBDEFLATE_SUCCESS || actual != usize)
+    {
+        if (out && out != buf)
+            free(out);
+        return UNZ_FAST_NOT_HANDLED;
+    }
+
+    if (info->check_crc)
+        info->crc32 = crc32(0, out, (uInt)usize);
+    info->pos_in_zipfile += csize;
+    info->rest_read_compressed = 0;
+    if (out == buf)
+    {
+        info->rest_read_uncompressed = 0;
+        info->stream.total_out = usize;
+        return (int)usize;
+    }
+    info->whole = out;
+    info->whole_pos = 0;
+    return unzFastRead(s, info, buf, len);
+}
+#endif
+
 /*
   Read bytes from the current file.
   buf contain buffer where data must be copied
@@ -1266,6 +1360,28 @@ extern int ZEXPORT unzReadCurrentFile  (file, buf, len)
     if (len==0)
         return 0;
 
+#ifdef USE_LIBDEFLATE
+    if (pfile_in_zip_read_info->whole || !pfile_in_zip_read_info->fast)
+    {
