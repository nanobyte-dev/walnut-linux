     pfile_in_zip_read_info->stream.next_out = (Bytef*)buf;
 
     pfile_in_zip_read_info->stream.avail_out = (uInt)len;
@@ -1534,6 +1650,10 @@ extern int ZEXPORT unzCloseCurrentFile (file)
