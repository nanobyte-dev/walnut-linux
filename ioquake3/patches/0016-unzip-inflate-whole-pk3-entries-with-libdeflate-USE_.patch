+        {
+            fs_zipFast = Cvar_Get("fs_zipFast", "1", 0);
+            Cvar_SetDescription(fs_zipFast, "1: inflate pk3 entries with libdeflate (faster), 0: with zlib, as upstream");
+        }
+        if (!fs_zipFast->integer && !pfile_in_zip_read_info->whole)
+            pfile_in_zip_read_info->fast = 1;
+        else
+        {
+            r = unzFastRead(s, pfile_in_zip_read_info, buf, len);
+            if (r != UNZ_FAST_NOT_HANDLED)
+                return r;
+        }
+    }
+#endif
