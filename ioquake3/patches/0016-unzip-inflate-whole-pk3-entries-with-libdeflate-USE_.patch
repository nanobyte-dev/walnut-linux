From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 17:23:19 +0300
Subject: unzip: inflate whole pk3 entries with libdeflate (USE_LIBDEFLATE,
 fs_zipFast)

On the first read from a deflated entry, read its compressed bytes at once and inflate them with
libdeflate, straight into the caller's buffer if that is as long as the entry (FS_ReadFile), else
into a buffer the following reads are served from (the WAV loader reads a header first). Anything
unusual (encrypted, over 16 MB, a libdeflate error) goes the zlib way as before. libdeflate needs
about 42% fewer instructions than zlib 1.3.2 on powerpc64 (qemu-ppc64 instruction counts over the 133
entries OpenArena's demo reads: all inflate to the same bytes, crc32 checked). Off by default in
cmake (USE_LIBDEFLATE), fs_zipFast 0 uses zlib at run time.

diff --git a/cmake/libraries/all.cmake b/cmake/libraries/all.cmake
--- a/cmake/libraries/all.cmake
+++ b/cmake/libraries/all.cmake
@@ -10,6 +10,7 @@ endforeach()
 include(libraries/curl)
 include(libraries/freetype)
 include(libraries/jpeg)
+include(libraries/libdeflate)
 include(libraries/ogg)
 include(libraries/opus)
 include(libraries/openal)
diff --git a/cmake/libraries/libdeflate.cmake b/cmake/libraries/libdeflate.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/libraries/libdeflate.cmake
@@ -0,0 +1,13 @@
+option(USE_LIBDEFLATE "Inflate the pk3 entries with libdeflate (faster than zlib)" OFF)
+
+if(USE_LIBDEFLATE)
+    find_path(LIBDEFLATE_INCLUDE_DIR libdeflate.h REQUIRED)
+    find_library(LIBDEFLATE_LIBRARY NAMES deflate libdeflate REQUIRED)
+
+    list(APPEND SERVER_LIBRARIES ${LIBDEFLATE_LIBRARY})
+    list(APPEND SERVER_INCLUDE_DIRS ${LIBDEFLATE_INCLUDE_DIR})
+    list(APPEND SERVER_DEFINITIONS USE_LIBDEFLATE)
+    list(APPEND CLIENT_LIBRARIES ${LIBDEFLATE_LIBRARY})
+    list(APPEND CLIENT_INCLUDE_DIRS ${LIBDEFLATE_INCLUDE_DIR})
+    list(APPEND CLIENT_DEFINITIONS USE_LIBDEFLATE)
+endif()
diff --git a/code/qcommon/unzip.c b/code/qcommon/unzip.c
--- a/code/qcommon/unzip.c
+++ b/code/qcommon/unzip.c
@@ -45,6 +45,11 @@ woven in by Terry Thorsen 1/2003.
 #include "../qcommon/qcommon.h"
 #include "unzip.h"
 
