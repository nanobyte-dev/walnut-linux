+cvar_t	*r_glStateCache;
 cvar_t	*r_uiFullScreen;
 cvar_t	*r_shadows;
 cvar_t	*r_flares;
@@ -838,6 +839,8 @@ const void *RB_TakeVideoFrameCmd( const void *data )
 */
 void GL_SetDefaultState( void )
 {
+	GLC_Reset();
+
 	qglClearDepth( 1.0f );
 
 	qglCullFace(GL_FRONT);
@@ -1061,6 +1064,8 @@ void R_Register( void )
 	r_simpleMipMaps = ri.Cvar_Get( "r_simpleMipMaps", "1", CVAR_ARCHIVE | CVAR_LATCH );
 	r_vertexLight = ri.Cvar_Get( "r_vertexLight", "0", CVAR_ARCHIVE | CVAR_LATCH );
 	r_mergeLightmaps = ri.Cvar_Get( "r_mergeLightmaps", "1", CVAR_LATCH );
+	r_glStateCache = ri.Cvar_Get( "r_glStateCache", "1", CVAR_LATCH );
+	ri.Cvar_SetDescription( r_glStateCache, "Send texture unit, texture enable and client array state to GL only when a draw needs it and it changed (0: every call as upstream)" );
 	ri.Cvar_SetDescription( r_mergeLightmaps, "Pack the map's lightmaps into a few atlas textures, so surfaces with the same texture and different lightmaps draw in one batch" );
 	r_uiFullScreen = ri.Cvar_Get( "r_uifullscreen", "0", 0);
 	r_subdivisions = ri.Cvar_Get ("r_subdivisions", "4", CVAR_ARCHIVE | CVAR_LATCH);
diff --git a/code/renderergl1/tr_local.h b/code/renderergl1/tr_local.h
--- a/code/renderergl1/tr_local.h
+++ b/code/renderergl1/tr_local.h
@@ -1058,7 +1058,8 @@ extern	cvar_t	*r_offsetUnits;
 extern	cvar_t	*r_fullbright;					// avoid lightmap pass
 extern	cvar_t	*r_lightmap;					// render lightmaps only
 extern	cvar_t	*r_vertexLight;
-extern	cvar_t	*r_mergeLightmaps;				// BSP lightmaps packed into a few atlas textures					// vertex lighting mode for better performance
+extern	cvar_t	*r_mergeLightmaps;				// BSP lightmaps packed into a few atlas textures
+extern	cvar_t	*r_glStateCache;				// deferred, filtered texture unit and array state					// vertex lighting mode for better performance
 extern	cvar_t	*r_uiFullScreen;				// ui is running fullscreen
 
 extern	cvar_t	*r_logFile;						// number of frames to emit GL logs
@@ -1629,6 +1630,40 @@ void RE_TakeVideoFrame( int width, int height,
 void R_DrawElements( int numIndexes, const glIndex_t *indexes );
 void VectorArrayNormalize( vec4_t *normals, unsigned int count );
 
+/*
+r_glStateCache (tr_backend.c): the texture unit selection, GL_TEXTURE_2D per unit, the client
+arrays and their pointers are only recorded where the code sets them, and sent to GL when a draw
+needs them, if they differ from what GL has; a call that depends on the active texture unit
+selects it first. Every renderergl1 file reaches GL through these names, so the deferred state
+is always applied before GL could see the difference.
+*/
+void GLC_Reset( void );
+void GLC_Flush( void );
+void GLC_ServerUnit( void );
+void GLC_Enable( GLenum cap );
+void GLC_Disable( GLenum cap );
+void GLC_EnableClientState( GLenum array );
+void GLC_DisableClientState( GLenum array );
+void GLC_VertexPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr );
+void GLC_ColorPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr );
+void GLC_TexCoordPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr );
+
+#define qglEnable( cap )					GLC_Enable( cap )
+#define qglDisable( cap )					GLC_Disable( cap )
+#define qglEnableClientState( a )			GLC_EnableClientState( a )
+#define qglDisableClientState( a )			GLC_DisableClientState( a )
+#define qglVertexPointer( n, t, s, p )		GLC_VertexPointer( n, t, s, p )
+#define qglColorPointer( n, t, s, p )		GLC_ColorPointer( n, t, s, p )
+#define qglTexCoordPointer( n, t, s, p )	GLC_TexCoordPointer( n, t, s, p )
+#define qglDrawElements( m, c, t, i )		( GLC_Flush(), qglDrawElements( m, c, t, i ) )
+#define qglBegin( m )						( GLC_Flush(), qglBegin( m ) )
+#define qglBindTexture( t, n )				( GLC_ServerUnit(), qglBindTexture( t, n ) )
+#define qglTexEnvf( t, p, v )				( GLC_ServerUnit(), qglTexEnvf( t, p, v ) )
+#define qglTexParameterf( t, p, v )			( GLC_ServerUnit(), qglTexParameterf( t, p, v ) )
+#define qglTexParameteri( t, p, v )			( GLC_ServerUnit(), qglTexParameteri( t, p, v ) )
+#define qglTexImage2D( t, l, f, w, h, b, e, y, p )	( GLC_ServerUnit(), qglTexImage2D( t, l, f, w, h, b, e, y, p ) )
+#define qglTexSubImage2D( t, l, x, y, w, h, f, e, p )	( GLC_ServerUnit(), qglTexSubImage2D( t, l, x, y, w, h, f, e, p ) )
+
 #ifdef idppc_altivec
 void LerpMeshVertexes_altivec( md3Surface_t *surf, float backlerp );
 void ProjectDlightTexture_altivec( void );
