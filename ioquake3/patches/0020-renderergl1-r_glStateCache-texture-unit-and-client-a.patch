From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 22:05:18 +0300
Subject: renderergl1: r_glStateCache, texture unit and client array state sent
 only when a draw needs it

RB_StageIteratorGeneric and DrawMultitextured set the same state around every batch and pass:
color and texture coordinate arrays disabled and enabled again, the same pointers into tess set
again, texture unit 1 enabled before and disabled after each multitextured draw, unit 0 and 1
selected twice (glActiveTexture and glClientActiveTexture). Mesa takes each call through its
dispatch, and a GL_TEXTURE_2D toggle invalidates the fixed function state it validates at the next
draw. With r_glStateCache 1 (latched) GL_SelectTexture only records the unit; glEnable and
glDisable of GL_TEXTURE_2D, the client array enables and the vertex, color and texture coordinate
pointers are recorded per unit (tr_local.h maps those qgl names to GLC_*), and GLC_Flush, which
glDrawElements and glBegin call first, sends what differs from what GL has. Calls that work on the
active unit (glBindTexture, glTexEnvf, glTexParameter, glTexImage2D, glTexSubImage2D) select it in
GL first. GL_SetDefaultState marks everything unknown. OpenArena's demo on llvmpipe (GL 2.1), with
r_mergeLightmaps: GL calls 1026 -> 482 a frame for the same 79 draws, the same pixels.
r_glStateCache 0 sends every call as before.

diff --git a/code/renderergl1/tr_backend.c b/code/renderergl1/tr_backend.c
--- a/code/renderergl1/tr_backend.c
+++ b/code/renderergl1/tr_backend.c
@@ -61,6 +61,186 @@ void GL_Bind( image_t *image ) {
 	}
 }
 
+/*
+** r_glStateCache (see tr_local.h)
+*/
+#define GLC_ARRAYS	4	// vertex, color, texture coordinates of units 0 and 1
+
+typedef struct {
+	GLint			size;	// 0: not set
+	GLenum			type;
+	GLsizei			stride;
+	const GLvoid	*ptr;
+} glcPointer_t;
+
+static struct {
+	qboolean		on;
+	int				serverUnit, clientUnit;		// in GL, -1: not known
+	int				tex2D[2], tex2DWant[2];		// GL_TEXTURE_2D per unit, in GL (-1: not known) and wanted
+	int				array[GLC_ARRAYS], arrayWant[GLC_ARRAYS];
+	glcPointer_t	ptr[GLC_ARRAYS], ptrWant[GLC_ARRAYS];
+} glc;
+
+// GL_SetDefaultState: nothing in GL is known, the wanted state is GL's default
+void GLC_Reset( void ) {
+	Com_Memset( &glc, 0, sizeof( glc ) );
+	glc.on = r_glStateCache->integer != 0;
+	glc.serverUnit = glc.clientUnit = -1;
+	glc.tex2D[0] = glc.tex2D[1] = -1;
+	glc.array[0] = glc.array[1] = glc.array[2] = glc.array[3] = -1;
+}
+
+static void GLC_SetServerUnit( int unit ) {
+	if ( glc.serverUnit != unit && qglActiveTextureARB ) {
+		qglActiveTextureARB( GL_TEXTURE0_ARB + unit );
+		glc.serverUnit = unit;
+	}
+}
+
+static void GLC_SetClientUnit( int unit ) {
+	if ( glc.clientUnit != unit && qglClientActiveTextureARB ) {
+		qglClientActiveTextureARB( GL_TEXTURE0_ARB + unit );
+		glc.clientUnit = unit;
+	}
+}
+
+// before a call that works on the active texture unit
+void GLC_ServerUnit( void ) {
+	if ( glc.on ) {
+		GLC_SetServerUnit( glState.currenttmu );
+	}
+}
+
+void GLC_Enable( GLenum cap ) {
+	if ( glc.on && cap == GL_TEXTURE_2D ) {
+		glc.tex2DWant[glState.currenttmu] = 1;
+		return;
+	}
+	(qglEnable)( cap );
+}
+
+void GLC_Disable( GLenum cap ) {
+	if ( glc.on && cap == GL_TEXTURE_2D ) {
+		glc.tex2DWant[glState.currenttmu] = 0;
+		return;
+	}
+	(qglDisable)( cap );
+}
+
+static int GLC_ArrayIndex( GLenum array ) {
+	switch ( array ) {
+	case GL_VERTEX_ARRAY:			return 0;
+	case GL_COLOR_ARRAY:			return 1;
+	case GL_TEXTURE_COORD_ARRAY:	return 2 + glState.currenttmu;
+	default:						return -1;
+	}
+}
+
+void GLC_EnableClientState( GLenum array ) {
+	int i = GLC_ArrayIndex( array );
+
+	if ( glc.on && i >= 0 ) {
+		glc.arrayWant[i] = 1;
+		return;
+	}
+	(qglEnableClientState)( array );
+}
+
+void GLC_DisableClientState( GLenum array ) {
+	int i = GLC_ArrayIndex( array );
+
+	if ( glc.on && i >= 0 ) {
+		glc.arrayWant[i] = 0;
+		return;
+	}
+	(qglDisableClientState)( array );
+}
+
+static void GLC_SetPointer( int i, GLint size, GLenum type, GLsizei stride, const GLvoid *ptr ) {
+	glcPointer_t *p = &glc.ptrWant[i];
+
+	p->size = size;
+	p->type = type;
+	p->stride = stride;
+	p->ptr = ptr;
+}
+
+void GLC_VertexPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr ) {
+	if ( glc.on ) {
+		GLC_SetPointer( 0, size, type, stride, ptr );
+		return;
+	}
+	(qglVertexPointer)( size, type, stride, ptr );
+}
+
+void GLC_ColorPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr ) {
+	if ( glc.on ) {
+		GLC_SetPointer( 1, size, type, stride, ptr );
+		return;
+	}
+	(qglColorPointer)( size, type, stride, ptr );
+}
+
+void GLC_TexCoordPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr ) {
+	if ( glc.on ) {
+		GLC_SetPointer( 2 + glState.currenttmu, size, type, stride, ptr );
+		return;
+	}
+	(qglTexCoordPointer)( size, type, stride, ptr );
+}
+
+// before a draw: what the code asked for since the last one, where GL has something else
+void GLC_Flush( void ) {
+	int i;
+
+	if ( !glc.on ) {
+		return;
+	}
+
+	for ( i = 0; i < 2; i++ ) {
+		if ( glc.tex2D[i] != glc.tex2DWant[i] ) {
+			GLC_SetServerUnit( i );
+			if ( glc.tex2DWant[i] ) {
+				(qglEnable)( GL_TEXTURE_2D );
+			} else {
+				(qglDisable)( GL_TEXTURE_2D );
+			}
+			glc.tex2D[i] = glc.tex2DWant[i];
+		}
+	}
+
+	for ( i = 0; i < GLC_ARRAYS; i++ ) {
+		glcPointer_t *want = &glc.ptrWant[i], *have = &glc.ptr[i];
+		qboolean setPointer = want->size && glc.arrayWant[i] &&
+			( want->ptr != have->ptr || want->size != have->size || want->type != have->type || want->stride != have->stride );
+
+		if ( glc.array[i] == glc.arrayWant[i] && !setPointer ) {
+			continue;
+		}
+		if ( i >= 2 ) {
+			GLC_SetClientUnit( i - 2 );
+		}
+		if ( setPointer ) {
+			switch ( i ) {
+			case 0:	(qglVertexPointer)( want->size, want->type, want->stride, want->ptr ); break;
+			case 1:	(qglColorPointer)( want->size, want->type, want->stride, want->ptr ); break;
+			default: (qglTexCoordPointer)( want->size, want->type, want->stride, want->ptr ); break;
+			}
+			*have = *want;
+		}
+		if ( glc.array[i] != glc.arrayWant[i] ) {
+			GLenum array = i == 0 ? GL_VERTEX_ARRAY : i == 1 ? GL_COLOR_ARRAY : GL_TEXTURE_COORD_ARRAY;
+
+			if ( glc.arrayWant[i] ) {
+				(qglEnableClientState)( array );
+			} else {
+				(qglDisableClientState)( array );
+			}
+			glc.array[i] = glc.arrayWant[i];
+		}
+	}
+}
+
 /*
 ** GL_SelectTexture
 */
@@ -71,6 +251,16 @@ void GL_SelectTexture( int unit )
 		return;
 	}
 
+	if ( glc.on )
+	{
+		// GLC_ServerUnit and GLC_Flush select it in GL when something needs it
+		if ( unit < 0 || unit > 1 ) {
+			ri.Error( ERR_DROP, "GL_SelectTexture: unit = %i", unit );
+		}
+		glState.currenttmu = unit;
+		return;
+	}
+
 	if ( unit == 0 )
 	{
 		qglActiveTextureARB( GL_TEXTURE0_ARB );
diff --git a/code/renderergl1/tr_init.c b/code/renderergl1/tr_init.c
--- a/code/renderergl1/tr_init.c
+++ b/code/renderergl1/tr_init.c
@@ -114,6 +114,7 @@ cvar_t	*r_drawBuffer;
