# Debugging
CONFIG_PPC_EARLY_DEBUG=y
CONFIG_PPC_EARLY_DEBUG_PS3GELIC=y
CONFIG_NETCONSOLE=y
CONFIG_CONFIGFS_FS=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
# GPU / research drivers (modules, loaded on demand)
CONFIG_FB_PS3=y
CONFIG_PS3_LV1CALL=m
CONFIG_PS3_PHYSMEM=m
CONFIG_PS3_DISP_MANAGER=m
CONFIG_PS3_VRAM=m
# Safety: nothing that writes flash or storage regions
# CONFIG_PS3_FLASH is not set
# CONFIG_PS3_FLASH_NG is not set
# CONFIG_PS3_NOR_FLASH is not set
# CONFIG_PS3_STRGMNGR is not set
# CONFIG_PS3_ENCDEC is not set
# CONFIG_SPUISO_FS is not set
# CONFIG_SPULDR_FS is not set
# Debian / systemd essentials
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_UNIX=y
CONFIG_SECCOMP=y
# Root on USB, ext4 built in
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# USB core and PS3 host controllers built in (needed for root on USB)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
# Reproducible version string (no git hash)
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION=""
