# Debugging
# Early debug over gelic hangs/never prints after kexec from Petitboot; Gentoo's working
# config doesn't use it either.
# CONFIG_PPC_EARLY_DEBUG is not set
CONFIG_NETCONSOLE=y
CONFIG_CONFIGFS_FS=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
# Dropped from the series on 2026-10-18 (docs/OTHEROS-PATCHES.md, "Decisions"): ps3sysmgr-char-device
# (no /dev/ps3sysmngr: raw SM packets, and the kernel stopped handling SM events while it was open),
# ps3rom-vendor-specific-command (raw BD drive commands), gelic-disable-eurus-ctrl-iface (wrote the
# hypervisor repository at every boot) and, with it, ps3jupiter and its module alias.
# Temperatures (docs/THERMAL.md): hwmon ps3_sm with the Cell BE and RSX temperatures SYSCON
# measures, read on demand from the System Manager (local/0040; get requests only, nothing sets
# the fan). ps3_sys_manager.hwmon=0 on the command line turns it off.
CONFIG_HWMON=y
CONFIG_PS3_SYS_MANAGER_HWMON=y
# GPU / research drivers (modules, loaded on demand)
CONFIG_FB_PS3=y
CONFIG_PS3_LV1CALL=m
CONFIG_PS3_PHYSMEM=m
# /dev/ps3dispmngr (patch 0080) stays off (decision 2026-10-18, docs/OTHEROS-PATCHES.md): the
# dispatcher manager carries the update manager (firmware update, EEPROM writes).
# CONFIG_PS3_DISP_MANAGER is not set
CONFIG_PS3_VRAM=m
# RSX driver (ps3rsx, out of tree, docs/DRIVER-PLAN.md): DRM core and KMS helpers as modules
CONFIG_DRM=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
# Memory: 1 MiB GPU pages need compaction after boot; zram and NFS swap (no swap on the
# PS3's HDD regions, which belong to GameOS)
CONFIG_COMPACTION=y
CONFIG_ZRAM=m
CONFIG_SWAP=y
CONFIG_NFS_SWAP=y
# Safety: nothing that writes flash or storage regions, and no writes to the hypervisor's
# repository (ps3_defconfig has it on; the kernel used it to record its highmem region at boot
# for later boot stages, which we don't have: Petitboot already records it before kexec)
# CONFIG_PS3_REPOSITORY_WRITE is not set
# CONFIG_PS3_FLASH is not set
# CONFIG_PS3_FLASH_NG is not set
# CONFIG_PS3_NOR_FLASH is not set
# CONFIG_PS3_STRGMNGR is not set
# CONFIG_PS3_ENCDEC is not set
# CONFIG_SPUISO_FS is not set
# CONFIG_SPULDR_FS is not set
# Debian / systemd essentials
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
# Game mode (docs/PLAN.md): cgroup v2 memory and CPU controllers, so ps3-game can keep the
# game and the display server resident (memory.low) and push the idle desktop out
# (cgroup.freeze, memory.reclaim). systemd delegates cpu, memory and pids to the user session.
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_UNIX=y
CONFIG_SECCOMP=y
# Root on USB, ext4 built in
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
# vfat codepages: dev_hdd1 mounts with iocharset=utf8 (ps3-gameos-mount), which needs NLS_UTF8;
# NLS_CODEPAGE_437 and NLS_ISO8859_1 are vfat's defaults (FAT_DEFAULT_CODEPAGE/IOCHARSET)
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# GameOS disk (docs/GAMEOS-HDD.md): dev_hdd0 is UFS2, dev_hdd1 vfat; read-only by construction,
# the UFS write support (experimental) is not built, so Linux can't write the GameOS partition
# Built in (not modules), with device-mapper below: the generic initramfs of the internal install
# (docs/release/ALPHA.md M1) then carries no kernel modules and works with every kernel release
CONFIG_UFS_FS=y
# CONFIG_UFS_FS_WRITE is not set
# CONFIG_UFS_DEBUG is not set
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# USB core and PS3 host controllers built in (needed for root on USB)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
# Reproducible version string (no git hash)
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION=""
# Petitboot's kexec-tools (2.0.2, 2011) predates big-endian ELFv2 kernels: build ELFv1
# (the default before 6.5). Turning it off needs EXPERT.
CONFIG_EXPERT=y
# CONFIG_PPC64_BIG_ENDIAN_ELF_ABI_V2 is not set
# Desktop input (docs/DESKTOP-PLAN.md): DualShock 3 (hid-sony needs the LED class), Bluetooth LE
# HID through bluez (uhid), uinput for input remappers
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_UHID=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
# Performance (docs/PERF.md): no lock/list debugging (lockdep alone held ~10 MB of RAM in static
# tables and checked every lock); perf events for profiling
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCKDEP is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_IRQFLAGS is not set
CONFIG_PERF_EVENTS=y

# Dynamic GART for ps3rsx (local/0007): a CMA area ps3rsx takes 1 MiB chunks from on demand
CONFIG_CMA=y
CONFIG_CMA_SYSFS=y
# device-mapper built in: the internal install's root and swap are dm-linear devices over the image file
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
