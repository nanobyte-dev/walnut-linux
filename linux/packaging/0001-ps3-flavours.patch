From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Fri, 16 Oct 2026 04:13:09 +0300
Subject: PS3 kernels only: the ps3 (release) and ps3-debug flavours on ppc64

debian/config/ppc64/defines.toml has only our two flavours (no installer udebs, no default
flavour), built with gcc-16 (the compiler of our deb builder and of the ppc64 chroot), image
vmlinux. Their configs are the full .config files tools/linux-config.sh writes at
source-package time (config.<flavour>, merged last).

Release names: a flavour's defs may set localversion, the release's suffix after the ABI name
in place of '-<flavour>' (gencontrol); the meta packages keep the flavour's name
(localversion_meta: linux-image-<flavour>, linux-headers-<flavour>). The release kernel (ps3)
has none, release 6.12.111+ps3.<N>; the debug kernel (ps3-debug) is 6.12.111+ps3.<N>-debug<stamp>,
the stamp (the date of the commit the version stands for) filled in by tools/deb-prepare.sh,
so every debug build installs next to the others.

Root defines.toml: a "ps3" suite (our changelog's distribution) whose ABI suffix +ps3.<N>
tools/deb-prepare.sh fills in, accepting +ps3.<N> and +ps3.<N>~dev<stamp> revisions; no
initramfs dependency (Petitboot boots /boot/vmlinux-<release> directly, root on USB or NFS)
and no AppArmor recommendation (not in our config); no linux-libc-dev, docs, source or
unversioned tools packages (those stay Debian's: our repository's pins would otherwise
replace them; linux-kbuild gets their rsync build dependency); the rt featureset
disabled.

Forwarded: not-needed
Last-Update: 2026-10-16

diff --git a/debian/bin/gencontrol.py b/debian/bin/gencontrol.py
--- a/debian/bin/gencontrol.py
+++ b/debian/bin/gencontrol.py
@@ -253,7 +253,7 @@ linux-signed-{vars['arch']} (@signedtemplate_sourceversion@) {dist}; urgency={ur
         vars: dict[str, str],
         makeflags: MakeFlags,
     ) -> None:
-        vars['flavour'] = vars['localversion'][1:]
+        vars['flavour'] = vars['localversion_meta'][1:]
         vars['class'] = config.description.hardware or ''
         vars['longclass'] = config.description.hardware_long or vars['class']
 
diff --git a/debian/config/defines.toml b/debian/config/defines.toml
--- a/debian/config/defines.toml
+++ b/debian/config/defines.toml
@@ -86,7 +86,8 @@ name = 'none'
 
 [[featureset]]
 name = 'rt'
-enable = true
+# PS3: no PREEMPT_RT kernels (and no linux-headers-*-common-rt)
+enable = false
   [featureset.description]
   parts = ['rt']
   [featureset.description.long]
@@ -119,6 +120,13 @@ name_regex = 'bookworm-backports'
 abi_suffix = '+deb12'
 revision_regex = '\d+(\.\d+)?(\+deb13u\d+)?~bpo12\+\d+'
 
+# PS3 builds (the ps3 project): version <debian revision>+ps3.<N>, or +ps3.<N>~dev<stamp> for
+# test builds; the ABI suffix (+ps3.<N>) is filled in by tools/deb-prepare.sh
+[[debianrelease]]
+name_regex = 'ps3'
+abi_suffix = '@PS3_ABI_SUFFIX@'
+revision_regex = '\d+(\.\d+)?(\+deb13u\d+)?\+ps3\.\d+(~dev\d+)?'
+
 # Use default rules for any suite with no explicit config
 [[debianrelease]]
 name_regex = '.*'
@@ -126,13 +134,16 @@ name_regex = '.*'
 [build]
 compiler = 'gcc-14'
 
+# PS3: only kernel packages (linux-libc-dev, linux-doc, linux-source and the tools stay Debian's)
+[packages]
+docs = false
+libc_dev = false
+source = false
+tools_unversioned = false
+
+# PS3: no initramfs (Petitboot boots /boot/vmlinux-<release> directly, root on USB or NFS) and
+# no AppArmor (not in the PS3 kernels' config)
 [relations.image]
-depends = [
-  'initramfs-tools (>= 0.120+deb8u2) | linux-initramfs-tool',
-]
-recommends = [
-  'apparmor',
-]
 breaks = [
   'fwupdate (<< 12-7)',
   'wireless-regdb (<< 2019.06.03-1~)',
diff --git a/debian/config/ppc64/defines.toml b/debian/config/ppc64/defines.toml
--- a/debian/config/ppc64/defines.toml
+++ b/debian/config/ppc64/defines.toml
@@ -1,37 +1,30 @@
+# PS3 kernels (the ps3 project's linux/packaging). Each flavour's config is the full .config
+# made by tools/linux-config.sh (debian/config/ppc64/config.<flavour>, merged last, so it decides
+# every option); debian/config/ppc64/args.<flavour> are its boot arguments.
+# Releases: <abiname> (6.12.111+ps3.<N>) for the release kernel, <abiname>-debug<stamp> for the
+# debug one (<stamp>: the date of the commit the version stands for, YYYYMMDDHHMM, filled in by
+# tools/deb-prepare.sh), so each debug build installs next to the others. The meta packages
+# follow the flavour names: linux-image-ps3, linux-image-ps3-debug.
 [[flavour]]
-name = 'powerpc64'
-[flavour.build]
-config = [
-  'kernelarch-powerpc/config-arch-64',
-  'kernelarch-powerpc/config-arch-64-be',
-]
+name = 'ps3'
 [flavour.defs]
-is_default = true
+localversion = ''
 [flavour.description]
-hardware = '64-bit PowerPC with 4k pages'
-[flavour.packages]
-installer = true
+hardware = 'PlayStation 3'
+hardware_long = 'the Sony PlayStation 3 under OtherOS++, built for memory (fewer debugging options)'
 
 [[flavour]]
-name = 'powerpc64-64k'
-[flavour.build]
-config = [
-  'kernelarch-powerpc/config-arch-64',
-  'kernelarch-powerpc/config-arch-64-be',
-  'kernelarch-powerpc/config-page-64k',
-]
+name = 'ps3-debug'
+[flavour.defs]
+localversion = '-debug@PS3_DEBUG_STAMP@'
 [flavour.description]
-hardware = '64-bit PowerPC with 64k pages'
+hardware = 'PlayStation 3 (debug)'
+hardware_long = 'the Sony PlayStation 3 under OtherOS++, with debugging options on'
 
 [[featureset]]
 name = 'none'
 
 [build]
+compiler = 'gcc-16'
 kernel_file = 'vmlinux'
 kernel_stem = 'vmlinux'
-
-[relations.image]
-suggests = [
-  'mkvmlinuz',
-  'grub-ieee1275',
-]
diff --git a/debian/lib/python/debian_linux/config_v2.py b/debian/lib/python/debian_linux/config_v2.py
--- a/debian/lib/python/debian_linux/config_v2.py
+++ b/debian/lib/python/debian_linux/config_v2.py
@@ -127,6 +127,9 @@ class ConfigDebianarchDefs:
 class ConfigFlavourDefs:
     is_default: bool = False
     is_quick: bool = False
+    # PS3: the release's suffix after the ABI name instead of '-<flavour>' ('' for none); the
+    # meta packages keep the flavour's name (linux-image-<flavour>)
+    localversion: Optional[str] = None
 
 
 @dataclasses.dataclass
diff --git a/debian/lib/python/debian_linux/gencontrol.py b/debian/lib/python/debian_linux/gencontrol.py
--- a/debian/lib/python/debian_linux/gencontrol.py
+++ b/debian/lib/python/debian_linux/gencontrol.py
@@ -601,7 +601,13 @@ class Gencontrol(object):
         vars: dict[str, str],
         makeflags: MakeFlags,
     ) -> None:
-        vars['localversion'] += '-' + config.name_flavour
+        # PS3: the meta packages are named after the flavour (localversion_meta), the release
+        # and its packages get the flavour's defs.localversion when it has one
+        vars['localversion_meta'] = vars['localversion'] + '-' + config.name_flavour
+        if config.defs_flavour.localversion is not None:
+            vars['localversion'] += config.defs_flavour.localversion
+        else:
+            vars['localversion'] = vars['localversion_meta']
 
         self.do_flavour_setup(config, vars, makeflags)
         self.do_flavour_makefile(config, vars, makeflags)
