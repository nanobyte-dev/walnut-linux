From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tibi <chibicitiberiu@zoho.eu>
Date: Fri, 16 Oct 2026 01:28:43 +0300
Subject: ps3fb: fix /dev/ps3gpu_fifo and _ctrl mmap offsets

The FIFO mapping passed a kernel virtual address where a physical address
is expected, so userspace got unrelated memory. The ctrl mapping subtracted
the page offset instead of adding it.

diff --git a/drivers/video/fbdev/ps3fb.c b/drivers/video/fbdev/ps3fb.c
--- a/drivers/video/fbdev/ps3fb.c
+++ b/drivers/video/fbdev/ps3fb.c
@@ -2018,11 +2018,11 @@ static int ps3fb_gpu_mmap(struct file *filp, struct vm_area_struct *vm)
 		case 1: io_flag = 0;
 			if( off >= GPU_FB_START) return -EINVAL;
 			psize = GPU_FB_START - off;
-			physical = ((unsigned long)ps3fb_videomemory.address) + off;
+			physical = __pa(ps3fb_videomemory.address) + off;
 			break;
 		case 2:	if(off >= ps3fb.ctrl_size) return -EINVAL;
 			psize = ps3fb.ctrl_size - off;
-			physical = ps3fb.ctrl_lpar - off;
+			physical = ps3fb.ctrl_lpar + off;
 			break;
 		case 3:	if( off >= ps3fb.dinfo_size) return -EINVAL;
 			psize = ps3fb.dinfo_size - off;
