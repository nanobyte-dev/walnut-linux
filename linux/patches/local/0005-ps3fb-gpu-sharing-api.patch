diff --git a/arch/powerpc/include/asm/ps3gpu.h b/arch/powerpc/include/asm/ps3gpu.h
--- a/arch/powerpc/include/asm/ps3gpu.h
+++ b/arch/powerpc/include/asm/ps3gpu.h
@@ -74,4 +74,40 @@ static inline int lv1_gpu_fb_close(u64 context_handle)
 					 0, 0, 0);
 }
 
+/*
+ * Sharing the RSX between ps3fb and an RSX driver (ps3rsx, out of tree). ps3fb owns the GPU
+ * memory handle and the display; the driver gets its own lv1 context on that memory handle
+ * and may take the GPU over (ps3fb then stops touching it until released).
+ */
+struct ps3fb_gpu_info {
+	u64 memory_handle;
+	u64 ddr_lpar;
+	u64 memory_size;	/* VRAM the GPU can address (from lv1 driver info) */
+	u64 reserved;		/* VRAM from offset 0 that ps3fb keeps, 1 MiB aligned */
+	u32 xres, yres;		/* current mode */
+	u32 line_length;	/* display pitch in VRAM */
+	u32 full_offset;	/* VRAM offset of frame 0 */
+};
+
+struct ps3fb_gpu_ctx {
+	u64 handle;
+	u64 ctrl_lpar;
+	u64 dinfo_lpar;
+	u64 reports_lpar;
+	u64 reports_size;
+};
+
+/* Called in hard IRQ context on a graphics exception: record and defer, nothing more */
+struct ps3fb_gpu_hook {
+	void (*exception)(void *data, u64 status, const void __iomem *exception_info);
+	void *data;
+};
+
+int ps3fb_gpu_get_info(struct ps3fb_gpu_info *info);
+int ps3fb_gpu_ctx_get(u64 flags, struct ps3fb_gpu_ctx *ctx);
+int ps3fb_gpu_iomap(u64 io, u64 lpar, u64 size, u64 flags);
+int ps3fb_gpu_takeover(bool own);
+void ps3fb_gpu_set_exception_hook(const struct ps3fb_gpu_hook *hook);
+unsigned int ps3fb_gpu_exception_seen(void);
+
 #endif /* _ASM_POWERPC_PS3GPU_H */
