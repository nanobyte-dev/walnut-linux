+/*
+ * GPU sharing with an RSX driver (see asm/ps3gpu.h). Lock order: gpu_own_lock, then
+ * console_lock, then ps3_gpu_mutex. fbcon takes the fb_info lock under console_lock, so the
+ * ioctls (which run under the fb_info lock) only ever trylock gpu_own_lock.
+ */
+static DEFINE_MUTEX(gpu_own_lock);
+static bool gpu_owned;			/* the RSX driver owns the GPU; ps3fb keeps off it */
+static DEFINE_MUTEX(gpu_ctx_lock);
+static struct ps3fb_gpu_ctx gpu_ctx;	/* the driver's context, allocated once, never freed */
+static u64 gpu_ctx_iomap[256];		/* lpar mapped at each 1 MiB IO page of gpu_ctx, or 0 */
+static const struct ps3fb_gpu_hook *gpu_hook;
+static unsigned int gpu_exceptions;	/* sticky: restore_state clears GPU_USER_DEBUG */
