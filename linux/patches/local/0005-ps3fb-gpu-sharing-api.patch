+/* --- GPU sharing API (asm/ps3gpu.h) ----------------------------------------------------- */
+
+int ps3fb_gpu_get_info(struct ps3fb_gpu_info *gi)
+{
+	struct fb_info *info = ps3fb.fbinfo;
+	struct ps3fb_par *par;
+
+	if (!info || !ps3fb.dinfo)
+		return -ENODEV;
+	par = info->par;
+	gi->memory_handle = ps3fb.memory_handle;
+	gi->ddr_lpar = ps3fb.ddr_lpar;
+	gi->memory_size = ps3fb.dinfo->memory_size;
+	/* ps3fb's DDR frames never exceed its XDR buffer (num_frames = smem_len / frame size),
+	 * plus one line for a centring offset */
+	gi->reserved = ALIGN(info->fix.smem_len + par->ddr_line_length, 1024 * 1024);
+	gi->xres = par->width;
+	gi->yres = par->height;
+	gi->line_length = par->ddr_line_length;
+	gi->full_offset = par->full_offset;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ps3fb_gpu_get_info);
+
+/* The driver's own context: allocated on first use, then kept until ps3fb shuts down, so
+ * module reloads never allocate or free lv1 contexts. The first caller's flags stick. */
+int ps3fb_gpu_ctx_get(u64 flags, struct ps3fb_gpu_ctx *ctx)
+{
+	int status = 0;
+
+	mutex_lock(&gpu_ctx_lock);
+	if (!gpu_ctx.handle) {
+		status = lv1_gpu_context_allocate(ps3fb.memory_handle, flags, &gpu_ctx.handle,
+						  &gpu_ctx.ctrl_lpar, &gpu_ctx.dinfo_lpar,
+						  &gpu_ctx.reports_lpar, &gpu_ctx.reports_size);
+		if (status) {
+			pr_err("%s: lv1_gpu_context_allocate failed: %d\n", __func__, status);
+			gpu_ctx.handle = 0;
+			status = -ENOSPC;
+		}
+	}
+	if (!status)
+		*ctx = gpu_ctx;
+	mutex_unlock(&gpu_ctx_lock);
+	return status;
+}
+EXPORT_SYMBOL_GPL(ps3fb_gpu_ctx_get);
+
+/* lv1_gpu_context_iomap on the driver's context, recorded so shutdown can undo it */
+int ps3fb_gpu_iomap(u64 io, u64 lpar, u64 size, u64 flags)
+{
+	bool map = flags & (CBE_IOPTE_PP_W | CBE_IOPTE_PP_R);
+	u64 off;
+	int status;
+
+	if (!IS_ALIGNED(io | size | lpar, 1024 * 1024) || !size ||
+	    io + size > ARRAY_SIZE(gpu_ctx_iomap) * 1024 * 1024)
+		return -EINVAL;
+	mutex_lock(&gpu_ctx_lock);
+	status = gpu_ctx.handle ? lv1_gpu_context_iomap(gpu_ctx.handle, io, lpar, size, flags) : -ENODEV;
+	if (!status)
+		for (off = 0; off < size; off += 1024 * 1024)
+			gpu_ctx_iomap[(io + off) >> 20] = map ? lpar + off : 0;
+	mutex_unlock(&gpu_ctx_lock);
+	return status > 0 ? -EIO : status;
+}
+EXPORT_SYMBOL_GPL(ps3fb_gpu_iomap);
+
+/* Undo the driver's iomaps and free its context (ps3fb shutdown, before freeing the memory) */
+static void ps3fb_gpu_ctx_free(void)
+{
+	unsigned int i;
+
+	mutex_lock(&gpu_ctx_lock);
+	if (gpu_ctx.handle) {
+		for (i = 0; i < ARRAY_SIZE(gpu_ctx_iomap); i++)
+			if (gpu_ctx_iomap[i])
+				lv1_gpu_context_iomap(gpu_ctx.handle, (u64)i << 20,
+						      gpu_ctx_iomap[i], 1024 * 1024, CBE_IOPTE_M);
+		lv1_gpu_context_free(gpu_ctx.handle);
+		memset(&gpu_ctx, 0, sizeof(gpu_ctx));
+		memset(gpu_ctx_iomap, 0, sizeof(gpu_ctx_iomap));
+	}
+	mutex_unlock(&gpu_ctx_lock);
+}
+
+/* SET_REFERENCE on ps3fb's own ring and wait for it: GET == PUT only means fetched. Called
+ * with ps3_gpu_mutex held, so no blit is being written into the ring meanwhile. */
+static int ps3fb_fifo_fence(void)
+{
+	static u32 cookie = 0xf0f00000;
+	struct gpu_fifo *fifo = &ps3fb.fifo;
+	volatile struct gpu_fifo_ctrl *ctrl = fifo->ctrl;
+	unsigned int timeout;
+	u32 *prev;
+
+	if (!ctrl)
+		return -ENODEV;
+	if ((fifo->len - ((fifo->curr - fifo->start) * sizeof(u32))) < 0x1000) {
+		*fifo->curr++ = 0x20000000 /* JMP */ | fifo->ioif;
+		wmb();
+		ctrl->put = fifo->ioif;
+		for (timeout = 100000; timeout && ctrl->put != ctrl->get; timeout--)
+			udelay(10);
+		if (ctrl->put != ctrl->get)
+			return -ETIMEDOUT;
+		fifo->curr = fifo->start;
+	}
+	prev = fifo->curr;
+	*fifo->curr++ = 0x00040050;	/* SET_REFERENCE */
+	*fifo->curr++ = ++cookie;
+	wmb();
+	ctrl->put += (fifo->curr - prev) * sizeof(u32);
+	for (timeout = 100000; timeout && ctrl->ref != cookie; timeout--)
+		udelay(10);
+	return ctrl->ref == cookie ? 0 : -ETIMEDOUT;
+}
+
+/*
+ * own = true: ps3fb stops touching the GPU (no console blits or flips, no direct-GPU ioctls,
+ * no mode changes or blanking) once its last command has executed. own = false: the caller
+ * has drained its own work; ps3fb re-runs its reset program and redraws the console.
+ */
+int ps3fb_gpu_takeover(bool own)
+{
+	int ret = 0;
+
+	mutex_lock(&gpu_own_lock);
+	if (own == gpu_owned)
+		goto out;
+	if (own && !ps3fb.task) {
+		ret = -EBUSY;		/* a direct-GPU user (PS3GPU_IOCTL_ENTER) holds the FIFO */
+		goto out;
+	}
+	console_lock();
+	mutex_lock(&ps3_gpu_mutex);
+	if (own) {
+		WRITE_ONCE(gpu_owned, true);
+		ret = ps3fb_fifo_fence();
+		if (ret) {
+			WRITE_ONCE(gpu_owned, false);
+			pr_err("%s: ps3fb's FIFO did not drain: %d\n", __func__, ret);
+		}
+		mutex_unlock(&ps3_gpu_mutex);
+	} else {
+		ret = ps3gpu_restore_state();
+		mutex_unlock(&ps3_gpu_mutex);
+		WRITE_ONCE(gpu_owned, false);
+		if (ps3fb.fbinfo)
+			ps3fb_sync(ps3fb.fbinfo, 0);
+	}
+	console_unlock();
+out:
+	mutex_unlock(&gpu_own_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ps3fb_gpu_takeover);
+
+void ps3fb_gpu_set_exception_hook(const struct ps3fb_gpu_hook *hook)
+{
+	WRITE_ONCE(gpu_hook, hook);
+	if (!hook && ps3fb.irq_no)
+		synchronize_irq(ps3fb.irq_no);
+}
+EXPORT_SYMBOL_GPL(ps3fb_gpu_set_exception_hook);
+
+unsigned int ps3fb_gpu_exception_seen(void)
+{
+	return READ_ONCE(gpu_exceptions);
+}
+EXPORT_SYMBOL_GPL(ps3fb_gpu_exception_seen);
+
