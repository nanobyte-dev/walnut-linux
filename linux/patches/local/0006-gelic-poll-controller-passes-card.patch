From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Fri, 16 Oct 2026 01:28:43 +0300
Subject: 0006-gelic-poll-controller-passes-card.patch

diff --git a/drivers/net/ethernet/toshiba/ps3_gelic_net.c b/drivers/net/ethernet/toshiba/ps3_gelic_net.c
--- a/drivers/net/ethernet/toshiba/ps3_gelic_net.c
+++ b/drivers/net/ethernet/toshiba/ps3_gelic_net.c
@@ -1169,7 +1169,8 @@ void gelic_net_poll_controller(struct net_device *netdev)
 	struct gelic_card *card = netdev_card(netdev);
 
 	gelic_card_set_irq_mask(card, 0);
-	gelic_card_interrupt(netdev->irq, netdev);
+	/* the handler's cookie is the card (see request_irq), not the net_device */
+	gelic_card_interrupt(netdev->irq, card);
 	gelic_card_set_irq_mask(card, card->irq_mask);
 }
 #endif /* CONFIG_NET_POLL_CONTROLLER */
