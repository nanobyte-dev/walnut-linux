 #include <linux/reboot.h>
 #include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/hwmon.h>
+#include <linux/completion.h>
+#include <linux/jiffies.h>
+#include <linux/moduleparam.h>
 
 #include <asm/firmware.h>
 #include <asm/lv1call.h>
@@ -31,7 +36,6 @@
  * Messages are comprised of a fixed field header followed by a message
  * specific payload.
  */
-
 /**
  * struct ps3_sys_manager_header - System manager message header.
  * @version: Header version, currently 1.
@@ -102,6 +106,8 @@ enum ps3_sys_manager_service_id {
 	PS3_SM_SERVICE_ID_SET_NEXT_OP = 5,
 	PS3_SM_SERVICE_ID_REQUEST_ERROR = 6,
 	PS3_SM_SERVICE_ID_SET_ATTR = 8,
+	PS3_SM_SERVICE_ID_TEMPERATURE = 13,
+	PS3_SM_SERVICE_ID_TEMPERATURE_REPLY = 14,
 };
 
 /**
@@ -230,6 +236,7 @@ static unsigned int ps3_sm_force_power_off;
 static int ps3_sys_manager_write(struct ps3_system_bus_device *dev,
 	const struct ps3_sys_manager_header *header, const void *payload)
 {
+	u8 buf[sizeof(struct ps3_sys_manager_header) + 16];
 	int result;
 
 	BUG_ON(header->version != 1);
@@ -237,11 +244,13 @@ static int ps3_sys_manager_write(struct ps3_system_bus_device *dev,
 	BUG_ON(header->payload_size != 8 && header->payload_size != 16);
 	BUG_ON(header->service_id > 8);
 
-	result = ps3_vuart_write(dev, header,
-		sizeof(struct ps3_sys_manager_header));
-
-	if (!result)
-		result = ps3_vuart_write(dev, payload, header->payload_size);
+	/*
+	 * One write, so no other message (a temperature request from another
+	 * thread) can land between the header and its payload.
+	 */
+	memcpy(buf, header, sizeof(*header));
+	memcpy(buf + sizeof(*header), payload, header->payload_size);
+	result = ps3_vuart_write(dev, buf, sizeof(*header) + header->payload_size);
 
 	return result;
 }
@@ -259,9 +268,14 @@ static int ps3_sys_manager_send_attr(struct ps3_system_bus_device *dev,
 		u8 version;
 		u8 reserved_1[3];
 		u32 attribute;
+		/*
+		 * payload_size has always been 16: the write sent 8 bytes of
+		 * stack after the attribute, now zeros.
+		 */
+		u8 reserved_2[8];
 	} payload;
 
-	BUILD_BUG_ON(sizeof(payload) != 8);
+	BUILD_BUG_ON(sizeof(payload) != 16);
 
 	dev_dbg(&dev->core, "%s:%d: %xh\n", __func__, __LINE__, attr);
 
@@ -395,6 +409,471 @@ static int ps3_sys_manager_send_response(struct ps3_system_bus_device *dev,
 	return ps3_sys_manager_write(dev, &header, &payload);
 }
 
+/*
+ * ps3_sys_manager_discard_payload - Consume a message payload not handled.
+ *
+ * The payload was usually queued already in the vuart's rx list, which
+ * ps3_vuart_clear_rx_bytes() doesn't drain, so read it out to keep the
+ * next header in step.
+ */
+
+static void ps3_sys_manager_discard_payload(struct ps3_system_bus_device *dev,
+	unsigned int payload_size)
+{
+	u8 buf[16];
+
+	if (payload_size <= sizeof(buf) && !ps3_vuart_read(dev, buf, payload_size))
+		return;
+
+	ps3_vuart_clear_rx_bytes(dev, payload_size);
+}
+
+#if IS_ENABLED(CONFIG_PS3_SYS_MANAGER_HWMON)
+
+/*
+ * Temperature sensors.
+ *
+ * Request: the header (service_id 13, payload_size 4, request_tag 0) and
+ *   u8 version (1), u8 tzone, u8 reserved[2].
+ * Reply: a header with an 8-byte payload
+ *   u8 version (1), u8 tzone, u8 status (0 = ok), u8 reserved,
+ *   u8 integer, u8 fraction (1/256 degree), u16 reserved.
+ * These are the bytes the get_temperature command of ps3vuart-tools
+ * (glevand, sguerrini97) sends and reads through /dev/ps3sysmngr under
+ * OtherOS++ (its request struct is padded to 20 bytes, so the payload is
+ * 4); GameOS's sys_game_get_temperature (lv2 syscall 383) uses the same
+ * service.  Thermal zones: 0 Cell BE, 1 RSX; others exist on some boards
+ * only (SYSCON's "tzone" list).  The reply's service id is not
+ * documented: 13 and 14 are accepted, and the one seen is logged once.
+ *
+ * Only this get request is ever sent.  One request is outstanding at a
+ * time, a value is cached for PS3_SM_TEMP_CACHE_MS, and the sensors give up
+ * for the boot after PS3_SM_TEMP_MAX_FAILS failed requests in a row or a
+ * REQUEST_ERROR reply, so a System Manager that refuses the service isn't
+ * asked again.  A zone the reply says is not there (status != 0) is
+ * switched off alone.  No request is sent once the system shuts down.
+ */
+
+enum {
+	PS3_SM_TEMP_MAX_ZONES = 8,
+	PS3_SM_TEMP_CACHE_MS = 1000,
+	PS3_SM_TEMP_TIMEOUT_MS = 1000,
+	PS3_SM_TEMP_MAX_FAILS = 3,
+};
+
+static bool hwmon_enable = true;
+module_param_named(hwmon, hwmon_enable, bool, 0444);
+MODULE_PARM_DESC(hwmon, "Temperature sensors (hwmon ps3_sm); 0 = off");
+
+static ushort temp_zones[PS3_SM_TEMP_MAX_ZONES] = { 0, 1 };
+static int temp_zones_count = 2;
+module_param_array(temp_zones, ushort, &temp_zones_count, 0444);
+MODULE_PARM_DESC(temp_zones, "SYSCON thermal zones to read (default 0,1: Cell BE, RSX)");
+
+struct ps3_sm_temp_reply {
+	u8 version;
+	u8 tzone;
+	u8 status;
+	u8 reserved_1;
+	u8 integer;
+	u8 fraction;
+	u16 reserved_2;
+};
+
+static struct ps3_sm_hwmon {
+	struct ps3_system_bus_device *dev;
+	struct mutex lock;		/* one request at a time, the cache */
+	spinlock_t reply_lock;		/* the fields below, from the vuart work */
+	struct completion done;
+	bool pending;
+	bool reply_error;
+	bool stopped;			/* power off or restart under way */
+	bool dead;			/* refused or never answers: give up */
+	bool sid_logged;
+	u8 pending_zone;
+	struct ps3_sm_temp_reply reply;
+	unsigned int fails;
+	unsigned int nzones;
+	u8 zone[PS3_SM_TEMP_MAX_ZONES];
+	long value[PS3_SM_TEMP_MAX_ZONES];	/* millidegrees Celsius */
+	unsigned long stamp[PS3_SM_TEMP_MAX_ZONES];
+	bool valid[PS3_SM_TEMP_MAX_ZONES];
+	bool absent[PS3_SM_TEMP_MAX_ZONES];	/* status != 0: not on this board */
+	unsigned long alarm;		/* bit per channel, from thermal events */
+	struct device *hwmon_dev;
+	u32 temp_config[PS3_SM_TEMP_MAX_ZONES + 1];
+	struct hwmon_channel_info temp_info;
+	const struct hwmon_channel_info *info[2];
+	struct hwmon_chip_info chip;
+} *ps3_sm_hwmon;
+
+static const char *ps3_sm_zone_name(u8 zone)
+{
+	switch (zone) {
+	case 0x00: return "Cell BE";
+	case 0x01: return "RSX";
+	case 0x02: return "XDR";
+	case 0x03: return "BE VR";
+	case 0x0a: return "Air intake";
+	case 0x0f: return "GbE";
+	case 0x14: return "Southbridge";
+	case 0x15: return "EE+GS";
+	default: return "SYSCON zone";
+	}
+}
+
+static int ps3_sm_temp_send(struct ps3_sm_hwmon *hw, u8 zone)
+{
+	struct {
+		struct ps3_sys_manager_header header;
+		u8 version;
+		u8 tzone;
+		u8 reserved[2];
+	} req;
+
+	BUILD_BUG_ON(sizeof(req) != 20);
+
+	memset(&req, 0, sizeof(req));
+	req.header.version = 1;
+	req.header.size = 16;
+	req.header.payload_size = 4;
+	req.header.service_id = PS3_SM_SERVICE_ID_TEMPERATURE;
+	req.header.request_tag = 0;
+	req.version = 1;
+	req.tzone = zone;
+
+	/* One write, so header and payload stay together in the tx queue. */
+	return ps3_vuart_write(hw->dev, &req, sizeof(req));
+}
+
+static int ps3_sm_temp_query(struct ps3_sm_hwmon *hw, int channel, long *val)
+{
+	struct ps3_sm_temp_reply reply;
+	unsigned long flags;
+	bool got, error;
+	int result;
+	u8 zone = hw->zone[channel];
+
+	if (hw->valid[channel] && time_before(jiffies, hw->stamp[channel] +
+		msecs_to_jiffies(PS3_SM_TEMP_CACHE_MS))) {
+		*val = hw->value[channel];
+		return 0;
+	}
+
+	if (hw->dead || hw->absent[channel])
+		return -ENODATA;
+
+	if (READ_ONCE(hw->stopped))
+		return -ESHUTDOWN;
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	hw->pending = true;
+	hw->reply_error = false;
+	hw->pending_zone = zone;
+	reinit_completion(&hw->done);
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+
+	result = ps3_sm_temp_send(hw, zone);
+
+	if (!result)
+		wait_for_completion_timeout(&hw->done,
+			msecs_to_jiffies(PS3_SM_TEMP_TIMEOUT_MS));
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	got = !hw->pending;
+	error = hw->reply_error;
+	hw->pending = false;
+	reply = hw->reply;
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+
+	if (got && !error && reply.status == 0) {
+		hw->fails = 0;
+		hw->value[channel] = reply.integer * 1000L +
+			DIV_ROUND_CLOSEST(reply.fraction * 1000, 256);
+		hw->stamp[channel] = jiffies;
+		hw->valid[channel] = true;
+		*val = hw->value[channel];
+		return 0;
+	}
+
+	if (got && error) {
+		dev_warn(&hw->dev->core,
+			"temperature: request refused (REQUEST_ERROR), sensors off\n");
+		hw->dead = true;
+		return -ENODATA;
+	}
+
+	if (got) {
+		/* The service works; this zone is not on the board. */
+		dev_info(&hw->dev->core,
+			"temperature: zone %u status %u, channel off\n",
+			zone, reply.status);
+		hw->fails = 0;
+		hw->absent[channel] = true;
+		return -ENODATA;
+	}
+
+	if (result) {
+		dev_dbg(&hw->dev->core, "temperature: write failed %d\n",
+			result);
+		result = -EIO;
+	} else {
+		result = -ETIMEDOUT;
+	}
+
+	if (++hw->fails >= PS3_SM_TEMP_MAX_FAILS) {
+		dev_warn(&hw->dev->core,
+			"temperature: %u failed requests (last %d), sensors off\n",
+			hw->fails, result);
+		hw->dead = true;
+	}
+
+	return result;
+}
+
+/* From the vuart work (or the final shutdown poll), header already read. */
+
+static int ps3_sm_temp_handle_reply(struct ps3_system_bus_device *dev,
+	const struct ps3_sys_manager_header *header)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+	struct ps3_sm_temp_reply reply;
+	unsigned long flags;
+	u8 buf[16];
+	int result;
+
+	/* ps3_sys_manager_handle_msg() checked 1 <= payload_size <= 16. */
+	result = ps3_vuart_read(dev, buf, header->payload_size);
+	if (result) {
+		ps3_vuart_clear_rx_bytes(dev, header->payload_size);
+		return result;
+	}
+
+	if (!hw || header->payload_size < sizeof(reply)) {
+		dev_dbg(&dev->core, "temperature reply: payload %u bytes\n",
+			header->payload_size);
+		return -EIO;
+	}
+
+	memcpy(&reply, buf, sizeof(reply));
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	if (hw->pending && reply.version == 1 &&
+		reply.tzone == hw->pending_zone) {
+		if (!hw->sid_logged) {
+			hw->sid_logged = true;
+			dev_info(&dev->core,
+				"temperature reply: service id %u, payload %u, tag %u\n",
+				header->service_id, header->payload_size,
+				header->request_tag);
+		}
+		hw->reply = reply;
+		hw->pending = false;
+		complete(&hw->done);
+	}
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+
+	/*
+	 * Non-zero: ps3_sys_manager_fin() polls until a message returns 0,
+	 * which must be the shutdown command, not this.
+	 */
+	return -EAGAIN;
+}
+
+static void ps3_sm_temp_request_error(void)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+	unsigned long flags;
+
+	if (!hw)
+		return;
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	if (hw->pending) {
+		hw->reply_error = true;
+		hw->pending = false;
+		complete(&hw->done);
+	}
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+}
+
+/*
+ * From the final power off / restart paths (also after a panic, with
+ * interrupts off): no locks.  A request already past the check may still
+ * go out; ps3_sm_temp_shutdown() at device shutdown is what waits for it.
+ */
+
+static void ps3_sm_temp_stop(void)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+
+	if (hw)
+		WRITE_ONCE(hw->stopped, true);
+}
+
+/*
+ * At device shutdown (power off, reboot, halt, kexec), in process context:
+ * every request holds hw->lock, so none is in flight once this returns.
+ */
+
+static void ps3_sm_temp_shutdown(void)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+
+	if (!hw)
+		return;
+
+	mutex_lock(&hw->lock);
+	WRITE_ONCE(hw->stopped, true);
+	mutex_unlock(&hw->lock);
+}
+
+static void ps3_sm_temp_alarm(u32 zone, bool on)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+	unsigned int i;
+
+	if (!hw)
+		return;
+
+	for (i = 0; i < hw->nzones; i++) {
+		if (hw->zone[i] != zone)
+			continue;
+		if (on)
+			set_bit(i, &hw->alarm);
+		else
+			clear_bit(i, &hw->alarm);
+		/* Not from the final shutdown poll: it may sleep. */
+		if (hw->hwmon_dev && !READ_ONCE(hw->stopped))
+			hwmon_notify_event(hw->hwmon_dev, hwmon_temp,
+				hwmon_temp_alarm, i);
+	}
+}
+
+static umode_t ps3_sm_hwmon_is_visible(const void *data,
+	enum hwmon_sensor_types type, u32 attr, int channel)
+{
+	return type == hwmon_temp ? 0444 : 0;
+}
+
+static int ps3_sm_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+	u32 attr, int channel, long *val)
+{
+	struct ps3_sm_hwmon *hw = dev_get_drvdata(dev);
+	int result;
+
+	if (type != hwmon_temp || channel >= hw->nzones)
+		return -EOPNOTSUPP;
+
+	switch (attr) {
+	case hwmon_temp_input:
+		mutex_lock(&hw->lock);
+		result = ps3_sm_temp_query(hw, channel, val);
+		mutex_unlock(&hw->lock);
+		return result;
+	case hwmon_temp_alarm:
+		*val = test_bit(channel, &hw->alarm);
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int ps3_sm_hwmon_read_string(struct device *dev,
+	enum hwmon_sensor_types type, u32 attr, int channel, const char **str)
+{
+	struct ps3_sm_hwmon *hw = dev_get_drvdata(dev);
+
+	if (type != hwmon_temp || attr != hwmon_temp_label ||
+		channel >= hw->nzones)
+		return -EOPNOTSUPP;
+
+	*str = ps3_sm_zone_name(hw->zone[channel]);
+	return 0;
+}
+
+static const struct hwmon_ops ps3_sm_hwmon_ops = {
+	.is_visible = ps3_sm_hwmon_is_visible,
+	.read = ps3_sm_hwmon_read,
+	.read_string = ps3_sm_hwmon_read_string,
+};
+
+static void ps3_sm_hwmon_register(struct ps3_system_bus_device *dev)
+{
+	struct ps3_sm_hwmon *hw;
+	struct device *hwmon_dev;
+	unsigned int i, n = 0;
+
+	if (!hwmon_enable)
+		return;
+
+	hw = devm_kzalloc(&dev->core, sizeof(*hw), GFP_KERNEL);
+	if (!hw)
+		return;
+
+	for (i = 0; i < temp_zones_count && i < PS3_SM_TEMP_MAX_ZONES; i++) {
+		if (temp_zones[i] > 0xff)
+			continue;
+		hw->zone[n] = temp_zones[i];
+		hw->temp_config[n] = HWMON_T_INPUT | HWMON_T_LABEL |
+			HWMON_T_ALARM;
+		n++;
+	}
+	if (!n)
+		return;
+
+	hw->dev = dev;
+	hw->nzones = n;
+	mutex_init(&hw->lock);
+	spin_lock_init(&hw->reply_lock);
+	init_completion(&hw->done);
+	hw->temp_info.type = hwmon_temp;
+	hw->temp_info.config = hw->temp_config;
+	hw->info[0] = &hw->temp_info;
+	hw->chip.ops = &ps3_sm_hwmon_ops;
+	hw->chip.info = hw->info;
+
+	/* Replies and events may come from now on. */
+	smp_store_release(&ps3_sm_hwmon, hw);
+
+	hwmon_dev = devm_hwmon_device_register_with_info(&dev->core, "ps3_sm",
+		hw, &hw->chip, NULL);
+	if (IS_ERR(hwmon_dev)) {
+		dev_warn(&dev->core, "hwmon registration failed %ld\n",
+			PTR_ERR(hwmon_dev));
+		WRITE_ONCE(ps3_sm_hwmon, NULL);
+		return;
+	}
+	hw->hwmon_dev = hwmon_dev;
+
+	dev_info(&dev->core, "hwmon: %u temperature zones, read on demand\n",
+		n);
+}
+
+/* Before devres frees it: no more replies or events reach it. */
+
+static void ps3_sm_hwmon_unregister(void)
+{
+	WRITE_ONCE(ps3_sm_hwmon, NULL);
+}
+
+#else
+
+static int ps3_sm_temp_handle_reply(struct ps3_system_bus_device *dev,
+	const struct ps3_sys_manager_header *header)
+{
