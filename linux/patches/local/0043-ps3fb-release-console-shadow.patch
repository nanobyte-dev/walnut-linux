 				StartStopTask(1);
@@ -2050,6 +2147,242 @@ static irqreturn_t ps3fb_vsync_interrupt(int irq, void *ptr)
 
 	return IRQ_HANDLED;
 }
+/* --- the console's XDR shadow (shadow_release) ------------------------------------------ */
+
+static int shadow_map(unsigned int i, u64 lpar, u64 flags)
+{
+	int status = lv1_gpu_context_iomap(ps3fb.context_handle, GPU_IOIF + (u64)i * SHADOW_CHUNK,
+					   lpar, SHADOW_CHUNK, flags);
+
+	if (status)
+		pr_err("ps3fb: iomap of IO page %u to %#llx failed: %d\n", i, lpar, status);
+	else
+		shadow.map_lpar[i] = lpar;
+	return status;
+}
+
+/* IO page i reads the first MiB, read only (writable it would expose the FIFO) */
+static int shadow_map_scratch(unsigned int i)
+{
+	return shadow_map(i, shadow.map_lpar[0], CBE_IOPTE_PP_R | CBE_IOPTE_M);
+}
+
+static void shadow_buf_free(struct shadow_buf *buf)
+{
+	unsigned int i;
+
+	if (buf->vaddr)
+		vunmap(buf->vaddr);
+	buf->vaddr = NULL;
+	for (i = 1; i < shadow.pages; i++) {
+		if (!buf->chunk[i])
+			continue;
+		if (IS_ENABLED(CONFIG_CMA) && buf->cma[i])
+			ps3rsx_cma_free(buf->chunk[i], 1);
+		else
+			__free_pages(buf->chunk[i], SHADOW_ORDER);
+		buf->chunk[i] = NULL;
+	}
+}
+
+/*
+ * Give the frame back to the page allocator. gpu_own_lock held, the RSX driver owns the GPU
+ * (ps3fb's FIFO has drained and issues nothing). Nothing happens while /dev/fbN is open.
+ */
+static void shadow_free(void)
+{
+	struct fb_info *info = ps3fb.fbinfo;
+	char __iomem *screen_base = info->screen_base;
+	unsigned long kib = (shadow.pages - 1) * (SHADOW_CHUNK >> 10);
+	unsigned int i, j;
+
+	console_lock();
+	mutex_lock(&shadow_lock);
+	if (shadow.users) {
+		mutex_unlock(&shadow_lock);
+		console_unlock();
+		return;			/* the last close tries again */
+	}
+	/* under shadow_lock: whoever opens /dev/fbN after this sees the suspended state
+	 * (fb_read/fb_write check it unlocked, then use screen_base) */
+	shadow.released = true;
+	fb_set_suspend(info, 1);	/* fbcon takes its cursor off first: still mapped */
+	info->screen_base = NULL;
+	mutex_unlock(&shadow_lock);
+	console_unlock();
+
+	shadow.changed = true;
+	for (i = 1; i < shadow.pages; i++) {
+		if (shadow_map_scratch(i)) {
+			/* lv1 refused: back to the frame, keep the memory */
+			for (j = 1; j < i; j++)
+				shadow_map(j, shadow.buf.chunk[j] ?
+					   ps3_mm_phys_to_lpar(page_to_phys(shadow.buf.chunk[j])) :
+					   shadow.map_lpar[0] + (u64)j * SHADOW_CHUNK,
+					   CBE_IOPTE_PP_W | CBE_IOPTE_PP_R | CBE_IOPTE_M);
+			console_lock();
+			mutex_lock(&shadow_lock);
+			info->screen_base = screen_base;
+			shadow.released = false;
+			mutex_unlock(&shadow_lock);
+			fb_set_suspend(info, 0);
+			console_unlock();
+			return;
+		}
+	}
+	if (shadow.buf.vaddr) {
+		shadow_buf_free(&shadow.buf);
+	} else if (shadow.boot_tail) {
+		void *start = ps3fb_videomemory.address + SHADOW_CHUNK;
+		unsigned long len = (shadow.pages - 1) * SHADOW_CHUNK;
+
+#ifdef CONFIG_ARCH_KEEP_MEMBLOCK
+		memblock_phys_free(__pa(start), len);	/* memblock and kmemleak forget it too */
+#endif
+		free_reserved_area(start, start + len, -1, NULL);
+		shadow.boot_tail = false;
+	}
+	pr_info("ps3fb: console shadow released while the GPU is taken (%lu KiB)\n", kib);
+}
+
+/*
+ * New frame memory: 1 MiB chunks from the page allocator (no hard reclaim), else from ps3rsx's
+ * CMA area (its GART has no other source, so it comes second), cleared, and one kernel mapping
+ * of the first MiB and the chunks for fbcon. No locks held: this may sleep for a while.
+ */
+static int shadow_alloc(struct shadow_buf *buf)
+{
+	unsigned int i, j, n = shadow.pages * (SHADOW_CHUNK >> PAGE_SHIFT);
+	struct page **pages;
+
+	for (i = 1; i < shadow.pages; i++) {
+		struct page *page = alloc_pages(GFP_KERNEL | __GFP_NOWARN | __GFP_NORETRY,
+						SHADOW_ORDER);
+
+		buf->cma[i] = false;
+		if (!page && IS_ENABLED(CONFIG_CMA)) {
+			page = ps3rsx_cma_alloc(1);
+			buf->cma[i] = true;
+		}
+		if (!page)
+			goto fail;
+		buf->chunk[i] = page;
+	}
+	pages = kvmalloc_array(n, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		goto fail;
+	for (j = 0; j < n; j++) {
+		unsigned int c = j / (SHADOW_CHUNK >> PAGE_SHIFT), k = j % (SHADOW_CHUNK >> PAGE_SHIFT);
+
+		pages[j] = c ? buf->chunk[c] + k :
+			virt_to_page(ps3fb_videomemory.address + ((unsigned long)k << PAGE_SHIFT));
+	}
+	buf->vaddr = vmap(pages, n, VM_MAP, PAGE_KERNEL);
+	kvfree(pages);
+	if (!buf->vaddr)
+		goto fail;
+	memset(buf->vaddr + GPU_FB_START, 0, (unsigned long)shadow.pages * SHADOW_CHUNK - GPU_FB_START);
+	return 0;
+
+fail:
+	shadow_buf_free(buf);
+	return -ENOMEM;
+}
+
+/* Map buf's chunks at their IO pages; gpu_own_lock held, released */
+static int shadow_map_buf(struct shadow_buf *buf)
+{
+	unsigned int i, j;
+
+	for (i = 1; i < shadow.pages; i++) {
+		if (shadow_map(i, ps3_mm_phys_to_lpar(page_to_phys(buf->chunk[i])),
+			       CBE_IOPTE_PP_W | CBE_IOPTE_PP_R | CBE_IOPTE_M)) {
+			for (j = 1; j < i; j++)
+				if (shadow_map_scratch(j))
+					buf->chunk[j] = NULL;	/* still mapped: leak it */
+			return -EIO;
+		}
+	}
+	return 0;
+}
+
+/* Release while the GPU is taken; take back when it isn't (or the switch went off) */
+static void shadow_work_fn(struct work_struct *work)
+{
+	struct shadow_buf buf = {};
+	struct fb_info *info = ps3fb.fbinfo;
+	bool want;
+
+	mutex_lock(&gpu_own_lock);
+	if (shadow.dead || !shadow.ready)
+		goto out;
+	if (gpu_owned && READ_ONCE(shadow_release) && !shadow.released) {
+		shadow_free();
+		goto out;
+	}
+	want = shadow.released && (!gpu_owned || !READ_ONCE(shadow_release));
+	mutex_unlock(&gpu_own_lock);
+	if (!want)
+		return;
+
+	if (shadow_alloc(&buf))
+		goto retry;
+	mutex_lock(&gpu_own_lock);
+	want = !shadow.dead && shadow.released && (!gpu_owned || !READ_ONCE(shadow_release));
+	if (!want) {
+		shadow_buf_free(&buf);		/* taken again meanwhile */
+		goto out;
+	}
+	if (shadow_map_buf(&buf)) {
+		shadow_buf_free(&buf);
+		mutex_unlock(&gpu_own_lock);
+		goto retry;
+	}
+	console_lock();
+	mutex_lock(&shadow_lock);
+	shadow.buf = buf;
+	info->screen_base = (char __force __iomem *)buf.vaddr + GPU_FB_START;
+	shadow.released = false;
+	mutex_unlock(&shadow_lock);
+	fb_set_suspend(info, 0);	/* fbcon redraws the visible console */
+	if (!gpu_owned)
+		ps3fb_sync(info, 0);
+	console_unlock();
+	shadow.retry = HZ;
+	pr_info("ps3fb: console shadow back\n");
+out:
+	mutex_unlock(&gpu_own_lock);
+	return;
+
+retry:
+	pr_warn_ratelimited("ps3fb: no memory for the console yet, next try in %lu s\n",
+			    shadow.retry / HZ);
+	mod_delayed_work(system_wq, &shadow_work, shadow.retry);
+	shadow.retry = min(shadow.retry * 2, (unsigned long)SHADOW_RETRY_MAX);
+}
+
+static int shadow_param_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	mutex_lock(&shadow_lock);
+	if (!ret && shadow.ready)
+		mod_delayed_work(system_wq, &shadow_work, 0);
+	mutex_unlock(&shadow_lock);
+	return ret;
+}
+
+static const struct kernel_param_ops shadow_param_ops = {
+	.set = shadow_param_set,
+	.get = param_get_bool,
+};
+module_param_cb(shadow_release, &shadow_param_ops, &shadow_release, 0644);
+MODULE_PARM_DESC(shadow_release,
+	"Free the console's XDR frame while the RSX driver owns the GPU (default: off)");
+module_param(shadow_release_delay_ms, uint, 0644);
+MODULE_PARM_DESC(shadow_release_delay_ms,
+	"How long the RSX driver must have owned the GPU before the frame goes (default: 3000)");
