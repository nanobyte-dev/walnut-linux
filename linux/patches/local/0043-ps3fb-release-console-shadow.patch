+/* The frame in chunks (after a shadow release): map it one IO page at a time */
+static int ps3fb_mmap_chunks(struct fb_info *info, struct vm_area_struct *vma)
+{
+	unsigned long len = vma->vm_end - vma->vm_start, addr = vma->vm_start, off, x, n, pfn;
+	int r;
+
+	/* remap_pfn_range covers a private (COW) mapping only whole */
+	if (!(vma->vm_flags & VM_SHARED) || vma->vm_pgoff >= info->fix.smem_len >> PAGE_SHIFT)
+		return -EINVAL;
+	off = vma->vm_pgoff << PAGE_SHIFT;
+	if (len > info->fix.smem_len - off)
+		return -EINVAL;
+	for (x = GPU_FB_START + off; len; x += n, addr += n, len -= n) {
+		unsigned int i = x / SHADOW_CHUNK;
+
+		n = min(len, (i + 1) * SHADOW_CHUNK - x);
+		if (i)
+			pfn = page_to_pfn(shadow.buf.chunk[i]) + ((x % SHADOW_CHUNK) >> PAGE_SHIFT);
+		else
+			pfn = virt_to_pfn(ps3fb_videomemory.address + x);
+		r = remap_pfn_range(vma, addr, pfn, n, vma->vm_page_prot);
+		if (r)
+			return r;
+	}
+	return 0;
+}
+
 static int ps3fb_mmap(struct fb_info *info, struct vm_area_struct *vma)
 {
 	int r;
 
-	r = vm_iomap_memory(vma, info->fix.smem_start, info->fix.smem_len);
+	mutex_lock(&shadow_lock);
+	if (shadow.released)
+		r = -EBUSY;	/* no frame while the RSX driver owns the GPU */
+	else if (shadow.buf.vaddr)
+		r = ps3fb_mmap_chunks(info, vma);
+	else
+		r = vm_iomap_memory(vma, info->fix.smem_start, info->fix.smem_len);
+	mutex_unlock(&shadow_lock);
 	dev_dbg(info->device, "ps3fb: mmap framebuffer P(%lx)->V(%lx)\n",
 		info->fix.smem_start + (vma->vm_pgoff << PAGE_SHIFT),
 		vma->vm_start);
@@ -1937,7 +2034,7 @@ static int ps3fb_ioctl(struct fb_info *info, unsigned int cmd, unsigned long arg
 				retval = -EBUSY;
