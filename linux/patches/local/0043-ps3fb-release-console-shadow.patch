+/*
+ * The console's XDR shadow (ps3fb.shadow_release=1, docs/KERNEL-MEMORY.md): while the RSX driver
+ * owns the GPU, nobody sees the console, so the frame part of ps3fb_videomemory is given back to
+ * the page allocator and taken again (in 1 MiB chunks, the GPU's IO page size) when ps3fb gets
+ * the GPU back. The first MiB (the FIFO, the reset program the RSX driver copies, and the first
+ * 512 KiB of the frame) stays: it is IO page 0 of ps3fb's context. While released, fbcon is
+ * suspended (FBINFO_STATE_SUSPENDED: no drawing, also not on panic), screen_base is NULL, the
+ * blits are off, mmap is refused, and the frame's IO pages read the first MiB instead, so a
+ * stray GPU fetch never faults. released, screen_base on release, users and ready change
+ * under shadow_lock, which nests inside everything else (open and mmap take it); the layout
+ * changes only under gpu_own_lock and while released. The memory is taken back by the work,
+ * not under the GPU handover's locks (CMA migration and reclaim may take seconds).
+ */
+#define SHADOW_CHUNK		SZ_1M
+#define SHADOW_ORDER		get_order(SHADOW_CHUNK)
+#define SHADOW_MAX_PAGES	(GPU_WONDOW_MAX / SHADOW_CHUNK)	/* IO pages, the first included */
+#define SHADOW_RETRY_MAX	(32 * HZ)
+
+static bool shadow_release;		/* the switch (default off until measured on the PS3) */
+static unsigned int shadow_release_delay_ms = 3000;
+static DEFINE_MUTEX(shadow_lock);
+
+/* the frame after the first release: 1 MiB chunks (chunk[0] unused: the first MiB stays) */
+struct shadow_buf {
+	struct page *chunk[SHADOW_MAX_PAGES];
+	bool cma[SHADOW_MAX_PAGES];
+	void *vaddr;			/* vmap of the first MiB and the chunks */
+};
+
+static struct {
+	bool ready;			/* probe done, not shut down: the work may be queued */
+	bool dead;			/* ps3fb shut down (under gpu_own_lock) */
+	bool released;			/* frame memory freed, fbcon suspended */
+	bool boot_tail;			/* the frame is still the boot memblock (linear map) */
+	bool changed;			/* the IO map differs from probe's single mapping */
+	unsigned int pages;		/* IO pages of ps3fb_videomemory, the first included */
+	unsigned int users;		/* opens of /dev/fbN (not fbcon's) */
+	unsigned long retry;		/* jiffies until the next try to take the frame back */
+	struct shadow_buf buf;		/* vaddr NULL: boot layout or released */
+	u64 map_lpar[SHADOW_MAX_PAGES];	/* what each IO page maps now */
+} shadow = { .retry = HZ };
+static void shadow_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(shadow_work, shadow_work_fn);
