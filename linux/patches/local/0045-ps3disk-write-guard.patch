diff --git a/drivers/block/ps3disk_guard.h b/drivers/block/ps3disk_guard.h
new file mode 100644
index 000000000..4397e2403
--- /dev/null
+++ b/drivers/block/ps3disk_guard.h
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * ps3disk write guard: the range logic.
+ *
+ * Kept free of kernel APIs (only u64, bool and errno values) so that a
+ * userspace test can compile this same file. Ranges are in 512-byte
+ * sectors of one region device, the units of blk_rq_pos() and of a
+ * dm-linear table's offsets.
+ */
+#ifndef _PS3DISK_GUARD_H
+#define _PS3DISK_GUARD_H
+
+enum ps3disk_guard_policy {
+	PS3DISK_GUARD_WRITABLE,		/* no checks */
+	PS3DISK_GUARD_READONLY,		/* every write refused */
+	PS3DISK_GUARD_WHITELIST,	/* writes only inside the sealed ranges */
+};
+
+/* [start, end), end > start */
+struct ps3disk_range {
+	u64 start;
+	u64 end;
+};
+
+#define PS3DISK_GUARD_MAX_RANGES	65536
+
+enum ps3disk_guard_verdict {
+	PS3DISK_GUARD_ALLOW,
+	PS3DISK_GUARD_CHECK_RANGES,	/* allowed if every bio is inside */
+	PS3DISK_GUARD_REFUSE_READONLY,
+	PS3DISK_GUARD_REFUSE_UNSEALED,
+};
+
+/*
+ * The decision before the ranges: harmless is a read or a flush without
+ * data; anything else (write, discard, write-zeroes, an unknown op) is a
+ * write as far as the guard goes, fail closed.
+ */
+static inline enum ps3disk_guard_verdict
+ps3disk_guard_decide(enum ps3disk_guard_policy policy, bool sealed,
+		     bool harmless)
+{
+	if (harmless || policy == PS3DISK_GUARD_WRITABLE)
+		return PS3DISK_GUARD_ALLOW;
+	if (policy != PS3DISK_GUARD_WHITELIST)
+		return PS3DISK_GUARD_REFUSE_READONLY;
+	if (!sealed)
+		return PS3DISK_GUARD_REFUSE_UNSEALED;
+	return PS3DISK_GUARD_CHECK_RANGES;
+}
+
+static inline int ps3disk_guard_parse_u64(const char **p, const char *e,
+					  u64 *v)
+{
+	const char *s = *p;
+	u64 x = 0;
+
+	if (s == e || *s < '0' || *s > '9')
+		return -EINVAL;
+	for (; s < e && *s >= '0' && *s <= '9'; s++) {
+		unsigned int d = *s - '0';
+
+		if (x > (~(u64)0 - d) / 10)
+			return -EINVAL;
+		x = x * 10 + d;
+	}
+	*p = s;
+	*v = x;
+	return 0;
+}
+
+static inline bool ps3disk_guard_blank(char c)
+{
+	return c == ' ' || c == '\t';
+}
+
+/*
+ * Parse len bytes at buf: lines of "start len" (decimal, separated by
+ * blanks, one pair per line, empty lines fine). The buffer must end with
+ * a newline: sysfs cuts a longer write at PAGE_SIZE without telling the
+ * driver, and a cut must never turn into a shorter range. Each range must
+ * be non-empty, inside [0, capacity) and aligned to align sectors. Up to room ranges go to out; *n is their number.
+ * Returns 0, -EINVAL for any malformed or out-of-range line, -ENOSPC for
+ * more than room ranges. On an error *n is unspecified and the caller
+ * must keep nothing of out.
+ */
+static inline int ps3disk_guard_parse(const char *buf, unsigned long len,
+				      u64 capacity, u64 align,
+				      struct ps3disk_range *out,
+				      unsigned int room, unsigned int *n)
+{
+	const char *p = buf, *e = buf + len;
+	unsigned int k = 0;
+
+	if (!align || (len && buf[len - 1] != '\n'))
+		return -EINVAL;
+	while (p < e) {
+		u64 start, sectors;
+		int err;
+
+		while (p < e && ps3disk_guard_blank(*p))
+			p++;
+		if (p < e && *p == '\n') {
+			p++;
+			continue;
+		}
+		if (p == e)
+			break;
+		err = ps3disk_guard_parse_u64(&p, e, &start);
+		if (err)
+			return err;
+		if (p == e || !ps3disk_guard_blank(*p))
+			return -EINVAL;
+		while (p < e && ps3disk_guard_blank(*p))
+			p++;
+		err = ps3disk_guard_parse_u64(&p, e, &sectors);
+		if (err)
+			return err;
+		while (p < e && ps3disk_guard_blank(*p))
+			p++;
+		if (p < e && *p != '\n')
+			return -EINVAL;
+		if (!sectors || start >= capacity || sectors > capacity - start)
+			return -EINVAL;
+		if (start % align || sectors % align)
+			return -EINVAL;
+		if (k == room)
+			return -ENOSPC;
+		out[k].start = start;
+		out[k].end = start + sectors;
+		k++;
+	}
+	*n = k;
+	return 0;
+}
+
+static inline bool ps3disk_guard_before(const struct ps3disk_range *a,
+					const struct ps3disk_range *b)
+{
+	return a->start < b->start || (a->start == b->start && a->end < b->end);
+}
+
+static inline void ps3disk_guard_sift(struct ps3disk_range *r, unsigned int i,
+				      unsigned int n)
+{
+	for (;;) {
+		unsigned int c = 2 * i + 1;
+		struct ps3disk_range t;
+
+		if (c >= n)
+			return;
+		if (c + 1 < n && ps3disk_guard_before(&r[c], &r[c + 1]))
+			c++;
+		if (!ps3disk_guard_before(&r[i], &r[c]))
+			return;
+		t = r[i];
+		r[i] = r[c];
+		r[c] = t;
+		i = c;
+	}
+}
+
+/*
+ * Sort r[0..n) by start (in place, heap sort: no recursion, no
+ * allocation) and merge ranges that overlap or touch. Returns the new
+ * number of ranges; *sectors gets the number of sectors they cover.
+ */
+static inline unsigned int ps3disk_guard_normalize(struct ps3disk_range *r,
+						   unsigned int n, u64 *sectors)
+{
+	unsigned int i, k;
+	u64 total = 0;
+
+	for (i = n / 2; i-- > 0;)
+		ps3disk_guard_sift(r, i, n);
+	for (i = n; i-- > 1;) {
+		struct ps3disk_range t = r[0];
+
+		r[0] = r[i];
+		r[i] = t;
+		ps3disk_guard_sift(r, 0, i);
+	}
+	k = 0;
+	for (i = 0; i < n; i++) {
+		if (k && r[i].start <= r[k - 1].end) {
+			if (r[i].end > r[k - 1].end)
+				r[k - 1].end = r[i].end;
+			continue;
+		}
+		r[k++] = r[i];
+	}
+	for (i = 0; i < k; i++)
+		total += r[i].end - r[i].start;
+	*sectors = total;
+	return k;
+}
+
+/*
+ * Whether [pos, pos + sectors) lies inside one range of r[0..n), which
+ * ps3disk_guard_normalize() made sorted and disjoint (so a run inside
+ * the union of the ranges is inside one of them). An empty or wrapping
+ * run is never inside.
+ */
+static inline bool ps3disk_guard_contains(const struct ps3disk_range *r,
+					  unsigned int n, u64 pos, u64 sectors)
+{
+	unsigned int lo = 0, hi = n;
+
+	if (!sectors || pos + sectors < pos)
+		return false;
+	/* the first range with start > pos */
+	while (lo < hi) {
+		unsigned int mid = lo + (hi - lo) / 2;
+
+		if (r[mid].start <= pos)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	if (!lo)
+		return false;
+	return pos < r[lo - 1].end && sectors <= r[lo - 1].end - pos;
+}
+
+#endif /* _PS3DISK_GUARD_H */
