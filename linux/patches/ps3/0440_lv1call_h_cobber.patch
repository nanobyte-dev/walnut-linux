From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psx-place PS3 patch set (author not recorded) <>
Date: Fri, 16 Oct 2026 01:28:43 +0300
Subject: 0440_lv1call_h_cobber.patch

Origin: the psx-place PS3 patch set by Sombat Tragoongoson, a fix added after glevand's
 OtherOS++ set; the original author is not recorded. Taken from https://github.com/damiandudycz/ps3 (files/kernel-patches/psx-place-Sombat-Tragoongoson/6.12).

diff --git a/arch/powerpc/include/asm/lv1call.h b/arch/powerpc/include/asm/lv1call.h
--- a/arch/powerpc/include/asm/lv1call.h
+++ b/arch/powerpc/include/asm/lv1call.h
@@ -14,6 +14,7 @@
 
 #include <linux/types.h>
 #include <linux/export.h>
+#include <asm/interrupt.h>
 
 /* lv1 call declaration macros */
 
@@ -210,7 +211,7 @@
 #define LV1_CALL(name, in, out, num)                               \
   extern s64 _lv1_##name(LV1_##in##_IN_##out##_OUT_ARG_DECL);      \
   static inline int lv1_##name(LV1_##in##_IN_##out##_OUT_ARG_DECL) \
-    {return _lv1_##name(LV1_##in##_IN_##out##_OUT_ARGS);}
+    {srr_regs_clobbered(); return _lv1_##name(LV1_##in##_IN_##out##_OUT_ARGS);}
 #endif
 
 #endif /* !defined(__ASSEMBLY__) */
