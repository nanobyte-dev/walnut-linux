@@ -1946,6 +1951,19 @@ inline void COpenGLExtensionHandler::extGlGenBuffers(GLsizei n, GLuint *buffers)
 
 inline void COpenGLExtensionHandler::extGlBindBuffer(GLenum target, GLuint buffer)
 {
+	// LU_GL_BIND: no bind of the buffer that is bound already
+	static const bool cache = luGlOpt("LU_GL_BIND");
+	if (cache) {
+		if (target == GL_ARRAY_BUFFER) {
+			if (BoundArrayBuffer == buffer)
+				return;
+			BoundArrayBuffer = buffer;
+		} else if (target == GL_ELEMENT_ARRAY_BUFFER) {
+			if (BoundElementBuffer == buffer)
+				return;
+			BoundElementBuffer = buffer;
+		}
+	}
 	if (pGlBindBufferARB)
 		pGlBindBufferARB(target, buffer);
 }
