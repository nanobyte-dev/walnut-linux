 			}
 
-			driver->setMaterial(material);
-			++material_swaps;
+			if (reuse_equal && have_last_material && material == last_material) {
+				// the driver has it set already
+			} else {
+				driver->setMaterial(material);
+				++material_swaps;
+				if (reuse_equal) {
+					last_material = material;
+					have_last_material = true;
+				}
+			}
 			if (auto *tex = material.getTexture(0); tex && tex->getType() == video::ETT_2D_ARRAY)
 				++array_texture_use;
 
