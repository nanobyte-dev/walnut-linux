+namespace {
+// LU_GL_SKY: quads of the same material drawn one after the other (the fog bands, the halos of the
+// sun and moon) go to the driver as one list, in the same order: the same pixels, a draw each less
+struct SkyQuads
+{
+	video::IVideoDriver *driver;
+	bool batch = luGlOpt("LU_GL_SKY");
+	std::vector<video::S3DVertex> vertices;
+	std::vector<u16> indices;
+
+	explicit SkyQuads(video::IVideoDriver *driver) : driver(driver) {}
+
+	void add(const video::S3DVertex *quad)
+	{
+		const u16 base = vertices.size();
+		vertices.insert(vertices.end(), quad, quad + 4);
+		for (u16 i : {0, 1, 2, 0, 2, 3})
+			indices.push_back(base + i);
+		if (!batch)
+			flush();
+	}
+
+	void flush()
+	{
+		if (vertices.empty())
+			return;
+		driver->drawIndexedTriangleList(vertices.data(), vertices.size(), indices.data(), indices.size() / 3);
+		vertices.clear();
+		indices.clear();
+	}
+};
+}
