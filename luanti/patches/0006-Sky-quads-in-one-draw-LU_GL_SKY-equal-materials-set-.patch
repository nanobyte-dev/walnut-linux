 	// Render all mesh buffers in order
 	drawcall_count += draw_order.size();
 
+	// LU_GL_MATREUSE: a buffer with the material of the one drawn before (the transparent
+	// pass is a buffer for each block and material) doesn't set it again
+	static const bool reuse_equal = luGlOpt("LU_GL_MATREUSE");
+	video::SMaterial last_material;
+	bool have_last_material = false;
+
 	for (auto &descriptor : draw_order) {
 		if (!descriptor.m_reuse_material) {
 			auto &material = descriptor.getMaterial();
@@ -1124,8 +1131,16 @@ void ClientMap::renderMap(video::IVideoDriver* driver, s32 pass)
