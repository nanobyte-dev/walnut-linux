@@ -51,10 +51,12 @@
 
 confflags_TEFLON = -Dteflon=false
 
-LLVM_ARCHS     = amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32
+LLVM_ARCHS     = amd64 arm64 armhf i386 loong64 powerpc ppc64el riscv64 s390x sparc64 x32
 RUSTICL_ARCHS  = amd64 arm64 armhf i386 loong64 ppc64el riscv64 x32
 NVK_ARCHS      = amd64 arm64 armhf i386 riscv64
-VALGRIND_ARCHS = amd64 arm64 armhf i386 powerpc ppc64 ppc64el riscv64 s390x
+VALGRIND_ARCHS = amd64 arm64 armhf i386 powerpc ppc64el riscv64 s390x
+# The PS3 (Cell PPE + RSX, an NV47): only the drivers it can use (see below)
+PS3_ARCHS      = ppc64
 
 # hurd doesn't do direct rendering
 ifeq ($(DEB_HOST_ARCH_OS), hurd)
@@ -171,6 +173,22 @@
   endif
 endif
 
+# PS3: nouveau for the RSX and softpipe as the reference renderer; no LLVM (llvmpipe, radeonsi,
+# zink and the Vulkan drivers can't drive the RSX and pulled ~200 MB of LLVM/z3 onto a 256 MB
+# machine), no VA/VDPAU/video codecs, no sensors; Cell compiler flags
+ifneq (,$(filter $(DEB_HOST_ARCH), $(PS3_ARCHS)))
+  GALLIUM_DEFAULTS =
+  GALLIUM_DRIVERS = softpipe nouveau
+  VULKAN_DEFAULTS =
+  VULKAN_DRIVERS =
+  VULKAN_LAYERS =
+  confflags_GALLIUM := -Dgallium-extra-hud=true -Dlmsensors=disabled -Dgallium-va=disabled \
+	-Dvideo-codecs= -Dllvm=disabled
+  confflags_VALGRIND := -Dvalgrind=disabled
+  DEB_CFLAGS_MAINT_APPEND += -mcpu=cell -mtune=cell
+  DEB_CXXFLAGS_MAINT_APPEND += -mcpu=cell -mtune=cell
+endif
+
 empty:=
 space := $(empty) $(empty)
 comma := ,
