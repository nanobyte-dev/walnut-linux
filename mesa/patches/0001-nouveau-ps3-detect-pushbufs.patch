Description: nouveau: detect the PS3 RSX, its DMA handles and smaller push buffers
 The PS3 RSX (NV47) is driven by the ps3rsx kernel driver: Sony PCI vendor id 0x104d and the
 PS3_ABI getparam identify it, and its VRAM/GART DMA objects are the hypervisor's. Its push
 buffers live in the small GART and the kernel copies each submission into its ring, so
 fewer and smaller ones do.
Author: PS3 Linux project
Forwarded: no
---
--- a/src/gallium/drivers/nouveau/nouveau_screen.c
+++ b/src/gallium/drivers/nouveau/nouveau_screen.c
@@ -322,6 +322,19 @@
    screen->device = dev;
    screen->initialized = false;
 
+   /* PS3 RSX: Sony's PCI vendor id, and the PS3_ABI getparam, which the kernel requires
+    * before it hands out a channel. The VRAM/GART DMA objects are the hypervisor's.
+    */
+   uint64_t vendor, ps3_abi;
+   screen->is_ps3 = dev->chipset == 0x47 &&
+                    !nouveau_getparam(dev, NOUVEAU_GETPARAM_PCI_VENDOR, &vendor) &&
+                    vendor == 0x104d &&
+                    !nouveau_getparam(dev, 0x1000 /* PS3_ABI */, &ps3_abi);
+   if (screen->is_ps3) {
+      nv04_data.vram = 0xfeed0000;
+      nv04_data.gart = 0xfeed0001;
+   }
+
    if (dev->chipset < 0xc0) {
       data = &nv04_data;
       size = sizeof(nv04_data);
@@ -404,8 +417,11 @@
    ret = nouveau_client_new(screen->device, &screen->client);
    if (ret)
       goto err;
+   /* PS3: pushbufs live in the small GART and ps3rsx copies each submission into its ring at
+    * once, so fewer and smaller ones do: the screen's only carries init and fences */
    ret = nouveau_pushbuf_create(screen, NULL, screen->client, screen->channel,
-                                4, 512 * 1024, &screen->pushbuf);
+                                screen->is_ps3 ? 2 : 4,
+                                screen->is_ps3 ? 64 * 1024 : 512 * 1024, &screen->pushbuf);
    if (ret)
       goto err;
 
@@ -515,7 +531,8 @@
       return ret;
 
    ret = nouveau_pushbuf_create(screen, context, context->client, screen->channel,
-                                4, 512 * 1024, &context->pushbuf);
+                                screen->is_ps3 ? 2 : 4,
+                                screen->is_ps3 ? 256 * 1024 : 512 * 1024, &context->pushbuf);
    if (ret)
       return ret;
 
--- a/src/gallium/drivers/nouveau/nouveau_screen.h
+++ b/src/gallium/drivers/nouveau/nouveau_screen.h
@@ -68,6 +68,7 @@
    bool has_svm;
    bool is_uma;
    bool disable_fences;
+   bool is_ps3; /* RSX behind the ps3rsx kernel driver: PS3 handles and offsets */
    void *svm_cutout;
    size_t svm_cutout_size;
 
