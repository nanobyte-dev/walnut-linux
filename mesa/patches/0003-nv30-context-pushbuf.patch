Description: nv30: push buffer robustness in the context
 Room for the fence kick_notify emits; a context that never queued anything gets push buffer
 space before the kick; nv30_context_destroy survives a failed init. Also the per-context
 count of texture upload staging in flight (used by the miptree upload limit).
Author: PS3 Linux project
Forwarded: no
---
--- a/src/gallium/drivers/nouveau/nv30/nv30_context.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_context.c
@@ -79,6 +79,10 @@
                         (struct nouveau_fence **)fence,
                         nv30->base.screen);
 
+   /* A context that never queued anything has no push buffer space yet; the kick's fence
+    * (kick_notify) would then be written through a NULL pointer. Get space first. */
+   if (!PUSH_SPACE(push, 16))
+      return;
    PUSH_KICK(push);
 
    nouveau_context_update_frame_stats(&nv30->base);
@@ -169,8 +173,11 @@
    nv30_framebuffer_init(pipe, NULL, nv30->fb_cbufs, &nv30->fb_zsbuf);
    util_unreference_framebuffer_state(&nv30->framebuffer);
 
-   nouveau_pushbuf_bufctx(nv30->base.pushbuf, NULL);
-   PUSH_KICK(nv30->base.pushbuf);
+   /* no pushbuf when nouveau_context_init failed (e.g. out of GART) */
+   if (nv30->base.pushbuf) {
+      nouveau_pushbuf_bufctx(nv30->base.pushbuf, NULL);
+      PUSH_KICK(nv30->base.pushbuf);
+   }
    nouveau_bufctx_del(&nv30->bufctx);
 
    if (nv30->screen->cur_ctx == nv30)
@@ -212,6 +219,7 @@
       return NULL;
    }
    nv30->base.pushbuf->kick_notify = nv30_context_kick_notify;
+   nv30->base.pushbuf->rsvd_kick = 16;	/* room for the fence kick_notify emits */
 
    nv30->base.pipe.stream_uploader = u_upload_create_default(&nv30->base.pipe);
    if (!nv30->base.pipe.stream_uploader) {
--- a/src/gallium/drivers/nouveau/nv30/nv30_context.h
+++ b/src/gallium/drivers/nouveau/nv30/nv30_context.h
@@ -59,6 +59,9 @@
 
    uint32_t dirty;
 
+   /* PS3: bytes of texture upload staging (GART) whose copies may still be pending */
+   unsigned staging_inflight;
+
    struct draw_context *draw;
    uint32_t draw_flags;
    uint32_t draw_dirty;
