From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Fri, 16 Oct 2026 02:48:56 +0300
Subject: nv30: the RSX fetches big-endian vertex and index buffers itself

Big-endian NV4x Macs pushed every vertex inline; the RSX fetches big-endian data natively
(ClassiCube 6.5 -> 79 fps at 1080p). No vertex type 0 (B8G8R8A8) on the RSX; inline data
with a single attribute draws nothing, so it is pushed twice.

Forwarded: no

diff --git a/src/gallium/drivers/nouveau/nv30/nv30_vbo.c b/src/gallium/drivers/nouveau/nv30/nv30_vbo.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_vbo.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_vbo.c
@@ -193,7 +193,11 @@ nv30_vbo_validate(struct nv30_context *nv30)
       return;
 
 #if UTIL_ARCH_BIG_ENDIAN
-   if (1) { /* Figure out where the buffers are getting messed up */
+   /* NV4x in big-endian Macs fetched vertex buffers wrongly, so they push every vertex inline.
+    * The RSX fetches big-endian vertex and index data natively (libgcm feeds it that way): on
+    * the PS3 the hardware fetches from the buffers, unless NV30_PS3_VBO_FIFO=1. */
+   if (!nv30->screen->base.is_ps3 || nv30->screen->ps3_vbo_fifo ||
+       unlikely(vertex->need_conversion)) {
 #else
    if (unlikely(vertex->need_conversion)) {
 #endif
@@ -262,7 +266,7 @@ nv30_vertex_state_create(struct pipe_context *pipe, unsigned num_elements,
     struct translate_key transkey;
     unsigned i;
 
-    so = CALLOC(1, sizeof(*so) + sizeof(*so->element) * num_elements);
+    so = CALLOC(1, sizeof(*so) + sizeof(*so->element) * MAX2(num_elements, 2));
     if (!so)
         return NULL;
     memcpy(so->pipe, elements, sizeof(*elements) * num_elements);
@@ -278,6 +282,11 @@ nv30_vertex_state_create(struct pipe_context *pipe, unsigned num_elements,
         enum pipe_format fmt = ve->src_format;
 
         so->element[i].state = nv30_vtxfmt(pipe->screen, fmt)->hw;
+        /* The RSX has no vertex type 0 (B8G8R8A8_UNORM): it raises a graph exception.
+         * Convert such attributes to float like unsupported ones. */
+        if (nv30_screen(pipe->screen)->base.is_ps3 &&
+            !(so->element[i].state & NV30_3D_VTXFMT_TYPE__MASK))
+            so->element[i].state = 0;
         if (!so->element[i].state) {
             switch (util_format_get_nr_components(fmt)) {
             case 1: fmt = PIPE_FORMAT_R32_FLOAT; break;
@@ -309,6 +318,20 @@ nv30_vertex_state_create(struct pipe_context *pipe, unsigned num_elements,
         so->strides[vbi] = ve->src_stride;
     }
 
+    /* The RSX draws nothing from inline vertex data with a single attribute (glamor's
+     * fills, any position-only draw): push the attribute twice, as attributes 0 and 1. The
+     * vertex program doesn't read attribute 1. */
+    if (nv30_screen(pipe->screen)->base.is_ps3 && num_elements == 1) {
+        unsigned j = transkey.nr_elements++;
+
+        so->pipe[1] = so->pipe[0];
+        so->element[1] = so->element[0];
+        transkey.element[j] = transkey.element[0];
+        transkey.element[j].output_offset = transkey.output_stride;
+        transkey.output_stride += transkey.output_stride;
+        so->num_elements = 2;
+    }
+
     so->translate = translate_create(&transkey);
     so->vtx_size = transkey.output_stride / 4;
     so->vtx_per_packet_max = NV04_PFIFO_MAX_PACKET_LEN / MAX2(so->vtx_size, 1);
