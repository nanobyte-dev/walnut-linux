diff --git a/src/mesa/main/texcompress_s3tc_speq.c b/src/mesa/main/texcompress_s3tc_speq.c
new file mode 100644
--- /dev/null
+++ b/src/mesa/main/texcompress_s3tc_speq.c
@@ -0,0 +1,40 @@
+/*
+ * PS3 (Cell): S3TC compression through libspeq, which runs it on the SPEs or with its own PPE
+ * encoder. Loaded at run time, so Mesa doesn't depend on it; without it (or on any error) the
+ * caller compresses with Mesa's encoder. All policy (image sizes, which unit, SPEQ_S3TC) lives in
+ * libspeq, so tuning it needs no Mesa rebuild.
+ */
+
+#include "util/detect_arch.h"
+
+#if DETECT_ARCH_PPC_64
+
+#include "c11/threads.h"
+#include "util/u_dl.h"
+#include "texcompress_s3tc.h"
+
+/* speq_s3tc_compress_v1(fmt, srccomps, src, w, h, dst, dst_stride): 0 or -errno */
+typedef int (*speq_s3tc_func)(unsigned, unsigned, const void *, unsigned, unsigned, void *,
+                              unsigned);
+
+static speq_s3tc_func speq_s3tc;
+static once_flag speq_once = ONCE_FLAG_INIT;
+
+static void
+speq_load(void)
+{
+   struct util_dl_library *lib = util_dl_open("libspeq.so.0");
+
+   if (lib)
+      speq_s3tc = (speq_s3tc_func)util_dl_get_proc_address(lib, "speq_s3tc_compress_v1");
+}
+
+bool
+_mesa_s3tc_speq(GLenum fmt, int srccomps, const GLubyte *src, int width, int height,
+                GLubyte *dst, int dst_stride)
+{
+   call_once(&speq_once, speq_load);
+   return speq_s3tc && speq_s3tc(fmt, srccomps, src, width, height, dst, dst_stride) == 0;
+}
+
+#endif
diff --git a/src/mesa/meson.build b/src/mesa/meson.build
