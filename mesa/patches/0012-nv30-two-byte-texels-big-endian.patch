From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sat, 17 Oct 2026 00:31:38 +0300
Subject: nv30: L8A8 and R8G8 texels in big-endian byte order

Gallium stores L8A8 and R8G8 as byte arrays (L or R first), and nv30 samples them as one
16-bit A8L8 texel. A big-endian host's GPU (the PS3's RSX) reads 16-bit texels as big-endian
halfwords, so the first byte is the high one there: luminance and alpha came out swapped on
every texel (GL_LUMINANCE_ALPHA fonts, Neverball). On big-endian the swizzle now takes L/R
from the high byte and A/G from the low one. Packed 565, 4444 and 1555 are host-order integers
and were already right; little-endian is unchanged.

Forwarded: no

diff --git a/src/gallium/drivers/nouveau/nv30/nv30_format.c b/src/gallium/drivers/nouveau/nv30/nv30_format.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_format.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_format.c
@@ -23,6 +23,8 @@
  *
  */
 
+#include "util/u_endian.h"
+
 #include "nv30/nv30-40_3d.xml.h"
 #include "nv30/nv30_context.h"
 #include "nv30/nv30_format.h"
@@ -189,6 +191,19 @@ nv30_vtxfmt_table[PIPE_FORMAT_COUNT] = {
 #define SWZ_SRC_3 0
 #define SWZ_SRC_x 0
 
+/* The two bytes of a 2x8-bit texel (L8A8, R8G8). Gallium stores these formats as byte arrays
+ * (byte 0 is L or R), but the GPU fetches the texel as one 16-bit A8L8 value: on little-endian
+ * hosts byte 0 is that value's low byte, while a big-endian host's GPU (the PS3's RSX) reads
+ * texels as big-endian halfwords, so byte 0 is the high one and the two would swap. Packed
+ * 16-bit formats (565, 4444, 1555) are host-order integers and come out right either way. */
+#if UTIL_ARCH_BIG_ENDIAN
+#define SWZ_SRC_b0 SWZ_SRC_3
+#define SWZ_SRC_b1 SWZ_SRC_0
+#else
+#define SWZ_SRC_b0 SWZ_SRC_0
+#define SWZ_SRC_b1 SWZ_SRC_3
+#endif
+
 #define NONE 0x00000000
 #define SRGB 0x00700000
 
@@ -238,10 +253,10 @@ nv30_texfmt_table[PIPE_FORMAT_COUNT] = {
    _(DXT3_SRGBA        , DXT3    , 0, C, C, C, C, 2, 1, 0, 3, SRGB, ____),
    _(DXT5_RGBA         , DXT5    , 0, C, C, C, C, 2, 1, 0, 3, NONE, ____),
    _(DXT5_SRGBA        , DXT5    , 0, C, C, C, C, 2, 1, 0, 3, SRGB, ____),
-   _(L8A8_UNORM        , A8L8    , 0, C, C, C, C, 0, 0, 0, 3, NONE, ____),
-   _(L8A8_SRGB         , A8L8    , 0, C, C, C, C, 0, 0, 0, 3, SRGB, ____),
-   _(R8G8_UNORM        , A8L8    , 0, C, C, 0, 1, 0, 3, x, x, NONE, ____),
-   _(R8G8_SNORM        , A8L8    , 0, C, C, 0, 1, 0, 3, x, x, NONE, SSSS),
+   _(L8A8_UNORM        , A8L8    , 0, C, C, C, C, b0, b0, b0, b1, NONE, ____),
+   _(L8A8_SRGB         , A8L8    , 0, C, C, C, C, b0, b0, b0, b1, SRGB, ____),
+   _(R8G8_UNORM        , A8L8    , 0, C, C, 0, 1, b0, b1, x, x, NONE, ____),
+   _(R8G8_SNORM        , A8L8    , 0, C, C, 0, 1, b0, b1, x, x, NONE, SSSS),
    _(Z16_UNORM         , Z16     , 0, C, C, C, 1, 3, 3, 3, x, NONE, ____),
    _(X8Z24_UNORM       , Z24     , 0, C, C, C, 1, 3, 3, 3, x, NONE, ____),
    _(S8_UINT_Z24_UNORM , Z24     , 0, C, C, C, 1, 3, 3, 3, x, NONE, ____),
