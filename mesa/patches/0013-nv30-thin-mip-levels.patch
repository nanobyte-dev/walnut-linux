From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 00:34:50 +0300
Subject: nv30: no swizzled render target 1 pixel wide in small mip levels

Mipmap generation renders every level (util_gen_mipmap, a u_blitter draw per level), and in a
power-of-two texture that isn't square the small levels are 1 pixel wide or high. A swizzled
render target 1 pixel wide (log2 width 0) raises graph exception 0x106 on the RSX, which ps3rsx
refuses: the whole push was lost (16x256: "swizzled render target 1 pixel wide", level 0's
upload with it). And small levels at offsets that aren't 64-byte aligned went through the
16x2 trick in nv30_validate_fb, which only hits the right texels for square levels (in 256x16
the 4x1 and 1x1 levels landed on the wrong ones).

On the PS3:
- a render target or depth texture with a level 1 pixel wide but taller (any width < height
  texture whose chain reaches width 1) stays linear, as 1-pixel-wide ones already did;
- a swizzled level 1 pixel high (1x1 included) is laid out as a plain row of texels, so it is
  rendered and cleared as a linear surface, with the offset's remainder below 64 bytes as the
  window x origin. nv30_surface records how a surface is rendered.

Covers every path that renders into a level: blits (mipmap generation, glCopyTexImage through
u_blitter), framebuffers (render to texture) and clear_render_target/clear_depth_stencil, which
now also set the window origin and clip themselves instead of keeping the last framebuffer's.
Linear surfaces and square swizzled levels taller than 1 pixel are unchanged.

Forwarded: no

diff --git a/src/gallium/drivers/nouveau/nv30/nv30_clear.c b/src/gallium/drivers/nouveau/nv30/nv30_clear.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_clear.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_clear.c
@@ -121,6 +121,27 @@ nv30_clear(struct pipe_context *pipe, unsigned buffers,
    nv30->state.scissor_off = 0;
 }
 
+/* The window origin and clip for clearing a surface on its own (what nv30_validate_fb sets for
+ * the framebuffer). PS3: a swizzled level 1 pixel high is cleared as a linear row
+ * (nv30_miptree_surface_new); the render target offset is 64-byte aligned, so the rest of a
+ * row's offset becomes the x origin, in pixels. Returns that origin (0 for other surfaces). */
+static unsigned
+nv30_clear_origin(struct nouveau_pushbuf *push, struct pipe_surface *ps)
+{
+   struct nv30_surface *sf = nv30_surface(ps);
+   unsigned x = 0;
+
+   if (!sf->swizzled && nv30_miptree(ps->texture)->swizzled)
+      x = (sf->offset & 63) / util_format_get_blocksize(ps->format);
+
+   BEGIN_NV04(push, NV30_3D(VIEWPORT_TX_ORIGIN), 4);
+   PUSH_DATA (push, x);
+   PUSH_DATA (push, 0);
+   PUSH_DATA (push, (x + sf->width - 1) << 16);
+   PUSH_DATA (push, (sf->height - 1) << 16);
+   return x;
+}
+
 static void
 nv30_clear_render_target(struct pipe_context *pipe, struct pipe_surface *ps,
                          const union pipe_color_union *color,
@@ -133,6 +154,7 @@ nv30_clear_render_target(struct pipe_context *pipe, struct pipe_surface *ps,
    struct nouveau_pushbuf *push = nv30->base.pushbuf;
    struct nouveau_object *eng3d = nv30->screen->eng3d;
    uint32_t rt_format;
+   unsigned origin;
 
    rt_format = nv30_format(pipe->screen, ps->format)->hw;
    if (util_format_get_blocksize(ps->format) == 4)
@@ -140,7 +162,7 @@ nv30_clear_render_target(struct pipe_context *pipe, struct pipe_surface *ps,
    else
       rt_format |= NV30_3D_RT_FORMAT_ZETA_Z16;
 
-   if (nv30_miptree(ps->texture)->swizzled) {
+   if (sf->swizzled) {
       rt_format |= NV30_3D_RT_FORMAT_TYPE_SWIZZLED;
       rt_format |= util_logbase2(sf->width) << 16;
       rt_format |= util_logbase2(sf->height) << 24;
@@ -152,10 +174,11 @@ nv30_clear_render_target(struct pipe_context *pipe, struct pipe_surface *ps,
        PUSH_REF1(push, mt->base.bo, NOUVEAU_BO_VRAM | NOUVEAU_BO_WR))
       return;
 
+   origin = nv30_clear_origin(push, ps);
    BEGIN_NV04(push, NV30_3D(RT_ENABLE), 1);
    PUSH_DATA (push, NV30_3D_RT_ENABLE_COLOR0);
    BEGIN_NV04(push, NV30_3D(RT_HORIZ), 3);
-   PUSH_DATA (push, sf->width << 16);
+   PUSH_DATA (push, (origin + sf->width) << 16);
    PUSH_DATA (push, sf->height << 16);
    PUSH_DATA (push, rt_format);
    BEGIN_NV04(push, NV30_3D(COLOR0_PITCH), 2);
@@ -191,6 +214,7 @@ nv30_clear_depth_stencil(struct pipe_context *pipe, struct pipe_surface *ps,
    struct nouveau_pushbuf *push = nv30->base.pushbuf;
    struct nouveau_object *eng3d = nv30->screen->eng3d;
    uint32_t rt_format, mode = 0;
+   unsigned origin;
 
    rt_format = nv30_format(pipe->screen, ps->format)->hw;
    if (util_format_get_blocksize(ps->format) == 4)
@@ -198,7 +222,7 @@ nv30_clear_depth_stencil(struct pipe_context *pipe, struct pipe_surface *ps,
    else
       rt_format |= NV30_3D_RT_FORMAT_COLOR_R5G6B5;
 
-   if (nv30_miptree(ps->texture)->swizzled) {
+   if (sf->swizzled) {
       rt_format |= NV30_3D_RT_FORMAT_TYPE_SWIZZLED;
       rt_format |= util_logbase2(sf->width) << 16;
       rt_format |= util_logbase2(sf->height) << 24;
@@ -215,10 +239,11 @@ nv30_clear_depth_stencil(struct pipe_context *pipe, struct pipe_surface *ps,
        PUSH_REF1(push, mt->base.bo, NOUVEAU_BO_VRAM | NOUVEAU_BO_WR))
       return;
 
+   origin = nv30_clear_origin(push, ps);
    BEGIN_NV04(push, NV30_3D(RT_ENABLE), 1);
    PUSH_DATA (push, 0);
    BEGIN_NV04(push, NV30_3D(RT_HORIZ), 3);
-   PUSH_DATA (push, sf->width << 16);
+   PUSH_DATA (push, (origin + sf->width) << 16);
    PUSH_DATA (push, sf->height << 16);
    PUSH_DATA (push, rt_format);
    if (eng3d->oclass < NV40_3D_CLASS) {
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_miptree.c b/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
@@ -469,11 +469,16 @@ nv30_miptree_create(struct pipe_screen *pscreen,
    blocksz = util_format_get_blocksize(pt->format);
 
    /* The RSX raises graph exception 0x106 rendering to a swizzled surface 1 pixel wide
-    * (log2 width 0; 2-wide and 1-high are fine): such render targets stay linear. */
+    * (log2 width 0; 2-wide and 1-high are fine): render targets 1 pixel wide stay linear,
+    * and so do those with a mip level 1 pixel wide but taller (16x256: levels 1x16 to 1x2,
+    * which mipmap generation renders). Levels 1 pixel high, 1x1 included, are drawn as
+    * linear rows instead (nv30_miptree_surface_new). */
    if ((pt->target == PIPE_TEXTURE_RECT) ||
        (pt->bind & PIPE_BIND_SCANOUT) ||
-       (nv30_screen(pscreen)->base.is_ps3 && (pt->bind & PIPE_BIND_RENDER_TARGET) &&
-        pt->width0 == 1) ||
+       (nv30_screen(pscreen)->base.is_ps3 &&
+        (pt->bind & (PIPE_BIND_RENDER_TARGET | PIPE_BIND_DEPTH_STENCIL)) &&
+        (pt->width0 == 1 ||
+         (pt->width0 < pt->height0 && u_minify(pt->width0, pt->last_level) == 1))) ||
        !util_is_power_of_two_or_zero(pt->width0) ||
        !util_is_power_of_two_or_zero(pt->height0) ||
        !util_is_power_of_two_or_zero(pt->depth0) ||
@@ -602,7 +607,18 @@ nv30_miptree_surface_new(struct pipe_context *pipe,
    ns->height = u_minify(pt->height0, ps->level);
    ns->depth = ps->last_layer - ps->first_layer + 1;
    ns->offset = layer_offset(pt, ps->level, ps->first_layer);
-   if (mt->swizzled)
+   ns->swizzled = mt->swizzled;
+   if (mt->swizzled && nv30_screen(pipe->screen)->base.is_ps3 && ns->height == 1 &&
+       pt->target != PIPE_TEXTURE_3D) {
+      /* A swizzled level 1 pixel high is laid out as a plain row of texels: render it as a
+       * linear surface. As a swizzled one, 1x1 (log2 width 0) raises graph exception 0x106
+       * on the RSX, and the 16x2 trick in nv30_validate_fb for small levels at offsets that
+       * aren't 64-byte aligned only hits the right texels for square levels (in 256x16 it
+       * misplaces the 4x1 and 1x1 levels). A row takes the offset's remainder as an x
+       * origin instead, with room for it in the pitch. */
+      ns->swizzled = false;
+      ns->pitch = align(ns->width * util_format_get_blocksize(pt->format) + 64, 64);
+   } else if (mt->swizzled)
       ns->pitch = 4096; /* random, just something the hw won't reject.. */
    else
       ns->pitch = lvl->pitch;
