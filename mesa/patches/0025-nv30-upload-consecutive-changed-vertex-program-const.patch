From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 13:12:43 +0300
Subject: nv30: upload consecutive changed vertex program constants in one
 burst

nv30_vertprog_validate sends every changed constant on its own: VP_UPLOAD_CONST_ID, the slot,
and its four words, six words per constant. Fixed-function GL changes several consecutive
constants per object (the modelview-projection matrix is four slots, the modelview matrix
used for lighting and fog four more), so a draw after a matrix change sent 24 to 48 words of
constants, a third of them headers and slot numbers.

The GPU moves to the next slot after every four words of a burst (libgcm uploads up to eight
constants per burst, PSL1GHT's rsxLoadVertexProgramParameterBlock; ps3rsx's shadow follows
the same rule), so a run of changed constants in consecutive slots now goes up as one burst
of the slot and 4n words, n at most four, the VP_UPLOAD_CONST window the method table
documents. Which constants are uploaded, and with what values, is unchanged.

Saves 2(n - 1) words per run of n changed constants: 6 for a matrix, in the push buffer and
in the kernel's copy and validation. Changes the command stream: the same constant writes,
with fewer method headers. Low risk; a hardware test would show misplaced or exploded
geometry, wrong lighting or fog.

NV30_VP_CONST_SINGLE=1 (read once, at screen creation) sends one constant per burst, as before.

Forwarded: no

diff --git a/src/gallium/drivers/nouveau/nv30/nv30_screen.c b/src/gallium/drivers/nouveau/nv30/nv30_screen.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_screen.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_screen.c
@@ -527,6 +527,7 @@ nv30_screen_create(struct nouveau_device *dev)
    screen->vtxfmt_always = debug_get_bool_option("NV30_VTXFMT_ALWAYS", false);
    screen->constbuf_alloc = debug_get_bool_option("NV30_CONSTBUF_ALLOC", false);
    screen->texunit_always = debug_get_bool_option("NV30_TEXUNIT_ALWAYS", false);
+   screen->vp_const_single = debug_get_bool_option("NV30_VP_CONST_SINGLE", false);
    if (!screen->ps3_vbo_fifo)
       screen->base.vidmem_bindings |= PIPE_BIND_VERTEX_BUFFER;
    screen->base.sysmem_bindings |= PIPE_BIND_VERTEX_BUFFER;
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_screen.h b/src/gallium/drivers/nouveau/nv30/nv30_screen.h
--- a/src/gallium/drivers/nouveau/nv30/nv30_screen.h
+++ b/src/gallium/drivers/nouveau/nv30/nv30_screen.h
@@ -32,6 +32,7 @@ struct nv30_screen {
    bool vtxfmt_always;         /* NV30_VTXFMT_ALWAYS: rewrite VTXFMT even when unchanged */
    bool constbuf_alloc;        /* NV30_CONSTBUF_ALLOC: a new user constant wrapper per update */
    bool texunit_always;        /* NV30_TEXUNIT_ALWAYS: rewrite every rebound texture unit */
+   bool vp_const_single;       /* NV30_VP_CONST_SINGLE: one constant per upload burst */
 
    struct nouveau_bo *notify;
 
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_vertprog.c b/src/gallium/drivers/nouveau/nv30/nv30_vertprog.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_vertprog.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_vertprog.c
@@ -174,24 +174,40 @@ nv30_vertprog_validate(struct nv30_context *nv30)
 
    if (vp->nr_consts) {
       struct nv04_resource *res = nv04_resource(nv30->vertprog.constbuf);
+      /* Changed constants in consecutive slots go up in one burst: the GPU moves to the next
+       * slot after every four words (libgcm writes up to eight per burst), up to the four
+       * VP_UPLOAD_CONST the method window has. A matrix is four such slots. */
+      const unsigned max_run = nv30->screen->vp_const_single ? 1 : NV30_3D_VP_UPLOAD_CONST__LEN;
+      unsigned run = 0;
 
-      for (i = 0; i < vp->nr_consts; i++) {
+      for (i = 0; i <= vp->nr_consts; i++) {
          struct nv30_vertprog_data *data = &vp->consts[i];
-
-         if (data->index < 0) {
-            if (!upload_data)
-               continue;
-         } else {
-            float *constbuf = (float *)res->data;
-            if (!upload_data &&
-                !memcmp(data->value, &constbuf[data->index * 4], 16))
-               continue;
-            memcpy(data->value, &constbuf[data->index * 4], 16);
+         bool upload = false;
+
+         if (i < vp->nr_consts) {
+            if (data->index < 0) {
+               upload = upload_data;
+            } else {
+               float *constbuf = (float *)res->data;
+               if (upload_data ||
+                   memcmp(data->value, &constbuf[data->index * 4], 16)) {
+                  memcpy(data->value, &constbuf[data->index * 4], 16);
+                  upload = true;
+               }
+            }
          }
 
-         BEGIN_NV04(push, NV30_3D(VP_UPLOAD_CONST_ID), 5);
-         PUSH_DATA (push, vp->data->start + i);
-         PUSH_DATAp(push, data->value, 4);
+         if (run && (!upload || run == max_run)) {
+            unsigned first = i - run;
+
+            BEGIN_NV04(push, NV30_3D(VP_UPLOAD_CONST_ID), 1 + 4 * run);
+            PUSH_DATA (push, vp->data->start + first);
+            for (unsigned j = first; j < i; j++)
+               PUSH_DATAp(push, vp->consts[j].value, 4);
+            run = 0;
+         }
+         if (upload)
+            run++;
       }
    }
 
