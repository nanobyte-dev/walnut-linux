diff --git a/src/gallium/drivers/nouveau/nv30/nv30_vbo.c b/src/gallium/drivers/nouveau/nv30/nv30_vbo.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_vbo.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_vbo.c
@@ -577,6 +577,40 @@ nv30_draw_elements(struct nv30_context *nv30, bool shorten,
    }
 }
 
+/* PS3, NV30_PS3_KICK_AUTO: submit what this context queued when that buys CPU/GPU overlap,
+ * at the start of a draw (no primitive open). Two conditions, both cheap (no ioctl):
+ *  - enough work queued since the last submission: at least NV30_PS3_KICK_MIN_BYTES and a
+ *    1/NV30_PS3_KICK_SPLIT share of the last frame's words, so a frame is cut into at most
+ *    about that many parts however many draws it has (many tiny draws don't mean many
+ *    submissions);
+ *  - the GPU has finished everything submitted so far (the fence notifier has caught up with
+ *    the last fence emitted, a plain memory read): while it is still busy, a submission adds
+ *    no overlap, only its cost.
+ */
+static inline void
+nv30_ps3_kick_auto(struct nv30_context *nv30, struct nouveau_pushbuf *push)
+{
+   struct nouveau_screen *screen = &nv30->screen->base;
+
+   /* (a mark outside the current push buffer: it switched buffers; start over) */
+   if (!nv30->kick_mark || push->cur < nv30->kick_mark ||
+       push->cur - nv30->kick_mark > (1 << 20)) {
+      nv30->kick_mark = push->cur;
+      return;
+   }
+
+   unsigned queued = push->cur - nv30->kick_mark;
+   if (queued < nv30->screen->ps3_kick_min_words ||
+       queued < nv30->frame_words_last / nv30->screen->ps3_kick_split)
+      return;
+
+   if ((int32_t)(screen->fence.sequence - screen->fence.update(&screen->base)) > 0)
+      return;
+
+   if (PUSH_SPACE(push, 16))
+      PUSH_KICK(push);
+}
+
 static void
 nv30_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
               unsigned drawid_offset,
@@ -598,11 +632,14 @@ nv30_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
    /* PS3, NV30_PS3_KICK_DRAWS=N: hand the GPU what is queued every N draws, so it starts on
     * a frame while the CPU still builds it. No primitive is open here, and all state stays
     * (bound buffers are referenced again in the next submission). */
-   if (unlikely(nv30->screen->ps3_kick_draws) &&
-       ++nv30->draws_since_kick >= nv30->screen->ps3_kick_draws) {
-      if (PUSH_SPACE(push, 16))
-         PUSH_KICK(push);
-      nv30->draws_since_kick = 0;
+   if (unlikely(nv30->screen->ps3_kick_draws)) {
+      if (++nv30->draws_since_kick >= nv30->screen->ps3_kick_draws) {
+         if (PUSH_SPACE(push, 16))
+            PUSH_KICK(push);
+         nv30->draws_since_kick = 0;
+      }
+   } else if (nv30->screen->ps3_kick_auto) {
+      nv30_ps3_kick_auto(nv30, push);
    }
 
    if (!info->primitive_restart &&
