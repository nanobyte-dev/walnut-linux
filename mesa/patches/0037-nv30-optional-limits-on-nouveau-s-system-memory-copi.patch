    caps->generate_mipmap = false;
    caps->string_marker = false;
    caps->buffer_sampler_view_rgba_only = false;
@@ -560,6 +560,21 @@ nv30_screen_create(struct nouveau_device *dev)
    screen->ps3_kick_min_words =
       MAX2(debug_get_num_option("NV30_PS3_KICK_MIN_BYTES", 16384), 1024) / 4;
    screen->ps3_kick_split = MAX2(debug_get_num_option("NV30_PS3_KICK_SPLIT", 4), 1);
+   /* NV30_SYSMEM_COPY: when the CPU read VRAM buffers in four flushes in a row (u_vbuf
+    * converting vertex formats the RSX can't fetch), nouveau gives every VRAM buffer created
+    * from then on a system memory copy of its whole contents, for good (hint_buf_keep_sysmem_copy).
+    * 1 (default): so; 0: never, a buffer gets its copy when the CPU first reads it;
+    * 2: only new PIPE_USAGE_DYNAMIC (GL_DYNAMIC_DRAW) buffers get one, the static ones when read.
+    */
+   switch (debug_get_num_option("NV30_SYSMEM_COPY", 1)) {
+   case 0: screen->base.hint_buf_mode = NOUVEAU_HINT_BUF_NEVER; break;
+   case 2: screen->base.hint_buf_mode = NOUVEAU_HINT_BUF_DYNAMIC; break;
+   default: screen->base.hint_buf_mode = NOUVEAU_HINT_BUF_ALL; break;
+   }
+   screen->sysmem_stats = MAX2(debug_get_num_option("NV30_SYSMEM_STATS", 0), 0);
+   /* NV30_INVALIDATE_BUFFER=1: glBufferData(NULL) of the same size (orphaning) invalidates the
+    * buffer in place, keeping its system memory copy, instead of creating a new one */
+   screen->invalidate_buffer = debug_get_bool_option("NV30_INVALIDATE_BUFFER", false);
    if (!screen->ps3_vbo_fifo)
       screen->base.vidmem_bindings |= PIPE_BIND_VERTEX_BUFFER;
    screen->base.sysmem_bindings |= PIPE_BIND_VERTEX_BUFFER;
