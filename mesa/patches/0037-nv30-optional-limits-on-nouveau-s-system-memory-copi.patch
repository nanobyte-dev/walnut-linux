 }
 
+/* NV30_INVALIDATE_BUFFER (nv30_screen.c) */
+static void
+nv30_invalidate_resource(struct pipe_context *pipe, struct pipe_resource *res)
+{
+   if (res->target == PIPE_BUFFER)
+      nouveau_buffer_invalidate(pipe, res);
+}
+
 void
 nv30_resource_init(struct pipe_context *pipe)
 {
+   if (nv30_screen(pipe->screen)->invalidate_buffer)
+      pipe->invalidate_resource = nv30_invalidate_resource;
    pipe->buffer_map = nouveau_buffer_transfer_map;
    pipe->texture_map = nv30_miptree_transfer_map;
    pipe->transfer_flush_region = nouveau_buffer_transfer_flush_region;
