+/* NV30_VTX_SNORM8: the component count of a signed normalized 8-bit format, else 0 */
+static inline unsigned
+nv30_snorm8_components(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_R8_SNORM:       return 1;
+   case PIPE_FORMAT_R8G8_SNORM:     return 2;
+   case PIPE_FORMAT_R8G8B8_SNORM:   return 3;
+   case PIPE_FORMAT_R8G8B8A8_SNORM: return 4;
+   default:                         return 0;
+   }
+}
+
