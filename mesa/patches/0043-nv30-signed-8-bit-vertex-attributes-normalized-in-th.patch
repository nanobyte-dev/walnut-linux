diff --git a/src/gallium/drivers/nouveau/nv30/nv30_vtx_snorm8.h b/src/gallium/drivers/nouveau/nv30/nv30_vtx_snorm8.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/nouveau/nv30/nv30_vtx_snorm8.h
@@ -0,0 +1,105 @@
+/*
+ * NV30_VTX_SNORM8: signed normalized 8-bit vertex attributes (GL_BYTE with normalized set:
+ * Sauerbraten's normals and tangents, QuakeSpasm's model normals) fetched by the GPU as plain
+ * unsigned bytes and normalized in the vertex program, instead of u_vbuf converting them to
+ * floats on the CPU at every draw. The RSX (and NV3x/NV4x) has no signed 8-bit vertex type;
+ * U8_USCALED (libgcm's UB256) gives each byte as a float 0..255, and four instructions at the
+ * start of the program turn that into what util_format's unpack gives:
+ *
+ *    s = SGE(v, 128)            1 where the byte is negative as int8
+ *    t = MAD(s, -256, v)        the int8 value, exact
+ *    t = MUL(t, 1/127)          as util_format: (float)(c * (1.0f/0x7f))
+ *    t = MAX(t, -1)             as util_format: MAX2(-1.0f, ...)
+ *
+ * The GPU always fetches four bytes (NV30_SNORM8_FETCH_SIZE): the RSX raises graph exception
+ * 0x106 for U8_USCALED with 1 to 3 components (Sauerbraten's R8G8B8_SNORM normals wedged it,
+ * 2026-10-19; RPCS3 takes UB256 as size 4 only, nouveau's table has it only as
+ * R8G8B8A8_USCALED). For a format with fewer components a fifth instruction sets the ones it
+ * lacks to what a fetch of the format gives:
+ *
+ *    t.<missing> = MOV((0, 0, 0, 1))
+ *
+ * so the bytes past the attribute (the next attribute's, or padding) never reach the program.
+ * Reading them needs room in the vertex (nv30_snorm8_fetch_fits); without it (a tightly packed
+ * 1 to 3 byte attribute at the end of its vertex) nv30 converts the attribute to float itself,
+ * as for formats the GPU can't fetch, and pushes those vertices inline.
+ *
+ * Which attributes get the prologue is a key of 3 bits per vertex program input (its
+ * component count, 0: none), from the vertex elements and kept to the inputs the program
+ * declares. A program is translated again when its key changes (as for clip planes).
+ *
+ * No Mesa types here: mesa/tests/vtx-snorm8-test.c in the PS3 tree runs these on the host,
+ * and vtx-snorm8-vpsim.c runs the translated programs on an NV40 vertex program interpreter.
+ */
+#ifndef NV30_VTX_SNORM8_H
+#define NV30_VTX_SNORM8_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NV30_SNORM8_MAX_ATTRIBS 16
+
+/* the component count of every SNORM8 fetch (U8_USCALED x4, libgcm's UB256 size 4) */
+#define NV30_SNORM8_FETCH_SIZE 4
+
+/* Can an attribute of nc bytes at src_offset in vertices of src_stride bytes be fetched as four
+ * bytes without reading past its vertex? A constant attribute (stride 0) is never fetched. */
+static inline bool
+nv30_snorm8_fetch_fits(unsigned nc, unsigned src_offset, unsigned src_stride)
+{
+   if (nc == NV30_SNORM8_FETCH_SIZE || !src_stride)
+      return true;
+   return src_offset % src_stride + NV30_SNORM8_FETCH_SIZE <= src_stride;
+}
+
+/* vertex program instructions the prologue adds for an input of nc components (0: none) */
+static inline unsigned
+nv30_snorm8_prologue_insns(unsigned nc)
+{
+   return !nc ? 0 : nc < NV30_SNORM8_FETCH_SIZE ? 5 : 4;
+}
+
+static inline uint64_t
+nv30_snorm8_key_set(uint64_t key, unsigned attr, unsigned nc)
+{
+   return (key & ~(UINT64_C(7) << (3 * attr))) | ((uint64_t)(nc & 7) << (3 * attr));
+}
+
+static inline unsigned
+nv30_snorm8_key_nc(uint64_t key, unsigned attr)
+{
+   return (unsigned)(key >> (3 * attr)) & 7;
+}
+
+/* the key of the inputs a program declares (one bit per input) */
+static inline uint64_t
+nv30_snorm8_key_for_inputs(uint64_t key, uint32_t inputs)
+{
+   uint64_t out = 0;
+
+   for (unsigned i = 0; i < NV30_SNORM8_MAX_ATTRIBS; i++) {
+      if (inputs & (1u << i))
+         out = nv30_snorm8_key_set(out, i, nv30_snorm8_key_nc(key, i));
+   }
+   return out;
+}
+
+/* the value of one fetched component (0..255) after the prologue, in the GPU's float steps */
+static inline float
+nv30_snorm8_vp(float v)
+{
+   const float s = v >= 128.0f ? 1.0f : 0.0f;  /* SGE */
+   float t = s * -256.0f + v;                    /* MAD: exact for these integers */
+   t = t * (1.0f / 127.0f);                      /* MUL */
+   return t > -1.0f ? t : -1.0f;                 /* MAX */
+}
+
+/* a constant attribute (stride 0) is emitted as its raw bytes too, so the prologue applies the
+ * same way: VTX_ATTR_nF with each byte as a float 0..255 */
+static inline float
+nv30_snorm8_raw(uint8_t b)
+{
+   return (float)b;
+}
+
+#endif
