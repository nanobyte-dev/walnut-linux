+/* NV30_VTX_SNORM8: each input of the key arrives as four bytes 0..255 (U8_USCALED x4) and is
+ * normalized into a temp as util_format's SNORM8 unpack does (nv30_vtx_snorm8.h); the
+ * program reads the temp instead of the input. Four instructions an input, a fifth for a
+ * format of fewer than four components (its missing ones as (0, 0, 0, 1): the fetched bytes
+ * past the attribute belong to something else), each reading at most one input and one
+ * constant as the hardware requires.
+ */
+static bool
+nvfx_vertprog_snorm8_prologue(struct nvfx_vpc *vpc)
+{
+   static const int masks[5] = {
+      0, NVFX_VP_MASK_X, NVFX_VP_MASK_X | NVFX_VP_MASK_Y,
+      NVFX_VP_MASK_X | NVFX_VP_MASK_Y | NVFX_VP_MASK_Z, NVFX_VP_MASK_ALL };
+   struct nv30_vertprog *vp = vpc->vp;
+   struct nvfx_src none = nvfx_src(nvfx_reg(NVFXSR_NONE, 0));
+   struct nvfx_src c, c0001;
+   bool have_c0001 = false;
+   unsigned i;
+
+   /* inputs read by index can't be redirected: the draw module takes the program then */
+   if (vpc->info->indirect_files & (1 << TGSI_FILE_INPUT))
+      return false;
+
+   c = nvfx_src(constant(vpc, -1, 128.0f, -256.0f, 1.0f / 127.0f, -1.0f));
+   for (i = 0; i < NV30_SNORM8_MAX_ATTRIBS; i++) {
+      const unsigned nc = nv30_snorm8_key_nc(vp->snorm8, i);
+      struct nvfx_src in = nvfx_src(nvfx_reg(NVFXSR_INPUT, i));
+      struct nvfx_reg t, s;
+
