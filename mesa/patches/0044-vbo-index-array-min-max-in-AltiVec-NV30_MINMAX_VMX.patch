diff --git a/src/mesa/vbo/vbo_minmax_vmx.h b/src/mesa/vbo/vbo_minmax_vmx.h
new file mode 100644
--- /dev/null
+++ b/src/mesa/vbo/vbo_minmax_vmx.h
@@ -0,0 +1,124 @@
+/*
+ * NV30_MINMAX_VMX: the min/max scan of an index array (vbo_get_minmax_index_mapped) eight
+ * 16-bit or four 32-bit indices at a time, in GCC vector types the compiler maps to AltiVec
+ * (VMX) in these functions; the caller takes them only where the CPU has it. A game drawing
+ * from client index arrays has every glDrawElements scanned: 6.5% of SuperTuxKart's CPU on the
+ * PS3 (Cell PPE, Mesa ps3.476), where the scalar loop is two compares and two branches per index.
+ *
+ * Same results as the scalar loops, also in the corner cases: no index at all gives min ~0u and
+ * max 0, primitive restart leaves the restart index out (a 16-bit array has none when the index
+ * is above 0xffff), and an array of nothing but restart indices gives ~0u and 0 too.
+ *
+ * No Mesa types here: mesa/tests/minmax-vmx-test.c in the PS3 tree checks them against the
+ * scalar loops on the host (GCC's generic vectors there).
+ */
+#ifndef VBO_MINMAX_VMX_H
+#define VBO_MINMAX_VMX_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#if defined(__powerpc__) || defined(__powerpc64__)
+#define VBO_VMX_TARGET __attribute__((target("altivec")))
+#else
+#define VBO_VMX_TARGET
+#endif
+
+/* Below this many indices the scalar loop: taking the vector lanes apart at the end goes through
+ * memory, a load-hit-store stall on the PPE, which only pays off over a longer array. */
+#define VBO_MINMAX_VMX_MIN 64
+
+typedef uint16_t vbo_v8u16 __attribute__((vector_size(16), may_alias));
+typedef uint32_t vbo_v4u32 __attribute__((vector_size(16), may_alias));
+
+VBO_VMX_TARGET static void
+vbo_minmax_u16_vmx(const uint16_t *idx, unsigned count, bool restart, unsigned restart_index,
+                   unsigned *min_index, unsigned *max_index)
+{
+   unsigned mn = ~0u, mx = 0, i = 0;
+
+   if (restart && restart_index > 0xffff)
+      restart = false;   /* no 16-bit index equals it */
+
+#define VBO_MINMAX_STEP(x) do {                       \
+      const unsigned v_ = (x);                        \
+      if (!restart || v_ != restart_index) {          \
+         if (v_ > mx) mx = v_;                        \
+         if (v_ < mn) mn = v_;                        \
+      }                                               \
+   } while (0)
+
+   while (i < count && ((uintptr_t)(idx + i) & 15))
+      VBO_MINMAX_STEP(idx[i++]);
+
+   if (count >= VBO_MINMAX_VMX_MIN && count - i >= 8) {
+      const vbo_v8u16 ones = (vbo_v8u16){ 0 } - 1, r = ones & (uint16_t)restart_index;
+      vbo_v8u16 vmn = ones, vmx = { 0 }, seen = { 0 };
+
+      for (; count - i >= 8; i += 8) {
+         const vbo_v8u16 v = *(const vbo_v8u16 *)(idx + i);
+         /* restart indices: 0xffff for the minimum, 0 for the maximum, not seen */
+         const vbo_v8u16 skip = restart ? (vbo_v8u16)(v == r) : (vbo_v8u16){ 0 };
+         const vbo_v8u16 lo = v | skip, hi = v & ~skip;
+         vbo_v8u16 m = (vbo_v8u16)(lo < vmn);
+         vmn = (lo & m) | (vmn & ~m);
+         m = (vbo_v8u16)(hi > vmx);
+         vmx = (hi & m) | (vmx & ~m);
+         seen |= ~skip;
+      }
+      bool any = false;
+      for (unsigned l = 0; l < 8; l++)
+         any |= seen[l] != 0;
+      if (any) {
+         for (unsigned l = 0; l < 8; l++) {
+            if (vmn[l] < mn) mn = vmn[l];
+            if (vmx[l] > mx) mx = vmx[l];
+         }
+      }
+   }
+
+   while (i < count)
+      VBO_MINMAX_STEP(idx[i++]);
+
+   *min_index = mn;
+   *max_index = mx;
+}
+
+VBO_VMX_TARGET static void
+vbo_minmax_u32_vmx(const uint32_t *idx, unsigned count, bool restart, unsigned restart_index,
+                   unsigned *min_index, unsigned *max_index)
+{
+   unsigned mn = ~0u, mx = 0, i = 0;
+
+   while (i < count && ((uintptr_t)(idx + i) & 15))
+      VBO_MINMAX_STEP(idx[i++]);
+
+   if (count >= VBO_MINMAX_VMX_MIN && count - i >= 4) {
+      const vbo_v4u32 ones = (vbo_v4u32){ 0 } - 1, r = ones & restart_index;
+      vbo_v4u32 vmn = ones, vmx = { 0 };
+
+      /* ~0u is the minimum's start anyway, 0 the maximum's: no "seen" needed */
+      for (; count - i >= 4; i += 4) {
+         const vbo_v4u32 v = *(const vbo_v4u32 *)(idx + i);
+         const vbo_v4u32 skip = restart ? (vbo_v4u32)(v == r) : (vbo_v4u32){ 0 };
+         const vbo_v4u32 lo = v | skip, hi = v & ~skip;
+         vbo_v4u32 m = (vbo_v4u32)(lo < vmn);
+         vmn = (lo & m) | (vmn & ~m);
+         m = (vbo_v4u32)(hi > vmx);
+         vmx = (hi & m) | (vmx & ~m);
+      }
+      for (unsigned l = 0; l < 4; l++) {
+         if (vmn[l] < mn) mn = vmn[l];
+         if (vmx[l] > mx) mx = vmx[l];
+      }
+   }
+
+   while (i < count)
+      VBO_MINMAX_STEP(idx[i++]);
+#undef VBO_MINMAX_STEP
+
+   *min_index = mn;
+   *max_index = mx;
+}
+
+#endif
