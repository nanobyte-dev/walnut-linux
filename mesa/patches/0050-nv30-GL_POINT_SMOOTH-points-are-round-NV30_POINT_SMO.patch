diff --git a/src/gallium/drivers/nouveau/nv30/nv30_point_smooth.c b/src/gallium/drivers/nouveau/nv30/nv30_point_smooth.c
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/nouveau/nv30/nv30_point_smooth.c
@@ -0,0 +1,144 @@
+/*
+ * Round points for GL_POINT_SMOOTH on nv30 (NV30_POINT_SMOOTH=1, the default).
+ *
+ * Neither NV3x nor NV4x has a known point smoothing switch (nouveau's method list has none, the
+ * RSX's libgcm neither), and nv30 ignored pipe_rasterizer_state::point_smooth: smooth points came
+ * out square (Yamagi Quake II's particles, which draws them as GL_POINTS with GL_POINT_SMOOTH
+ * and ARB_point_parameters). The state tracker leaves the smoothing to the driver (radeonsi and
+ * zink run nir_lower_point_smooth on a fragment shader variant). nv30 does the same on TGSI:
+ * points drawn with point_smooth run a variant of the bound fragment program
+ * (nv30_fragprog_select) which reads the point coordinate the hardware puts in a free texture
+ * coordinate (the point sprite's coordinate replacement, as for gl_PointCoord), computes the
+ * fragment's distance from the centre, discards it outside the circle and multiplies the colour's
+ * alpha by the coverage of a one-pixel edge, like nir_lower_point_smooth:
+ *
+ *    t.xy = pc.xy - 0.5
+ *    t.x  = 1 / rsq(t.x * t.x + t.y * t.y)      distance from the centre, in point units
+ *    t.z  = 1 / |ddx(pc.x)|                     the point's size in pixels
+ *    t.w  = (0.5 - t.x) * t.z                   pixels inside the edge
+ *    kill if t.w < 0
+ *    t.w  = min(t.w, 1)
+ *    COLOR[0] = colour * (1, 1, 1, t.w)
+ *
+ * The blending the application set does the rest (GL leaves it to the application: smooth
+ * points without blending have the coverage in alpha only). 1 / rsq: nvfx has no SQRT, and
+ * rsq(0) is infinite, so the centre is 0 instead of 0 * inf.
+ */
+
+#include "tgsi/tgsi_parse.h"
+#include "tgsi/tgsi_scan.h"
+#include "tgsi/tgsi_transform.h"
+
+#include "nv30/nv30_state.h"
+
+struct smooth_ctx {
+   struct tgsi_transform_context base;
+   int color_out;       /* OUT index of COLOR[0] */
+   unsigned tmp;        /* coverage temporary */
+   unsigned color_tmp;  /* COLOR[0] as the program writes it */
+   unsigned coord;      /* the new PCOORD input */
+   unsigned imm;        /* (0.5, 0.5, 1.0, 0.0) */
+};
+
+static void
+smooth_prolog(struct tgsi_transform_context *tctx)
+{
+   struct smooth_ctx *s = (struct smooth_ctx *)tctx;
+   struct tgsi_full_instruction inst;
+   const unsigned t = s->tmp, X = TGSI_SWIZZLE_X, Z = TGSI_SWIZZLE_Z, W = TGSI_SWIZZLE_W;
+
+   tgsi_transform_temps_decl(tctx, s->tmp, s->color_tmp);
+   tgsi_transform_input_decl(tctx, s->coord, TGSI_SEMANTIC_PCOORD, 0, TGSI_INTERPOLATE_LINEAR);
+   tgsi_transform_immediate_decl(tctx, 0.5f, 0.5f, 1.0f, 0.0f);
+
+   /* t.xy = pc.xy - 0.5; t.x = dot(t.xy, t.xy); t.x = 1 / rsq(t.x) */
+   tgsi_transform_op2_inst(tctx, TGSI_OPCODE_ADD, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_XY,
+                           TGSI_FILE_INPUT, s->coord, TGSI_FILE_IMMEDIATE, s->imm, true);
+   tgsi_transform_op2_inst(tctx, TGSI_OPCODE_DP2, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_X,
+                           TGSI_FILE_TEMPORARY, t, TGSI_FILE_TEMPORARY, t, false);
+   tgsi_transform_op1_swz_inst(tctx, TGSI_OPCODE_RSQ, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_X,
+                               TGSI_FILE_TEMPORARY, t, X);
+   tgsi_transform_op1_swz_inst(tctx, TGSI_OPCODE_RCP, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_X,
+                               TGSI_FILE_TEMPORARY, t, X);
+
+   /* t.z = 1 / |ddx(pc.x)| */
+   tgsi_transform_op1_swz_inst(tctx, TGSI_OPCODE_DDX, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_Z,
+                               TGSI_FILE_INPUT, s->coord, X);
+   inst = tgsi_default_full_instruction();
+   inst.Instruction.Opcode = TGSI_OPCODE_RCP;
+   inst.Instruction.NumDstRegs = 1;
+   tgsi_transform_dst_reg(&inst.Dst[0], TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_Z);
+   inst.Instruction.NumSrcRegs = 1;
+   tgsi_transform_src_reg(&inst.Src[0], TGSI_FILE_TEMPORARY, t, Z, Z, Z, Z);
+   inst.Src[0].Register.Absolute = 1;
+   tctx->emit_instruction(tctx, &inst);
+
+   /* t.w = (0.5 - t.x) * t.z; kill if negative; t.w = min(t.w, 1) */
+   tgsi_transform_op2_swz_inst(tctx, TGSI_OPCODE_ADD, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_W,
+                               TGSI_FILE_IMMEDIATE, s->imm, X, TGSI_FILE_TEMPORARY, t, X, true);
+   tgsi_transform_op2_swz_inst(tctx, TGSI_OPCODE_MUL, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_W,
+                               TGSI_FILE_TEMPORARY, t, W, TGSI_FILE_TEMPORARY, t, Z, false);
+   tgsi_transform_kill_inst(tctx, TGSI_FILE_TEMPORARY, t, W, false);
+   tgsi_transform_op2_swz_inst(tctx, TGSI_OPCODE_MIN, TGSI_FILE_TEMPORARY, t, TGSI_WRITEMASK_W,
+                               TGSI_FILE_TEMPORARY, t, W, TGSI_FILE_IMMEDIATE, s->imm, Z, false);
+}
+
+static void
+smooth_inst(struct tgsi_transform_context *tctx, struct tgsi_full_instruction *inst)
+{
+   struct smooth_ctx *s = (struct smooth_ctx *)tctx;
+
+   for (unsigned i = 0; i < inst->Instruction.NumDstRegs; i++) {
+      struct tgsi_full_dst_register *dst = &inst->Dst[i];
+      if (dst->Register.File == TGSI_FILE_OUTPUT && dst->Register.Index == s->color_out) {
+         dst->Register.File = TGSI_FILE_TEMPORARY;
+         dst->Register.Index = s->color_tmp;
+      }
+   }
+   tctx->emit_instruction(tctx, inst);
+}
+
+static void
+smooth_epilog(struct tgsi_transform_context *tctx)
+{
+   struct smooth_ctx *s = (struct smooth_ctx *)tctx;
+
+   tgsi_transform_op1_inst(tctx, TGSI_OPCODE_MOV, TGSI_FILE_OUTPUT, s->color_out,
+                           TGSI_WRITEMASK_XYZ, TGSI_FILE_TEMPORARY, s->color_tmp);
+   tgsi_transform_op2_swz_inst(tctx, TGSI_OPCODE_MUL, TGSI_FILE_OUTPUT, s->color_out,
+                               TGSI_WRITEMASK_W, TGSI_FILE_TEMPORARY, s->color_tmp, TGSI_SWIZZLE_W,
+                               TGSI_FILE_TEMPORARY, s->tmp, TGSI_SWIZZLE_W, false);
+}
+
+/* The program's smooth point variant (tokens to FREE), or NULL: no COLOR[0] output, control
+ * flow that returns early, or out of memory. */
+struct tgsi_token *
+nv30_point_smooth_tokens(const struct tgsi_token *tokens)
+{
+   struct tgsi_shader_info info;
+   struct smooth_ctx s;
+
+   tgsi_scan_shader(tokens, &info);
+   if (info.processor != MESA_SHADER_FRAGMENT ||
+       info.opcode_count[TGSI_OPCODE_RET] || info.opcode_count[TGSI_OPCODE_CAL])
+      return NULL;
+
+   memset(&s, 0, sizeof(s));
+   s.color_out = -1;
+   for (unsigned i = 0; i < info.num_outputs; i++) {
+      if (info.output_semantic_name[i] == TGSI_SEMANTIC_COLOR &&
+          info.output_semantic_index[i] == 0)
+         s.color_out = i;
+   }
+   if (s.color_out < 0)
+      return NULL;
+   s.tmp = info.file_max[TGSI_FILE_TEMPORARY] + 1;
+   s.color_tmp = s.tmp + 1;
+   s.coord = info.file_max[TGSI_FILE_INPUT] + 1;
+   s.imm = info.immediate_count;
+
+   s.base.prolog = smooth_prolog;
+   s.base.transform_instruction = smooth_inst;
+   s.base.epilog = smooth_epilog;
+   return tgsi_transform_shader(tokens, tgsi_num_tokens(tokens) + 200, &s.base);
+}
