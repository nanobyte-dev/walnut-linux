diff --git a/src/gallium/drivers/nouveau/nv30/nv30_fragprog.c b/src/gallium/drivers/nouveau/nv30/nv30_fragprog.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_fragprog.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_fragprog.c
@@ -230,8 +230,15 @@ nv30_fp_state_create(struct pipe_context *pipe,
 static void
 nv30_fp_state_delete(struct pipe_context *pipe, void *hwcso)
 {
+   struct nv30_context *nv30 = nv30_context(pipe);
    struct nv30_fragprog *fp = hwcso;
 
+   if (fp->smooth)
+      nv30_fp_state_delete(pipe, fp->smooth);
+   /* a program made later at this address is not the one the GPU holds */
+   if (nv30->state.fragprog == fp)
+      nv30->state.fragprog = NULL;
+
    pipe_resource_reference(&fp->buffer, NULL);
 
    if (fp->draw)
@@ -256,6 +263,70 @@ nv30_fp_state_bind(struct pipe_context *pipe, void *hwcso)
       nouveau_bufctx_reset(nv30->bufctx, BUFCTX_FRAGPROG);
 
    nv30->fragprog.program = fp;
+   nv30->fragprog.user = fp;
+   nv30->dirty |= NV30_NEW_FRAGPROG;
+}
+
+/* NV30_POINT_SMOOTH: the smooth point variant of fp (nv30_point_smooth.c), translated, or fp
+ * when it can't be had (no colour output, out of texture coordinates for the point coordinate,
+ * a translation failure) */
+static struct nv30_fragprog *
+nv30_fragprog_smooth(struct nv30_context *nv30, struct nv30_fragprog *fp)
+{
+   struct nv30_fragprog *v;
+
+   if (fp->smooth)
+      return fp->smooth;
+   if (fp->smooth_failed)
+      return fp;
+
+   fp->smooth_failed = true;
+   v = CALLOC_STRUCT(nv30_fragprog);
+   if (!v)
+      return fp;
+   v->pipe.tokens = nv30_point_smooth_tokens(fp->pipe.tokens);
+   if (!v->pipe.tokens) {
+      FREE(v);
+      return fp;
+   }
+   tgsi_scan_shader(v->pipe.tokens, &v->info);
+   v->is_smooth = true;
+   nv30_shader_cache_fp_translate(nv30, v);   /* _nvfx_fragprog_translate */
+   if (!v->translated) {
+      nv30_fp_state_delete(&nv30->base.pipe, v);
+      return fp;
+   }
+   /* The point coordinate's texture coordinate is marked 0xfffe (replaced, nothing routed to
+    * it). Vertex programs route nothing to a free one (0xffff) either: as free, a vertex program
+    * keeps its code when the program switches between fp and the variant (nv30_vertprog_validate
+    * translates it again when the texture coordinates differ). */
+   for (unsigned i = 0; i < ARRAY_SIZE(v->texcoord); i++) {
+      if (v->texcoord[i] == 0xfffe)
+         v->texcoord[i] = 0xffff;
+   }
+   fp->smooth_failed = false;
+   fp->smooth = v;
+   return v;
+}
+
+/* Before each draw: the GPU runs the bound program, or its smooth point variant for points drawn
+ * with point_smooth (NV30_POINT_SMOOTH) */
+void
+nv30_fragprog_select(struct nv30_context *nv30, bool smooth_points)
+{
+   struct nv30_fragprog *fp = nv30->fragprog.user;
+
+   if (!fp)
+      return;
+   if (smooth_points)
+      fp = nv30_fragprog_smooth(nv30, fp);
+   if (fp == nv30->fragprog.program)
+      return;
+
+   /* as nv30_fp_state_bind */
+   if (fp != nv30->state.fragprog)
+      nouveau_bufctx_reset(nv30->bufctx, BUFCTX_FRAGPROG);
+   nv30->fragprog.program = fp;
    nv30->dirty |= NV30_NEW_FRAGPROG;
 }
 
