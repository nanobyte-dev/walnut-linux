+/*
+ * NEVERBALL_GL_ITEMS: item_draw for items drawn in a row, at p. The same
+ * matrices with fewer pushes, the depth mask left alone when the item has no
+ * billboards, and the mesh buffers and pointers kept for the next item
+ * (sol_draw_run; with NEVERBALL_GL_MESH all item files share one buffer);
+ * item_draw_end reverts them after the last item.
+ */
+
+void item_draw_run(struct s_rend *rend,
+                   const struct v_item *hp,
+                   const GLfloat *M, float t)
+{
+    const GLfloat s = ITEM_RADIUS;
+
+    struct s_draw *draw = item_file(hp);
+
+    glPushMatrix();
+    {
+        glTranslatef(hp->p[0],
+                     hp->p[1],
+                     hp->p[2]);
+        glScalef(s, s, s);
+
+        if (draw && draw->base && draw->base->rc)
+        {
+            glDepthMask(GL_FALSE);
+            {
+                sol_bill(draw, rend, M, t);
+            }
+            glDepthMask(GL_TRUE);
+        }
+
+        sol_draw_run(draw, rend, 0, 1);
+    }
+    glPopMatrix();
+}
+
+void item_draw_end(void)
+{
+    sol_draw_end();
+}
