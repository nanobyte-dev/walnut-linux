+/*
+ * NEVERBALL_GL_MESH: the vertices and elements of all meshes of a file in one
+ * buffer object each, so the buffers and pointers are set once for all the
+ * meshes drawn in a row (sol_draw_mesh) instead of once a mesh. A file with
+ * more vertices than 16-bit elements can index keeps a buffer per mesh.
+ */
+
+static int sol_defer;
+
+static void sol_load_meshes(struct s_draw **dv, int dn)
+{
+    struct d_vert *vv = NULL;
+    struct d_geom *gv = NULL;
+
+    int di, bi, mi, vn = 0, gn = 0;
+
+#define FOR_MESHES                                       \
+    for (di = 0; di < dn; di++)                          \
+        for (bi = 0; bi < dv[di]->bc; bi++)              \
+            for (mi = 0; mi < dv[di]->bv[bi].mc; mi++)
+
+    FOR_MESHES
+    {
+        vn += dv[di]->bv[bi].mv[mi].vbc;
+        gn += dv[di]->bv[bi].mv[mi].ebc / 3;
+    }
+
+    if (vn > 0 && vn <= 65536 &&
+        (vv = (struct d_vert *) malloc(vn * sizeof (*vv))) &&
+        (gv = (struct d_geom *) malloc((gn ? gn : 1) * sizeof (*gv))))
+    {
+        int vi = 0, gi = 0, i;
+
+        /* The first file owns the buffers. */
+
+        glGenBuffers_(1, &dv[0]->vbo);
+        glGenBuffers_(1, &dv[0]->ebo);
+
+        FOR_MESHES
+        {
+            struct d_mesh *mp = dv[di]->bv[bi].mv + mi;
+            const int mg = mp->ebc / 3;
+
+            memcpy(vv + vi, mp->tv, mp->vbc * sizeof (*vv));
+
+            for (i = 0; i < mg; i++)
+            {
+                gv[gi + i].i = mp->tg[i].i + vi;
+                gv[gi + i].j = mp->tg[i].j + vi;
+                gv[gi + i].k = mp->tg[i].k + vi;
+            }
+
+            mp->vbo    = dv[0]->vbo;
+            mp->ebo    = dv[0]->ebo;
+            mp->voff   = vi;
+            mp->eoff   = gi * sizeof (*gv);
+            mp->shared = 1;
+
+            vi += mp->vbc;
+            gi += mg;
+        }
+
+        glBindBuffer_(GL_ARRAY_BUFFER,         dv[0]->vbo);
+        glBufferData_(GL_ARRAY_BUFFER,         vn * sizeof (*vv), vv,
+                      GL_STATIC_DRAW);
+        glBindBuffer_(GL_ARRAY_BUFFER,         0);
+
+        glBindBuffer_(GL_ELEMENT_ARRAY_BUFFER, dv[0]->ebo);
+        glBufferData_(GL_ELEMENT_ARRAY_BUFFER, gn * sizeof (*gv), gv,
+                      GL_STATIC_DRAW);
+        glBindBuffer_(GL_ELEMENT_ARRAY_BUFFER, 0);
+    }
+    else if (dn > 1)
+    {
+        /* Too many vertices for one buffer: one for each file. */
+
+        for (di = 0; di < dn; di++)
+            sol_load_meshes(dv + di, 1);
+    }
+    else
+    {
+        /* A buffer per mesh, as without the switch. */
+
+        FOR_MESHES
+        {
+            struct d_mesh *mp = dv[di]->bv[bi].mv + mi;
+
+            glGenBuffers_(1, &mp->vbo);
+            glBindBuffer_(GL_ARRAY_BUFFER,         mp->vbo);
+            glBufferData_(GL_ARRAY_BUFFER,         mp->vbc * sizeof (struct d_vert),
+                          mp->tv, GL_STATIC_DRAW);
+            glBindBuffer_(GL_ARRAY_BUFFER,         0);
+
+            glGenBuffers_(1, &mp->ebo);
+            glBindBuffer_(GL_ELEMENT_ARRAY_BUFFER, mp->ebo);
+            glBufferData_(GL_ELEMENT_ARRAY_BUFFER, mp->ebc / 3 * sizeof (struct d_geom),
+                          mp->tg, GL_STATIC_DRAW);
+            glBindBuffer_(GL_ELEMENT_ARRAY_BUFFER, 0);
+        }
+    }
+
+    free(gv);
+    free(vv);
+
+    FOR_MESHES
+    {
+        struct d_mesh *mp = dv[di]->bv[bi].mv + mi;
+
+        free(mp->tv);
+        free(mp->tg);
+
+        mp->tv = NULL;
+        mp->tg = NULL;
+    }
+
+#undef FOR_MESHES
+}
+
+/*
+ * Files loaded between sol_share_begin and sol_share_end (the items) share
+ * one buffer, so items of different kinds drawn in a row need no new buffers
+ * or pointers either.
+ */
+
+void sol_share_begin(void)
+{
+    sol_defer = glext_opt(GL_OPT_MESH);
+}
+
+void sol_share_end(struct s_draw **dv, int dn)
+{
+    if (sol_defer)
+    {
+        sol_defer = 0;
+        sol_load_meshes(dv, dn);
+    }
+}
