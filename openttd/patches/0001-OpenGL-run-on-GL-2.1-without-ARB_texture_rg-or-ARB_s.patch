From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS3 Linux project <ps3@localhost>
Date: Sat, 17 Oct 2026 15:37:37 +0300
Subject: OpenGL: run on GL 2.1 without ARB_texture_rg or
 ARB_shader_texture_lod

The OpenGL backend refused GL 2.x drivers that lack GL_ARB_texture_rg
("Single element texture formats not supported"), such as Mesa's nv30
(GeForce 5/6/7, the PS3's RSX). Three things stopped it:

- Single element textures (8bpp video buffer, animation buffer, sprite
  remap channel, recolour tables) were GL_R8/GL_RED only. Without GL 3.0
  or ARB_texture_rg they are now GL_LUMINANCE8/GL_LUMINANCE: a luminance
  texel reads its value in .r too, so the shaders are unchanged. The
  buffer clears use the same format (glClearBufferSubData rejects GL_R8
  without ARB_texture_rg).
- The vertex array object check below GL 3.0 required both the ARB and
  the APPLE extension, while BindVBAExtension() takes either; it now
  needs one of them.
- The GLSL 1.10 sprite and remap fragment shaders call texture2DLod,
  which fragment shaders only have with ARB_ or ATI_shader_texture_lod.
  Without either (the extension macros are undefined), texture2DLod is
  defined as texture2D: sprites are drawn at the size of their zoom
  level, so the implicit level of detail picks the same mip-map level,
  and the full-screen remap pass samples single-level textures.

Forwarded: no

diff --git a/src/table/opengl_shader.h b/src/table/opengl_shader.h
--- a/src/table/opengl_shader.h
+++ b/src/table/opengl_shader.h
@@ -98,11 +98,21 @@ static const char *_frag_shader_remap_func = \
 	"  return clamp(adj + ob * (1.0 - adj), 0.0, 1.0);"
 	"}";
 
+/**
+ * Without a shader texture LOD extension, texture2DLod is not available in fragment shaders (GLSL 1.10/1.20).
+ * Sprites are drawn at the size of the zoom level, so the implicit level of detail selects the same mip-map level.
+ */
+static const char *_frag_shader_lod_fallback = \
+	"#if !defined(GL_ARB_shader_texture_lod) && !defined(GL_ATI_shader_texture_lod)\n"
+	"#define texture2DLod(sampler, coord, lod) texture2D(sampler, coord)\n"
+	"#endif\n";
+
 /** Fragment shader that performs a palette lookup to read the colour from an 8bpp texture. */
 static const char *_frag_shader_rgb_mask_blend[] = {
 	"#version 110\n",
 	"#extension GL_ATI_shader_texture_lod: enable\n",
 	"#extension GL_ARB_shader_texture_lod: enable\n",
+	_frag_shader_lod_fallback,
 	"uniform sampler2D colour_tex;",
 	"uniform sampler1D palette;",
 	"uniform sampler2D remap_tex;",
@@ -150,6 +160,7 @@ static const char *_frag_shader_sprite_blend[] = {
 	"#version 110\n",
 	"#extension GL_ATI_shader_texture_lod: enable\n",
 	"#extension GL_ARB_shader_texture_lod: enable\n",
+	_frag_shader_lod_fallback,
 	"uniform sampler2D colour_tex;",
 	"uniform sampler1D palette;",
 	"uniform sampler2D remap_tex;",
