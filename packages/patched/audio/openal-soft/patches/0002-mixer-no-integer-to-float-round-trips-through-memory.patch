 #include <algorithm>
 #include <array>
 #include <atomic>
@@ -2375,6 +2383,52 @@ void Write(std::span<FloatBufferLine const> const InBuffer, void *const OutBuffe
     }
 }
 
+#if defined(__ALTIVEC__) && defined(__powerpc64__) && !defined(_ARCH_PWR8)
+/* 16-bit stereo on the PPE (Cell), what the PS3's ALSA device takes: the generic loop converts each
+ * sample with fctiwz, a store and a load back into an integer register (load-hit-store, about 40
+ * cycles a sample). AltiVec does eight frames in vector registers: vec_cts(x, 15) is x*32768
+ * truncated toward zero and saturated, vec_packs saturates to 16 bits, which is SampleConv<i16>'s
+ * clamp and truncation bit for bit.
+ */
+template<>
+void Write<i16>(std::span<FloatBufferLine const> const InBuffer, void *const OutBuffer,
+    std::size_t const Offset, std::size_t const SamplesToDo, std::size_t const FrameStep)
+{
+    ASSUME(FrameStep > 0);
+    ASSUME(SamplesToDo > 0);
+
+    auto const output = std::span{static_cast<i16*>(OutBuffer), (Offset+SamplesToDo)*FrameStep}
+        .subspan(Offset*FrameStep);
+    if(FrameStep > InBuffer.size())
+        std::ranges::fill(output, SampleConv<i16>(0.0f));
+
+    auto i = 0_uz;
+    if(InBuffer.size() == 2 && FrameStep == 2
+        && ((reinterpret_cast<std::uintptr_t>(output.data())
+            | reinterpret_cast<std::uintptr_t>(InBuffer[0].data())
+            | reinterpret_cast<std::uintptr_t>(InBuffer[1].data()))&15) == 0)
+    {
+        auto const *const left = InBuffer[0].data();
+        auto const *const right = InBuffer[1].data();
+        auto *const out = reinterpret_cast<int16_t*>(output.data());
+        for(;i+8 <= SamplesToDo;i += 8)
+        {
+            auto const l = vec_packs(vec_cts(vec_ld(0, left+i), 15), vec_cts(vec_ld(16, left+i), 15));
+            auto const r = vec_packs(vec_cts(vec_ld(0, right+i), 15), vec_cts(vec_ld(16, right+i), 15));
+            vec_st(vec_mergeh(l, r), 0, out+2*i);
+            vec_st(vec_mergel(l, r), 16, out+2*i);
+        }
+    }
+    auto outbase = output.begin();
+    for(auto const &srcbuf : InBuffer)
+    {
+        auto out = outbase++ + gsl::narrow_cast<std::ptrdiff_t>(i*FrameStep);
+        for(auto k = i;k < SamplesToDo;++k, out += gsl::narrow_cast<std::ptrdiff_t>(FrameStep))
+            *out = SampleConv<i16>(srcbuf[k]);
+    }
+}
+#endif
+
 template<typename T>
 void Write(std::span<FloatBufferLine const> const InBuffer, std::span<void*const> const OutBuffers,
     std::size_t const Offset, std::size_t const SamplesToDo)
diff --git a/core/mixer/mixer_c.cpp b/core/mixer/mixer_c.cpp
--- a/core/mixer/mixer_c.cpp
+++ b/core/mixer/mixer_c.cpp
@@ -1,6 +1,7 @@
 #include "config.h"
 
 #include <algorithm>
+#include <array>
 #include <cstddef>
 #include <limits>
 #include <ranges>
@@ -36,6 +37,36 @@ template<typename T>
 using SamplerT = auto(T const &istate, std::span<float const> vals, std::size_t pos, unsigned frac)
     noexcept NONBLOCKING -> float;
 
+#if defined(__powerpc64__) && !defined(_ARCH_PWR8)
+/* The PPE (Cell) and the PowerPC 970 have no move between integer and floating-point registers:
+ * converting the 16-bit fraction to a float stores it and loads it back, and the load waits for the
+ * store (a load-hit-store, about 40 cycles on the PPE) once per output sample of every voice. Two
+ * small tables give the same float without the round trip: frac/65536 is exactly lo/65536 plus
+ * hi*256/65536, both exact in a float, so the sum is the same value bit for bit.
+ */
+struct FracTables {
+    std::array<float,256> lo{}, hi{};
+    constexpr FracTables() noexcept
+    {
+        for(auto i = 0u;i < 256u;++i)
+        {
+            lo[i] = static_cast<float>(i) * (1.0f/MixerFracOne);
+            hi[i] = static_cast<float>(i<<8) * (1.0f/MixerFracOne);
+        }
+    }
+};
+constexpr auto gFracTables = FracTables{};
+static_assert(MixerFracBits == 16);
+
+[[nodiscard, gnu::always_inline]] constexpr
+auto frac_to_float(unsigned const frac) noexcept -> float
+{ return gFracTables.lo[frac&0xffu] + gFracTables.hi[(frac>>8)&0xffu]; }
+#else
+[[nodiscard]] constexpr
+auto frac_to_float(unsigned const frac) noexcept -> float
+{ return gsl::narrow_cast<float>(frac)*(1.0f/MixerFracOne); }
+#endif
+
 [[nodiscard]] constexpr
 auto do_point(std::span<float const> const vals, std::size_t const pos, unsigned) noexcept
     NONBLOCKING -> float
@@ -43,14 +74,16 @@ auto do_point(std::span<float const> const vals, std::size_t const pos, unsigned
 [[nodiscard]] constexpr
 auto do_lerp(std::span<float const> const vals, std::size_t const pos, unsigned const frac)
     noexcept NONBLOCKING -> float
-{ return lerpf(vals[pos+0], vals[pos+1], gsl::narrow_cast<float>(frac)*(1.0f/MixerFracOne)); }
+{ return lerpf(vals[pos+0], vals[pos+1], frac_to_float(frac)); }
 [[nodiscard]] constexpr
 auto do_cubic(CubicState const &istate, std::span<float const> const vals, std::size_t const pos,
     unsigned const frac) noexcept NONBLOCKING -> float
 {
     /* Calculate the phase index and factor. */
     auto const pi = unsigned{frac>>CubicPhaseDiffBits}; ASSUME(pi < CubicPhaseCount);
-    auto const pf = gsl::narrow_cast<float>(frac&CubicPhaseDiffMask)*float{1.0f/CubicPhaseDiffOne};
+    /* (frac&mask)/CubicPhaseDiffOne, exactly: the masked bits moved up to a 16-bit fraction */
+    auto const pf = frac_to_float((frac&CubicPhaseDiffMask) << CubicPhaseBits);
+    static_assert(CubicPhaseDiffBits + CubicPhaseBits == MixerFracBits);
 
     auto const fil = std::span{istate.filter[pi].mCoeffs};
     auto const phd = std::span{istate.filter[pi].mDeltas};
