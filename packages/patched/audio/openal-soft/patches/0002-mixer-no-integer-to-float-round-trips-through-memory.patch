+++ b/core/voice.cpp
@@ -4,6 +4,14 @@
 
 #include "voice.h"
 
+#if defined(__ALTIVEC__) && defined(__powerpc64__) && !defined(_ARCH_PWR8)
+#include <altivec.h>
+#include <cstdint>
+#undef vector
+#undef pixel
+#undef bool
