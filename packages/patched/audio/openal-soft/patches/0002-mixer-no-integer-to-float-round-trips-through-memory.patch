+
 #include <algorithm>
 #include <array>
 #include <atomic>
@@ -275,6 +283,71 @@ void LoadSamples(std::span<float> const dstSamples, std::span<T const> const src
     });
 }
 
+#if defined(__ALTIVEC__) && defined(__powerpc64__) && !defined(_ARCH_PWR8)
+/* 16-bit samples on the PPE (Cell), the common case of game sounds: the generic loop above converts
+ * each sample with a store and a load back into a float register, and the load waits for the store
+ * (load-hit-store, about 40 cycles), once per sample of every voice. AltiVec converts eight at a
+ * time in vector registers: vec_ctf(x, 15) is x/32768, the same exact value as to_float.
+ */
+namespace altivec {
+
+[[gnu::always_inline]] inline
+auto load_u(int16_t const *const p) noexcept -> __vector signed short
+{
+    return vec_perm(vec_ld(0, p), vec_ld(15, p), vec_lvsl(0, p));
+}
+
+} // namespace altivec
+
+template<>
+void LoadSamples<i16>(std::span<float> const dstSamples, std::span<i16 const> const srcData,
+    std::size_t const srcChan, std::size_t const srcOffset, std::size_t const srcStep,
+    std::size_t const samplesPerBlock [[maybe_unused]]) noexcept
+{
+    static_assert(sizeof(i16) == sizeof(int16_t));
+    Expects(srcChan < srcStep);
+
+    auto const start = srcOffset*srcStep + srcChan;
+    auto const *const src = reinterpret_cast<int16_t const*>(srcData.data()) + start;
+    /* elements readable from src: the vector loads stay inside the buffer */
+    auto const avail = srcData.size() - start;
+    auto *const dst = dstSamples.data();
+    auto const total = dstSamples.size();
+    auto i = 0_uz;
+    auto scalar = [src,dst,srcStep](std::size_t const k) noexcept
+    { dst[k] = static_cast<float>(src[k*srcStep]) * (1.0f/32768.0f); };
+
+    if(srcStep == 1 || srcStep == 2)
+    {
+        while(i < total && (reinterpret_cast<std::uintptr_t>(dst+i)&15) != 0)
+            scalar(i++);
+        if(srcStep == 1)
+        {
+            for(;i+8 <= total && i+8 <= avail;i += 8)
+            {
+                auto const v = altivec::load_u(src+i);
+                vec_st(vec_ctf(vec_unpackh(v), 15), 0, dst+i);
+                vec_st(vec_ctf(vec_unpackl(v), 15), 16, dst+i);
+            }
+        }
+        else
+        {
+            /* every other short: bytes 0-1, 4-5, ... of the two vectors (big-endian) */
+            static const __vector unsigned char even = {0,1, 4,5, 8,9, 12,13, 16,17, 20,21, 24,25,
+                28,29};
+            for(;i+8 <= total && 2*i+16 <= avail;i += 8)
+            {
+                auto const v = vec_perm(altivec::load_u(src+2*i), altivec::load_u(src+2*i+8), even);
+                vec_st(vec_ctf(vec_unpackh(v), 15), 0, dst+i);
+                vec_st(vec_ctf(vec_unpackl(v), 15), 16, dst+i);
+            }
+        }
+    }
+    for(;i < total;++i)
+        scalar(i);
+}
+#endif
+
 template<>
 void LoadSamples<IMA4Data>(std::span<float> dstSamples, std::span<IMA4Data const> src,
     std::size_t const srcChan, std::size_t const srcOffset, std::size_t const srcStep,
