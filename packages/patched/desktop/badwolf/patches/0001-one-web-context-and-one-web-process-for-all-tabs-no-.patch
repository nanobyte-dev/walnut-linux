+/* badwolf_web_context: the one web context all tabs use, made on first use: website data (cookies,
+ * local storage, the disk cache) kept under the XDG data and cache directories, no bubblewrap sandbox
+ * (it needs user namespaces, which the PS3's kernel doesn't have, and WebKit has no fallback) */
+static WebKitWebContext *
+badwolf_web_context(void)
+{
+	if(shared_web_context != NULL) return shared_web_context;
+
+	gchar *data_dir  = g_build_filename(g_get_user_data_dir(), "badwolf", "website-data", NULL);
+	gchar *cache_dir = g_build_filename(g_get_user_cache_dir(), "badwolf", NULL);
+	WebKitWebsiteDataManager *website_data_manager = webkit_website_data_manager_new(
+	    "base-data-directory", data_dir, "base-cache-directory", cache_dir, NULL);
+
+	shared_web_context = webkit_web_context_new_with_website_data_manager(website_data_manager);
+	g_object_unref(website_data_manager);
+
+	gchar *cookies = g_build_filename(data_dir, "cookies.sqlite", NULL);
+	WebKitCookieManager *cookie_manager = webkit_web_context_get_cookie_manager(shared_web_context);
+	webkit_cookie_manager_set_persistent_storage(
+	    cookie_manager, cookies, WEBKIT_COOKIE_PERSISTENT_STORAGE_SQLITE);
+	webkit_cookie_manager_set_accept_policy(cookie_manager, WEBKIT_COOKIE_POLICY_ACCEPT_NO_THIRD_PARTY);
+	g_free(cookies);
+	g_free(data_dir);
+	g_free(cache_dir);
+
+	webkit_web_context_set_web_extensions_directory(shared_web_context, web_extensions_directory);
+
+	g_signal_connect(G_OBJECT(shared_web_context),
+	                 "download-started",
+	                 G_CALLBACK(web_contextCb_download_started),
+	                 NULL);
+
+	/* flawfinder: ignore. Consider that g_strsplit is safe enough */
+	char *badwolf_l10n = getenv("BADWOLF_L10N");
+
+	if(badwolf_l10n != NULL)
+	{
+		gchar **languages = g_strsplit(badwolf_l10n, ":", -1);
+		webkit_web_context_set_spell_checking_languages(shared_web_context,
+		                                                (const gchar *const *)languages);
+		g_strfreev(languages);
+
+		webkit_web_context_set_spell_checking_enabled(shared_web_context, TRUE);
+	}
+
+	webkit_web_context_register_uri_scheme(
+	    shared_web_context, "man", man_uri_scheme_request_cb, NULL, NULL);
+
+	return shared_web_context;
+}
+
+/* badwolf_any_web_view: the web view of an open tab, if there is one */
+static WebKitWebView *
+badwolf_any_web_view(void)
+{
+	GtkNotebook *notebook = GTK_NOTEBOOK(window->notebook);
+
+	for(gint i = 0; i < gtk_notebook_get_n_pages(notebook); i++)
+	{
+		struct Client *client =
+		    g_object_get_data(G_OBJECT(gtk_notebook_get_nth_page(notebook, i)), "badwolf-client");
+		if(client != NULL && client->webView != NULL) return client->webView;
+	}
+
+	return NULL;
+}
