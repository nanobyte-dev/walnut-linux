+/* badwolf_home_uri: the start page's URI (WALNUT_BROWSER_HOME, else BADWOLF_HOME_PAGE if it's there) */
+const gchar *
+badwolf_home_uri(void)
+{
+	static gchar *home = NULL;
+
+	if(home != NULL) return home;
+
+	/* flawfinder: ignore. A URI, only copied */
+	const char *env = getenv("WALNUT_BROWSER_HOME");
+	if(env != NULL && env[0] != '\0')
+		home = g_strdup(env);
+	/* flawfinder: ignore, just a presence check */
+	else if(access(BADWOLF_HOME_PAGE, R_OK) == 0)
+		home = g_filename_to_uri(BADWOLF_HOME_PAGE, NULL, NULL);
+	if(home == NULL) home = g_strdup("about:blank");
+
+	return home;
+}
+
+static void
+reloadCb_clicked(GtkButton *UNUSED(reload), gpointer user_data)
+{
+	struct Client *browser = (struct Client *)user_data;
+
+	webkit_web_view_reload(browser->webView);
+}
+
+static void
+homeCb_clicked(GtkButton *UNUSED(home), gpointer user_data)
+{
+	struct Client *browser = (struct Client *)user_data;
+
+	webkit_web_view_load_uri(browser->webView, badwolf_home_uri());
+}
