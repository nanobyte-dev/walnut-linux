diff --git a/config.h b/config.h
--- a/config.h
+++ b/config.h
@@ -138,4 +138,12 @@
 // Default one made for mandoc
 #define BADWOLF_MAN_HTML_CMD "man", "-Thtml", "-Oman=man:%N.%S", "-Otoc"
 
+/* BADWOLF_SEARCH_URI: where words typed in the location bar go (the query appended, escaped).
+ * DuckDuckGo's HTML version: results without scripts, light on a slow CPU */
+#define BADWOLF_SEARCH_URI "https://html.duckduckgo.com/html/?q="
+
+/* BADWOLF_HOME_PAGE: the start page, opened at start and in a new tab when the file exists
+ * (WALNUT_BROWSER_HOME=<URI> overrides it); about:blank otherwise */
+#define BADWOLF_HOME_PAGE DATADIR "/start.html"
+
 #endif /* CONFIG_H_INCLUDED */
diff --git a/uri.c b/uri.c
--- a/uri.c
+++ b/uri.c
@@ -4,8 +4,11 @@
 
 #include "uri.h"
 
+#include "config.h"
+
 #include <glib.h>   /* g_strcmp0(), g_uri_parse_scheme(), g_strdup_printf */
 #include <stdlib.h> /* realpath(), free() */
+#include <string.h> /* strpbrk() */
 #include <unistd.h> /* access() */
 
 const gchar *
@@ -34,5 +37,16 @@ badwolf_ensure_uri_scheme(const gchar *text, gboolean try_file)
 		}
 	}
 
+	/* words, or one word with no dot, slash or colon in it (but localhost): a web search */
+	if(strpbrk(text, " \t") != NULL || (strpbrk(text, "./:") == NULL && g_strcmp0(text, "localhost") != 0))
+	{
+		gchar *words = g_strstrip(g_strdup(text));
+		gchar *query = g_uri_escape_string(words, NULL, FALSE);
+		gchar *uri   = g_strconcat(BADWOLF_SEARCH_URI, query, NULL);
+		g_free(query);
+		g_free(words);
+		return uri;
+	}
+
 	return g_strdup_printf("http://%s", text);
 }
