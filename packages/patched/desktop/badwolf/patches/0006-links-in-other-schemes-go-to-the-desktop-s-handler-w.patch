Subject: links in other schemes go to the desktop's handler (walnut://,
 mailto:)

WebKit only loads the web's own schemes; a link to anything else (the GameDB site's "Open in Walnut
Games", walnut://game/<id>, or mailto:) failed with "unsupported URL". Such a navigation, or a new
window for one, is now handed to the desktop's default handler for x-scheme-handler/<scheme>
through GIO, as xdg-open does, and the page stays where it is. A scheme with no handler is logged.

diff --git a/badwolf.c b/badwolf.c
--- a/badwolf.c
+++ b/badwolf.c
@@ -345,6 +345,32 @@ WebViewCb_permission_request(WebKitWebView *UNUSED(web_view),
 	return TRUE; /* Stop other handlers */
 }
 
+/* badwolf_hand_to_desktop: a link in a scheme WebKit doesn't load (walnut://, mailto:, ...) goes to
+ * the desktop's handler for it (x-scheme-handler/<scheme>, as xdg-open does); TRUE when it did */
+static gboolean
+badwolf_hand_to_desktop(WebKitNavigationAction *navigation_action)
+{
+	static const char *const web_schemes[] = {
+	    "http", "https", "file", "about", "data", "blob", "javascript", "man", "webkit", NULL};
+	const gchar *uri = webkit_uri_request_get_uri(webkit_navigation_action_get_request(navigation_action));
+	gchar *scheme = g_uri_parse_scheme(uri);
+	gboolean ours = FALSE;
+
+	if(scheme != NULL && !g_strv_contains(web_schemes, scheme))
+	{
+		GError *err = NULL;
+		if(!g_app_info_launch_default_for_uri(uri, NULL, &err))
+		{
+			fprintf(stderr, "badwolf: no handler for <%s>: %s\n", uri, err->message);
+			g_error_free(err);
+		}
+		ours = TRUE;
+	}
+
+	g_free(scheme);
+	return ours;
+}
+
 static gboolean
 WebViewCb_decide_policy(WebKitWebView *UNUSED(web_view),
                         WebKitPolicyDecision *decision,
@@ -358,10 +384,25 @@ WebViewCb_decide_policy(WebKitWebView *UNUSED(web_view),
 
 	switch(decision_type)
 	{
+	case WEBKIT_POLICY_DECISION_TYPE_NEW_WINDOW_ACTION:
+		n                 = WEBKIT_NAVIGATION_POLICY_DECISION(decision);
+		navigation_action = webkit_navigation_policy_decision_get_navigation_action(n);
+		if(badwolf_hand_to_desktop(navigation_action))
+		{
+			webkit_policy_decision_ignore(decision);
+			return TRUE;
+		}
+		return FALSE;
 	case WEBKIT_POLICY_DECISION_TYPE_NAVIGATION_ACTION:
 		n                 = WEBKIT_NAVIGATION_POLICY_DECISION(decision);
 		navigation_action = webkit_navigation_policy_decision_get_navigation_action(n);
 
+		if(badwolf_hand_to_desktop(navigation_action))
+		{
+			webkit_policy_decision_ignore(decision);
+			return TRUE;
+		}
+
 		if(GDK_CONTROL_MASK == webkit_navigation_action_get_modifiers(navigation_action) ||
 		   2 == webkit_navigation_action_get_mouse_button(navigation_action))
 		{
