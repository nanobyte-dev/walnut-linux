+# Walnut (the PS3): the GTK 3 flavour only (Badwolf), and what a 256 MB console's browser leaves out
+# (docs/research/BROWSERS.md "Our build"). Gone: WebGL (and ANGLE), WebRTC and media capture,
+# WebAudio, WebCodecs, speech synthesis, gamepads, geolocation, spellchecking, credential storage
+# (libsecret), AVIF and JPEG XL images, PDF.js, WebDriver, the remote inspector, MiniBrowser, the
+# Wayland target (X11 only), journald logging, introspection and documentation, and the bubblewrap
+# sandbox (no user namespaces on our kernel; the GTK 3 API never turns it on anyway).
+# Kept: <video>/<audio> with GStreamer and Media Source (decided 2026-10-28: video is tried on the
+# PS3 before deciding), without GStreamer GL.
+# DEB_BUILD_PROFILES=pkg.webkit2gtk.novideo also drops GStreamer, for measuring.
+WALNUT_CMAKE_ARGUMENTS = \
+	   -DENABLE_WEBGL=OFF -DENABLE_WEBGPU=OFF \
+	   -DENABLE_WEB_RTC=OFF -DUSE_GSTREAMER_WEBRTC=OFF -DENABLE_MEDIA_STREAM=OFF -DENABLE_MEDIA_RECORDER=OFF \
+	   -DENABLE_WEB_AUDIO=OFF -DENABLE_WEB_CODECS=OFF -DENABLE_SPEECH_SYNTHESIS=OFF \
+	   -DENABLE_ENCRYPTED_MEDIA=OFF -DUSE_GSTREAMER_GL=OFF \
+	   -DENABLE_GAMEPAD=OFF -DENABLE_GEOLOCATION=OFF -DENABLE_SPELLCHECK=OFF -DUSE_LIBSECRET=OFF \
+	   -DUSE_AVIF=OFF -DUSE_JPEGXL=OFF -DENABLE_PDFJS=OFF \
+	   -DENABLE_WEBDRIVER=OFF -DENABLE_REMOTE_INSPECTOR=OFF -DENABLE_MINIBROWSER=OFF \
+	   -DENABLE_WAYLAND_TARGET=OFF -DENABLE_JOURNALD_LOG=OFF \
+	   -DENABLE_INTROSPECTION=OFF -DENABLE_DOCUMENTATION=OFF \
+	   -DENABLE_BUBBLEWRAP_SANDBOX=OFF
+# The PS3's PPE is a Cell: schedule for it (the instruction set stays Debian's ppc64 baseline)
+ifeq ($(DEB_HOST_ARCH),ppc64)
+	CFLAGS += -mtune=cell
+	CXXFLAGS += -mtune=cell
+endif
+ifneq (,$(filter pkg.webkit2gtk.novideo,$(DEB_BUILD_PROFILES)))
+	WALNUT_CMAKE_ARGUMENTS += -DUSE_GSTREAMER=OFF
+endif
