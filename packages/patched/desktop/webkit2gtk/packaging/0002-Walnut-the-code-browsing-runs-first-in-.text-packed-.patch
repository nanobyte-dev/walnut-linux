From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Thu, 29 Oct 2026 23:30:00 +0200
Subject: Walnut: the code browsing runs first in .text, packed relative
 relocations

On ppc64 the libraries are linked with a section ordering file (debian/walnut-text-order.ld): the 21897 functions of libwebkit2gtk and 4478 of libjavascriptcoregtk that ran while Badwolf loaded and scrolled pages under qemu-user come first in .text, the rest after them. With 128 KB of readahead per page fault, a browsing session read most of the 71 MB of libwebkit2gtk's code before; now it reads about half. And DT_RELR (-z pack-relative-relocs): .rela.dyn 13.2 MB to 1.3 MB. The code itself is the same.

diff --git a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -36,6 +36,12 @@
 ifeq ($(DEB_HOST_ARCH),ppc64)
 	CFLAGS += -mtune=cell
 	CXXFLAGS += -mtune=cell
+	# The code a page load and a scroll run first in .text, the rest after it: debian/walnut-text-order.ld
+	# lists the functions that ran in traces of Badwolf under qemu-user (GameDB and Wikipedia pages,
+	# docs/research/BROWSERS.md "Making it fit"), so the pages of the libraries a browsing session reads
+	# from disk are about half as many. Relative relocations packed (DT_RELR, glibc 2.36): 13 MB less
+	# for the dynamic loader to read at every process start.
+	LDFLAGS += -Wl,-z,pack-relative-relocs -Wl,--section-ordering-file,$(CURDIR)/debian/walnut-text-order.ld
 endif
 ifneq (,$(filter pkg.webkit2gtk.novideo,$(DEB_BUILD_PROFILES)))
 	WALNUT_CMAKE_ARGUMENTS += -DUSE_GSTREAMER=OFF
diff --git a/debian/walnut-text-order.ld b/debian/walnut-text-order.ld
new file mode 100644
