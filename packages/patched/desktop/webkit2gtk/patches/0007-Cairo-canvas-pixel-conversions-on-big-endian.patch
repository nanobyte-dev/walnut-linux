Subject: Cairo: canvas pixel conversions on big-endian

Cairo's ARGB32 surfaces (PixelFormat::BGRA8 and BGRX8) hold native-endian 32-bit pixels: B, G, R, A in memory on little-endian, A, R, G, B on big-endian. The non-Skia conversions read them as BGRA bytes everywhere, so on big-endian getImageData returned opaque red as transparent black, and every readback, putImageData and filter through a pixel buffer had its channels moved. On big-endian with Cairo, convert through byte-swapped rows; a copy between identical formats is untouched.

diff --git a/Source/WebCore/platform/graphics/PixelBufferConversion.cpp b/Source/WebCore/platform/graphics/PixelBufferConversion.cpp
--- a/Source/WebCore/platform/graphics/PixelBufferConversion.cpp
+++ b/Source/WebCore/platform/graphics/PixelBufferConversion.cpp
@@ -32,6 +32,7 @@
 #include "Logging.h"
 #include "PixelFormat.h"
 #include <wtf/StdLibExtras.h>
+#include <wtf/Vector.h>
 #include <wtf/text/ParsingUtilities.h>
 #include <wtf/text/TextStream.h>
 
@@ -479,7 +480,7 @@ static void convertImagePixelsToFloat16(const ConstPixelBufferConversionView& so
 }
 #endif // ENABLE(PIXEL_FORMAT_RGBA16F)
 
-void convertImagePixels(const ConstPixelBufferConversionView& source, const PixelBufferConversionView& destination, const IntSize& destinationSize)
+static void convertImagePixelsInternal(const ConstPixelBufferConversionView& source, const PixelBufferConversionView& destination, const IntSize& destinationSize)
 {
 #if ENABLE(PIXEL_FORMAT_RGBA16F)
     auto isSourceFloat = source.format.pixelFormat == PixelFormat::RGBA16F;
@@ -556,6 +557,57 @@ void convertImagePixels(const ConstPixelBufferConversionView& source, const Pixe
