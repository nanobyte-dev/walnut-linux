 }
 
+#if USE(CAIRO) && CPU(BIG_ENDIAN)
+static bool isNativeWordPixelFormat(PixelFormat format)
+{
+    return format == PixelFormat::BGRA8 || format == PixelFormat::BGRX8;
+}
+
+static void byteSwapPixels(std::span<uint8_t> row)
+{
+    for (size_t x = 0; x + 4 <= row.size(); x += 4) {
+        std::swap(row[x], row[x + 3]);
+        std::swap(row[x + 1], row[x + 2]);
+    }
+}
+#endif
+
+void convertImagePixels(const ConstPixelBufferConversionView& source, const PixelBufferConversionView& destination, const IntSize& destinationSize)
+{
+#if USE(CAIRO) && CPU(BIG_ENDIAN)
+    // Cairo's ARGB32 pixels (BGRA8 and BGRX8 here) are native-endian 32-bit words: B, G, R, A in memory
+    // on little-endian, but A, R, G, B on big-endian, where the conversions below would read the
+    // wrong channels (getImageData gave opaque red as transparent black). Convert through
+    // byte-swapped rows. A copy between identical formats needs no swap.
+    bool sameFormat = source.format.alphaFormat == destination.format.alphaFormat && source.format.pixelFormat == destination.format.pixelFormat && source.format.colorSpace == destination.format.colorSpace;
+    bool swapSource = !sameFormat && isNativeWordPixelFormat(source.format.pixelFormat);
+    bool swapDestination = !sameFormat && isNativeWordPixelFormat(destination.format.pixelFormat);
+    if (swapSource || swapDestination) {
+        size_t bytesPerRow = destinationSize.width() * 4;
+        Vector<uint8_t> swapped;
+        ConstPixelBufferConversionView swappedSource = source;
+        if (swapSource && destinationSize.width() > 0 && destinationSize.height() > 0) {
+            swapped.grow(bytesPerRow * destinationSize.height());
+            auto swappedSpan = swapped.mutableSpan();
+            for (int y = 0; y < destinationSize.height(); ++y) {
+                auto row = swappedSpan.subspan(bytesPerRow * y, bytesPerRow);
+                memcpySpan(row, source.rows.subspan(source.bytesPerRow * y, bytesPerRow));
+                byteSwapPixels(row);
+            }
+            swappedSource.rows = swapped.span();
+            swappedSource.bytesPerRow = bytesPerRow;
+        }
+        convertImagePixelsInternal(swappedSource, destination, destinationSize);
+        if (swapDestination) {
+            for (int y = 0; y < destinationSize.height(); ++y)
+                byteSwapPixels(destination.rows.subspan(destination.bytesPerRow * y, bytesPerRow));
+        }
+        return;
+    }
+#endif
+    convertImagePixelsInternal(source, destination, destinationSize);
+}
