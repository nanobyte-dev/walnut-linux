+// glbatchtmu: the textures of a batch are bound only before the batch's draw, the unit that is active
+// first and then the others in order, one glActiveTexture for each unit that changes, and the unit goes back to 0 once after the last batch
+// (the stock code selects the unit for each bind and goes back to 0 after each group of them)
+VAR(glbatchtmu, 0, 1, 1);
+
+static inline void bindtmu(renderstate &cur, int tmu, GLenum target, GLuint id)
+{
+    cur.textures[tmu] = id;
+    cur.pendtargets[tmu] = target;
+    cur.pendmask |= 1<<tmu;
+}
+
+static void flushtmus(renderstate &cur)
+{
+    // the unit that is active already first, then the others in order
+    int tmu = cur.activetmu;
+    for(;;)
+    {
+        if(cur.pendmask&(1<<tmu))
+        {
+            cur.pendmask &= ~(1<<tmu);
+            if(cur.activetmu != tmu) glActiveTexture_(GL_TEXTURE0 + (cur.activetmu = tmu));
+            glBindTexture(cur.pendtargets[tmu], cur.textures[tmu]);
+        }
+        if(!cur.pendmask) break;
+        tmu = 0;
+        while(!(cur.pendmask&(1<<tmu))) tmu++;
+    }
+}
+
+static inline void resettmu(renderstate &cur)
+{
+    flushtmus(cur);
+    if(cur.activetmu) glActiveTexture_(GL_TEXTURE0 + (cur.activetmu = 0));
+}
+
