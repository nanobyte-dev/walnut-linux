@@ -1294,6 +1295,8 @@ void R_Register( void )
 	ri.Cvar_SetDescription( r_glslMaxBones, "Most IQM joints skinned by GLSL programs: 0 skins on the CPU and compiles no bone-animation programs, -1 is the driver's limit (upstream)" );
 	r_glslAllPrograms = ri.Cvar_Get( "r_glslAllPrograms", "0", CVAR_LATCH );
 	ri.Cvar_SetDescription( r_glslAllPrograms, "1: compile the shadow and post-processing programs even without framebuffer objects, as upstream" );
+	r_glslKeepPrograms = ri.Cvar_Get( "r_glslKeepPrograms", "1", 0 );
+	ri.Cvar_SetDescription( r_glslKeepPrograms, "Keep the compiled GLSL programs when the renderer restarts at a map load, for the next start to reuse; 0 compiles them all again, as upstream" );
 	ri.Cvar_SetDescription( r_glslKeepShaders, "1: keep the GLSL shader objects attached after linking, as upstream (more memory)" );
 
 	r_hdr = ri.Cvar_Get( "r_hdr", "1", CVAR_ARCHIVE | CVAR_LATCH );
@@ -1626,13 +1629,15 @@ void RE_Shutdown( qboolean destroyWindow ) {
 			FBO_Shutdown();
 		R_DeleteTextures();
 		R_ShutdownVaos();
-		GLSL_ShutdownGPUShaders();
+		// the window and its GL context stay when the client restarts the renderer for a map
+		GLSL_ShutdownGPUShaders(!destroyWindow && r_glslKeepPrograms->integer);
 	}
 
 	R_DoneFreeType();
 
 	// shut down platform specific OpenGL stuff
 	if ( destroyWindow ) {
+		GLSL_DeleteKeptPrograms();
 		GLimp_Shutdown();
 
 		Com_Memset( &glConfig, 0, sizeof( glConfig ) );
