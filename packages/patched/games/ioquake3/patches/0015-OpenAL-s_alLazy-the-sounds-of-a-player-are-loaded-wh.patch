From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sat, 17 Oct 2026 17:08:22 +0300
Subject: OpenAL: s_alLazy, the sounds of a player are loaded when first played

OpenArena registers 13 sound files for every player that joins (death, pain, jump, fall, taunt...)
and S_AL_RegisterSound read, decoded and uploaded each one on the spot: 65 files, 5.2 MB inflated
from the pk3, for the five players that join OpenArena's demo, of which 14 are ever played. With
s_alLazy 1 (default) the sounds of a player model (sound/player/<model>/, not the footsteps) stay
unloaded when the file exists (S_CodecFileExists repeats the codec extension search) and
S_AL_BufferUse loads them at the first play, the way it reloads an evicted sound. s_alLazy 2 does
it for every sound, 0 is upstream.

diff --git a/code/client/snd_codec.c b/code/client/snd_codec.c
--- a/code/client/snd_codec.c
+++ b/code/client/snd_codec.c
@@ -167,6 +167,48 @@ void *S_CodecLoad(const char *filename, snd_info_t *info)
 	return S_CodecGetSound(filename, info);
 }
 
+/*
+=================
+S_CodecFileExists
+
+Whether S_CodecLoad would find a file to try: the name as given if a codec has its
+extension, otherwise (or if that is missing) the name with any codec's extension.
+=================
+*/
+qboolean S_CodecFileExists(const char *filename)
+{
+	snd_codec_t *codec;
+	char		localName[ MAX_QPATH ];
+	char		altName[ MAX_QPATH ];
+	const char	*ext;
+
+	Q_strncpyz(localName, filename, MAX_QPATH);
+	ext = COM_GetExtension(localName);
+
+	if( *ext )
+	{
+		for( codec = codecs; codec; codec = codec->next )
+		{
+			if( !Q_stricmp( ext, codec->ext ) )
+			{
+				if( FS_ReadFile( localName, NULL ) >= 0 )
+					return qtrue;
+				COM_StripExtension( filename, localName, MAX_QPATH );
+				break;
+			}
+		}
+	}
+
+	for( codec = codecs; codec; codec = codec->next )
+	{
+		Com_sprintf( altName, sizeof (altName), "%s.%s", localName, codec->ext );
+		if( FS_ReadFile( altName, NULL ) >= 0 )
+			return qtrue;
+	}
+
+	return qfalse;
+}
+
 /*
 =================
 S_CodecOpenStream
diff --git a/code/client/snd_codec.h b/code/client/snd_codec.h
--- a/code/client/snd_codec.h
+++ b/code/client/snd_codec.h
@@ -71,6 +71,7 @@ void S_CodecInit( void );
 void S_CodecShutdown( void );
 void S_CodecRegister(snd_codec_t *codec);
 void *S_CodecLoad(const char *filename, snd_info_t *info);
+qboolean S_CodecFileExists(const char *filename);
 snd_stream_t *S_CodecOpenStream(const char *filename);
 void S_CodecCloseStream(snd_stream_t *stream);
 int S_CodecReadStream(snd_stream_t *stream, int bytes, void *buffer);
diff --git a/code/client/snd_openal.c b/code/client/snd_openal.c
--- a/code/client/snd_openal.c
+++ b/code/client/snd_openal.c
@@ -31,6 +31,7 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 
 // Console variables specific to OpenAL
 cvar_t *s_alPrecache;
+cvar_t *s_alLazy;
 cvar_t *s_alGain;
 cvar_t *s_alSources;
 cvar_t *s_alDopplerFactor;
@@ -517,6 +518,22 @@ void S_AL_BufferShutdown( void )
 	alBuffersInitialised = qfalse;
 }
 
+/*
+=================
+S_AL_IsPlayerSound
+
+sound/player/<model>/<name>: the voice of one player model (not sound/player/<name>, or the
+footsteps, which every player plays all the time)
+=================
+*/
+static qboolean S_AL_IsPlayerSound( const char *sample )
+{
+	if( Q_stricmpn( sample, "sound/player/", 13 ) )
+		return qfalse;
+	sample += 13;
+	return strchr( sample, '/' ) && Q_stricmpn( sample, "footsteps/", 10 );
+}
+
 /*
 =================
 S_AL_RegisterSound
@@ -528,7 +545,19 @@ sfxHandle_t S_AL_RegisterSound( const char *sample, qboolean compressed )
 	sfxHandle_t sfx = S_AL_BufferFind(sample);
 
 	if((!knownSfx[sfx].inMemory) && (!knownSfx[sfx].isDefault))
+	{
+		// A game registers all the sounds of a player when it joins (OpenArena: 13 files, mostly
+		// never played), and each is read from its pk3 and decoded on the spot. If the file is
+		// there, S_AL_BufferUse loads it when it is played, as for a sound that was evicted.
+		if( s_alLazy->integer && s_alPrecache->integer &&
+			( s_alLazy->integer > 1 || S_AL_IsPlayerSound( sample ) ) &&
+			S_CodecFileExists( sample ) )
+		{
+			knownSfx[sfx].lastUsedTime = Com_Milliseconds();
+			return sfx;
+		}
 		S_AL_BufferLoad(sfx, s_alPrecache->integer);
+	}
 	knownSfx[sfx].lastUsedTime = Com_Milliseconds();
 
 	if (knownSfx[sfx].isDefault) {
@@ -2518,6 +2547,8 @@ qboolean S_AL_Init( soundInterface_t *si )
 
 	// New console variables
 	s_alPrecache = Cvar_Get( "s_alPrecache", "1", CVAR_ARCHIVE );
+	s_alLazy = Cvar_Get( "s_alLazy", "1", CVAR_ARCHIVE );
+	Cvar_SetDescription( s_alLazy, "1: load the sounds of the players (sound/player/) when they are first played instead of when registered, 2: all sounds, 0: as upstream" );
 	s_alGain = Cvar_Get( "s_alGain", "1.0", CVAR_ARCHIVE );
 	s_alSources = Cvar_Get( "s_alSources", "96", CVAR_ARCHIVE );
 	s_alDopplerFactor = Cvar_Get( "s_alDopplerFactor", "1.0", CVAR_ARCHIVE );
