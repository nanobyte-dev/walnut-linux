 #define	LIGHTMAP_SIZE	128
+
+// one BSP lightmap (24 bit) to RGBA at dst, rows dstStride bytes apart
+static void R_LightmapToRGBA( byte *buf_p, byte *dst, int dstStride, float *maxIntensity ) {
+	int		x, y;
+
+	for ( y = 0 ; y < LIGHTMAP_SIZE ; y++ ) {
+		byte *image = dst + y * dstStride;
+		byte *src = buf_p + y * LIGHTMAP_SIZE * 3;
+
+		for ( x = 0 ; x < LIGHTMAP_SIZE ; x++ ) {
+			if ( r_lightmap->integer == 2 )
+			{	// color code by intensity as development tool	(FIXME: check range)
+				float r = src[x*3+0];
+				float g = src[x*3+1];
+				float b = src[x*3+2];
+				float intensity;
+				float out[3] = {0.0, 0.0, 0.0};
+
+				intensity = 0.33f * r + 0.685f * g + 0.063f * b;
+
+				if ( intensity > 255 )
+					intensity = 1.0f;
+				else
+					intensity /= 255.0f;
+
+				if ( intensity > *maxIntensity )
+					*maxIntensity = intensity;
+
+				HSVtoRGB( intensity, 1.00, 0.50, out );
+
+				image[x*4+0] = out[0] * 255;
+				image[x*4+1] = out[1] * 255;
+				image[x*4+2] = out[2] * 255;
+				image[x*4+3] = 255;
+			} else {
+				R_ColorShiftLightingBytes( &src[x*3], &image[x*4] );
+				image[x*4+3] = 255;
+			}
+		}
+	}
+}
+
+/*
+===============
+R_MergeLightmaps
+
+r_mergeLightmaps: the lightmaps go into a few atlas pages instead of one texture each. Surfaces
+of one texture with different lightmaps are different shaders, and every shader change ends a
+batch (RB_RenderDrawSurfList), so a map drawn from N lightmaps splits its world into up to N
+batches per texture. The pages hold 2^k lightmaps each (2^k for the largest k that fits, at most
+64, then the rest the same way), so the texels add up to what the separate lightmaps had: no VRAM is wasted on
+empty cells. ParseFace and ParseMesh move each surface's lightmap coordinates into its cell; the
+lightmaps are sampled at texel centres without mipmaps, so a cell's neighbours never bleed in.
+===============
+*/
+static void R_MergeLightmaps( byte *buf, int numReal ) {
+	int		maxSide, maxTiles, numPages, first, page, i;
+	float	maxIntensity = 0;
+
+	// at most 1024x1024 (64 lightmaps, 4 MB of temporary memory while it is built): the pages are
+	// powers of two in lightmaps, so a larger page would only help maps with 128 or more
+	maxSide = glConfig.maxTextureSize < 1024 ? glConfig.maxTextureSize : 1024;
+	maxTiles = ( maxSide / LIGHTMAP_SIZE ) * ( maxSide / LIGHTMAP_SIZE );
+	if ( maxTiles < 1 )
+		maxTiles = 1;
+
+	for ( numPages = 0, first = 0 ; first < numReal ; numPages++ ) {
+		int tiles = 1;
+		while ( tiles * 2 <= numReal - first && tiles * 2 <= maxTiles )
+			tiles *= 2;
+		first += tiles;
+	}
+
+	tr.numLightmaps = numPages;
+	tr.numRealLightmaps = numReal;
+	tr.lightmaps = ri.Hunk_Alloc( numPages * sizeof(image_t *), h_low );
+	tr.lightmapPlaces = ri.Hunk_Alloc( numReal * sizeof(lightmapPlace_t), h_low );
+
+	for ( page = 0, first = 0 ; page < numPages ; page++ ) {
+		int tiles = 1, log2tiles = 0, cols, rows, width, height;
+		byte *image;
+
+		while ( tiles * 2 <= numReal - first && tiles * 2 <= maxTiles ) {
+			tiles *= 2;
+			log2tiles++;
+		}
+		cols = 1 << ( ( log2tiles + 1 ) / 2 );
+		rows = tiles / cols;
+		width = cols * LIGHTMAP_SIZE;
+		height = rows * LIGHTMAP_SIZE;
+
+		image = ri.Hunk_AllocateTempMemory( width * height * 4 );
+		for ( i = 0 ; i < tiles ; i++ ) {
+			lightmapPlace_t *place = &tr.lightmapPlaces[first + i];
+			int col = i % cols, row = i / cols;
+
+			R_LightmapToRGBA( buf + ( first + i ) * LIGHTMAP_SIZE * LIGHTMAP_SIZE * 3,
+				image + ( row * LIGHTMAP_SIZE * width + col * LIGHTMAP_SIZE ) * 4, width * 4, &maxIntensity );
+
+			place->page = page;
+			place->scale[0] = 1.0f / cols;
+			place->scale[1] = 1.0f / rows;
+			place->offset[0] = (float)col / cols;
+			place->offset[1] = (float)row / rows;
+		}
+
+		tr.lightmaps[page] = R_CreateImage( va("*lightmap%d",page), image,
+			width, height, IMGTYPE_COLORALPHA,
+			IMGFLAG_NOLIGHTSCALE | IMGFLAG_NO_COMPRESSION | IMGFLAG_CLAMPTOEDGE, 0 );
+		ri.Hunk_FreeTempMemory( image );
+		first += tiles;
+	}
+
+	ri.Printf( PRINT_DEVELOPER, "%d lightmaps merged into %d pages\n", numReal, numPages );
+	if ( r_lightmap->integer == 2 )	{
+		ri.Printf( PRINT_ALL, "Brightest lightmap value: %d\n", ( int ) ( maxIntensity * 255 ) );
+	}
+}
+
+// r_mergeLightmaps: a BSP lightmap's coordinates moved into its atlas cell
+static void R_MergedLightmapCoords( int lightmapNum, float *st ) {
+	const lightmapPlace_t *place;
+
+	if ( !tr.lightmapPlaces || lightmapNum < 0 || lightmapNum >= tr.numRealLightmaps )
+		return;
+	place = &tr.lightmapPlaces[lightmapNum];
+	st[0] = place->offset[0] + st[0] * place->scale[0];
+	st[1] = place->offset[1] + st[1] * place->scale[1];
+}
