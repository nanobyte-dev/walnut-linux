+/*
+===============
+FixMergedLightmapTexCoords
+
+r_mergeLightmaps: a surface's lightmap coordinates point into its lightmap's cell of an atlas
+page (R_MergeLightmaps). That is all a plain $lightmap stage needs. Stages that do more with
+those coordinates get them back in the lightmap's own 0..1 space (a tcMod transform in front)
+and, when they sample the atlas, moved back into the cell after their own tcMods: tcMods on a
+$lightmap stage, tcGen other than lightmap on it, tcGen lightmap on another image (external
+lightmaps). Such a shader then belongs to one lightmap (lmRealIndex) instead of to its page.
+===============
+*/
+static qboolean AddLightmapTransform( textureBundle_t *bundle, qboolean front, qboolean toCell,
+		const lightmapPlace_t *place ) {
+	texModInfo_t *tmi;
+
+	if ( bundle->numTexMods >= TR_MAX_TEXMODS ) {
+		ri.Printf( PRINT_DEVELOPER, "WARNING: too many tcMods to fix lightmap texcoords for r_mergeLightmaps in shader '%s'\n", shader.name );
+		return qfalse;
+	}
+	if ( front ) {
+		memmove( &bundle->texMods[1], &bundle->texMods[0], bundle->numTexMods * sizeof( texModInfo_t ) );
+		tmi = &bundle->texMods[0];
+	} else {
+		tmi = &bundle->texMods[bundle->numTexMods];
+	}
+	bundle->numTexMods++;
+
+	Com_Memset( tmi, 0, sizeof( *tmi ) );
+	tmi->type = TMOD_TRANSFORM;
+	if ( toCell ) {
+		tmi->matrix[0][0] = place->scale[0];
+		tmi->matrix[1][1] = place->scale[1];
+		tmi->translate[0] = place->offset[0];
+		tmi->translate[1] = place->offset[1];
+	} else {
+		tmi->matrix[0][0] = 1.0f / place->scale[0];
+		tmi->matrix[1][1] = 1.0f / place->scale[1];
+		tmi->translate[0] = -place->offset[0] / place->scale[0];
+		tmi->translate[1] = -place->offset[1] / place->scale[1];
+	}
+	return qtrue;
+}
+
+static void FixMergedLightmapTexCoords( void ) {
+	const lightmapPlace_t *place;
+	int stage;
+	qboolean fixed = qfalse;
+
+	if ( !tr.lightmapPlaces || shader.lightmapIndex < 0 || shader_realLightmapIndex < 0 ||
+			shader_realLightmapIndex >= tr.numRealLightmaps ) {
+		return;
+	}
+	place = &tr.lightmapPlaces[shader_realLightmapIndex];
+
+	for ( stage = 0; stage < MAX_SHADER_STAGES; stage++ ) {
+		textureBundle_t *bundle = &stages[stage].bundle[0];
+
+		if ( !stages[stage].active ) {
+			break;
+		}
+
+		if ( bundle->isLightmap ) {
+			// the common case: the cell's coordinates as they are
+			if ( !shader_lmCoordsReal && bundle->tcGen == TCGEN_LIGHTMAP && !bundle->numTexMods ) {
+				continue;
+			}
+			if ( bundle->numTexMods + 1 + ( !shader_lmCoordsReal && bundle->tcGen == TCGEN_LIGHTMAP ) > TR_MAX_TEXMODS ) {
+				ri.Printf( PRINT_DEVELOPER, "WARNING: too many tcMods to fix lightmap texcoords for r_mergeLightmaps in shader '%s'\n", shader.name );
+				continue;
+			}
+			if ( !shader_lmCoordsReal && bundle->tcGen == TCGEN_LIGHTMAP ) {
+				AddLightmapTransform( bundle, qtrue, qfalse, place );
+			}
+			AddLightmapTransform( bundle, qfalse, qtrue, place );
+			fixed = qtrue;
+		} else if ( !shader_lmCoordsReal && bundle->tcGen == TCGEN_LIGHTMAP ) {
+			if ( AddLightmapTransform( bundle, qtrue, qfalse, place ) ) {
+				fixed = qtrue;
+			}
+		}
+	}
+
+	if ( fixed || shader_lmCoordsReal ) {
+		shader.lmRealIndex = shader_realLightmapIndex;
+		shader.lmCoordsReal = shader_lmCoordsReal;
+	}
+}
