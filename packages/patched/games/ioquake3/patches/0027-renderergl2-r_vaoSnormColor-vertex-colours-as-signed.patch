diff --git a/code/renderergl2/tr_vbo.c b/code/renderergl2/tr_vbo.c
--- a/code/renderergl2/tr_vbo.c
+++ b/code/renderergl2/tr_vbo.c
@@ -47,6 +47,22 @@ void R_VaoPackColor(uint16_t *out, vec4_t c)
 	out[3] = c[3] * 65535.0f + 0.5f;
 }
 
+/*
+r_vaoSnormColor: vertex colours go to the GPU as signed normalized 16-bit values (v / 2: 0..32767)
+instead of unsigned normalized ones. GPUs without a 16-bit unsigned normalized vertex fetch (Mesa
+nv30, the PS3's RSX) have the driver convert R16G16B16A16_UNORM to floats on the CPU at every draw
+(u_vbuf), which also reads the vertex buffer back from video memory and keeps a copy of it in
+system memory. 0 maps to -1, which comes out as 0 or a hair below it under both of GL's signed
+normalized rules (c / 32767 and (2c + 1) / 65535), so a zero alpha still fails an alpha test.
+*/
+void R_VaoColorToSnorm(int16_t *out, const uint16_t *in, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		out[i] = in[i] ? (int16_t)(in[i] >> 1) : -1;
+}
+
 void R_VaoUnpackTangent(vec4_t v, int16_t *pack)
 {
 	v[0] = pack[0] / 32767.0f;
@@ -227,7 +243,7 @@ vao_t *R_CreateVao2(const char *name, int numVertexes, srfVert_t *verts, int num
 	vao->attribs[ATTR_INDEX_TANGENT       ].type = GL_SHORT;
 	vao->attribs[ATTR_INDEX_TEXCOORD      ].type = GL_FLOAT;
 	vao->attribs[ATTR_INDEX_LIGHTCOORD    ].type = GL_FLOAT;
-	vao->attribs[ATTR_INDEX_COLOR         ].type = GL_UNSIGNED_SHORT;
+	vao->attribs[ATTR_INDEX_COLOR         ].type = r_vaoSnormColor->integer ? GL_SHORT : GL_UNSIGNED_SHORT;
 	vao->attribs[ATTR_INDEX_LIGHTDIRECTION].type = GL_SHORT;
 
 	vao->attribs[ATTR_INDEX_POSITION      ].normalized = GL_FALSE;
@@ -289,8 +305,11 @@ vao_t *R_CreateVao2(const char *name, int numVertexes, srfVert_t *verts, int num
 		memcpy(data + dataOfs, &verts[i].lightmap, sizeof(verts[i].lightmap));
 		dataOfs += sizeof(verts[i].lightmap);
 
-		// colors
