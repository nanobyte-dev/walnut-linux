-			vaoSurf->vao->attribs[ATTR_INDEX_NORMAL  ].type = GL_SHORT;
+			vaoSurf->vao->attribs[ATTR_INDEX_NORMAL  ].type = packed ? GL_UNSIGNED_BYTE : GL_SHORT;
