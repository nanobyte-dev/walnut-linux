+			qboolean packed = mdvModel->numFrames > 1 && glRefConfig.md3PackedFrames && !tangents;
 
-			if (mdvModel->numFrames > 1)
+			if (packed)
+			{
+				offset_st      = 0;
+				offset_xyz     = surf->numVerts * sizeof(vec2_t);
+				offset_normal  = offset_xyz + sizeof(int16_t) * 4;
+				offset_tangent = offset_normal;
+				stride_st  = sizeof(vec2_t);
+				stride_xyz = sizeof(int16_t) * 4 + sizeof(uint8_t) * 4;
+				stride_normal = stride_tangent = stride_xyz;
+
+				dataSize = offset_xyz + surf->numVerts * mdvModel->numFrames * stride_xyz;
+			}
+			else if (mdvModel->numFrames > 1)
 			{
 				// vertex animation, store texcoords first, then position/normal/tangents
 				offset_st      = 0;
@@ -771,7 +786,39 @@ static qboolean R_LoadMD3(model_t * mod, int lod, void *buffer, int bufferSize,
 			data = ri.Malloc(dataSize);
 			dataOfs = 0;
 
-			if (mdvModel->numFrames > 1)
+			if (packed)
+			{
+				st = surf->st;
+				for ( j = 0 ; j < surf->numVerts ; j++, st++ ) {
+					memcpy(data + dataOfs, &st->st, sizeof(vec2_t));
+					dataOfs += sizeof(st->st);
+				}
+
+				v = surf->verts;
+				for ( j = 0; j < surf->numVerts * mdvModel->numFrames ; j++, v++ )
+				{
+					int16_t xyz[4];
+					uint8_t normal[4];
+					int k;
+
+					// the loader made these from MD3's int16 * MD3_XYZ_SCALE: exact back
+					for (k = 0; k < 3; k++)
+						xyz[k] = (int16_t)lrintf(v->xyz[k] * (1.0f / MD3_XYZ_SCALE));
+					xyz[3] = 0;
+					for (k = 0; k < 4; k++)
+					{
+						int n = (int)lrintf(v->normal[k] * (127.0f / 32767.0f)) + 128;
+
+						normal[k] = (uint8_t)(n < 1 ? 1 : n > 255 ? 255 : n);
+					}
+
+					memcpy(data + dataOfs, xyz, sizeof(xyz));
+					dataOfs += sizeof(xyz);
+					memcpy(data + dataOfs, normal, sizeof(normal));
+					dataOfs += sizeof(normal);
+				}
+			}
+			else if (mdvModel->numFrames > 1)
 			{
 				st = surf->st;
 				for ( j = 0 ; j < surf->numVerts ; j++, st++ ) {
@@ -843,9 +890,9 @@ static qboolean R_LoadMD3(model_t * mod, int lod, void *buffer, int bufferSize,
 			vaoSurf->vao->attribs[ATTR_INDEX_NORMAL  ].count = 4;
