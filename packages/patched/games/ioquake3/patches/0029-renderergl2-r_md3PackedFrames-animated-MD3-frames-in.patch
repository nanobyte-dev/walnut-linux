From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sun, 18 Oct 2026 16:41:24 +0300
Subject: renderergl2: r_md3PackedFrames, animated MD3 frames in 12 bytes a
 vertex

With GPU vertex animation every frame of every animated MD3 model sits in its VBO as a float
position and four shorts of normal, 20 bytes a vertex a frame: 62 MB for the models of the bench
demo, in the PS3's video memory, which is also its fastest swap.

r_md3PackedFrames 1 (default 0, latched; only with r_normalMapping 0, as tangents would need their
own packing) stores MD3's own 16-bit positions (1/64 units, exact) with a pad and the normal as
four unsigned bytes (n * 127 + 128), 12 bytes: the demo's model VBOs 62.2 -> 37.5 MB. Both
formats are ones nv30 fetches natively (V16_SSCALED, U8_UNORM). The vertex-animation programs get
USE_PACKED_FRAMES and decode with a new uniform, u_PackedFrames, 1 while a packed VAO is drawn:
lightall uses its vertex-animation variant for every entity, single-frame models included, whose
VBOs keep floats. On llvmpipe at GL 2.1, the demo's 30 sampled frames: 1734 pixels differ, by at
most 2 levels (the 8-bit normals' lighting).

diff --git a/code/renderergl2/glsl/fogpass_vp.glsl b/code/renderergl2/glsl/fogpass_vp.glsl
--- a/code/renderergl2/glsl/fogpass_vp.glsl
+++ b/code/renderergl2/glsl/fogpass_vp.glsl
@@ -25,6 +25,9 @@ uniform mat4    u_ModelViewProjectionMatrix;
 
 #if defined(USE_VERTEX_ANIMATION)
 uniform float   u_VertexLerp;
+  #if defined(USE_PACKED_FRAMES)
+uniform float  u_PackedFrames;
+  #endif
 #elif defined(USE_BONE_ANIMATION)
 uniform mat4 u_BoneMatrix[MAX_GLSL_BONES];
 #endif
@@ -107,6 +110,12 @@ void main()
 #if defined(USE_VERTEX_ANIMATION)
 	vec3 position = mix(attr_Position, attr_Position2, u_VertexLerp);
 	vec3 normal   = mix(attr_Normal,   attr_Normal2,   u_VertexLerp);
+#if defined(USE_PACKED_FRAMES)
+	// a model VAO with packed frames: 1/64 units, normals as n * 127 + 128 (the other entities
+	// drawn with this program, single-frame models, have u_PackedFrames 0)
+	position *= 1.0 - u_PackedFrames * (63.0 / 64.0);
+	normal = mix(normal, normal * (255.0 / 127.0) - 128.0 / 127.0, u_PackedFrames);
+#endif
 #elif defined(USE_BONE_ANIMATION)
 	mat4 vtxMat  = u_BoneMatrix[int(attr_BoneIndexes.x)] * attr_BoneWeights.x;
 	     vtxMat += u_BoneMatrix[int(attr_BoneIndexes.y)] * attr_BoneWeights.y;
