diff --git a/code/renderergl2/tr_glsl.c b/code/renderergl2/tr_glsl.c
--- a/code/renderergl2/tr_glsl.c
+++ b/code/renderergl2/tr_glsl.c
@@ -134,6 +134,7 @@ static uniformInfo_t uniformsInfo[] =
 
 	{ "u_Time",          GLSL_FLOAT },
 	{ "u_VertexLerp" ,   GLSL_FLOAT },
+	{ "u_PackedFrames",  GLSL_FLOAT },
 	{ "u_NormalScale",   GLSL_VEC4 },
 	{ "u_SpecularScale", GLSL_VEC4 },
 
@@ -1179,6 +1180,16 @@ void GLSL_DeleteGPUShader(shaderProgram_t *program)
 	}
 }
 
+/*
+The defines of a vertex-animated program: with r_md3PackedFrames the frames hold MD3's own 16-bit
+positions (1/64 units) and normals as unsigned bytes (n * 127 + 128), which USE_PACKED_FRAMES
+turns back into model units and a signed normal.
+*/
+static const char *GLSL_VertexAnimationDefines(void)
+{
+	return glRefConfig.md3PackedFrames ? "#define USE_VERTEX_ANIMATION\n#define USE_PACKED_FRAMES\n" : "#define USE_VERTEX_ANIMATION\n";
+}
+
 void GLSL_InitGPUShaders(void)
 {
 	int             startTime, endTime;
@@ -1210,6 +1221,13 @@ void GLSL_InitGPUShaders(void)
 		glRefConfig.gpuVertexAnimation = qfalse;
 	}
 
+	// r_md3PackedFrames: the model VBOs (tr_model.c) and the programs' decode agree, both decided
+	// here for this renderer start; only without tangents (r_normalMapping 0), which would need
+	// their own packing
+	glRefConfig.md3PackedFrames = glRefConfig.gpuVertexAnimation && r_md3PackedFrames->integer && !r_normalMapping->integer;
+	if (glRefConfig.md3PackedFrames)
+		ri.Printf(PRINT_ALL, "Using packed MD3 frames\n");
+
 	for (i = 0; i < GENERICDEF_COUNT; i++)
 	{	
 		if ((i & GENERICDEF_USE_VERTEX_ANIMATION) && (i & GENERICDEF_USE_BONE_ANIMATION))
@@ -1235,7 +1253,7 @@ void GLSL_InitGPUShaders(void)
 			if (!glRefConfig.gpuVertexAnimation)
 				continue;
 
-			Q_strcat(extradefines, 1024, "#define USE_VERTEX_ANIMATION\n");
+			Q_strcat(extradefines, 1024, GLSL_VertexAnimationDefines());
 			attribs |= ATTR_POSITION2 | ATTR_NORMAL2;
 		}
 		else if (i & GENERICDEF_USE_BONE_ANIMATION)
@@ -1300,7 +1318,7 @@ void GLSL_InitGPUShaders(void)
 
 		if (i & FOGDEF_USE_VERTEX_ANIMATION)
 		{
-			Q_strcat(extradefines, 1024, "#define USE_VERTEX_ANIMATION\n");
+			Q_strcat(extradefines, 1024, GLSL_VertexAnimationDefines());
 			attribs |= ATTR_POSITION2 | ATTR_NORMAL2;
 		}
 		else if (i & FOGDEF_USE_BONE_ANIMATION)
@@ -1477,7 +1495,7 @@ void GLSL_InitGPUShaders(void)
 
 			if (glRefConfig.gpuVertexAnimation)
 			{
-				Q_strcat(extradefines, 1024, "#define USE_VERTEX_ANIMATION\n");
+				Q_strcat(extradefines, 1024, GLSL_VertexAnimationDefines());
 				attribs |= ATTR_POSITION2 | ATTR_NORMAL2;
 
 				if (r_normalMapping->integer)
@@ -1534,7 +1552,7 @@ void GLSL_InitGPUShaders(void)
 
 		if (i & SHADOWMAPDEF_USE_VERTEX_ANIMATION)
 		{
-			Q_strcat(extradefines, 1024, "#define USE_VERTEX_ANIMATION\n");
+			Q_strcat(extradefines, 1024, GLSL_VertexAnimationDefines());
 			attribs |= ATTR_POSITION2 | ATTR_NORMAL2;
 		}
 
