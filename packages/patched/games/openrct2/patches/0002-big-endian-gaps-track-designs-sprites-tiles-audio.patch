+
+TEST(LittleEndianTest, LoadStore)
+{
+    const uint8_t bytes[4] = { 0x78, 0x56, 0x34, 0x12 };
+    ASSERT_EQ(LoadLE32(bytes), 0x12345678u);
+    ASSERT_EQ(LoadLE16(bytes), 0x5678u);
