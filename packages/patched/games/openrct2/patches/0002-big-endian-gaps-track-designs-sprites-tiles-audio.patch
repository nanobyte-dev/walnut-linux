 #include "TrackElement.h"
 #include "WallElement.h"
 
+#include <bit>
+#include <utility>
+
 namespace OpenRCT2
 {
+    void TileElement::LittleEndianToHost()
+    {
+        if constexpr (std::endian::native == std::endian::big)
+        {
+            auto* b = reinterpret_cast<uint8_t*>(this);
+            auto swap16 = [b](size_t offset) { std::swap(b[offset], b[offset + 1]); };
+            // offsets of the 16-bit fields in each element type (world/tile_element/*.h)
+            switch (getType())
+            {
+                case TileElementType::path:
+                    swap16(5);  // surfaceIndex
+                    swap16(7);  // railingsIndex
+                    swap16(13); // rideIndex / additionStatus
+                    break;
+                case TileElementType::track:
+                    swap16(5);  // trackType
+                    swap16(7);  // uMaze.mazeEntry / uRide.sequence, colourScheme
+                    swap16(12); // rideIndex
+                    swap16(14); // rideType
+                    break;
+                case TileElementType::smallScenery:
+                    swap16(5); // entryIndex
+                    break;
+                case TileElementType::largeScenery:
+                    swap16(5); // entryIndex
+                    swap16(7); // bannerIndex
+                    break;
+                case TileElementType::wall:
+                    swap16(5);  // entryIndex
+                    swap16(10); // bannerIndex
+                    break;
+                case TileElementType::entrance:
+                    swap16(8);  // pathType
+                    swap16(10); // rideIndex
+                    swap16(13); // entryIndex
+                    break;
+                case TileElementType::banner:
+                    swap16(5); // index
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
     BannerIndex TileElement::getBannerIndex() const
     {
         switch (getType())
