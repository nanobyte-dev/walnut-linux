+// ByteSwapBE converts host order to big-endian (network order): the bytes in memory afterwards are
+// the big-endian representation, on every host (a swap on little-endian hosts, the identity on big-endian ones)
+template<typename T>
+static std::vector<uint8_t> BytesOf(const T& value)
+{
+    std::vector<uint8_t> bytes(sizeof(T));
+    std::memcpy(bytes.data(), &value, sizeof(T));
+    return bytes;
+}
+
 TEST(SwapBETest, ForUInt16_SwapsBytes)
 {
     uint16_t before = 0x1234;
     uint16_t after = ByteSwapBE(before);
-    ASSERT_EQ(0x3412u, after);
+    ASSERT_EQ(BytesOf(after), (std::vector<uint8_t>{ 0x12, 0x34 }));
 }
 
 TEST(SwapBETest, ForUInt32_SwapsBytes)
 {
     uint32_t before = 0x12345678;
     uint32_t after = ByteSwapBE(before);
-    ASSERT_EQ(0x78563412u, after);
+    ASSERT_EQ(BytesOf(after), (std::vector<uint8_t>{ 0x12, 0x34, 0x56, 0x78 }));
 }
 
