 /*===========================================================================
   Transform an OpenGL vertex to pure 2D
   ===========================================================================*/
+void DrawLibOpenGL::primVertex(float x, float y) {
+  if (!m_inPrim)
+    return; /* outside glBegin/glEnd the GL ignored it */
+  xmgl::Vtx v;
+  v.x = x;
+  v.y = y;
+  v.u = m_curU;
+  v.v = m_curV;
+  memcpy(v.c, xmgl::curUb, 4);
+  m_prim.push_back(v);
+}
+
 void DrawLibOpenGL::glVertexSP(float x, float y) {
+  if (xmgl::on) {
+    primVertex(x, m_renderSurf->getDispHeight() - y);
+    return;
+  }
   glVertex2f(x, m_renderSurf->getDispHeight() - y);
 }
 
 void DrawLibOpenGL::glVertex(float x, float y) {
+  if (xmgl::on) {
+    primVertex(x, y);
+    return;
+  }
   glVertex2f(x, y);
 }
 
 void DrawLibOpenGL::glTexCoord(float x, float y) {
-  glTexCoord2f(x, y);
+  m_curU = x;
+  m_curV = y;
