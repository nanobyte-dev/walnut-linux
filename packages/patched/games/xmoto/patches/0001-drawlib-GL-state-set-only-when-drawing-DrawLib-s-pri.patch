+=============================================================================*/
+
+/* See GLBatch.h. This file calls the GL itself (glad_gl*). */
+#define XM_GLBATCH_IMPL
+#include "common/BuildConfig.h"
+#include "include/xm_SDL.h"
+#include "include/xm_OpenGL.h"
+#include "helpers/Log.h"
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <time.h>
+
+#ifdef ENABLE_OPENGL
+
+namespace xmgl {
+
+bool on = false;
+bool blocks = false;
+bool dirty = false;
+GLubyte curUb[4] = { 255, 255, 255, 255 };
+
+namespace {
+
+struct State {
+  bool tex2d, blend, alpha;
+  GLuint tex;
+  GLenum bsrc, bdst;
+  GLenum afunc;
+  GLclampf aref;
+};
+
+struct Colour {
+  bool isFloat;
+  GLubyte ub[4];
+  GLfloat f[4];
+};
+
+/* where the vertex and texcoord pointers point */
+enum Arrays { ARR_GAME, ARR_BATCH, ARR_STATIC };
+
+State want, have;
+Colour cwant, chave;
+bool chaveKnown;
+bool wantV, wantT, wantC; /* the game's client arrays */
+bool haveV, haveT, haveC;
+GLuint wantBuf, haveBuf;
+Arrays arrays;
+GLuint arraysBuf;
+const void *arraysBase;
+
+bool inGameBegin; /* inside the game's own glBegin/glEnd */
+bool inPrim; /* inside a DrawLib primitive */
+bool haveVBO;
+
+/* immediate batch */
+const int BATCH_MAX = 32768;
+Vtx *batch;
+int nBatch;
+GLenum batchMode;
+
+/* pending static range */
+bool stPending;
+GLuint stBuf;
+const void *stBase;
+GLenum stMode;
+int stFirst, stCount;
+
+/* stats */
+bool stats;
+unsigned long sFrames, sDraws, sBatchDraws, sStaticDraws, sGameDraws, sGameBegins,
+  sVerts, sBatchVerts, sSyncs;
+double sLast;
+
+double now() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec + t.tv_nsec / 1e9;
+}
+
+void bindArrayBuffer(GLuint b) {
+  if (haveBuf != b) {
+    glad_glBindBufferARB(GL_ARRAY_BUFFER_ARB, b);
+    haveBuf = b;
+  }
+}
+
+void clientArray(GLenum a, bool &have, bool want) {
+  if (have != want) {
+    if (want)
+      glad_glEnableClientState(a);
+    else
+      glad_glDisableClientState(a);
+    have = want;
+  }
+}
+
+void setCap(GLenum cap, bool &h, bool w) {
+  if (h != w) {
+    if (w)
+      glad_glEnable(cap);
+    else
+      glad_glDisable(cap);
+    h = w;
+  }
+}
+
+/* the state a draw depends on */
+bool drawStateDiffers() {
+  if (want.tex2d != have.tex2d || want.blend != have.blend ||
+      want.alpha != have.alpha)
+    return true;
+  if (want.tex2d && want.tex != have.tex)
+    return true;
+  if (want.blend && (want.bsrc != have.bsrc || want.bdst != have.bdst))
+    return true;
+  if (want.alpha && (want.afunc != have.afunc || want.aref != have.aref))
+    return true;
+  return false;
+}
+
+void applyDrawState() {
+  if (want.tex2d && want.tex != have.tex) {
+    glad_glBindTexture(GL_TEXTURE_2D, want.tex);
+    have.tex = want.tex;
+  }
+  setCap(GL_TEXTURE_2D, have.tex2d, want.tex2d);
+  if (want.blend && (want.bsrc != have.bsrc || want.bdst != have.bdst)) {
+    glad_glBlendFunc(want.bsrc, want.bdst);
+    have.bsrc = want.bsrc;
+    have.bdst = want.bdst;
+  }
+  setCap(GL_BLEND, have.blend, want.blend);
+  if (want.alpha && (want.afunc != have.afunc || want.aref != have.aref)) {
+    glad_glAlphaFunc(want.afunc, want.aref);
+    have.afunc = want.afunc;
+    have.aref = want.aref;
+  }
+  setCap(GL_ALPHA_TEST, have.alpha, want.alpha);
+}
+
+void applyAllState() {
+  applyDrawState();
+  if (want.tex != have.tex) {
+    glad_glBindTexture(GL_TEXTURE_2D, want.tex);
+    have.tex = want.tex;
+  }
+  if (want.bsrc != have.bsrc || want.bdst != have.bdst) {
+    glad_glBlendFunc(want.bsrc, want.bdst);
+    have.bsrc = want.bsrc;
+    have.bdst = want.bdst;
+  }
+  if (want.afunc != have.afunc || want.aref != have.aref) {
+    glad_glAlphaFunc(want.afunc, want.aref);
+    have.afunc = want.afunc;
+    have.aref = want.aref;
+  }
+}
+
+bool colourDiffers() {
+  if (!chaveKnown || chave.isFloat != cwant.isFloat)
+    return true;
+  if (cwant.isFloat)
+    return memcmp(chave.f, cwant.f, sizeof(cwant.f)) != 0;
+  return memcmp(chave.ub, cwant.ub, sizeof(cwant.ub)) != 0;
+}
+
+void applyColour() {
+  if (colourDiffers()) {
+    if (cwant.isFloat)
+      glad_glColor4f(cwant.f[0], cwant.f[1], cwant.f[2], cwant.f[3]);
+    else
+      glad_glColor4ub(cwant.ub[0], cwant.ub[1], cwant.ub[2], cwant.ub[3]);
+    chave = cwant;
+    chaveKnown = true;
+  }
+}
+
+void flushBatch() {
+  if (nBatch == 0)
+    return;
+  if (haveVBO)
+    bindArrayBuffer(0);
+  if (arrays != ARR_BATCH) {
+    glad_glVertexPointer(2, GL_FLOAT, sizeof(Vtx), &batch[0].x);
+    glad_glTexCoordPointer(2, GL_FLOAT, sizeof(Vtx), &batch[0].u);
+    glad_glColorPointer(4, GL_UNSIGNED_BYTE, sizeof(Vtx), &batch[0].c);
+    arrays = ARR_BATCH;
+  }
+  clientArray(GL_VERTEX_ARRAY, haveV, true);
+  clientArray(GL_TEXTURE_COORD_ARRAY, haveT, true);
+  clientArray(GL_COLOR_ARRAY, haveC, true);
+  glad_glDrawArrays(batchMode, 0, nBatch);
+  chaveKnown = false; /* undefined after a draw with a colour array */
+  sDraws++;
+  sBatchDraws++;
+  sVerts += nBatch;
+  sBatchVerts += nBatch;
+  nBatch = 0;
+}
+
+void flushStatic() {
+  if (!stPending)
+    return;
+  if (haveVBO)
+    bindArrayBuffer(stBuf);
+  if (arrays != ARR_STATIC || arraysBuf != stBuf || arraysBase != stBase) {
+    glad_glVertexPointer(2, GL_FLOAT, 4 * sizeof(float), stBase);
+    glad_glTexCoordPointer(
+      2, GL_FLOAT, 4 * sizeof(float), (const char *)stBase + 2 * sizeof(float));
+    arrays = ARR_STATIC;
+    arraysBuf = stBuf;
+    arraysBase = stBase;
+  }
+  clientArray(GL_VERTEX_ARRAY, haveV, true);
+  clientArray(GL_TEXTURE_COORD_ARRAY, haveT, true);
+  clientArray(GL_COLOR_ARRAY, haveC, false);
+  glad_glDrawArrays(stMode, stFirst, stCount);
+  sDraws++;
+  sStaticDraws++;
+  sVerts += stCount;
+  stPending = false;
+}
+
+void flushAll() {
+  flushBatch();
+  flushStatic();
+}
+
+void markDirty() {
+  dirty = true;
+}
+
+} // namespace
+
+void init() {
+  const char *e = getenv("XMOTO_GL_BATCH");
+  on = !(e && e[0] == '0');
+  e = getenv("XMOTO_GL_BLOCKS");
+  blocks = on && !(e && e[0] == '0');
+  e = getenv("XMOTO_GL_STATS");
+  stats = e && e[0] && e[0] != '0';
+  haveVBO = glad_glBindBufferARB != NULL;
+
+  /* the GL's initial state */
+  want.tex2d = want.blend = want.alpha = false;
+  want.tex = 0;
+  want.bsrc = GL_ONE;
+  want.bdst = GL_ZERO;
+  want.afunc = GL_ALWAYS;
+  want.aref = 0.0f;
+  have = want;
+  cwant.isFloat = true;
+  cwant.f[0] = cwant.f[1] = cwant.f[2] = cwant.f[3] = 1.0f;
+  memset(cwant.ub, 0, sizeof(cwant.ub));
+  chave = cwant;
+  chaveKnown = true;
+  wantV = wantT = wantC = false;
+  haveV = haveT = haveC = false;
+  wantBuf = haveBuf = 0;
+  arrays = ARR_GAME;
+  inGameBegin = inPrim = false;
+  if (batch == NULL)
+    batch = (Vtx *)malloc(BATCH_MAX * sizeof(Vtx));
+  nBatch = 0;
+  stPending = false;
+  dirty = false;
+  sLast = now();
+
+  LogInfo("GL: draw batching %s (XMOTO_GL_BATCH), level buffer %s "
+          "(XMOTO_GL_BLOCKS)",
+          on ? "on" : "off",
+          blocks ? "on" : "off");
+}
+
+void sync() {
+  sSyncs++;
+  flushAll();
+  applyAllState();
+  applyColour();
+  clientArray(GL_VERTEX_ARRAY, haveV, wantV);
+  clientArray(GL_TEXTURE_COORD_ARRAY, haveT, wantT);
+  clientArray(GL_COLOR_ARRAY, haveC, wantC);
+  if (haveVBO)
+    bindArrayBuffer(wantBuf);
+  dirty = false;
+}
+
+static bool lazyCap(GLenum cap, bool **w) {
+  switch (cap) {
+    case GL_TEXTURE_2D:
+      *w = &want.tex2d;
+      return true;
+    case GL_BLEND:
+      *w = &want.blend;
+      return true;
+    case GL_ALPHA_TEST:
+      *w = &want.alpha;
+      return true;
+  }
+  return false;
+}
+
+void enable(GLenum cap) {
+  bool *w;
+  if (!on || inGameBegin) {
+    glad_glEnable(cap);
+    return;
+  }
+  if (inPrim)
+    return; /* the GL ignores it inside glBegin/glEnd */
+  if (lazyCap(cap, &w)) {
+    *w = true;
+    markDirty();
+  } else {
+    pre();
+    glad_glEnable(cap);
+  }
+}
+
+void disable(GLenum cap) {
+  bool *w;
+  if (!on || inGameBegin) {
+    glad_glDisable(cap);
+    return;
+  }
+  if (inPrim)
+    return;
+  if (lazyCap(cap, &w)) {
+    *w = false;
+    markDirty();
+  } else {
+    pre();
+    glad_glDisable(cap);
+  }
+}
+
+void bindTexture(GLenum target, GLuint tex) {
+  if (!on || inGameBegin || target != GL_TEXTURE_2D) {
+    if (on && !inGameBegin)
+      pre();
+    glad_glBindTexture(target, tex);
+    return;
+  }
+  if (inPrim)
+    return;
+  want.tex = tex;
+  markDirty();
+}
+
+void deleteTextures(GLsizei n, const GLuint *tex) {
+  if (on)
+    pre();
+  glad_glDeleteTextures(n, tex);
+  for (GLsizei i = 0; i < n; i++) {
+    /* the GL binds 0 in place of a deleted bound texture */
+    if (have.tex == tex[i])
+      have.tex = 0;
+    if (want.tex == tex[i])
+      want.tex = 0;
+  }
+}
+
+void blendFunc(GLenum s, GLenum d) {
+  if (!on || inGameBegin) {
+    glad_glBlendFunc(s, d);
+    return;
+  }
+  if (inPrim)
+    return;
+  want.bsrc = s;
+  want.bdst = d;
+  markDirty();
+}
+
+void alphaFunc(GLenum f, GLclampf ref) {
+  if (!on || inGameBegin) {
+    glad_glAlphaFunc(f, ref);
+    return;
+  }
+  if (inPrim)
+    return;
+  want.afunc = f;
+  want.aref = ref;
+  markDirty();
+}
+
+void color4ub(GLubyte r, GLubyte g, GLubyte b, GLubyte a) {
+  if (!on || inGameBegin) {
+    glad_glColor4ub(r, g, b, a);
+    if (on) {
+      chaveKnown = false;
+      markDirty();
+    }
+    return;
+  }
+  /* allowed inside glBegin/glEnd: the current colour */
+  curUb[0] = r;
+  curUb[1] = g;
+  curUb[2] = b;
+  curUb[3] = a;
+  cwant.isFloat = false;
+  cwant.ub[0] = r;
+  cwant.ub[1] = g;
+  cwant.ub[2] = b;
+  cwant.ub[3] = a;
+  markDirty();
+}
+
+void color4f(GLfloat r, GLfloat g, GLfloat b, GLfloat a) {
+  if (!on || inGameBegin) {
+    glad_glColor4f(r, g, b, a);
+    if (on) {
+      chaveKnown = false;
+      markDirty();
+    }
+    return;
+  }
+  for (int i = 0; i < 4; i++) {
+    GLfloat c = i == 0 ? r : i == 1 ? g : i == 2 ? b : a;
+    c = c < 0.0f ? 0.0f : c > 1.0f ? 1.0f : c;
+    curUb[i] = (GLubyte)(c * 255.0f + 0.5f);
+  }
+  cwant.isFloat = true;
+  cwant.f[0] = r;
+  cwant.f[1] = g;
+  cwant.f[2] = b;
+  cwant.f[3] = a;
+  markDirty();
+}
+
+void enableClientState(GLenum a) {
+  if (!on) {
+    glad_glEnableClientState(a);
+    return;
+  }
+  switch (a) {
+    case GL_VERTEX_ARRAY:
+      wantV = true;
+      break;
+    case GL_TEXTURE_COORD_ARRAY:
+      wantT = true;
+      break;
+    case GL_COLOR_ARRAY:
+      wantC = true;
+      break;
+    default:
+      pre();
+      glad_glEnableClientState(a);
+      return;
+  }
+  markDirty();
+}
+
+void disableClientState(GLenum a) {
+  if (!on) {
+    glad_glDisableClientState(a);
+    return;
+  }
+  switch (a) {
+    case GL_VERTEX_ARRAY:
+      wantV = false;
+      break;
+    case GL_TEXTURE_COORD_ARRAY:
+      wantT = false;
+      break;
+    case GL_COLOR_ARRAY:
+      wantC = false;
+      break;
+    default:
+      pre();
+      glad_glDisableClientState(a);
+      return;
+  }
+  markDirty();
+}
+
+void bindBuffer(GLenum target, GLuint buf) {
+  if (!on || target != GL_ARRAY_BUFFER_ARB) {
+    if (on)
+      pre();
+    glad_glBindBufferARB(target, buf);
+    return;
+  }
+  wantBuf = buf;
+  markDirty();
+}
+
+void deleteBuffers(GLsizei n, const GLuint *buf) {
+  if (on)
+    pre();
+  glad_glDeleteBuffersARB(n, buf);
+  for (GLsizei i = 0; i < n; i++) {
+    if (haveBuf == buf[i])
+      haveBuf = 0;
+    if (wantBuf == buf[i])
+      wantBuf = 0;
+    if (arraysBuf == buf[i] && arrays == ARR_STATIC)
+      arrays = ARR_GAME;
+  }
+}
+
+void vertexPointer(GLint size, GLenum type, GLsizei stride, const void *p) {
+  if (on) {
+    pre();
+    arrays = ARR_GAME;
+  }
+  glad_glVertexPointer(size, type, stride, p);
+}
+
+void texCoordPointer(GLint size, GLenum type, GLsizei stride, const void *p) {
+  if (on) {
+    pre();
+    arrays = ARR_GAME;
+  }
+  glad_glTexCoordPointer(size, type, stride, p);
+}
+
+void drawArrays(GLenum mode, GLint first, GLsizei count) {
+  if (on) {
+    pre();
+    sDraws++;
+    sGameDraws++;
+  }
+  glad_glDrawArrays(mode, first, count);
+}
+
+void begin(GLenum mode) {
+  if (on) {
+    pre();
+    inGameBegin = true;
+    sDraws++;
+    sGameBegins++;
+  }
+  glad_glBegin(mode);
+}
+
+void end() {
+  glad_glEnd();
+  if (on) {
+    inGameBegin = false;
+    chaveKnown = false; /* glColor may have been called inside */
+    markDirty();
+  }
+}
+
+void primBegin() {
+  inPrim = true;
+}
+
+static inline void put(const Vtx &v) {
+  batch[nBatch++] = v;
+}
+
+void primEnd(GLenum mode, const Vtx *v, int n) {
+  inPrim = false;
+  GLenum target;
+  int need;
+
+  switch (mode) {
+    case GL_POLYGON:
+      if (n < 3)
+        return;
+      target = GL_TRIANGLES;
+      need = 3 * (n - 2);
+      break;
+    case GL_QUADS:
+      n -= n % 4;
+      if (n == 0)
+        return;
+      target = GL_TRIANGLES;
+      need = n / 4 * 6;
+      break;
+    case GL_TRIANGLES:
+      n -= n % 3;
+      if (n == 0)
+        return;
+      target = GL_TRIANGLES;
+      need = n;
+      break;
+    default: /* lines: drawn on their own, as they came */
+      if (n == 0)
+        return;
+      target = mode;
+      need = n;
+      break;
+  }
+  if (need > BATCH_MAX) {
+    /* too large for the batch: as the game did */
+    pre();
+    applyDrawState();
+    glad_glBegin(mode);
+    for (int i = 0; i < n; i++) {
+      glad_glColor4ub(v[i].c[0], v[i].c[1], v[i].c[2], v[i].c[3]);
+      glad_glTexCoord2f(v[i].u, v[i].v);
+      glad_glVertex2f(v[i].x, v[i].y);
+    }
+    glad_glEnd();
+    chaveKnown = false;
+    markDirty();
+    return;
+  }
+
+  flushStatic();
+  if (nBatch > 0 &&
+      (batchMode != target || target != GL_TRIANGLES ||
+       nBatch + need > BATCH_MAX || drawStateDiffers()))
+    flushBatch();
+  if (nBatch == 0) {
+    applyDrawState();
+    batchMode = target;
+  }
+
+  /* triangles in the order Mesa splits polygons and quads into (llvmpipe:
+     the same pixels as glBegin/glEnd) */
+  switch (mode) {
+    case GL_POLYGON:
+      for (int i = 0; i + 2 < n; i++) {
+        put(v[i + 1]);
+        put(v[i + 2]);
+        put(v[0]);
+      }
+      break;
+    case GL_QUADS:
+      for (int i = 0; i + 3 < n; i += 4) {
+        put(v[i + 0]);
+        put(v[i + 1]);
+        put(v[i + 2]);
+        put(v[i + 0]);
+        put(v[i + 2]);
+        put(v[i + 3]);
+      }
+      break;
+    default:
+      for (int i = 0; i < n; i++)
+        put(v[i]);
+      break;
+  }
+  markDirty();
+  if (target != GL_TRIANGLES)
+    flushBatch();
+}
+
+void drawStatic(GLuint buf, const void *base, GLenum mode, int first, int count) {
+  if (count <= 0)
+    return;
+
+  flushBatch();
+  if (stPending &&
+      (stBuf != buf || stBase != base || stMode != mode ||
+       stFirst + stCount != first || drawStateDiffers() || colourDiffers()))
+    flushStatic();
+  if (stPending) {
+    stCount += count;
+    return;
+  }
+  applyDrawState();
+  applyColour();
+  stPending = true;
+  stBuf = buf;
+  stBase = base;
+  stMode = mode;
+  stFirst = first;
+  stCount = count;
+  markDirty();
+}
+
+void frameEnd() {
+  if (!on)
+    return;
+  sync();
+  if (!stats)
+    return;
+  sFrames++;
+  double t = now();
+  if (t - sLast >= 5.0) {
+    double f = sFrames;
+    char line[512];
+    snprintf(line,
+             sizeof(line),
+             "GL stats: %.1f fps, per frame: %.1f draws (%.1f batched, %.1f "
+             "static ranges, %.1f game glDrawArrays, %.1f game glBegin), %.0f "
+             "vertices (%.0f from client memory), %.1f syncs",
+             f / (t - sLast),
+             sDraws / f,
+             sBatchDraws / f,
+             sStaticDraws / f,
+             sGameDraws / f,
+             sGameBegins / f,
+             sVerts / f,
+             sBatchVerts / f,
+             sSyncs / f);
+    LogInfo("%s", line);
+    fprintf(stderr, "%s\n", line);
+    sFrames = sDraws = sBatchDraws = sStaticDraws = sGameDraws = sGameBegins =
+      sVerts = sBatchVerts = sSyncs = 0;
+    sLast = t;
+  }
+}
+
+} // namespace xmgl
+
+#endif
