+/*
+ * Fewer, larger OpenGL draws (included by xm_OpenGL.h after glad.h).
+ *
+ * Every GL call of the game goes through the macros at the end of this file.
+ * The state the 2D drawing changes all the time (GL_TEXTURE_2D, GL_BLEND,
+ * GL_ALPHA_TEST, the bound texture, the blend and alpha functions, the
+ * current colour, the client arrays) is recorded and set on the GL only when
+ * something is drawn, and only where it differs. The primitives DrawLib draws
+ * (glBegin/glEnd before) are collected as triangles into one client vertex
+ * array and drawn with one glDrawArrays per run of equal state; the level's
+ * blocks are ranges of one static buffer (drawStatic), adjacent ranges with the
+ * same state being one draw. Any other GL call first draws what is pending and
+ * sets the recorded state, so the GL sees the same state at every draw as with
+ * the game's own calls, in the same order.
+ *
+ * XMOTO_GL_BATCH=0 turns it off (every call goes to the GL at once and DrawLib
+ * uses glBegin/glEnd again), XMOTO_GL_BLOCKS=0 the level buffer (the blocks
+ * drawn polygon by polygon again); XMOTO_GL_STATS=1 logs the GL draws per
+ * frame (stderr and xmoto.log, every 5 s).
+ */
+
+#ifndef __XM_GLBATCH_H__
+#define __XM_GLBATCH_H__
+
+namespace xmgl {
+
+struct Vtx {
+  float x, y, u, v;
+  unsigned char c[4];
+};
+
+extern bool on; /* XMOTO_GL_BATCH, read once at start */
+extern bool blocks; /* XMOTO_GL_BLOCKS (and on): blocks from one level buffer */
+extern bool dirty; /* something pending, or recorded state not on the GL */
+extern GLubyte curUb[4]; /* the current colour, for DrawLib's vertices */
+
+void init(); /* after the context exists */
+void sync(); /* draw what is pending, then put the recorded state on the GL */
+inline void pre() {
+  if (dirty)
+    sync();
+}
+
+/* recorded state (the macros below route the game's calls here) */
+void enable(GLenum cap);
+void disable(GLenum cap);
+void bindTexture(GLenum target, GLuint tex);
+void deleteTextures(GLsizei n, const GLuint *tex);
+void blendFunc(GLenum s, GLenum d);
+void alphaFunc(GLenum f, GLclampf ref);
+void color4ub(GLubyte r, GLubyte g, GLubyte b, GLubyte a);
+void color4f(GLfloat r, GLfloat g, GLfloat b, GLfloat a);
+void enableClientState(GLenum a);
+void disableClientState(GLenum a);
+void bindBuffer(GLenum target, GLuint buf);
+void deleteBuffers(GLsizei n, const GLuint *buf);
+void vertexPointer(GLint size, GLenum type, GLsizei stride, const void *p);
+void texCoordPointer(GLint size, GLenum type, GLsizei stride, const void *p);
+void drawArrays(GLenum mode, GLint first, GLsizei count);
+void begin(GLenum mode); /* the game's own glBegin/glEnd */
+void end();
+
+/* DrawLib: between primBegin and primEnd state changes are ignored, as the GL
+   ignores them inside glBegin/glEnd */
+void primBegin();
+/* mode: GL_POLYGON, GL_QUADS, GL_TRIANGLES, GL_LINE_LOOP, GL_LINE_STRIP;
+   vertices in the order glVertex got them */
+void primEnd(GLenum mode, const Vtx *v, int n);
+
+/* a range of a static buffer of x,y,u,v floats (buf 0: client memory at base),
+   drawn with the recorded state and current colour */
+void drawStatic(GLuint buf, const void *base, GLenum mode, int first, int count);
+
+void frameEnd(); /* before the swap: draws what is pending, counts the frame */
+
+} // namespace xmgl
+
+#ifndef XM_GLBATCH_IMPL
+/* state the layer records */
+#undef glEnable
+#define glEnable(c) xmgl::enable(c)
+#undef glDisable
+#define glDisable(c) xmgl::disable(c)
+#undef glBindTexture
+#define glBindTexture(t, x) xmgl::bindTexture(t, x)
+#undef glDeleteTextures
+#define glDeleteTextures(n, x) xmgl::deleteTextures(n, x)
+#undef glBlendFunc
+#define glBlendFunc(s, d) xmgl::blendFunc(s, d)
+#undef glAlphaFunc
+#define glAlphaFunc(f, r) xmgl::alphaFunc(f, r)
+#undef glColor4ub
+#define glColor4ub(r, g, b, a) xmgl::color4ub(r, g, b, a)
+#undef glColor4f
+#define glColor4f(r, g, b, a) xmgl::color4f(r, g, b, a)
+#undef glEnableClientState
+#define glEnableClientState(a) xmgl::enableClientState(a)
+#undef glDisableClientState
+#define glDisableClientState(a) xmgl::disableClientState(a)
+#undef glBindBufferARB
+#define glBindBufferARB(t, b) xmgl::bindBuffer(t, b)
+#undef glDeleteBuffersARB
+#define glDeleteBuffersARB(n, b) xmgl::deleteBuffers(n, b)
+#undef glVertexPointer
+#define glVertexPointer(s, t, st, p) xmgl::vertexPointer(s, t, st, p)
+#undef glTexCoordPointer
+#define glTexCoordPointer(s, t, st, p) xmgl::texCoordPointer(s, t, st, p)
+#undef glDrawArrays
+#define glDrawArrays(m, f, c) xmgl::drawArrays(m, f, c)
+#undef glBegin
+#define glBegin(m) xmgl::begin(m)
+#undef glEnd
+#define glEnd() xmgl::end()
+
+/* everything else: what is pending first */
+#define XMGL_PRE(f, ...) (xmgl::pre(), glad_##f(__VA_ARGS__))
+#undef glAttachObjectARB
+#define glAttachObjectARB(...) XMGL_PRE(glAttachObjectARB, __VA_ARGS__)
+#undef glBindFramebufferEXT
+#define glBindFramebufferEXT(...) XMGL_PRE(glBindFramebufferEXT, __VA_ARGS__)
+#undef glBufferDataARB
+#define glBufferDataARB(...) XMGL_PRE(glBufferDataARB, __VA_ARGS__)
+#undef glClear
+#define glClear(...) XMGL_PRE(glClear, __VA_ARGS__)
+#undef glClearColor
+#define glClearColor(...) XMGL_PRE(glClearColor, __VA_ARGS__)
+#undef glCompileShaderARB
+#define glCompileShaderARB(...) XMGL_PRE(glCompileShaderARB, __VA_ARGS__)
+#undef glCreateProgramObjectARB
+#define glCreateProgramObjectARB() (xmgl::pre(), glad_glCreateProgramObjectARB())
+#undef glCreateShaderObjectARB
+#define glCreateShaderObjectARB(...) XMGL_PRE(glCreateShaderObjectARB, __VA_ARGS__)
+#undef glDeleteFramebuffersEXT
+#define glDeleteFramebuffersEXT(...) XMGL_PRE(glDeleteFramebuffersEXT, __VA_ARGS__)
+#undef glFramebufferTexture2DEXT
+#define glFramebufferTexture2DEXT(...) XMGL_PRE(glFramebufferTexture2DEXT, __VA_ARGS__)
+#undef glGenBuffersARB
+#define glGenBuffersARB(...) XMGL_PRE(glGenBuffersARB, __VA_ARGS__)
+#undef glGenFramebuffersEXT
+#define glGenFramebuffersEXT(...) XMGL_PRE(glGenFramebuffersEXT, __VA_ARGS__)
+#undef glGenTextures
+#define glGenTextures(...) XMGL_PRE(glGenTextures, __VA_ARGS__)
+#undef glGetFloatv
+#define glGetFloatv(...) XMGL_PRE(glGetFloatv, __VA_ARGS__)
+#undef glGetInfoLogARB
+#define glGetInfoLogARB(...) XMGL_PRE(glGetInfoLogARB, __VA_ARGS__)
+#undef glGetIntegerv
+#define glGetIntegerv(...) XMGL_PRE(glGetIntegerv, __VA_ARGS__)
+#undef glGetObjectParameterivARB
+#define glGetObjectParameterivARB(...) XMGL_PRE(glGetObjectParameterivARB, __VA_ARGS__)
+#undef glLineWidth
+#define glLineWidth(...) XMGL_PRE(glLineWidth, __VA_ARGS__)
+#undef glLinkProgramARB
+#define glLinkProgramARB(...) XMGL_PRE(glLinkProgramARB, __VA_ARGS__)
+#undef glLoadIdentity
+#define glLoadIdentity() (xmgl::pre(), glad_glLoadIdentity())
+#undef glMatrixMode
+#define glMatrixMode(...) XMGL_PRE(glMatrixMode, __VA_ARGS__)
+#undef glOrtho
+#define glOrtho(...) XMGL_PRE(glOrtho, __VA_ARGS__)
+#undef glPopMatrix
+#define glPopMatrix() (xmgl::pre(), glad_glPopMatrix())
+#undef glPushMatrix
+#define glPushMatrix() (xmgl::pre(), glad_glPushMatrix())
+#undef glReadBuffer
+#define glReadBuffer(...) XMGL_PRE(glReadBuffer, __VA_ARGS__)
+#undef glReadPixels
+#define glReadPixels(...) XMGL_PRE(glReadPixels, __VA_ARGS__)
+#undef glRotatef
+#define glRotatef(...) XMGL_PRE(glRotatef, __VA_ARGS__)
+#undef glScalef
+#define glScalef(...) XMGL_PRE(glScalef, __VA_ARGS__)
+#undef glScissor
+#define glScissor(...) XMGL_PRE(glScissor, __VA_ARGS__)
+#undef glShaderSourceARB
+#define glShaderSourceARB(...) XMGL_PRE(glShaderSourceARB, __VA_ARGS__)
+#undef glTexImage2D
+#define glTexImage2D(...) XMGL_PRE(glTexImage2D, __VA_ARGS__)
+#undef glTexParameteri
+#define glTexParameteri(...) XMGL_PRE(glTexParameteri, __VA_ARGS__)
+#undef glTranslatef
+#define glTranslatef(...) XMGL_PRE(glTranslatef, __VA_ARGS__)
+#undef glUseProgramObjectARB
+#define glUseProgramObjectARB(...) XMGL_PRE(glUseProgramObjectARB, __VA_ARGS__)
+#undef glViewport
+#define glViewport(...) XMGL_PRE(glViewport, __VA_ARGS__)
+/* inside the game's own glBegin/glEnd, which begin() starts with a sync */
+/* glVertex2f, glVertex2i, glTexCoord2f go to the GL directly */
+#endif
+
+#endif
