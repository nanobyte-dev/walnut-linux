From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Fri, 16 Oct 2026 02:48:56 +0300
Subject: nvfx: 32-bit colour exports from fragment programs (NV40)

FP_CONTROL bit 6 takes colour outputs from the fp32 registers: closer to softpipe
(NV40_FP_EXPORT32=0 turns it off).

Forwarded: no

diff --git a/src/gallium/drivers/nouveau/nv30/nvfx_fragprog.c b/src/gallium/drivers/nouveau/nv30/nvfx_fragprog.c
--- a/src/gallium/drivers/nouveau/nv30/nvfx_fragprog.c
+++ b/src/gallium/drivers/nouveau/nv30/nvfx_fragprog.c
@@ -33,6 +33,7 @@ struct nvfx_fpc {
    unsigned inst_offset;
    unsigned have_const;
    unsigned is_nv4x;
+   bool export32;	/* colour from the fp32 registers R0/R2-R4 instead of H0/H4-H8 */
 
    struct util_dynarray imm_data;
 
@@ -169,7 +170,7 @@ emit_dst(struct nvfx_fpc *fpc, struct nvfx_reg dst)
    case NVFXSR_OUTPUT:
       if (dst.index == 1)
          fp->fp_control |= 0x0000000e;
-      else {
+      else if (!fpc->export32) {
          hw[0] |= NVFX_FP_OP_OUT_REG_HALF;
          dst.index <<= 1;
       }
@@ -1083,6 +1084,12 @@ _nvfx_fragprog_translate(uint16_t oclass, struct nv30_fragprog *fp)
       goto out_err;
 
    fpc->is_nv4x = (oclass >= NV40_3D_CLASS) ? ~0 : 0;
+   /* NV40 FP_CONTROL bit 6 (libgcm: 32-bit exports) takes the colour outputs from R0, R2-R4
+    * instead of the fp16 H0, H4-H8: colours then round like a fp32 pipeline's (fp16 output put
+    * 2193 bytes of the gears test 1 off softpipe, fp32 282). NV40_FP_EXPORT32=0 turns it off. */
+   fpc->export32 = fpc->is_nv4x && debug_get_bool_option("NV40_FP_EXPORT32", true);
+   if (fpc->export32)
+      fp->fp_control |= 0x00000040;
    fpc->max_temps = fpc->is_nv4x ? 48 : 32;
    fpc->fp = fp;
    fpc->num_regs = 2;
