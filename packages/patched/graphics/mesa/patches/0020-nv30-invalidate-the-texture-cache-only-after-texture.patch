diff --git a/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c b/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c
@@ -157,12 +157,18 @@ nv30_fragtex_sampler_states_bind(struct pipe_context *pipe,
    struct nv30_context *nv30 = nv30_context(pipe);
    unsigned i;
 
+   /* The state tracker binds all its samplers when any changes: a unit keeping its sampler
+    * (and its view, nv30_fragtex_set_sampler_views) needs no new texture state. */
    for (i = 0; i < nr; i++) {
+      if (nv30->fragprog.samplers[i] == hwcso[i])
+         continue;
       nv30->fragprog.samplers[i] = hwcso[i];
       nv30->fragprog.dirty_samplers |= (1 << i);
    }
 
    for (; i < nv30->fragprog.num_samplers; i++) {
+      if (!nv30->fragprog.samplers[i])
+         continue;
       nv30->fragprog.samplers[i] = NULL;
       nv30->fragprog.dirty_samplers |= (1 << i);
    }
@@ -179,13 +185,20 @@ nv30_fragtex_set_sampler_views(struct pipe_context *pipe, unsigned nr,
    struct nv30_context *nv30 = nv30_context(pipe);
    unsigned i;
 
+   /* The state tracker passes all its views when any changes. A unit whose view stays the
+    * same object (it holds a reference, so the same pointer is the same view of the same
+    * texture) keeps its texture state and its buffer reference, unless its sampler changed. */
    for (i = 0; i < nr; i++) {
+      if (nv30->fragprog.textures[i] == views[i])
+         continue;
       nouveau_bufctx_reset(nv30->bufctx, BUFCTX_FRAGTEX(i));
       pipe_sampler_view_reference(&nv30->fragprog.textures[i], views[i]);
       nv30->fragprog.dirty_samplers |= (1 << i);
    }
 
    for (; i < nv30->fragprog.num_textures; i++) {
+      if (!nv30->fragprog.textures[i])
+         continue;
       nouveau_bufctx_reset(nv30->bufctx, BUFCTX_FRAGTEX(i));
       pipe_sampler_view_reference(&nv30->fragprog.textures[i], NULL);
       nv30->fragprog.dirty_samplers |= (1 << i);
