diff --git a/src/gallium/drivers/nouveau/nv30/nv30_state.c b/src/gallium/drivers/nouveau/nv30/nv30_state.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_state.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_state.c
@@ -332,9 +332,43 @@ nv30_set_constant_buffer(struct pipe_context *pipe,
 {
    struct nv30_context *nv30 = nv30_context(pipe);
    struct pipe_resource *buf = cb ? cb->buffer : NULL;
+   struct pipe_resource **pconst, **puser;
+   unsigned *pnr;
    unsigned size;
 
+   if (shader == MESA_SHADER_VERTEX) {
+      pconst = &nv30->vertprog.constbuf;
+      puser = &nv30->vertprog.constbuf_user;
+      pnr = &nv30->vertprog.constbuf_nr;
+      nv30->dirty |= NV30_NEW_VERTCONST;
+   } else
+   if (shader == MESA_SHADER_FRAGMENT) {
+      pconst = &nv30->fragprog.constbuf;
+      puser = &nv30->fragprog.constbuf_user;
+      pnr = &nv30->fragprog.constbuf_nr;
+      nv30->dirty |= NV30_NEW_FRAGCONST;
+   } else
+      return;
+
    if (cb && cb->user_buffer) {
+      /* The state tracker passes new user constants whenever they change, which in
+       * fixed-function GL is about every draw (a new modelview matrix per object). Only the
+       * wrapper's data pointer is ever read (vertprog/fragprog validate, swtnl): while this
+       * context holds the only reference to the wrapper it made last time, point that one
+       * at the new memory instead of allocating a wrapper per call and freeing the last. */
+      struct pipe_resource *user = *puser;
+
+      if (user && user == *pconst && p_atomic_read(&user->reference.count) == 1) {
+         struct nv04_resource *res = nv04_resource(user);
+
+         res->data = (void *)cb->user_buffer;
+         user->width0 = cb->buffer_size;
+         util_range_set_empty(&res->valid_buffer_range);
+         util_range_add(user, &res->valid_buffer_range, 0, cb->buffer_size);
+         *pnr = cb->buffer_size / (4 * sizeof(float));
+         return;
+      }
+
       buf = nouveau_user_buffer_create(pipe->screen, (void*)cb->user_buffer,
                                        cb->buffer_size,
                                        PIPE_BIND_CONSTANT_BUFFER);
@@ -344,18 +378,12 @@ nv30_set_constant_buffer(struct pipe_context *pipe,
    if (buf)
       size = buf->width0 / (4 * sizeof(float));
 
-   if (shader == MESA_SHADER_VERTEX) {
-      pipe_resource_reference(&nv30->vertprog.constbuf, buf);
-      nv30->vertprog.constbuf_nr = size;
-      nv30->dirty |= NV30_NEW_VERTCONST;
-   } else
-   if (shader == MESA_SHADER_FRAGMENT) {
-      pipe_resource_reference(&nv30->fragprog.constbuf, buf);
-      nv30->fragprog.constbuf_nr = size;
-      nv30->dirty |= NV30_NEW_FRAGCONST;
-   }
+   pipe_resource_reference(pconst, buf);
+   *pnr = size;
+   *puser = NULL;
 
    if (cb && cb->user_buffer) {
+      *puser = buf;
       pipe_resource_reference(&buf, NULL);
    }
 }
