diff --git a/src/mesa/main/texforcedxt.c b/src/mesa/main/texforcedxt.c
new file mode 100644
--- /dev/null
+++ b/src/mesa/main/texforcedxt.c
@@ -0,0 +1,384 @@
+/*
+ * Texture compression at upload, for games that upload plain RGB(A)8 textures (PS3: VRAM is also
+ * the swap tier, and DXT1 takes an eighth of an X8R8G8B8 texture, DXT5 a quarter).
+ *
+ * NV30_FORCE_DXT=off (default) | opaque | all. A glTexImage2D the policy takes
+ * (texforcedxt_policy.h) gets a DXT TexFormat while its InternalFormat stays what the game asked
+ * for; Mesa's S3TC texstore then compresses it (through libspeq on the PS3: the SPEs, RGB and RGBA
+ * sources directly), as for any compressed upload. Levels above 0 follow level 0 (Mesa's choice
+ * of a level's format from the level below). Afterwards:
+ * - glTexSubImage on whole 4x4 blocks: those blocks compressed again from the new pixels;
+ *   anything else, glCopyTexSubImage and a framebuffer attachment: every compressed-at-upload
+ *   level is decoded (st_GetTexSubImage: a GPU blit on nv30) and specified again uncompressed,
+ *   so the texture is from then on what the game asked for (once per texture);
+ * - glGenerateMipmap: Mesa's path for compressed textures (the base decoded, the levels made on
+ *   the CPU and compressed: libspeq again), counted and timed;
+ * - glGetTexImage returns the decoded blocks; GL_TEXTURE_INTERNAL_FORMAT stays the game's,
+ *   GL_TEXTURE_COMPRESSED tells the truth (the spec allows storing a generic format compressed).
+ * NV30_FORCE_DXT_MIN (64): smallest width and height; NV30_FORCE_DXT_NEAREST=1: also textures
+ * magnified with GL_NEAREST (kept by default: pixel art and UI drawn 1:1 show DXT's blocks most);
+ * NV30_FORCE_DXT_STATS=N: a "nv30-forcedxt:" line on stderr every N compressed textures, at every
+ * return to uncompressed and at context destruction; NV30_FORCE_DXT_DEBUG=1: a line per decision.
+ * The name says NV30 (the PS3's switches are NV30_*), but this is core Mesa: any driver with
+ * native DXT1/DXT5 sampling takes it, softpipe included (the host check).
+ */
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "c11/threads.h"
+#include "util/detect_arch.h"
+#include "util/os_misc.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+#include "context.h"
+#include "enums.h"
+#include "errors.h"
+#include "image.h"
+#include "mtypes.h"
+#include "pixel.h"
+#include "teximage.h"
+#include "texforcedxt.h"
+#include "texforcedxt_policy.h"
+#include "state_tracker/st_cb_texture.h"
+#include "state_tracker/st_context.h"
+#include "pipe/p_screen.h"
+
+static struct {
+   enum fdxt_mode mode;
+   unsigned min, stats_every;
+   bool nearest_ok, debug;
+} cfg;
+
+/* process totals (every context; atomics) */
+static struct {
+   uint64_t tex, dxt1, dxt5, levels, kb_raw, kb_dxt;   /* compressed at upload: level 0 + levels */
+   uint64_t sub, sub_kb;                               /* sub-image updates stored compressed */
+   uint64_t unforced, unforced_kb;                     /* textures (levels' KiB) back uncompressed */
+   uint64_t mipgen, mipgen_us, scan_us;
+   uint64_t why[FDXT_WHY_COUNT];
+} tot;
+
+static once_flag cfg_once = ONCE_FLAG_INIT;
+/* set while a texture is specified again uncompressed (no decision then) */
+static __thread bool suspended;
+
+static void
+cfg_load(void)
+{
+   const char *m = os_get_option("NV30_FORCE_DXT");
+   const char *v;
+
+   cfg.mode = FDXT_OFF;
+   if (m && (!strcmp(m, "opaque") || !strcmp(m, "1")))
+      cfg.mode = FDXT_OPAQUE;
+   else if (m && !strcmp(m, "all"))
+      cfg.mode = FDXT_ALL;
+   else if (m && strcmp(m, "off") && strcmp(m, "0"))
+      fprintf(stderr, "nv30-forcedxt: NV30_FORCE_DXT=%s unknown (off, opaque, all): off\n", m);
+   v = os_get_option("NV30_FORCE_DXT_MIN");
+   cfg.min = v ? MAX2(atoi(v), 4) : 64;
+   v = os_get_option("NV30_FORCE_DXT_NEAREST");
+   cfg.nearest_ok = v && atoi(v) > 0;
+   v = os_get_option("NV30_FORCE_DXT_STATS");
+   cfg.stats_every = v ? MAX2(atoi(v), 0) : 0;
+   v = os_get_option("NV30_FORCE_DXT_DEBUG");
+   cfg.debug = v && atoi(v) > 0;
+}
+
+static inline enum fdxt_mode
+mode(void)
+{
+   call_once(&cfg_once, cfg_load);
+   return cfg.mode;
+}
+
+static void
+report(const char *event)
+{
+   char why[384];
+   int n = 0;
+
+   for (int i = FDXT_WHY_LEVEL; i < FDXT_WHY_COUNT && n < (int)sizeof(why) - 32; i++)
+      n += snprintf(why + n, sizeof(why) - n, " skip_%s=%" PRIu64, fdxt_why_name[i],
+                    p_atomic_read(&tot.why[i]));
+   fprintf(stderr, "nv30-forcedxt: %s mode=%s min=%u tex=%" PRIu64 " dxt1=%" PRIu64
+           " dxt5=%" PRIu64 " levels=%" PRIu64 " kb_raw=%" PRIu64 " kb_dxt=%" PRIu64
+           " sub=%" PRIu64 " sub_kb=%" PRIu64 " unforced=%" PRIu64 " unforced_kb=%" PRIu64
+           " mipgen=%" PRIu64 " mipgen_ms=%" PRIu64 " scan_ms=%" PRIu64 "%s\n",
+           event, cfg.mode == FDXT_ALL ? "all" : cfg.mode == FDXT_OPAQUE ? "opaque" : "off",
+           cfg.min, p_atomic_read(&tot.tex), p_atomic_read(&tot.dxt1), p_atomic_read(&tot.dxt5),
+           p_atomic_read(&tot.levels), p_atomic_read(&tot.kb_raw) / 1024,
+           p_atomic_read(&tot.kb_dxt) / 1024, p_atomic_read(&tot.sub),
+           p_atomic_read(&tot.sub_kb) / 1024, p_atomic_read(&tot.unforced),
+           p_atomic_read(&tot.unforced_kb) / 1024, p_atomic_read(&tot.mipgen),
+           p_atomic_read(&tot.mipgen_us) / 1000, p_atomic_read(&tot.scan_us) / 1000, why);
+}
+
+void
+_mesa_force_dxt_report_end(void)
+{
+   if (mode() != FDXT_OFF && cfg.stats_every)
+      report("end");
+}
+
+/* at exit (or unload) too: games often exit without destroying their context */
+static void __attribute__((destructor))
+report_exit(void)
+{
+   if (cfg.mode != FDXT_OFF && cfg.stats_every)
+      report("exit");
+}
+
+static bool
+is_forced_format(mesa_format f)
+{
+   return f == MESA_FORMAT_RGB_DXT1 || f == MESA_FORMAT_RGBA_DXT5;
+}
+
+bool
+_mesa_force_dxt_image(const struct gl_texture_image *img)
+{
+   /* a plain internal format is never stored as DXT otherwise */
+   return img && is_forced_format(img->TexFormat) && fdxt_internal_comps(img->InternalFormat) &&
+          mode() != FDXT_OFF;
+}
+
+static bool
+native_s3tc(struct gl_context *ctx)
+{
+   struct pipe_screen *screen = st_context(ctx)->screen;
+
+   return ctx->Extensions.EXT_texture_compression_s3tc &&
+          screen->is_format_supported(screen, PIPE_FORMAT_DXT1_RGB, PIPE_TEXTURE_2D, 0, 0,
+                                      PIPE_BIND_SAMPLER_VIEW) &&
+          screen->is_format_supported(screen, PIPE_FORMAT_DXT5_RGBA, PIPE_TEXTURE_2D, 0, 0,
+                                      PIPE_BIND_SAMPLER_VIEW);
+}
+
+/* level > 0 of a texture whose levels follow a compressed-at-upload level 0: counted */
+static void
+count_level(int w, int h, enum fdxt_result r)
+{
+   p_atomic_inc(&tot.levels);
+   p_atomic_add(&tot.kb_raw, fdxt_level_bytes(w, h, FDXT_KEEP));
+   p_atomic_add(&tot.kb_dxt, fdxt_level_bytes(w, h, r));
+}
+
+mesa_format
+_mesa_force_dxt_choose(struct gl_context *ctx, struct gl_texture_object *texObj, GLuint dims,
+                       GLenum target, GLint level, GLint internalFormat, GLsizei width,
+                       GLsizei height, GLsizei depth, GLint border, GLenum format, GLenum type,
+                       const GLvoid *pixels, const struct gl_pixelstore_attrib *unpack,
+                       mesa_format texFormat)
+{
+   struct fdxt_request r;
+   enum fdxt_result res;
+   enum fdxt_why why;
+
+   if (mode() == FDXT_OFF || suspended || target != GL_TEXTURE_2D || dims != 2)
+      return texFormat;
+   if (level > 0) {
+      /* the format came from the level below (_mesa_choose_texture_format) */
+      if (is_forced_format(texFormat) && fdxt_internal_comps(internalFormat))
+         count_level(width, height,
+                     texFormat == MESA_FORMAT_RGB_DXT1 ? FDXT_DXT1 : FDXT_DXT5);
+      return texFormat;
+   }
+
+   _mesa_update_pixel(ctx);
+   memset(&r, 0, sizeof(r));
+   r.mode = cfg.mode;
+   r.min = cfg.min;
+   r.nearest_ok = cfg.nearest_ok;
+   r.dims = dims;
+   r.target_2d = true;
+   r.level = level;
+   r.internal_format = internalFormat;
+   r.format = format;
+   r.type = type;
+   r.width = width;
+   r.height = height;
+   r.depth = depth;
+   r.border = border;
+   r.has_data = pixels || unpack->BufferObj;
+   r.transfer_ops = ctx->_ImageTransferState != 0;
+   r.swap_bytes = unpack->SwapBytes;
+   r.mag_nearest = texObj && texObj->Sampler.Attrib.MagFilter == GL_NEAREST;
+   r.s3tc = true;     /* checked below, after the cheap tests */
+
+   res = fdxt_decide(&r, !UTIL_ARCH_LITTLE_ENDIAN, &why);
+   if (res != FDXT_KEEP && !native_s3tc(ctx)) {
+      res = FDXT_KEEP;
+      why = FDXT_WHY_NOS3TC;
+   }
+   /* a level 1 already there uncompressed (levels uploaded smallest first, or a texture made
+    * with glTexImage2D(NULL) and given data later): level 0 stays alike, or the texture would be
+    * incomplete (every level must have one format) */
+   if (res != FDXT_KEEP && texObj) {
+      const struct gl_texture_image *l1 = texObj->Image[0][1];
+
+      if (l1 && l1->Width > 0 && l1->InternalFormat == internalFormat &&
+          !is_forced_format(l1->TexFormat)) {
+         res = FDXT_KEEP;
+         why = FDXT_WHY_LEVEL;
+      }
+   }
+   if (res == FDXT_CHECK_ALPHA) {
+      bool opaque = false;
+
+      if (!unpack->BufferObj) {   /* a PBO's alpha is taken as not opaque (no map for a scan) */
+         int64_t t0 = os_time_get_nano();
+         const uint8_t *src = _mesa_image_address2d(unpack, pixels, width, height, format,
+                                                    type, 0, 0);
+         int stride = _mesa_image_row_stride(unpack, width, format, type);
+
+         opaque = fdxt_alpha_opaque(src, width, height, stride,
+                                    fdxt_src_alpha_byte(format, type, !UTIL_ARCH_LITTLE_ENDIAN));
+         p_atomic_add(&tot.scan_us, (os_time_get_nano() - t0) / 1000);
+      }
+      res = fdxt_alpha_result(cfg.mode, opaque, &why);
+   }
+   if (res == FDXT_KEEP) {
+      if (why >= FDXT_WHY_LEVEL)
+         p_atomic_inc(&tot.why[why]);
+      if (cfg.debug && why >= FDXT_WHY_LEVEL)
+         fprintf(stderr, "nv30-forcedxt: %dx%d %s %s/%s kept (%s)\n", width, height,
+                 _mesa_enum_to_string(internalFormat), _mesa_enum_to_string(format),
+                 _mesa_enum_to_string(type), fdxt_why_name[why]);
+      return texFormat;
+   }
+
+   p_atomic_inc(&tot.tex);
+   p_atomic_inc(res == FDXT_DXT1 ? &tot.dxt1 : &tot.dxt5);
+   count_level(width, height, res);
+   if (cfg.debug)
+      fprintf(stderr, "nv30-forcedxt: %dx%d %s %s/%s texture %u -> %s\n", width, height,
+              _mesa_enum_to_string(internalFormat), _mesa_enum_to_string(format),
+              _mesa_enum_to_string(type), texObj ? texObj->Name : 0,
+              res == FDXT_DXT1 ? "dxt1" : "dxt5");
+   if (cfg.stats_every && !(p_atomic_read(&tot.tex) % cfg.stats_every))
+      report("tex");
+   return res == FDXT_DXT1 ? MESA_FORMAT_RGB_DXT1 : MESA_FORMAT_RGBA_DXT5;
+}
+
+void
+_mesa_force_dxt_unforce(struct gl_context *ctx, struct gl_texture_object *texObj,
+                        const char *why)
+{
+   uint64_t kb = 0;
+   int n = 0;
+
+   if (mode() == FDXT_OFF || !texObj || texObj->Target != GL_TEXTURE_2D || suspended)
+      return;
+   /* Every level is read first: once level 0 is specified again, the texture's resource is a new
+    * one, and the other levels' images still point at the old one in a way st_GetTexSubImage
+    * no longer reads right (it takes an image whose resource isn't the texture's for a level of
+    * its own). Then from level 0 up, so Mesa's choice of a level's format from the level below
+    * gives each the uncompressed format too. */
+   GLubyte *bufs[MAX_TEXTURE_LEVELS] = { 0 };
+   GLint ifmt[MAX_TEXTURE_LEVELS];
+   int wh[MAX_TEXTURE_LEVELS][2];
+
+   for (int level = 0; level < MAX_TEXTURE_LEVELS; level++) {
+      struct gl_texture_image *img = texObj->Image[0][level];
+      struct gl_pixelstore_attrib save;
+
+      if (!_mesa_force_dxt_image(img))
+         continue;
+      wh[level][0] = img->Width;
+      wh[level][1] = img->Height;
+      ifmt[level] = img->InternalFormat;
+      bufs[level] = malloc((size_t)img->Width * img->Height * 4);
+      if (!bufs[level]) {
+         _mesa_error(ctx, GL_OUT_OF_MEMORY, "NV30_FORCE_DXT: decompress");
+         for (int l = 0; l < level; l++)
+            free(bufs[l]);
+         return;
+      }
+      save = ctx->Pack;
+      ctx->Pack = ctx->DefaultPacking;
+      st_GetTexSubImage(ctx, 0, 0, 0, img->Width, img->Height, 1, GL_RGBA, GL_UNSIGNED_BYTE,
+                        bufs[level], img);
+      ctx->Pack = save;
+   }
+   for (int level = 0; level < MAX_TEXTURE_LEVELS; level++) {
+      if (!bufs[level])
+         continue;
+      suspended = true;
+      _mesa_force_dxt_respecify(ctx, texObj, level, ifmt[level], wh[level][0], wh[level][1],
+                                bufs[level]);
+      suspended = false;
+      free(bufs[level]);
+      kb += fdxt_level_bytes(wh[level][0], wh[level][1], FDXT_KEEP);
+      n++;
+   }
+   if (!n)
+      return;
+   p_atomic_inc(&tot.unforced);
+   p_atomic_add(&tot.unforced_kb, kb);
+   if (cfg.debug || cfg.stats_every) {
+      char ev[64];
+
+      snprintf(ev, sizeof(ev), "unforced why=%s texture=%u levels=%d", why, texObj->Name, n);
+      report(ev);
+   }
+}
+
+void
+_mesa_force_dxt_subimage(struct gl_context *ctx, struct gl_texture_object *texObj,
+                         struct gl_texture_image *img, GLint xoffset, GLint yoffset,
+                         GLsizei width, GLsizei height, bool count)
+{
+   if (!_mesa_force_dxt_image(img) || suspended)
+      return;
+   if (!fdxt_sub_aligned(xoffset, yoffset, width, height, img->Width, img->Height)) {
+      _mesa_force_dxt_unforce(ctx, texObj, "subimage");
+      return;
+   }
+   if (count && width > 0 && height > 0) {
+      p_atomic_inc(&tot.sub);
+      p_atomic_add(&tot.sub_kb, (uint64_t)width * height * 4);
+   }
+}
+
+void
+_mesa_force_dxt_copy(struct gl_context *ctx, struct gl_texture_object *texObj, GLenum target,
+                     GLint level)
+{
+   if (mode() == FDXT_OFF || !texObj || target != GL_TEXTURE_2D || level < 0 ||
+       level >= MAX_TEXTURE_LEVELS)
+      return;
+   if (_mesa_force_dxt_image(texObj->Image[0][level]))
+      _mesa_force_dxt_unforce(ctx, texObj, "copy");
+}
+
+int64_t
+_mesa_force_dxt_mipgen_begin(struct gl_texture_object *texObj)
+{
+   if (mode() == FDXT_OFF || texObj->Target != GL_TEXTURE_2D ||
+       texObj->Attrib.BaseLevel >= MAX_TEXTURE_LEVELS ||
+       !_mesa_force_dxt_image(texObj->Image[0][texObj->Attrib.BaseLevel]))
+      return 0;
+   return MAX2(os_time_get_nano(), 1);
+}
+
+void
+_mesa_force_dxt_mipgen_end(struct gl_texture_object *texObj, int64_t t0)
+{
+   if (!t0)
+      return;
+   p_atomic_inc(&tot.mipgen);
+   p_atomic_add(&tot.mipgen_us, (os_time_get_nano() - t0) / 1000);
+   /* the levels made, counted as uploads */
+   for (int level = texObj->Attrib.BaseLevel + 1; level < MAX_TEXTURE_LEVELS; level++) {
+      struct gl_texture_image *img = texObj->Image[0][level];
+
+      if (_mesa_force_dxt_image(img))
+         count_level(img->Width, img->Height,
+                     img->TexFormat == MESA_FORMAT_RGB_DXT1 ? FDXT_DXT1 : FDXT_DXT5);
+   }
+}
