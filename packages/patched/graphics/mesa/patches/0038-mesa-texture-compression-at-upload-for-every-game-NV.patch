new file mode 100644
--- /dev/null
+++ b/src/mesa/main/texforcedxt.h
@@ -0,0 +1,66 @@
+/*
+ * Texture compression at upload (texforcedxt.c): plain RGB(A)8 2D textures stored as DXT1 (or
+ * DXT5) by Mesa's S3TC texstore, which compresses through libspeq on the PS3's SPEs.
+ * NV30_FORCE_DXT=off (default) | opaque | all; the decision is texforcedxt_policy.h.
+ */
+#ifndef TEXFORCEDXT_H
+#define TEXFORCEDXT_H
+
+#include <stdbool.h>
+#include "util/glheader.h"
+#include "formats.h"
+
+struct gl_context;
+struct gl_texture_object;
+struct gl_texture_image;
+struct gl_pixelstore_attrib;
+
+/* glTexImage (teximage.c): the format to store the image in, texFormat or a DXT format */
+mesa_format
+_mesa_force_dxt_choose(struct gl_context *ctx, struct gl_texture_object *texObj, GLuint dims,
