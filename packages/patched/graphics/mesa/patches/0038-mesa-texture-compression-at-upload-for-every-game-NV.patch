diff --git a/src/mesa/main/texforcedxt_policy.h b/src/mesa/main/texforcedxt_policy.h
new file mode 100644
--- /dev/null
+++ b/src/mesa/main/texforcedxt_policy.h
@@ -0,0 +1,209 @@
+/*
+ * Texture compression at upload (NV30_FORCE_DXT, texforcedxt.c): the decision alone, plain C with
+ * no Mesa state, so it can be tested on its own (the PS3 tree's mesa/tests/forcedxt-policy-test.c).
+ *
+ * A glTexImage2D of an 8-bit RGB(A) image with a plain internal format (GL_RGB, GL_RGB8, 3,
+ * GL_RGBA, GL_RGBA8, 4) into GL_TEXTURE_2D level 0 is stored as DXT1 when it has no alpha (an RGB
+ * internal format, an RGB source, or every alpha byte 255) and, in mode "all", as DXT5 when it has.
+ * Levels above 0 aren't decided here: Mesa gives a level the format of the level below when their
+ * internal formats agree (_mesa_choose_texture_format), so a chain follows its level 0.
+ * Never: no data (glTexImage2D(NULL) without a PBO: a render target, or a texture filled by
+ * glTexSubImage), smaller than min x min, sizes not powers of two (nv30 lays DXT out as POT
+ * mipmaps; its NPOT layout is untested with DXT), a border, pixel transfer ops or byte swapping,
+ * GL_NEAREST magnification (pixel art, UI drawn 1:1) unless allowed, other targets (cube maps:
+ * every face would have to decide alike), other formats and types.
+ */
+#ifndef TEXFORCEDXT_POLICY_H
+#define TEXFORCEDXT_POLICY_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "util/glheader.h"
+
+enum fdxt_mode { FDXT_OFF = 0, FDXT_OPAQUE, FDXT_ALL };
+
+enum fdxt_result {
+   FDXT_KEEP = 0,       /* store as the game asked */
+   FDXT_DXT1,           /* RGB DXT1 */
+   FDXT_DXT5,           /* RGBA DXT5 */
+   FDXT_CHECK_ALPHA,    /* DXT1 if every alpha byte is 255, else (mode all) DXT5 or KEEP */
+};
+
+/* why an image is kept; FDXT_WHY_COUNT counters in the stats */
+enum fdxt_why {
+   FDXT_WHY_NONE = 0, FDXT_WHY_OFF, FDXT_WHY_TARGET, FDXT_WHY_LEVEL, FDXT_WHY_NODATA,
+   FDXT_WHY_SMALL, FDXT_WHY_NPOT, FDXT_WHY_BORDER, FDXT_WHY_TRANSFER, FDXT_WHY_FORMAT,
+   FDXT_WHY_NEAREST, FDXT_WHY_ALPHA, FDXT_WHY_NOS3TC, FDXT_WHY_COUNT
+};
+
+static const char *const fdxt_why_name[FDXT_WHY_COUNT] = {
+   "none", "off", "target", "level", "nodata", "small", "npot", "border", "transfer", "format",
+   "nearest", "alpha", "nos3tc",
+};
+
+struct fdxt_request {
+   enum fdxt_mode mode;
+   unsigned min;              /* smallest width and height compressed */
+   bool nearest_ok;           /* NV30_FORCE_DXT_NEAREST=1 */
+   bool s3tc;                 /* the driver stores DXT1 and DXT5 natively */
+   unsigned dims;             /* 1, 2, 3 */
+   bool target_2d;            /* GL_TEXTURE_2D */
+   int level;
+   GLenum internal_format, format, type;
+   int width, height, depth, border;
+   bool has_data;             /* pixels or a bound unpack PBO */
+   bool transfer_ops;         /* ctx->_ImageTransferState */
+   bool swap_bytes;           /* unpack SwapBytes */
+   bool mag_nearest;          /* the texture's magnification filter is GL_NEAREST */
+};
+
+static inline bool
+fdxt_pot(int x)
+{
+   return x > 0 && !(x & (x - 1));
+}
+
+/* 3: an RGB(A) internal format of 8 bits a channel or less specified; 4: RGBA; 0: anything else */
+static inline int
+fdxt_internal_comps(GLenum internal_format)
+{
+   switch (internal_format) {
+   case 3: case GL_RGB: case GL_RGB8:
+      return 3;
+   case 4: case GL_RGBA: case GL_RGBA8:
+      return 4;
+   default:
+      return 0;
+   }
+}
+
+/* Where the alpha byte of the source pixels is: 0..3 within each 4-byte pixel, -1 no alpha (an RGB
+ * source, 3 bytes a pixel), -2 a format/type not taken. big_endian: the packed 8888 types. */
+static inline int
+fdxt_src_alpha_byte(GLenum format, GLenum type, bool big_endian)
+{
+   bool rgb = format == GL_RGB || format == GL_BGR;
+   bool rgba = format == GL_RGBA || format == GL_BGRA;
+
+   if (rgb && type == GL_UNSIGNED_BYTE)
+      return -1;
+   if (!rgba)
+      return -2;
+   switch (type) {
+   case GL_UNSIGNED_BYTE:
+      return 3;
+   case GL_UNSIGNED_INT_8_8_8_8_REV:   /* alpha in bits 24-31 */
+      return big_endian ? 0 : 3;
+   case GL_UNSIGNED_INT_8_8_8_8:       /* alpha in bits 0-7 */
+      return big_endian ? 3 : 0;
+   default:
+      return -2;
+   }
+}
+
+static inline enum fdxt_result
+fdxt_decide(const struct fdxt_request *r, bool big_endian, enum fdxt_why *why)
+{
+   int comps, alpha;
+
+#define KEEP(w) do { *why = (w); return FDXT_KEEP; } while (0)
+   *why = FDXT_WHY_NONE;
+   if (r->mode == FDXT_OFF)
+      KEEP(FDXT_WHY_OFF);
+   if (r->dims != 2 || !r->target_2d)
+      KEEP(FDXT_WHY_TARGET);
+   if (r->level != 0)
+      KEEP(FDXT_WHY_LEVEL);
+   comps = fdxt_internal_comps(r->internal_format);
+   alpha = fdxt_src_alpha_byte(r->format, r->type, big_endian);
+   if (!comps || alpha == -2)
+      KEEP(FDXT_WHY_FORMAT);
+   if (!r->has_data)
+      KEEP(FDXT_WHY_NODATA);
+   if (r->border)
+      KEEP(FDXT_WHY_BORDER);
+   if (r->width < (int)r->min || r->height < (int)r->min || r->depth != 1)
+      KEEP(FDXT_WHY_SMALL);
+   if (!fdxt_pot(r->width) || !fdxt_pot(r->height))
+      KEEP(FDXT_WHY_NPOT);
+   if (r->transfer_ops || r->swap_bytes)
+      KEEP(FDXT_WHY_TRANSFER);
+   if (r->mag_nearest && !r->nearest_ok)
+      KEEP(FDXT_WHY_NEAREST);
+   if (!r->s3tc)
+      KEEP(FDXT_WHY_NOS3TC);
+#undef KEEP
+   if (comps == 3 || alpha == -1)
+      return FDXT_DXT1;
+   return FDXT_CHECK_ALPHA;
+}
+
+/* after FDXT_CHECK_ALPHA: opaque is whether every alpha byte is 255 (false when unknown, a PBO) */
+static inline enum fdxt_result
+fdxt_alpha_result(enum fdxt_mode mode, bool opaque, enum fdxt_why *why)
+{
+   if (opaque)
+      return FDXT_DXT1;
+   if (mode == FDXT_ALL)
+      return FDXT_DXT5;
+   *why = FDXT_WHY_ALPHA;
+   return FDXT_KEEP;
+}
+
+/* Whether every alpha byte of a w x h image of 4-byte pixels is 255: rows row_stride bytes apart,
+ * alpha at byte a (0..3) of each pixel. Stops at the first other value. Eight bytes at a time when
+ * the rows allow it (two pixels a load). */
+static inline bool
+fdxt_alpha_opaque(const uint8_t *src, int w, int h, size_t row_stride, int a)
+{
+   for (int y = 0; y < h; y++) {
+      const uint8_t *p = src + (size_t)y * row_stride;
+      int x = 0;
+
+      if (!((uintptr_t)p & 7)) {
+         uint64_t mask;
+         union { uint64_t q; uint8_t b[8]; } m = { 0 };
+
+         m.b[a] = m.b[a + 4] = 0xff;
+         mask = m.q;
+         for (; x + 8 <= w; x += 8) {
+            uint64_t q[4];
+
+            memcpy(q, p + 4 * x, sizeof(q));
+            if ((q[0] & q[1] & q[2] & q[3] & mask) != mask)
+               return false;
+         }
+      }
+      for (; x < w; x++)
+         if (p[4 * x + a] != 0xff)
+            return false;
+   }
+   return true;
+}
+
+/* bytes of a w x h level stored by the RSX: 4 a texel uncompressed (RGB as X8R8G8B8), DXT1 8 and
+ * DXT5 16 a 4x4 block */
+static inline uint64_t
+fdxt_level_bytes(int w, int h, enum fdxt_result fmt)
+{
+   uint64_t blocks = (uint64_t)((w + 3) / 4) * ((h + 3) / 4);
+
+   if (fmt == FDXT_DXT1)
+      return blocks * 8;
+   if (fmt == FDXT_DXT5)
+      return blocks * 16;
+   return (uint64_t)w * h * 4;
+}
+
+/* Whether a sub-image update of a w x h level at x, y covers whole 4x4 blocks (a partial block
+ * only at the right or bottom edge): then its blocks are compressed again from the new pixels;
+ * otherwise the texture goes back to its uncompressed format first */
+static inline bool
+fdxt_sub_aligned(int x, int y, int w, int h, int level_w, int level_h)
+{
+   return !(x & 3) && !(y & 3) && (!(w & 3) || x + w == level_w) && (!(h & 3) || y + h == level_h);
+}
+
+#endif
