+   screen->staging_big_max =
+      (uint64_t)CLAMP(debug_get_num_option("NV30_STAGING_POOL_MB", 0), 0, 64) << 20;
+   screen->staging_big_stats = debug_get_bool_option("NV30_STAGING_POOL_STATS", false);
    screen->ps3_kick_draws = ps3 ? debug_get_num_option("NV30_PS3_KICK_DRAWS", 0) : 0;
