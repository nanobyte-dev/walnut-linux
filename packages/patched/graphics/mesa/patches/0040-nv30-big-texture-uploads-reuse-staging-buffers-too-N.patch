diff --git a/src/gallium/drivers/nouveau/nv30/nv30_staging_policy.h b/src/gallium/drivers/nouveau/nv30/nv30_staging_policy.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/nouveau/nv30/nv30_staging_policy.h
@@ -0,0 +1,75 @@
+/*
+ * NV30_STAGING_POOL_MB: the decisions of the pool of big staging buffers (nv30_miptree.c), on
+ * their own so the host can test them (mesa/tests/staging-pool-test.c in the PS3 tree). No Mesa
+ * types: an entry is an opaque buffer, its size class and when it went into the pool.
+ *
+ * Entries are kept in the order they went in (index 0 the oldest). A request takes the smallest
+ * entry of at least its class and at most twice it (a full-screen buffer serves a half-screen
+ * update, not a 64 KiB one); the pool gives back its oldest entries first, when a new one would
+ * pass the byte budget, and every entry idle for longer than the idle time.
+ */
+#ifndef NV30_STAGING_POLICY_H
+#define NV30_STAGING_POLICY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NV30_STAGING_BIG_CLASS   (1u << 20)   /* big buffers come in whole MiB */
+#define NV30_STAGING_BIG_ENTRIES 16
+#define NV30_STAGING_BIG_IDLE_US 1000000      /* a buffer unused this long goes back */
+
+struct nv30_staging_entry {
+   void *bo;
+   unsigned size;      /* the class */
+   int64_t put_us;     /* when it went into the pool */
+};
+
+static inline unsigned
+nv30_staging_big_class(unsigned size)
+{
+   return (size + NV30_STAGING_BIG_CLASS - 1) & ~(NV30_STAGING_BIG_CLASS - 1);
+}
+
+/* The entry a request of class cls takes, or -1 */
+static inline int
+nv30_staging_big_pick(const struct nv30_staging_entry *e, unsigned n, unsigned cls)
+{
+   int best = -1;
+   unsigned i;
+
+   for (i = 0; i < n; i++) {
+      if (e[i].size < cls || (uint64_t)e[i].size > 2ull * cls)
+         continue;
+      if (best < 0 || e[i].size < e[best].size)
+         best = i;
+   }
+   return best;
+}
+
+/*
+ * How many of the oldest entries go back: those idle since before now - idle_us, then as many
+ * more as it takes for add more bytes (0: none, only the ageing) to fit max with at most
+ * NV30_STAGING_BIG_ENTRIES - (add ? 1 : 0) entries left.
+ */
+static inline unsigned
+nv30_staging_big_evict(const struct nv30_staging_entry *e, unsigned n, uint64_t bytes,
+                       unsigned add, uint64_t max, int64_t now, int64_t idle_us)
+{
+   unsigned k = 0;
+   unsigned room = NV30_STAGING_BIG_ENTRIES - (add ? 1 : 0);
+
+   while (k < n && now - e[k].put_us > idle_us)
+      bytes -= e[k++].size;
+   while (k < n && (bytes + add > max || n - k > room))
+      bytes -= e[k++].size;
+   return k;
+}
+
+/* Whether a buffer of class cls may go into the pool at all */
+static inline bool
+nv30_staging_big_fits(unsigned cls, uint64_t max)
+{
+   return cls && cls <= max;
+}
+
+#endif
