+/*
+ * NV30_STAGING_POOL_MB=M: the same for uploads over NV30_STAGING_POOL_MAX_BO. OpenTTD's OpenGL
+ * driver uploads its whole 1080p screen from a pixel buffer every frame (8.3 MB, and 2 MB of
+ * palette animation): on the PS3 each was a new GART buffer, zeroed by the kernel, mapped, faulted
+ * in page by page (one hash table insertion through lv1 per 4 KiB page), unmapped (one more lv1
+ * call per page) and freed: 40% of the game's CPU at the title screen. And with 4 MB in flight,
+ * nv30_staging_bo_new() waited for the GPU before each of them. Now big write-only uploads take a
+ * buffer of their MiB class, or one up to twice its size, from a pool of idle buffers, still
+ * mapped, at most M MiB; one unused for a second goes back to the kernel (nv30_staging_big_age(),
+ * from every flush), so a burst of uploads leaves no GART behind. A reused buffer adds nothing to
+ * the GART, so it is not counted in staging_inflight and never waits.
+ */
+static struct nouveau_bo *
+nv30_staging_big_get(struct nv30_screen *screen, unsigned cls)
+{
+   struct nouveau_bo *bo = NULL;
+   int i;
+
+   simple_mtx_lock(&screen->staging_lock);
+   i = nv30_staging_big_pick(screen->staging_big, screen->staging_big_count, cls);
+   if (i >= 0) {
+      bo = screen->staging_big[i].bo;
+      screen->staging_big_bytes -= screen->staging_big[i].size;
+      memmove(&screen->staging_big[i], &screen->staging_big[i + 1],
+              (screen->staging_big_count - i - 1) * sizeof(screen->staging_big[0]));
+      screen->staging_big_count--;
+      screen->staging_big_hits++;
+   } else {
+      screen->staging_big_misses++;
+   }
+   simple_mtx_unlock(&screen->staging_lock);
+   return bo;
+}
+
+/* Take the first n entries out of the pool; the caller frees them outside the lock */
+static unsigned
+nv30_staging_big_take(struct nv30_screen *screen, unsigned n, struct nouveau_bo **out)
+{
+   unsigned i;
+
+   for (i = 0; i < n; i++) {
+      out[i] = screen->staging_big[i].bo;
+      screen->staging_big_bytes -= screen->staging_big[i].size;
+   }
+   memmove(&screen->staging_big[0], &screen->staging_big[n],
+           (screen->staging_big_count - n) * sizeof(screen->staging_big[0]));
+   screen->staging_big_count -= n;
+   return n;
+}
+
+/* fence work: the copy out of the buffer is done (runs with or without the fence lock held) */
+static void
+nv30_staging_big_put(void *data)
+{
+   struct nv30_staging_return *r = data;
+   struct nv30_screen *screen = r->screen;
+   struct nouveau_bo *bo = r->bo, *evict[NV30_STAGING_BIG_ENTRIES];
+   unsigned cls = r->size, n = 0, i;
+   int64_t now = os_time_get();
+
+   FREE(r);
+   simple_mtx_lock(&screen->staging_lock);
+   if (!screen->staging_closed && nv30_staging_big_fits(cls, screen->staging_big_max)) {
+      n = nv30_staging_big_evict(screen->staging_big, screen->staging_big_count,
+                                 screen->staging_big_bytes, cls, screen->staging_big_max,
+                                 now, NV30_STAGING_BIG_IDLE_US);
+      nv30_staging_big_take(screen, n, evict);
+      screen->staging_big[screen->staging_big_count].bo = bo;
+      screen->staging_big[screen->staging_big_count].size = cls;
+      screen->staging_big[screen->staging_big_count++].put_us = now;
+      screen->staging_big_bytes += cls;
+      bo = NULL;
+   }
+   simple_mtx_unlock(&screen->staging_lock);
+   for (i = 0; i < n; i++)
+      nouveau_bo_ref(NULL, &evict[i]);
+   if (bo)
+      nouveau_bo_ref(NULL, &bo);
+}
+
+void
+nv30_staging_big_age(struct nv30_screen *screen)
+{
+   struct nouveau_bo *evict[NV30_STAGING_BIG_ENTRIES];
+   unsigned n, i;
+
+   /* unlocked peek: a stale count only delays the ageing to the next flush */
+   if (!screen->staging_big_max || !p_atomic_read(&screen->staging_big_count))
+      return;
+   simple_mtx_lock(&screen->staging_lock);
+   n = nv30_staging_big_evict(screen->staging_big, screen->staging_big_count,
+                              screen->staging_big_bytes, 0, screen->staging_big_max,
+                              os_time_get(), NV30_STAGING_BIG_IDLE_US);
+   nv30_staging_big_take(screen, n, evict);
+   simple_mtx_unlock(&screen->staging_lock);
+   for (i = 0; i < n; i++)
+      nouveau_bo_ref(NULL, &evict[i]);
+}
+
 void *
 nv30_miptree_transfer_map(struct pipe_context *pipe, struct pipe_resource *pt,
                           unsigned level, unsigned usage,
@@ -422,6 +524,14 @@ nv30_miptree_transfer_map(struct pipe_context *pipe, struct pipe_resource *pt,
       size = nv30_staging_pool_size(size);
       tx->pooled_size = size;
       tx->tmp.bo = nv30_staging_pool_get(nv30->screen, size);
+   } else if (nv30->screen->staging_big_max && !(usage & PIPE_MAP_READ) &&
+              size > NV30_STAGING_POOL_MAX_BO &&
+              nv30_staging_big_fits(nv30_staging_big_class(size),
+                                    nv30->screen->staging_big_max)) {
+      size = nv30_staging_big_class(size);
+      tx->big_size = size;
+      tx->tmp.bo = nv30_staging_big_get(nv30->screen, size);
+      tx->big_reused = tx->tmp.bo != NULL;
    }
    ret = tx->tmp.bo ? 0 : nv30_staging_bo_new(nv30, size, &tx->tmp.bo);
    if (ret) {
@@ -507,14 +617,16 @@ nv30_miptree_transfer_unmap(struct pipe_context *pipe,
       }
 
       /* Allow the copies above to finish executing before freeing the source */
-      nv30->staging_inflight += tx->tmp.bo->size;
+      if (!tx->big_reused)
+         nv30->staging_inflight += tx->tmp.bo->size;
       struct nv30_staging_return *r =
-         tx->pooled_size ? MALLOC_STRUCT(nv30_staging_return) : NULL;
+         tx->pooled_size || tx->big_size ? MALLOC_STRUCT(nv30_staging_return) : NULL;
       if (r) {
          r->screen = nv30->screen;
          r->bo = tx->tmp.bo;
-         r->size = tx->pooled_size;
-         nouveau_fence_work(nv30->base.fence, nv30_staging_pool_put, r);
+         r->size = tx->pooled_size ? tx->pooled_size : tx->big_size;
+         nouveau_fence_work(nv30->base.fence,
+                            tx->pooled_size ? nv30_staging_pool_put : nv30_staging_big_put, r);
       } else {
          nouveau_fence_work(nv30->base.fence,
                             nouveau_fence_unref_bo, tx->tmp.bo);
