From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sun, 25 Oct 2026 03:49:00 +0200
Subject: u_upload, st, nv30: an upload buffer that cannot be had is not
 written through

Real Sauerbraten (2026-10-25, Mesa ps3.819) segfaulted at address 0 in libc's memcpy, called
from st_setup_current() (st_atom_array.cpp:343), right after ps3rsx logged "out of GART for a
4096 KiB BO": with the RSX's VRAM full, the game's buffers had gone to GART, and the stream
uploader's next 1 MiB buffer (a 4 MiB nouveau_mm slab) did not fit. u_upload_alloc() then
returns ptr NULL, and st_setup_current() copies the current (zero-stride) vertex attributes
there without looking.

- st_setup_current(): no copy without a buffer; the vertex buffer stays unbound.
- u_upload_alloc(): on a failed allocation *releasebuf keeps the previous upload buffer for the
  caller to release (it was cleared, so every failure leaked a buffer: under memory pressure
  the next failure came sooner), *outbuf is set to NULL (callers test it, and it could still
  hold an earlier call's buffer), and a buffer whose map failed is not left in upload->buffer
  to be handed out a second time.
- u_vbuf_upload_buffers(): what u_upload_data() gave back is released on the error path too.
- nv30: a zero-stride attribute without a buffer (or whose map fails) reads as zero, in
  nv30_emit_vtxattr() and on the push path, instead of mapping NULL.

The draw then runs with those attributes at zero for a frame instead of crashing.

diff --git a/src/gallium/auxiliary/util/u_upload_mgr.c b/src/gallium/auxiliary/util/u_upload_mgr.c
--- a/src/gallium/auxiliary/util/u_upload_mgr.c
+++ b/src/gallium/auxiliary/util/u_upload_mgr.c
@@ -207,6 +207,7 @@ u_upload_alloc_buffer(struct u_upload_mgr *upload, unsigned min_size, struct pip
    if (upload->map == NULL) {
       u_upload_release_buffer(upload);
       pipe_resource_release(upload->pipe, upload->buffer);
+      upload->buffer = NULL;   /* else the next allocation hands it to *releasebuf again */
       return 0;
    }
 
@@ -253,9 +254,11 @@ u_upload_alloc(struct u_upload_mgr *upload,
       buffer_size = u_upload_alloc_buffer(upload, offset + size, releasebuf);
 
       if (unlikely(!buffer_size)) {
+         /* *releasebuf keeps the previous buffer, which the caller releases: clearing it
+          * leaked that buffer at every failed allocation */
          *out_offset = ~0;
+         *outbuf = NULL;
          *ptr = NULL;
-         *releasebuf = NULL;
          return;
       }
    } else {
@@ -271,6 +274,7 @@ u_upload_alloc(struct u_upload_mgr *upload,
       if (unlikely(!upload->map)) {
          upload->transfer = NULL;
          *out_offset = ~0;
+         *outbuf = NULL;   /* callers test it: it kept a previous call's buffer */
          *ptr = NULL;
          *releasebuf = NULL;
          return;
diff --git a/src/gallium/auxiliary/util/u_vbuf.c b/src/gallium/auxiliary/util/u_vbuf.c
--- a/src/gallium/auxiliary/util/u_vbuf.c
+++ b/src/gallium/auxiliary/util/u_vbuf.c
@@ -1166,11 +1166,12 @@ u_vbuf_upload_buffers(struct u_vbuf *mgr,
                        mgr->has_signed_vb_offset ? 0 : offset,
                        size, 4, ptr + offset, &real_vb->buffer_offset,
                        &real_vb->buffer.resource, &releasebufs[rcount]);
-         if (!real_vb->buffer.resource)
-            return PIPE_ERROR_OUT_OF_MEMORY;
-
          if (releasebufs[rcount])
             rcount++;
+         if (!real_vb->buffer.resource) {
+            *release_count = rcount;   /* the caller releases what was given back */
+            return PIPE_ERROR_OUT_OF_MEMORY;
+         }
 
          real_vb->buffer_offset -= offset;
       }
@@ -1230,11 +1231,12 @@ u_vbuf_upload_buffers(struct u_vbuf *mgr,
                     mgr->has_signed_vb_offset ? 0 : start,
                     end - start, 4,
                     ptr + start, &real_vb->buffer_offset, &real_vb->buffer.resource, &releasebufs[rcount]);
-      if (!real_vb->buffer.resource)
-         return PIPE_ERROR_OUT_OF_MEMORY;
-
       if (releasebufs[rcount])
          rcount++;
+      if (!real_vb->buffer.resource) {
+         *release_count = rcount;   /* the caller releases what was given back */
+         return PIPE_ERROR_OUT_OF_MEMORY;
+      }
 
       real_vb->buffer_offset -= start;
    }
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_push.c b/src/gallium/drivers/nouveau/nv30/nv30_push.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_push.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_push.c
@@ -214,6 +214,10 @@ nv30_push_vbo(struct nv30_context *nv30, const struct pipe_draw_info *info,
       struct nv04_resource *res = nv04_resource(vb->buffer.resource);
 
       if (!vb->buffer.resource) {
+         /* a zero-stride buffer whose upload ran out of memory reads as zero */
+         static const uint32_t zeros[8];
+         if (!nv30->vertex->strides[i])
+            ctx.translate->set_buffer(ctx.translate, i, zeros, 0, ~0);
          continue;
       }
 
