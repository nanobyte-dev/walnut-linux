+/* Out of GART for a fence's wait object: wait for the GPU to finish everything submitted, so the
+ * memory that waits on those fences goes back (their wait objects, the staging buffers and the
+ * buffer storage their works free). Fences of the batch being built are left alone: waiting on
+ * them would submit it, and this runs from the submission's kick_notify too.
+ */
+static void
+nouveau_fence_reclaim(struct nouveau_screen *screen)
+{
+   struct nouveau_fence_list *fence_list = &screen->fence;
+   struct nouveau_fence *fence, *last = NULL, *held = NULL;
+
+   simple_mtx_assert_locked(&fence_list->lock);
+
+   for (fence = fence_list->head; fence; fence = fence->next)
+      if (fence->state == NOUVEAU_FENCE_STATE_FLUSHED)
+         last = fence;
+   if (!last)
+      return;
+
+   /* signalled, it is deleted if the list held the last reference */
+   _nouveau_fence_ref(last, &held);
+   if (last->bo)
+      nouveau_bo_wait(last->bo, NOUVEAU_BO_RDWR, screen->client);
+   else
+      nouveau_fence_poll(last);
+   _nouveau_fence_update(screen, false);
+   _nouveau_fence_ref(NULL, &held);
+}
