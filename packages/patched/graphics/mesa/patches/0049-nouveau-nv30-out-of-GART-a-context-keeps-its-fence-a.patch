+static bool
+nouveau_fence_poll(struct nouveau_fence *fence)
+{
+   struct nouveau_screen *screen = fence->screen;
+   int64_t until = os_time_get_nano() + 10 * 1000000000ll;
+
+   simple_mtx_assert_locked(&screen->fence.lock);
+
+   while (fence->state < NOUVEAU_FENCE_STATE_SIGNALLED) {
+      _nouveau_fence_update(screen, false);
+      if (fence->state == NOUVEAU_FENCE_STATE_SIGNALLED)
+         break;
+      if (os_time_get_nano() > until) {
+         debug_printf("nouveau: fence %u (no wait object) not signalled after 10 s\n",
+                      fence->sequence);
+         return false;
+      }
+#if DETECT_OS_POSIX
+      sched_yield();
+#endif
+   }
+   return true;
+}
