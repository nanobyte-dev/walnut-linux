    /* texture memory changes: invalidate the texture cache before the next draw */
    p_atomic_inc(&nv30->screen->tex_gen);
 
@@ -757,6 +767,8 @@ nv30_transfer_copy_data(struct nouveau_context *nv,
    struct nouveau_pushbuf *push = nv->pushbuf;
    unsigned pages, lines;
 
+   nv30_state_check_lost(nv30_context(&nv->pipe));
+
    pages = size >> 12;
    size -= (pages << 12);
 
