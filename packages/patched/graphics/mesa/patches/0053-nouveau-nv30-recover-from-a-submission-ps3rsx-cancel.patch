       nv30->draw_dirty |= nv30->dirty;
@@ -527,6 +578,8 @@ nv30_state_validate(struct nv30_context *nv30, uint32_t mask, bool hwtnl)
       nv30->dirty &= ~mask;
    }
 
+   nv30->in_validate = false;
+
    nouveau_pushbuf_bufctx(push, bctx);
    if (PUSH_VAL(push)) {
       nouveau_pushbuf_bufctx(push, NULL);
