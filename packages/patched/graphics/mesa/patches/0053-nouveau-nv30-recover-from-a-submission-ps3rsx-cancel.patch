       nv30->state.vtxfmt_nr = 0;	/* the last context to draw is gone: GPU formats unknown */
    } else {
       /* The context that drew last is gone, and the GPU holds its state, not what this
@@ -488,6 +488,55 @@ nv30_state_context_switch(struct nv30_context *nv30)
       nv30->dirty &= ~NV30_NEW_ZSA;
 
    nv30->screen->cur_ctx = nv30;
+   nv30->state_lost = false;
+}
+
+/*
+ * ps3rsx cancelled a submission of this screen's channel: one of its pushes was rejected
+ * (ps3rsx_validate, docs/DRIVER.md), and the kernel sent none of it. The GPU holds the state of
+ * the channel's last accepted submission, not what any context set since, so nothing this
+ * driver keeps about the GPU is true any more, for this context or another on the channel:
+ *  - this context's queued words were built on that state: the kick here drops them (the
+ *    winsys, nouveau_pushbuf::cancel_seen) and submits only the fence, which signals what waits
+ *    on the fences of the cancelled submission;
+ *  - the screen, once per cancellation: vertex programs and their constants are uploaded again
+ *    where used (the heaps emptied: the GPU may lack their code), fragment programs at their
+ *    next validation (lost_gen), and no context's view of the GPU state counts (cur_ctx), so
+ *    the next to draw writes all of its state, as after the last context to draw went away
+ *    (0029: all 16 vertex formats, the fragment program, the base index and restart state);
+ *  - this context invalidates the texture cache before its next draw.
+ * What the cancelled submission uploaded or rendered is lost (as after a GPU reset).
+ */
+void
+nv30_state_lost(struct nv30_context *nv30)
+{
+   struct nv30_screen *screen = nv30->screen;
+   struct nouveau_pushbuf *push = nv30->base.pushbuf;
+   uint32_t cancelled = screen->base.device->cancelled;
+
+   if (PUSH_SPACE(push, 16))
+      PUSH_KICK(push);
+   push->cancel_seen = cancelled;
+
+   if (screen->lost_seen != cancelled) {
+      struct nouveau_heap *heap;
+
+      screen->lost_seen = cancelled;
+      screen->lost_gen++;
+      heap = screen->vp_exec_heap;
+      while (heap->next && heap->next->in_use) {
+         struct nouveau_heap **evict = heap->next->priv;
+         nouveau_heap_free(evict);
+      }
+      heap = screen->vp_data_heap;
+      while (heap->next && heap->next->in_use) {
+         struct nv30_vertprog *evp = heap->next->priv;
+         nouveau_heap_free(&evp->data);
+      }
+      screen->cur_ctx = NULL;
+   }
+   nv30->state_lost = true;
+   nv30->tex_gen = p_atomic_read(&screen->tex_gen) - 1;
 }
 
 bool
@@ -498,8 +547,10 @@ nv30_state_validate(struct nv30_context *nv30, uint32_t mask, bool hwtnl)
    struct nouveau_bufref *bref;
    struct state_validate *validate;
 
+   nv30_state_check_lost(nv30);
    if (nv30->screen->cur_ctx != nv30)
       nv30_state_context_switch(nv30);
+   nv30->in_validate = true;
 
