From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Fri, 30 Oct 2026 00:36:54 +0200
Subject: nv30: on the PS3, a texture that finds no VRAM goes to GART
 (NV30_GART_TEXTURES)

The CPU-visible VRAM (215 MB less X's buffers) can fill up: Trigger Rally keeps
every level's menu thumbnails, and the textures loaded last (its car, sky and
buildings) failed to allocate, drew untextured, and state tracker retried the
allocation at every draw (about 400 failed GEM_NEW a second). ps3rsx has
already given back the VRAM swap's chunks by then.

The RSX samples from main memory (TEX_FORMAT DMA1) and renders into it (the
blit's GART destinations, 0007). When the VRAM allocation fails, a miptree
that isn't a depth buffer, scanout, shared or display target is placed in GART
(it costs RAM while it lives); one warning on stderr. The domain is taken from
the buffer wherever a texture is referenced (fragment textures, the transfer
rects, render targets, clears), and the surface context DMAs (COLOR0-3, ZETA)
point at GART while a render target is there (state.fb_dma_gart: otherwise
the stream is unchanged). NV30_GART_TEXTURES=0 turns it off.

diff --git a/src/gallium/drivers/nouveau/nv30/nv30_clear.c b/src/gallium/drivers/nouveau/nv30/nv30_clear.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_clear.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_clear.c
@@ -170,10 +170,22 @@ nv30_clear_render_target(struct pipe_context *pipe, struct pipe_surface *ps,
       rt_format |= NV30_3D_RT_FORMAT_TYPE_LINEAR;
    }
 
-   if (!PUSH_SPACE_EX(push, 32, 1, 0) ||
-       PUSH_REF1(push, mt->base.bo, NOUVEAU_BO_VRAM | NOUVEAU_BO_WR))
+   if (!PUSH_SPACE_EX(push, 40, 1, 0) ||
+       PUSH_REF1(push, mt->base.bo, nv30_bo_domain(mt->base.bo) | NOUVEAU_BO_WR))
       return;
 
+   /* PS3: a texture in GART (nv30_miptree_create) is cleared where it is */
+   if (nv30->screen->base.is_ps3) {
+      struct nv04_fifo *fifo = push->channel->data;
+      bool gart = nv30_bo_domain(mt->base.bo) == NOUVEAU_BO_GART;
+
+      if (gart || nv30->state.fb_dma_gart) {
+         BEGIN_NV04(push, NV30_3D(DMA_COLOR0), 1);
+         PUSH_DATA (push, gart ? fifo->gart : fifo->vram);
+         nv30->state.fb_dma_gart |= gart;
+      }
+   }
+
    origin = nv30_clear_origin(push, ps);
    BEGIN_NV04(push, NV30_3D(RT_ENABLE), 1);
    PUSH_DATA (push, NV30_3D_RT_ENABLE_COLOR0);
@@ -235,10 +247,18 @@ nv30_clear_depth_stencil(struct pipe_context *pipe, struct pipe_surface *ps,
    if (buffers & PIPE_CLEAR_STENCIL)
       mode |= NV30_3D_CLEAR_BUFFERS_STENCIL;
 
-   if (!PUSH_SPACE_EX(push, 32, 1, 0) ||
-       PUSH_REF1(push, mt->base.bo, NOUVEAU_BO_VRAM | NOUVEAU_BO_WR))
+   if (!PUSH_SPACE_EX(push, 40, 1, 0) ||
+       PUSH_REF1(push, mt->base.bo, nv30_bo_domain(mt->base.bo) | NOUVEAU_BO_WR))
       return;
 
+   /* PS3: ZETA may point at a GART colour target's buffer (nv30_validate_fb) */
+   if (nv30->screen->base.is_ps3 && nv30->state.fb_dma_gart) {
+      struct nv04_fifo *fifo = push->channel->data;
+
+      BEGIN_NV04(push, NV30_3D(DMA_ZETA), 1);
+      PUSH_DATA (push, nv30_bo_domain(mt->base.bo) == NOUVEAU_BO_GART ? fifo->gart : fifo->vram);
+   }
+
    origin = nv30_clear_origin(push, ps);
    BEGIN_NV04(push, NV30_3D(RT_ENABLE), 1);
    PUSH_DATA (push, 0);
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_context.h b/src/gallium/drivers/nouveau/nv30/nv30_context.h
--- a/src/gallium/drivers/nouveau/nv30/nv30_context.h
+++ b/src/gallium/drivers/nouveau/nv30/nv30_context.h
@@ -57,6 +57,8 @@ struct nv30_context {
       unsigned vtxfmt_nr;
       int index_bias;
       uint8_t prim_restart;	/* 2: unknown */
+      /* PS3: a surface context DMA (COLOR0-3, ZETA) may point at GART (nv30_validate_fb) */
+      bool fb_dma_gart;
       struct nv30_fragprog *fragprog;
    } state;
 
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c b/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_fragtex.c
@@ -126,9 +126,9 @@ nv30_fragtex_validate(struct nv30_context *nv30)
 
          BEGIN_NV04(push, NV30_3D(TEX_OFFSET(unit)), 8);
          PUSH_MTHDl(push, NV30_3D(TEX_OFFSET(unit)), BUFCTX_FRAGTEX(unit),
-                          mt->base.bo, 0, NOUVEAU_BO_VRAM | NOUVEAU_BO_RD);
+                          mt->base.bo, 0, nv30_bo_domain(mt->base.bo) | NOUVEAU_BO_RD);
          PUSH_MTHDs(push, NV30_3D(TEX_FORMAT(unit)), BUFCTX_FRAGTEX(unit),
-                          mt->base.bo, format, NOUVEAU_BO_VRAM | NOUVEAU_BO_RD,
+                          mt->base.bo, format, nv30_bo_domain(mt->base.bo) | NOUVEAU_BO_RD,
                           NV30_3D_TEX_FORMAT_DMA0,
                           NV30_3D_TEX_FORMAT_DMA1);
          PUSH_DATA (push, sv->wrap | (ss->wrap & sv->wrap_mask));
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_miptree.c b/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
@@ -27,6 +27,8 @@
 #include "util/u_inlines.h"
 #include "util/u_surface.h"
 #include "util/os_time.h"
+#include "util/log.h"
+#include "util/u_atomic.h"
 
 #include "nv_m2mf.xml.h"
 #include "nv_object.xml.h"
@@ -121,7 +123,7 @@ define_rect(struct pipe_resource *pt, unsigned level, unsigned z,
    }
 
    rect->bo     = mt->base.bo;
-   rect->domain = NOUVEAU_BO_VRAM;
+   rect->domain = nv30_bo_domain(mt->base.bo);
    rect->offset = layer_offset(pt, level, z);
    rect->cpp    = util_format_get_blocksize(pt->format);
 
@@ -847,12 +849,35 @@ nv30_miptree_create(struct pipe_screen *pscreen,
    ret = nouveau_bo_new(dev, NOUVEAU_BO_VRAM |
                         (nv30_screen(pscreen)->base.is_ps3 ? NOUVEAU_BO_MAP : 0),
                         256, size, NULL, &mt->base.bo);
+   mt->base.domain = NOUVEAU_BO_VRAM;
+
+   /* PS3: the CPU-visible VRAM (215 MB less X's buffers) is full, and ps3rsx has already
+    * taken back what the VRAM swap held. A game whose textures don't fit (Trigger Rally keeps
+    * every level's menu thumbnails) then drew untextured whatever came last (its car, sky and
+    * buildings), and st retried the allocation at every draw. The RSX samples from main
+    * memory too, and renders into it (the blit's GART destinations, 0007): put the texture in
+    * GART, which costs RAM while it lives. Depth buffers and window/shared buffers stay in
+    * VRAM (the scanout and DRI3 back buffers have their own fallback, 0054). */
+   if (ret && nv30_screen(pscreen)->gart_textures &&
+       !(pt->bind & (PIPE_BIND_DEPTH_STENCIL | PIPE_BIND_SCANOUT | PIPE_BIND_SHARED |
+                     PIPE_BIND_DISPLAY_TARGET))) {
+      ret = nouveau_bo_new(dev, NOUVEAU_BO_GART | NOUVEAU_BO_MAP, 256, size, NULL,
+                           &mt->base.bo);
+      if (!ret) {
+         struct nv30_screen *screen = nv30_screen(pscreen);
+
+         mt->base.domain = NOUVEAU_BO_GART;
+         if (p_atomic_inc_return(&screen->gart_textures_made) == 1)
+            mesa_logw("nv30: no VRAM for a %u KiB texture, placed in GART "
+                      "(and the next ones that don't fit; NV30_GART_TEXTURES=0: off)",
+                      size >> 10);
+      }
+   }
    if (ret) {
       FREE(mt);
       return NULL;
    }
 
-   mt->base.domain = NOUVEAU_BO_VRAM;
    return &mt->base.base;
 }
 
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_screen.c b/src/gallium/drivers/nouveau/nv30/nv30_screen.c
