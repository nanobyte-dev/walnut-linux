     */
    const bool ps3 = screen->base.is_ps3;
    screen->ps3_vbo_fifo = ps3 && debug_get_bool_option("NV30_PS3_VBO_FIFO", false);
+   screen->gart_textures = ps3 && debug_get_bool_option("NV30_GART_TEXTURES", true);
    screen->tex_invalidate_always = debug_get_bool_option("NV30_TEX_INVALIDATE_ALWAYS", false);
    screen->vtx_invalidate_draw = debug_get_bool_option("NV30_VTX_INVALIDATE_DRAW", false);
    screen->vtxfmt_always = debug_get_bool_option("NV30_VTXFMT_ALWAYS", false);
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_screen.h b/src/gallium/drivers/nouveau/nv30/nv30_screen.h
--- a/src/gallium/drivers/nouveau/nv30/nv30_screen.h
+++ b/src/gallium/drivers/nouveau/nv30/nv30_screen.h
@@ -28,6 +28,12 @@ struct nv30_screen {
 
    bool ps3_vbo_fifo; /* PS3: push vertices inline instead of fetching (NV30_PS3_VBO_FIFO) */
 
+   /* PS3: a texture that finds no room in the CPU-visible VRAM goes to GART instead of
+    * failing (NV30_GART_TEXTURES, default on); gart_textures counts them, for the one-time
+    * warning */
+   bool gart_textures;
+   uint32_t gart_textures_made;
+
    /* Bumped (atomically, by any context) whenever texture memory may have changed: a copy
     * into or out of a texture, a new framebuffer (what was rendered may be sampled now), a
     * flush (another context may sample what this one rendered). Each context invalidates the
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_state_validate.c b/src/gallium/drivers/nouveau/nv30/nv30_state_validate.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_state_validate.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_state_validate.c
@@ -41,6 +41,8 @@ nv30_validate_fb(struct nv30_context *nv30)
    struct pipe_framebuffer_state *fb = &nv30->framebuffer;
    struct nouveau_pushbuf *push = nv30->base.pushbuf;
    struct nouveau_object *eng3d = nv30->screen->eng3d;
+   /* the buffers behind COLOR0 to COLOR3 and ZETA, for their context DMAs on the PS3 */
+   struct nouveau_bo *dma_bo[5] = { NULL };
    uint32_t rt_format;
    int h = fb->height;
    int w = fb->width;
@@ -144,9 +146,11 @@ nv30_validate_fb(struct nv30_context *nv30)
          PUSH_DATA (push, (zsf->pitch << 16) | rsf->pitch);
       }
       PUSH_MTHDl(push, NV30_3D(COLOR0_OFFSET), BUFCTX_FB, rbo, rsf->offset & ~63,
-                       NOUVEAU_BO_VRAM | NOUVEAU_BO_RDWR);
+                       nv30_bo_domain(rbo) | NOUVEAU_BO_RDWR);
       PUSH_MTHDl(push, NV30_3D(ZETA_OFFSET), BUFCTX_FB, zbo, zsf->offset & ~63,
-                       NOUVEAU_BO_VRAM | NOUVEAU_BO_RDWR);
+                       nv30_bo_domain(zbo) | NOUVEAU_BO_RDWR);
+      dma_bo[0] = rbo;
+      dma_bo[4] = zbo;
    }
 
    if (nv30->state.rt_enable & NV30_3D_RT_ENABLE_COLOR1) {
@@ -155,7 +159,8 @@ nv30_validate_fb(struct nv30_context *nv30)
 
       BEGIN_NV04(push, NV30_3D(COLOR1_OFFSET), 2);
       PUSH_MTHDl(push, NV30_3D(COLOR1_OFFSET), BUFCTX_FB, bo, sf->offset,
-                       NOUVEAU_BO_VRAM | NOUVEAU_BO_RDWR);
+                       nv30_bo_domain(bo) | NOUVEAU_BO_RDWR);
+      dma_bo[1] = bo;
       PUSH_DATA (push, sf->pitch);
    }
 
@@ -165,7 +170,8 @@ nv30_validate_fb(struct nv30_context *nv30)
 
       BEGIN_NV04(push, NV40_3D(COLOR2_OFFSET), 1);
       PUSH_MTHDl(push, NV40_3D(COLOR2_OFFSET), BUFCTX_FB, bo, sf->offset,
-                       NOUVEAU_BO_VRAM | NOUVEAU_BO_RDWR);
+                       nv30_bo_domain(bo) | NOUVEAU_BO_RDWR);
+      dma_bo[2] = bo;
       BEGIN_NV04(push, NV40_3D(COLOR2_PITCH), 1);
       PUSH_DATA (push, sf->pitch);
    }
@@ -176,10 +182,40 @@ nv30_validate_fb(struct nv30_context *nv30)
 
       BEGIN_NV04(push, NV40_3D(COLOR3_OFFSET), 1);
       PUSH_MTHDl(push, NV40_3D(COLOR3_OFFSET), BUFCTX_FB, bo, sf->offset,
-                       NOUVEAU_BO_VRAM | NOUVEAU_BO_RDWR);
+                       nv30_bo_domain(bo) | NOUVEAU_BO_RDWR);
+      dma_bo[3] = bo;
       BEGIN_NV04(push, NV40_3D(COLOR3_PITCH), 1);
       PUSH_DATA (push, sf->pitch);
    }
+
+   /* PS3: a render target may be a texture that went to GART (nv30_miptree_create): point the
+    * surface's context DMA at GART. Only while one is there, or one was since the DMAs were
+    * last all VRAM (state.fb_dma_gart): otherwise the stream is unchanged. */
+   if (nv30->screen->base.is_ps3) {
+      struct nv04_fifo *fifo = push->channel->data;
+      bool gart = false;
+      uint32_t dma[5];
+      int i;
+
+      for (i = 0; i < 5; i++) {
+         dma[i] = (dma_bo[i] && nv30_bo_domain(dma_bo[i]) == NOUVEAU_BO_GART) ?
+                  fifo->gart : fifo->vram;
+         gart |= dma[i] == fifo->gart;
+      }
+      if (gart || nv30->state.fb_dma_gart) {
+         BEGIN_NV04(push, NV30_3D(DMA_COLOR1), 1);
+         PUSH_DATA (push, dma[1]);
+         BEGIN_NV04(push, NV30_3D(DMA_COLOR0), 2);
+         PUSH_DATA (push, dma[0]);
+         PUSH_DATA (push, dma[4]);	/* ZETA */
+         if (eng3d->oclass >= NV40_3D_CLASS) {
+            BEGIN_NV04(push, NV40_3D(DMA_COLOR2), 2);
+            PUSH_DATA (push, dma[2]);
+            PUSH_DATA (push, dma[3]);
+         }
+         nv30->state.fb_dma_gart = gart;
+      }
+   }
 }
 
 static void
@@ -464,6 +500,7 @@ nv30_state_context_switch(struct nv30_context *nv30)
       nv30->state.num_vtxelts = 16;
       nv30->state.index_bias = INT32_MIN;
       nv30->state.prim_restart = 2;
+      nv30->state.fb_dma_gart = true;	/* the surface DMAs: unknown */
    }
    nv30->dirty = NV30_NEW_ALL;
 
