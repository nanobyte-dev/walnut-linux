diff --git a/src/gallium/winsys/nouveau/drm/nouveau.c b/src/gallium/winsys/nouveau/drm/nouveau.c
--- a/src/gallium/winsys/nouveau/drm/nouveau.c
+++ b/src/gallium/winsys/nouveau/drm/nouveau.c
@@ -1167,7 +1167,7 @@ pushbuf_submit(struct nouveau_pushbuf *push, struct nouveau_object *chan)
     * count on what that one was to set (a draw on its textures and programs, a copy on its
     * DMA objects, the rest of a draw it began). They go nowhere; the fence kick_notify adds
     * below still does, so what waits on it is not left waiting. The buffer list stays. */
-   if (push->cancel_seen != dev->cancelled) {
+   if (push->cancel_seen != NOUVEAU_CANCELLED(dev)) {
       for (struct nouveau_pushbuf_krec *k = nvpb->list; k; k = k->next) {
          k->nr_push = 0;
          k->nr_reloc = 0;
@@ -1175,8 +1175,13 @@ pushbuf_submit(struct nouveau_pushbuf *push, struct nouveau_object *chan)
       push->cur = nvpb->bgn;
    }
 
-   if (push->kick_notify && !push->kick_notify(push))
+   if (push->kick_notify && !push->kick_notify(push)) {
+      /* the fence could not be made (an allocation failed): the words stay in the push buffer,
+       * but pushbuf_flush lets go of their buffer list and relocations, so they must not go out
+       * at the next kick. Counted as a cancelled submission: that kick drops them. */
+      NOUVEAU_CANCEL(dev);
       return -EINVAL;
+   }
 
    nouveau_pushbuf_data(push, NULL, 0, 0);
 
@@ -1207,14 +1212,20 @@ pushbuf_submit(struct nouveau_pushbuf *push, struct nouveau_object *chan)
       if (ret == -ECANCELED) {
          /* ps3rsx rejected a push of it and sent none: the driver re-sends its state before
           * it draws again (nouveau_device::cancelled); the rest of this list goes nowhere */
-         uint32_t n = ++dev->cancelled;
+         uint32_t n = NOUVEAU_CANCEL(dev);
          if (!(n & (n - 1)))
             err("ps3rsx cancelled a submission (%u so far): its state is sent again\n", n);
          break;
       }
       if (ret) {
-         err("kernel rejected pushbuf: %s\n", strerror(-ret));
-         pushbuf_dump(dev, krec, krec_id++, channel);
+         /* it did not go either: as a cancelled one, so what waits on its reports (queries)
+          * ends, and the driver sends its state again before it draws. A channel that fails
+          * every submission says so at the 1st, 2nd, 4th, 8th... (as for -ECANCELED). */
+         uint32_t n = NOUVEAU_CANCEL(dev);
+         if (!(n & (n - 1))) {
+            err("kernel rejected pushbuf (%u so far): %s\n", n, strerror(-ret));
+            pushbuf_dump(dev, krec, krec_id++, channel);
+         }
          break;
       }
 
@@ -1643,7 +1654,7 @@ nouveau_pushbuf_new(struct nouveau_client *client, struct nouveau_object *chan,
    push = &nvpb->base;
    push->client = client;
    push->channel = chan;
-   push->cancel_seen = client->device->cancelled;
+   push->cancel_seen = NOUVEAU_CANCELLED(client->device);
    push->flags = NOUVEAU_BO_RD;
    if (fifo->pushbuf & NOUVEAU_GEM_DOMAIN_GART) {
       push->flags |= NOUVEAU_BO_GART;
diff --git a/src/gallium/winsys/nouveau/drm/nouveau.h b/src/gallium/winsys/nouveau/drm/nouveau.h
--- a/src/gallium/winsys/nouveau/drm/nouveau.h
+++ b/src/gallium/winsys/nouveau/drm/nouveau.h
@@ -5,6 +5,7 @@
 #include <stdint.h>
 
 #include "util/list.h"
+#include "util/u_atomic.h"
 
 #include "drm-uapi/nouveau_drm.h"
 #include "nv_device_info.h"
@@ -57,10 +58,17 @@ struct nouveau_device {
 
    /* Submissions the kernel cancelled (ps3rsx's -ECANCELED: a push of it was rejected, so
     * the GPU holds the state of the channel's last accepted submission, not what the
-    * driver set since). Push buffers built before it changed are dropped at their kick. */
+    * driver set since). Push buffers built before it changed are dropped at their kick.
+    * A submission the kernel failed another way counts too: it was not sent either. Contexts
+    * of one screen submit from their own threads: read it with NOUVEAU_CANCELLED() (relaxed:
+    * a plain load on the PPE, read at every draw), bump it
+    * with NOUVEAU_CANCEL(). */
    uint32_t cancelled;
 };
 
+#define NOUVEAU_CANCELLED(dev) p_atomic_read_relaxed(&(dev)->cancelled)
+#define NOUVEAU_CANCEL(dev)    p_atomic_inc_return(&(dev)->cancelled)
+
 struct nouveau_client {
    struct nouveau_device *device;
 };
