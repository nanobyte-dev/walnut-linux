+ * TIME_ELAPSED begin, which no kick follows at once), which a GPU reset could too. ps3rsx cancels,
+ * and the winsys counts a submission the kernel failed another way the same
+ * (nouveau_device::cancelled stays 0 on a machine where none failed). */
 static bool
 nv30_query_object_lost(struct nv30_screen *screen, struct nv30_query_object *qo)
 {
-   return qo->lost || (!qo->sent && qo->cancel_seen != screen->base.device->cancelled);
+   return qo->lost || (!qo->sent && qo->cancel_seen != NOUVEAU_CANCELLED(screen->base.device));
 }
 
 static volatile void *
@@ -92,10 +93,11 @@ nv30_ntfy(struct nv30_screen *screen, struct nv30_query_object *qo)
 }
 
 /*
- * Waits for a query object's report: true once it is in. On the PS3 the wait ends without it
- * (false, and the object is lost for good) when it never comes: its submission was cancelled
- * (nv30_query_object_lost()), or it isn't in NV30_QUERY_DEADLINE_NS after the wait began.
- * Elsewhere it spins until the report lands, as before. YIELD: sched_yield() while waiting.
+ * Waits for a query object's report: true once it is in. The wait ends without it (false, and
+ * the object is lost for good) when it never comes: its submission was cancelled or failed
+ * (nv30_query_object_lost(), on every machine), or on the PS3 it isn't in NV30_QUERY_DEADLINE_NS
+ * after the wait began. Elsewhere it otherwise spins until the report lands, as before.
+ * YIELD: sched_yield() while waiting.
  */
 static bool
 nv30_query_object_wait(struct nv30_screen *screen, struct nv30_query_object *qo, bool yield)
@@ -104,13 +106,13 @@ nv30_query_object_wait(struct nv30_screen *screen, struct nv30_query_object *qo,
    int64_t end = 0;
 
    while (ntfy[3] & 0xff000000) {
+      if (nv30_query_object_lost(screen, qo))
+         return false;
       if (screen->base.is_ps3) {
-         int64_t now = os_time_get_nano();   /* a call: device->cancelled is read again */
+         int64_t now = os_time_get_nano();
 
          if (!end)
             end = now + NV30_QUERY_DEADLINE_NS;
-         if (nv30_query_object_lost(screen, qo))
-            return false;
          if (now >= end) {
             static bool warned;
             if (!warned) {
@@ -337,7 +339,7 @@ nv30_query_end(struct pipe_context *pipe, struct pipe_query *pq)
       nouveau_fence_ref(nv30->base.fence, &q->fence, &screen->base);
    PUSH_KICK (push);
    /* no cancellation since the report was queued: the kick sent it, and it comes */
-   if (q->qo[1] && q->qo[1]->cancel_seen == screen->base.device->cancelled)
+   if (q->qo[1] && q->qo[1]->cancel_seen == NOUVEAU_CANCELLED(screen->base.device))
       q->qo[1]->sent = true;
    return true;
 }
