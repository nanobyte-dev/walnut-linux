+   screen->idx_gart = ps3 && debug_get_bool_option("NV30_PS3_IDX_GART", nv30_ps3_idx_gart_default(ps3));
    screen->fp_gart = ps3 && debug_get_bool_option("NV30_PS3_FP_GART", nv30_ps3_fp_gart_default(ps3));
