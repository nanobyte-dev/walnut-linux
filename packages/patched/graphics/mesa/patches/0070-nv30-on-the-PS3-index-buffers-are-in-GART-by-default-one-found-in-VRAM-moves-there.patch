@@ -742,6 +742,10 @@ nv30_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
    if (nv30->vbo_user && !(nv30->dirty & (NV30_NEW_VERTEX | NV30_NEW_ARRAYS)))
       nv30_update_user_vbufs(nv30);
 
+   /* NV30_PS3_IDX_GART: an index buffer in VRAM moves to GART first (nv30_idxbuf_to_gart) */
+   if (unlikely(nv30->screen->idx_gart) && info->index_size > 1 && !info->has_user_indices)
+      nv30_idxbuf_to_gart(nv30, nv04_resource(info->index.resource));
