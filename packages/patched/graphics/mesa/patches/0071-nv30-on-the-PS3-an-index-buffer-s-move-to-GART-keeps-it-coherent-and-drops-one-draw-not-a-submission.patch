             map = pipe_buffer_map(pipe, nv30->vtxbuf[i].buffer.resource,
-                                  PIPE_MAP_UNSYNCHRONIZED |
-                                  PIPE_MAP_READ, &transfer[i]);
+                                  nv30_render_map_flags(nv30, nv30->vtxbuf[i].buffer.resource),
