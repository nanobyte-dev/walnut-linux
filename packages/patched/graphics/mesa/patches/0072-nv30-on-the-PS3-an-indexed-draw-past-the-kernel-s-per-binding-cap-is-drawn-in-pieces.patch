+/* BEGIN prim, the index batches of [start, start + count) through the bound index buffer, END */
+static void
+nv30_idx_batches(struct nouveau_pushbuf *push, unsigned prim, unsigned start, unsigned count)
+{
+   BEGIN_NV04(push, NV30_3D(VERTEX_BEGIN_END), 1);
+   PUSH_DATA (push, prim);
+   while (count) {
+      const unsigned mpush = 2047 * 256;
+      unsigned npush  = (count > mpush) ? mpush : count;
+      unsigned wpush  = ((npush + 255) & ~255) >> 8;
+
+      count -= npush;
+
+      BEGIN_NI04(push, NV30_3D(VB_INDEX_BATCH), wpush);
+      while (npush >= 256) {
+         PUSH_DATA (push, 0xff000000 | start);
+         start += 256;
+         npush -= 256;
+      }
+
+      if (npush)
+         PUSH_DATA (push, ((npush - 1) << 24) | start);
+   }
+   BEGIN_NV04(push, NV30_3D(VERTEX_BEGIN_END), 1);
+   PUSH_DATA (push, NV30_3D_VERTEX_BEGIN_END_STOP);
+}
+
+/* NV30_PS3_IDX_STATS=1: a stderr line each time a count of split draws passes a power of two */
+static void
+nv30_idx_split_count(struct nv30_screen *screen, uint32_t *n, const char *what)
+{
+   uint32_t v = p_atomic_inc_return(n);
+
+   if (unlikely(screen->idx_stats) && !(v & (v - 1)))
+      fprintf(stderr, "nv30: %u indexed draws %s (%.1f s)\n", v, what,
+              (os_time_get_nano() - screen->idx_stats_t0) / 1e9);
+}
+
+/* One piece of a split draw (nv30_idx_split.h): its own binding, at the 256-byte step at or below
+ * its first index, so ps3rsx's copy of it starts at most 255 bytes early */
+struct nv30_idx_emit {
+   struct nv30_context *nv30;
+   struct nv04_resource *res;
+   unsigned offset, isz, prim, start;
+};
+
+static void
+nv30_idx_piece(void *ctx, unsigned s, unsigned n)
+{
+   struct nv30_idx_emit *e = ctx;
+   struct nouveau_pushbuf *push = e->nv30->base.pushbuf;
+   uint64_t pos = (uint64_t)(e->start + s) * e->isz;
+   uint64_t at = pos & ~(uint64_t)255;
+
+   const uint64_t copy = nv30_idx_copy_bytes(pos - at, n, e->isz);
+
+   /* with the copies already in this submission the file's share would pass: a new one */
+   if (e->nv30->ps3_idx_bytes && e->nv30->ps3_idx_bytes + copy > NV30_PS3_IDX_SUBMIT_BYTES) {
+      PUSH_KICK(push);
+      nv30_idx_split_count(e->nv30->screen, &e->nv30->screen->idx_split_kicks,
+                           "pieces put in a submission of their own");
+   }
+   e->nv30->ps3_idx_bytes = (uint32_t)MIN2(e->nv30->ps3_idx_bytes + copy, NV30_PS3_IDX_SUBMIT_BYTES);
+   BEGIN_NV04(push, NV30_3D(IDXBUF_OFFSET), 2);
+   PUSH_RESRC(push, NV30_3D(IDXBUF_OFFSET), BUFCTX_IDXBUF, e->res, e->offset + (uint32_t)at,
+                    NOUVEAU_BO_LOW | NOUVEAU_BO_RD, 0, 0);
+   PUSH_MTHD (push, NV30_3D(IDXBUF_FORMAT), BUFCTX_IDXBUF, e->res->bo,
+                    (e->isz == 2) ? 0x00000010 : 0x00000000,
+                    e->res->domain | NOUVEAU_BO_RD,
+                    0, NV30_3D_IDXBUF_FORMAT_DMA1);
+   nv30_idx_batches(push, e->prim, (unsigned)((pos - at) / e->isz), n);
+}
+
