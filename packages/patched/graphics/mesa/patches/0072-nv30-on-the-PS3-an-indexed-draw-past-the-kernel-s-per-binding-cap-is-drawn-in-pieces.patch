diff --git a/src/gallium/drivers/nouveau/nv30/nv30_idx_split.h b/src/gallium/drivers/nouveau/nv30/nv30_idx_split.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/nouveau/nv30/nv30_idx_split.h
@@ -0,0 +1,198 @@
+/*
+ * PS3 (ps3rsx's index copies): the kernel copies the indices each index buffer binding draws into
+ * its own ring before the GPU reads them, refuses a submission whose copies pass the file's share
+ * of the ring (NV30_PS3_IDX_SUBMIT_BYTES), and refuses a binding whose primitives span more than
+ * 1 MiB of indices ("more than 1 MiB of indices through one binding": IXS_MAX in ps3rsx's
+ * idxsnap.h, ib_close in its validate.c; there is no GETPARAM for it). Its copy starts up to 255
+ * bytes before the binding's first index (a multiple of 256 bytes from the binding's offset). So
+ * nv30 draws an indexed draw over that as pieces, each with its own binding at a 256-byte step at
+ * or below its first index and at most NV30_PS3_IDX_PIECE_BYTES of indices: at most 255 bytes of
+ * skew plus the piece, under the cap with room to spare.
+ *
+ * Pure code (no context), so tests/idx-split-test.c checks it against a model of the primitives:
+ *  - nv30_idx_split: modes whose pieces are ranges of the draw's indices (lists, strips): a list
+ *    cut on a primitive boundary, a strip cut with the overlap that keeps its triangles and their
+ *    winding; with primitive restart, cut right after a restart index when the window has one,
+ *    else counted from the last restart (where the list's grouping and the strip's alternation
+ *    start again). The pieces still hold their restart indices: the GPU restarts on them as before.
+ *  - nv30_idx_convert: fans, polygons and line loops share their first vertex across any cut:
+ *    written out as a triangle (line) list instead, restart indices consumed, each triangle's
+ *    provoking vertex the one GL gives it (last or first convention), then split as a list.
+ */
+#ifndef NV30_IDX_SPLIT_H
+#define NV30_IDX_SPLIT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "compiler/shader_enums.h"
+
+#define NV30_PS3_IDX_BINDING_MAX (1u << 20)	/* ps3rsx's IXS_MAX */
+#define NV30_PS3_IDX_PIECE_BYTES (NV30_PS3_IDX_BINDING_MAX - 4096)
+/* One open file's index copies in one submission take at most 1.25 MiB of the kernel's ring (its
+ * IXS_BUDGET; more is refused, "more index copies in one submit than one file's share of the ring"):
+ * two pieces never fit together, so a piece that would pass this (with the copies of the draws
+ * since the last kick, each counted as the kernel lays it out: its skew, 256-byte steps) is put in
+ * a submission of its own. The kernel uses a copy again for the same range in one submission, so
+ * the count only overestimates (an extra kick, never a refusal). 8 KiB margin. */
+#define NV30_PS3_IDX_SUBMIT_BYTES ((1280u << 10) - 8192)
+
+/* the bytes of ring the kernel's copy of count indices of isz bytes at byte pos (from the
+ * binding's offset) takes: from the 256-byte step at or below pos, rounded up to 256 */
+static inline uint64_t
+nv30_idx_copy_bytes(uint64_t pos, unsigned count, unsigned isz)
+{
+   return ((pos & 255) + (uint64_t)count * isz + 255) & ~(uint64_t)255;
+}
+
+static inline uint32_t
+nv30_idx_get(const void *p, unsigned isz, unsigned i)
+{
+   return isz == 1 ? ((const uint8_t *)p)[i] : isz == 2 ? ((const uint16_t *)p)[i] :
+                     ((const uint32_t *)p)[i];
+}
+
+/* modes nv30_idx_split cuts (the others: nv30_idx_convert first, or not at all) */
+static inline bool
+nv30_idx_split_contiguous(unsigned mode)
+{
+   switch (mode) {
+   case MESA_PRIM_POINTS: case MESA_PRIM_LINES: case MESA_PRIM_TRIANGLES: case MESA_PRIM_QUADS:
+   case MESA_PRIM_LINE_STRIP: case MESA_PRIM_TRIANGLE_STRIP: case MESA_PRIM_QUAD_STRIP:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static inline bool
+nv30_idx_convertible(unsigned mode)
+{
+   return mode == MESA_PRIM_TRIANGLE_FAN || mode == MESA_PRIM_POLYGON || mode == MESA_PRIM_LINE_LOOP;
+}
+
+typedef void (*nv30_idx_piece_fn)(void *ctx, unsigned start, unsigned count);
+
+/*
+ * [0, count) as pieces of at most max indices, each drawn alone as mode: fn(ctx, start, count) for
+ * each, in order. idx (isz bytes per index, from the draw's start) is read only with restart.
+ * Returns the number of pieces, or 0 for a mode it doesn't cut or a max too small to progress.
+ */
+static inline unsigned
+nv30_idx_split(unsigned mode, unsigned count, unsigned max, bool restart, uint32_t rst,
+               const void *idx, unsigned isz, nv30_idx_piece_fn fn, void *ctx)
+{
+   unsigned unit, overlap, s = 0, seg = 0, n = 0;
+
+   switch (mode) {
+   case MESA_PRIM_POINTS:         unit = 1; overlap = 0; break;
+   case MESA_PRIM_LINES:          unit = 2; overlap = 0; break;
+   case MESA_PRIM_TRIANGLES:      unit = 3; overlap = 0; break;
+   case MESA_PRIM_QUADS:          unit = 4; overlap = 0; break;
+   case MESA_PRIM_LINE_STRIP:     unit = 1; overlap = 1; break;
+   /* a strip's triangles alternate their winding from its start: each piece starts an even
+    * number of indices after it (the next piece repeats the last two) */
+   case MESA_PRIM_TRIANGLE_STRIP: unit = 2; overlap = 2; break;
+   case MESA_PRIM_QUAD_STRIP:     unit = 2; overlap = 2; break;
+   default: return 0;
+   }
+   if (max < 8 || (restart && !idx))
+      return 0;
+   while (s < count) {
+      unsigned e = count - s <= max ? count : s + max;
+      bool cut = false;
+
+      /* a restart index first in the piece: what follows starts afresh */
+      if (restart && nv30_idx_get(idx, isz, s) == rst)
+         seg = s + 1;
+      if (e < count) {
+         if (restart) {
+            /* the last restart index in the window: the piece ends with it */
+            for (unsigned i = e; i-- > s + 1; ) {
+               if (nv30_idx_get(idx, isz, i) == rst) {
+                  e = i + 1;
+                  cut = true;
+                  break;
+               }
+            }
+         }
+         if (!cut) {
+            /* whole primitives (lists), an even count from the strip's start (strips) */
+            e -= (e - seg) % unit;
+            if (e <= s + overlap)
+               return 0;
+         }
+      }
+      fn(ctx, s, e - s);
+      n++;
+      if (e >= count)
+         break;
+      if (cut)
+         s = seg = e;
+      else
+         s = e - overlap;
+   }
+   return n;
+}
+
+/* the most indices nv30_idx_convert writes for count */
+static inline uint64_t
+nv30_idx_convert_max(unsigned mode, unsigned count)
+{
+   return (mode == MESA_PRIM_LINE_LOOP ? 2ull : 3ull) * count;
+}
+
+/* the mode nv30_idx_convert's list is drawn as */
+static inline unsigned
+nv30_idx_convert_mode(unsigned mode)
+{
+   return mode == MESA_PRIM_LINE_LOOP ? MESA_PRIM_LINES : MESA_PRIM_TRIANGLES;
+}
+
+/*
+ * A fan, polygon or line loop of count indices (isz bytes each) as a triangle or line list of
+ * 32-bit indices in out (room for nv30_idx_convert_max): with restart, each run between restart
+ * indices is a primitive of its own. The vertex GL takes a flat colour from stays the last of
+ * its triangle (line), or with first (flatshade_first) the first: a fan's triangle k takes
+ * vertex k + 2 (first: k + 1), a polygon's vertex 0 either way; a loop's segment k takes vertex
+ * k + 1 (first: k), its closing segment vertex 0 (first: the last). Returns the indices written.
+ */
+static inline unsigned
+nv30_idx_convert(unsigned mode, unsigned count, bool restart, uint32_t rst, const void *idx,
+                 unsigned isz, bool first, uint32_t *out)
+{
+   unsigned o = 0, s0 = 0;
+
+   for (unsigned i = 0; i <= count; i++) {
+      if (i < count && !(restart && nv30_idx_get(idx, isz, i) == rst))
+         continue;
+      /* the primitive [s0, i) */
+      if (mode == MESA_PRIM_LINE_LOOP) {
+         if (i - s0 >= 2) {
+            for (unsigned k = s0 + 1; k < i; k++) {
+               out[o++] = nv30_idx_get(idx, isz, k - 1);
+               out[o++] = nv30_idx_get(idx, isz, k);
+            }
+            out[o++] = nv30_idx_get(idx, isz, i - 1);
+            out[o++] = nv30_idx_get(idx, isz, s0);
+         }
+      } else if (i - s0 >= 3) {
+         uint32_t c = nv30_idx_get(idx, isz, s0);
+         bool c_first = mode == MESA_PRIM_POLYGON ? first : !first;
+
+         for (unsigned k = s0 + 2; k < i; k++) {
+            uint32_t a = nv30_idx_get(idx, isz, k - 1), b = nv30_idx_get(idx, isz, k);
+
+            /* (c, a, b) and (a, b, c): the same winding, the provoking vertex last or first */
+            if (c_first) {
+               out[o++] = c; out[o++] = a; out[o++] = b;
+            } else {
+               out[o++] = a; out[o++] = b; out[o++] = c;
+            }
+         }
+      }
+      s0 = i + 1;
+   }
+   return o;
+}
+
+#endif
