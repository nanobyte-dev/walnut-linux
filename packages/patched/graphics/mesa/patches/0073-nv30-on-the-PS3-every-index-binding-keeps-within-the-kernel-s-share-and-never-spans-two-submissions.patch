    screen->idx_split = ps3 && debug_get_bool_option("NV30_PS3_IDX_SPLIT", true);
+   if (ps3 && !screen->idx_split)
+      fprintf(stderr, "nv30: NV30_PS3_IDX_SPLIT=0: indexed draws past 1 MiB of indices whole, which "
+              "ps3rsx refuses\n");
    screen->idx_stats_t0 = os_time_get_nano();
    screen->fp_const_vram = debug_get_bool_option("NV30_FP_CONST_VRAM", !ps3);
    screen->index_upload = debug_get_num_option("NV30_INDEX_UPLOAD", ps3 ? 32 : 0);
