diff --git a/src/gallium/drivers/nouveau/nv30/nv30_sifm_extent.h b/src/gallium/drivers/nouveau/nv30/nv30_sifm_extent.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/nouveau/nv30/nv30_sifm_extent.h
@@ -0,0 +1,46 @@
+#ifndef __NV30_SIFM_EXTENT_H__
+#define __NV30_SIFM_EXTENT_H__
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "nv30/nv30_transfer.h"
+
+/*
+ * PS3: ps3rsx refuses a scaled-image (SIFM) copy whose source might be read past the end of its
+ * buffer (validate.c, sifm_check). It doesn't know whether the engine clamps its reads to the
+ * declared IMAGE_IN_SIZE, so it takes the larger of that size and the texels the steps sample,
+ * the last output's texel plus, with bilinear filtering, the next one. nv30_transfer_rect_sifm
+ * declares align(w, 2) x align(h, 2): an odd-height source counts one row more than it has.
+ * These are the kernel's numbers for the words nv30_transfer_rect_sifm sends.
+ */
+
+/* One past the last source texel along an axis: from p (12.4), the step d (12.20) and n outputs */
+static inline uint64_t
+nv30_sifm_end(uint32_t p, uint32_t d, uint32_t n, bool nearest)
+{
+   uint64_t last = ((uint64_t)(p & 0xffff) << 16) + (uint64_t)d * (n - 1);
+
+   if (nearest)
+      last += d / 2;   /* ORIGIN_CENTER */
+   return (last >> 20) + 1 + !nearest;   /* FILTER_BILINEAR reads the next texel too */
+}
+
+/* The bytes from src's offset the kernel takes the copy src -> dst to read */
+static inline uint64_t
+nv30_sifm_src_bytes(const struct nv30_rect *src, const struct nv30_rect *dst, bool nearest)
+{
+   uint32_t ow = dst->x1 - dst->x0, oh = dst->y1 - dst->y0;
+   uint32_t dudx = ((src->x1 - src->x0) << 20) / ow;
+   uint32_t dvdy = ((src->y1 - src->y0) << 20) / oh;
+   uint64_t cols = nv30_sifm_end(src->x0 << 4, dudx, ow, nearest);
+   uint64_t rows = nv30_sifm_end(src->y0 << 4, dvdy, oh, nearest);
+
+   if (cols < ((src->w + 1) & ~1u))
+      cols = (src->w + 1) & ~1u;   /* IMAGE_IN_SIZE: align(w, 2) */
+   if (rows < ((src->h + 1) & ~1u))
+      rows = (src->h + 1) & ~1u;   /* and align(h, 2) */
+   return (uint64_t)(src->pitch & 0xffff) * (rows - 1) + cols * src->cpp;
+}
+
+#endif
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_transfer.c b/src/gallium/drivers/nouveau/nv30/nv30_transfer.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_transfer.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_transfer.c
@@ -36,6 +36,7 @@
 #include "nv30/nv30-40_3d.xml.h"
 
 #include "nv30/nv30_context.h"
+#include "nv30/nv30_sifm_extent.h"
 #include "nv30/nv30_transfer.h"
 #include "nv30/nv30_winsys.h"
 
@@ -448,12 +449,36 @@ nv30_transfer_rect_blit(XFER_ARGS)
    }
 }
 
+/* NV30_PS3_IDX_STATS=1, and always the first: a stderr line each time the count of copies the
+ * SIFM guard below sent another way passes a power of two */
+static void
+nv30_sifm_guard_count(struct nv30_screen *screen)
+{
+   uint32_t v = p_atomic_inc_return(&screen->sifm_guarded);
+
+   if (v == 1 || (unlikely(screen->idx_stats) && !(v & (v - 1))))
+      fprintf(stderr, "nv30: %u copies whose SIFM source would pass its buffer's end taken by the 3D "
+              "blit or the CPU instead\n", v);
+}
+
 static bool
 nv30_transfer_sifm(XFER_ARGS)
 {
    if (!src->pitch || src->w > 1024 || src->h > 1024 || src->w < 2 || src->h < 2)
       return false;
 
+   /* PS3: the extent ps3rsx checks (nv30_sifm_extent.h) inside the source's buffer, or ps3rsx
+    * refuses the submission and the copy is lost with everything queued in it. The staging buffers
+    * and linear textures have the room (nv30_miptree.c), so this only catches a source nothing
+    * padded; the next method, the 3D blit, then copies it on the GPU (the CPU for a one-byte
+    * swizzled destination, which on the PS3 is always mappable: textures are made in the
+    * CPU-visible VRAM or in GART) */
+   if (nv30->screen->base.is_ps3 && src->bo && dst->x1 > dst->x0 && dst->y1 > dst->y0 &&
+       src->offset + nv30_sifm_src_bytes(src, dst, filter == NEAREST) > src->bo->size) {
+      nv30_sifm_guard_count(nv30->screen);
+      return false;
+   }
+
    if (src->d > 1 || dst->d > 1)
       return false;
 
