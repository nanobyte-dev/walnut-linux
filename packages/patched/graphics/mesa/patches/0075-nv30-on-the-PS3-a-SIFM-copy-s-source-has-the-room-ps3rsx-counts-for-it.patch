@@ -52,6 +52,7 @@ files_libnouveau = files(
   'nv30/nv30_state_validate.c',
   'nv30/nv30_texture.c',
   'nv30/nv30_transfer.c',
+  'nv30/nv30_sifm_extent.h',
   'nv30/nv30_transfer.h',
   'nv30/nv30_vbo.c',
   'nv30/nv30_vertprog.c',
diff --git a/src/gallium/drivers/nouveau/nv30/nv30_miptree.c b/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
--- a/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
+++ b/src/gallium/drivers/nouveau/nv30/nv30_miptree.c
@@ -693,6 +693,12 @@ nv30_miptree_transfer_map(struct pipe_context *pipe, struct pipe_resource *pt,
                box->width, box->height, &tx->img);
 
    unsigned size = tx->base.layer_stride * tx->base.box.depth;
+   /* PS3: a copy out of the staging buffer by SIFM (into a swizzled texture) declares its source
+    * align(h, 2) rows high, and ps3rsx checks all of them inside the buffer (nv30_sifm_extent.h):
+    * an odd-height box gets one row more at the end (the layout and layer_stride stay; a row of
+    * stride bytes holds align(w, 2) texels, the stride being a multiple of 64) */
+   if (nv30->screen->base.is_ps3 && (tx->nblocksy & 1))
+      size += tx->base.stride;
    tx->pooled_size = 0;
    if (nv30->screen->staging_max && !(usage & PIPE_MAP_READ) &&
        size <= NV30_STAGING_POOL_MAX_BO) {
@@ -946,6 +952,12 @@ nv30_miptree_create(struct pipe_screen *pscreen,
       size = mt->layer_size * 6;
    }
 
+   /* PS3: a linear texture's level copied by SIFM (resource_copy_region into a swizzled texture,
+    * a resolve) is declared align(h, 2) rows high, and ps3rsx checks all of them inside the buffer
+    * (nv30_sifm_extent.h): one row more at the end, for the last level */
+   if (nv30_screen(pscreen)->base.is_ps3 && mt->uniform_pitch)
+      size += mt->uniform_pitch;
+
    /* nv30_transfer_rect_cpu maps textures; on the PS3, VRAM above 224 MB has no CPU mapping,
     * so ask for the CPU-visible part (NOUVEAU_GEM_DOMAIN_MAPPABLE). */
    ret = nouveau_bo_new(dev, NOUVEAU_BO_VRAM |
