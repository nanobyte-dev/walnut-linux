+/* PS3 (nouveau_mm_ps3.h): the GART pool of buf's new storage, from its usage and flags. Storage
+ * the CPU rewrites all the time (stream, staging, persistent, coherent buffers, so u_upload's, and a
+ * user buffer's upload at each draw) goes to mm_GART_stream, out of the other buffers' slab objects;
+ * the rest, and everything without a stream pool, to mm_GART. */
+struct nouveau_mman *
+nouveau_buffer_gart_mm(struct nouveau_screen *screen, const struct nv04_resource *buf)
+{
+   const enum pipe_resource_usage usage = buf->base.usage;
+
+   if (screen->mm_GART_stream &&
+       (usage == PIPE_USAGE_STREAM || usage == PIPE_USAGE_STAGING ||
+        (buf->base.flags & (PIPE_RESOURCE_FLAG_MAP_PERSISTENT | PIPE_RESOURCE_FLAG_MAP_COHERENT)) ||
+        (buf->status & NOUVEAU_BUFFER_STATUS_USER_MEMORY)))
+      return screen->mm_GART_stream;
+   return screen->mm_GART;
+}
+
 static inline bool
 nouveau_buffer_allocate(struct nouveau_screen *screen,
                         struct nv04_resource *buf, unsigned domain)
@@ -86,7 +103,7 @@ nouveau_buffer_allocate(struct nouveau_screen *screen,
       NOUVEAU_DRV_STAT(screen, buf_obj_current_bytes_vid, buf->base.width0);
    } else
    if (domain == NOUVEAU_BO_GART) {
-      buf->mm = nouveau_mm_allocate(screen->mm_GART, size,
+      buf->mm = nouveau_mm_allocate(nouveau_buffer_gart_mm(screen, buf), size,
                                     &buf->bo, &buf->offset);
       if (!buf->bo)
          return false;
@@ -231,13 +248,14 @@ nouveau_transfer_staging(struct nouveau_context *nv,
       if (tx->map)
          tx->map += adj;
    } else {
-      tx->mm =
-         nouveau_mm_allocate(nv->screen->mm_GART, size, &tx->bo, &tx->offset);
+      /* (PS3: in the stream pool, with the other storage rewritten all the time) */
+      struct nouveau_mman *mm = nv->screen->mm_GART_stream ? nv->screen->mm_GART_stream
+                                                           : nv->screen->mm_GART;
+      tx->mm = nouveau_mm_allocate(mm, size, &tx->bo, &tx->offset);
       if (!tx->bo) {
          /* out of GART: the GPU's work so far holds staging and freed storage back */
          nouveau_fence_wait_idle(nv);
-         tx->mm =
-            nouveau_mm_allocate(nv->screen->mm_GART, size, &tx->bo, &tx->offset);
+         tx->mm = nouveau_mm_allocate(mm, size, &tx->bo, &tx->offset);
       }
       if (tx->bo) {
          tx->offset += adj;
