@@ -209,6 +219,7 @@ nouveau_mm_allocate(struct nouveau_mman *cache,
 
       list_del(&slab->head);
       list_add(&slab->head, &bucket->used);
+      bucket->num_free--;
    }
 
    *offset = mm_slab_alloc(slab) << slab->order;
@@ -227,11 +238,23 @@ nouveau_mm_allocate(struct nouveau_mman *cache,
    return alloc;
 }
 
+/* a slab no bucket holds any more: its object goes (once the buffers' own references to it have) */
+static void
+mm_slab_release(struct nouveau_mman *cache, struct mm_slab *slab)
+{
+   p_atomic_add(&cache->allocated, -(int64_t)((uint64_t)slab->count << slab->order));
+   p_atomic_inc(&cache->slabs_freed);
+   nouveau_bo_ref(NULL, &slab->bo);
+   FREE(slab);
+}
+
 void
 nouveau_mm_free(struct nouveau_mm_allocation *alloc)
 {
    struct mm_slab *slab = (struct mm_slab *)alloc->priv;
-   struct mm_bucket *bucket = mm_bucket_by_order(slab->cache, slab->order);
+   struct nouveau_mman *cache = slab->cache;
+   struct mm_bucket *bucket = mm_bucket_by_order(cache, slab->order);
+   struct mm_slab *surplus = NULL;
 
    simple_mtx_lock(&bucket->lock);
    mm_slab_free(slab, alloc->offset >> slab->order);
@@ -239,6 +262,12 @@ nouveau_mm_free(struct nouveau_mm_allocation *alloc)
    if (slab->free == slab->count) {
       list_del(&slab->head);
       list_addtail(&slab->head, &bucket->free);
+      /* past the empty slabs the bucket keeps, the oldest empty one goes */
+      if (++bucket->num_free > cache->keep && cache->keep >= 0) {
+         surplus = list_first_entry(&bucket->free, struct mm_slab, head);
+         list_del(&surplus->head);
+         bucket->num_free--;
+      }
    } else
    if (slab->free == 1) {
       list_del(&slab->head);
@@ -246,6 +275,8 @@ nouveau_mm_free(struct nouveau_mm_allocation *alloc)
    }
    simple_mtx_unlock(&bucket->lock);
 
+   if (surplus)
+      mm_slab_release(cache, surplus);
    FREE(alloc);
 }
 
@@ -269,11 +300,15 @@ nouveau_mm_create(struct nouveau_device *dev, uint32_t domain,
    cache->domain = domain;
    cache->config = *config;
    cache->allocated = 0;
+   cache->keep = -1;
+   cache->peak = 0;
+   cache->slabs_made = cache->slabs_freed = 0;
 
    for (i = 0; i < MM_NUM_BUCKETS; ++i) {
       list_inithead(&cache->bucket[i].free);
       list_inithead(&cache->bucket[i].used);
       list_inithead(&cache->bucket[i].full);
+      cache->bucket[i].num_free = 0;
       simple_mtx_init(&cache->bucket[i].lock, mtx_plain);
    }
 
@@ -314,3 +349,28 @@ nouveau_mm_destroy(struct nouveau_mman *cache)
 
    FREE(cache);
 }
+
+/* before the pool's first allocation: the empty slabs each of its buckets keeps (-1: all) */
+void
+nouveau_mm_set_keep(struct nouveau_mman *cache, int keep)
+{
+   if (cache)
+      cache->keep = keep;
+}
+
+void
+nouveau_mm_get_stats(struct nouveau_mman *cache, struct nouveau_mm_stats *st)
+{
+   memset(st, 0, sizeof(*st));
+   if (!cache)
+      return;
+   st->bytes = p_atomic_read(&cache->allocated);
+   st->peak = p_atomic_read(&cache->peak);
+   st->slabs_made = p_atomic_read(&cache->slabs_made);
+   st->slabs_freed = p_atomic_read(&cache->slabs_freed);
+   for (int i = 0; i < MM_NUM_BUCKETS; ++i) {
+      simple_mtx_lock(&cache->bucket[i].lock);
+      st->kept += cache->bucket[i].num_free;
+      simple_mtx_unlock(&cache->bucket[i].lock);
+   }
+}
