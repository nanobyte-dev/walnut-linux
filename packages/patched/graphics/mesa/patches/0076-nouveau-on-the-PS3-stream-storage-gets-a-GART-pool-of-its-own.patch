diff --git a/src/gallium/drivers/nouveau/nouveau_mm_ps3.h b/src/gallium/drivers/nouveau/nouveau_mm_ps3.h
new file mode 100644
index 0000000..ae29ffc
--- /dev/null
+++ b/src/gallium/drivers/nouveau/nouveau_mm_ps3.h
@@ -0,0 +1,64 @@
+#ifndef __NOUVEAU_MM_PS3_H__
+#define __NOUVEAU_MM_PS3_H__
+
+#include <inttypes.h>
+#include <stdio.h>
+
+#include "util/u_debug.h"
+#include "util/u_math.h"
+
+#include "nouveau_mm.h"
+#include "nouveau_screen.h"
+
+/*
+ * The PS3's GART pools (nouveau_screen_init, once mm_GART is made; is_ps3 only):
+ * - NV30_PS3_GART_POOL (default 1): a second GART suballocator, mm_GART_stream, on the same size
+ *   classes, for the storage that is rewritten all the time: stream, staging, persistent, coherent and
+ *   user-memory buffers (nouveau_buffer_gart_mm) and transfer staging and readback areas
+ *   (nouveau_transfer_staging), so they share slab objects only with each other and the other GART
+ *   buffers (index buffers, buffers moved to GART) share theirs only with long-lived storage. The
+ *   pool is chosen once per allocation; 0: one pool, as before.
+ * - NV30_PS3_MM_KEEP_SLAB=N (default -1: none is ever freed, as before 0077, and as mm_VRAM keeps
+ *   on): each size class of the two GART pools keeps N empty slabs for its next allocations and frees
+ *   the slabs that empty past them; 0: every slab that empties is freed. Not the default: each free
+ *   closes a GEM object, and a load that crosses a slab boundary every frame would make and free a
+ *   slab every frame.
+ * - NV30_PS3_GART_STATS=1: a stderr line at the screen's end with each pool's bytes of slab objects,
+ *   their peak, the slabs made and freed and the empty ones kept (counted always: at a slab's making
+ *   and freeing only).
+ */
+static inline void
+nouveau_mm_ps3_init(struct nouveau_screen *screen, union nouveau_bo_config *config)
+{
+   const int keep = CLAMP(debug_get_num_option("NV30_PS3_MM_KEEP_SLAB", -1), -1, 64);
+
+   screen->gart_stats = debug_get_bool_option("NV30_PS3_GART_STATS", false);
+   if (debug_get_bool_option("NV30_PS3_GART_POOL", true))
+      screen->mm_GART_stream = nouveau_mm_create(screen->device, NOUVEAU_BO_GART | NOUVEAU_BO_MAP,
+                                                 config);
+   nouveau_mm_set_keep(screen->mm_GART, keep);
+   nouveau_mm_set_keep(screen->mm_GART_stream, keep);
+}
+
+/* the screen's end, before mm_GART goes: the stats line, and the stream pool */
+static inline void
+nouveau_mm_ps3_fini(struct nouveau_screen *screen)
+{
+   if (screen->gart_stats) {
+      struct nouveau_mm_stats g, s;
+      nouveau_mm_get_stats(screen->mm_GART, &g);
+      nouveau_mm_get_stats(screen->mm_GART_stream, &s);
+      fprintf(stderr, "nv30: GART slabs at the end (NV30_PS3_GART_STATS): mm_GART %" PRIu64 " KiB, peak %"
+              PRIu64 " KiB, %u made, %u freed, %u kept empty; ", g.bytes >> 10, g.peak >> 10, g.slabs_made,
+              g.slabs_freed, g.kept);
+      if (screen->mm_GART_stream)
+         fprintf(stderr, "mm_GART_stream %" PRIu64 " KiB, peak %" PRIu64 " KiB, %u made, %u freed, "
+                 "%u kept empty\n", s.bytes >> 10, s.peak >> 10, s.slabs_made, s.slabs_freed, s.kept);
+      else
+         fprintf(stderr, "mm_GART_stream off\n");
+   }
+   nouveau_mm_destroy(screen->mm_GART_stream);
+   screen->mm_GART_stream = NULL;
+}
+
+#endif // __NOUVEAU_MM_PS3_H__
