# The lockdep variant of the debug flavour (LINUX_VARIANT=lockdep, tools/linux-config.sh), on top of
# ps3.config and ps3-debug.config: the slub_debug and lockdep boot of round 3 (boot it with
# slub_debug=FZPU added to the kernel line). It costs about 10 MB of RAM in static tables and checks
# every lock: never the default kernel, never published; ps3rsx is built for it (ps3rsx-modules,
# the pairing rule) like for any kernel.
# PROVE_LOCKING selects the lock debugging options below; they are listed so ps3.config's
# "is not set" lines for them don't stand.
CONFIG_PROVE_LOCKING=y
CONFIG_LOCKDEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RT_MUTEXES=y
CONFIG_DEBUG_WW_MUTEX_SLOWPATH=y
CONFIG_DEBUG_RWSEMS=y
CONFIG_DEBUG_LOCK_ALLOC=y
CONFIG_DEBUG_IRQFLAGS=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_SLUB_DEBUG=y
