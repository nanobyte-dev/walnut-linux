# The release flavour, on top of ps3.config: about 8.7 MB less resident kernel image
# (docs/KERNEL-MEMORY.md section 4, rows 1, 3, 4, 8, 9, 10 and 15; measured on 6.12.112).
# SLUB_DEBUG stays (99K; /proc/slabinfo for memory work).
# CONFIG_STRICT_KERNEL_RWX is not set
# powerpc selects STRICT_KERNEL_RWX whenever STRICT_MODULE_RWX is set (arch/powerpc/Kconfig)
# CONFIG_STRICT_MODULE_RWX is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IPV6 is not set
# CONFIG_IO_URING is not set
# CONFIG_QUOTA is not set
# CONFIG_KEXEC is not set
# CONFIG_HUGETLBFS is not set
CONFIG_NFS_V4=m
CONFIG_LOG_BUF_SHIFT=16
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_IKCONFIG is not set
CONFIG_INET_TABLE_PERTURB_ORDER=8
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_STACKOVERFLOW is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_RCU_TRACE is not set
