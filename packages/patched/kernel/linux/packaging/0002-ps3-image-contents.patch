From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Fri, 16 Oct 2026 04:13:09 +0300
Subject: PS3 image contents: stripped vmlinux, real System.map, boot arguments

Petitboot kexecs /boot/vmlinux-<release> on a 256 MB machine, so the image is fully stripped
(symbol table too, as our kernels always were) instead of --strip-debug. No -dbg package is
built, so the image ships the real System.map rather than a placeholder. The flavour's boot
arguments (debian/config/<arch>/args.<flavour>, from linux/flavours/release.args and
debug.args) are installed as /usr/lib/ps3/boot/<release>.args, which ps3-update-kboot
(ps3-boot) puts in the kernel's Petitboot menu entry.

Forwarded: not-needed
Last-Update: 2026-10-16

diff --git a/debian/rules.real b/debian/rules.real
--- a/debian/rules.real
+++ b/debian/rules.real
@@ -192,7 +192,8 @@ $(STAMPS_DIR)/build_$(ARCH)_$(FEATURESET)_$(FLAVOUR): $(STAMPS_DIR)/setup_$(ARCH
 	install -D -m644 '$(DIR)/$(IMAGE_FILE)' $(OUTPUT_DIR)/boot/$(IMAGE_INSTALL_STEM)-$(REAL_VERSION)
 ifeq ($(IMAGE_FILE),vmlinux)
 # This is the unprocessed ELF image, so we need to strip debug symbols
-	$(CROSS_COMPILE)strip --strip-debug $(OUTPUT_DIR)/boot/$(IMAGE_INSTALL_STEM)-$(REAL_VERSION)
+# PS3: and the symbol table (Petitboot kexecs it in a 256 MB machine; System.map has the symbols)
+	$(CROSS_COMPILE)strip $(OUTPUT_DIR)/boot/$(IMAGE_INSTALL_STEM)-$(REAL_VERSION)
 endif
 
 	install -D -m644 $(DIR)/vmlinux $(OUTPUT_DIR_DBG)/boot/vmlinux-$(REAL_VERSION)
@@ -454,8 +455,12 @@ ifneq ($(filter arm64 armel armhf mipsel mips64el mipsr6 mipsr6el mips64r6 mips6
 	dh_install --sourcedir=$(DIR2) usr
 endif
 	sed '/CONFIG_\(MODULE_SIG_\(ALL\|KEY\)\|SYSTEM_TRUSTED_KEYS\|BUILD_SALT\)[ =]/d' $(DIR)/.config > $(DESTDIR)/boot/config-$(REAL_VERSION)
-	echo "ffffffffffffffff B The real System.map is in the linux-image-<version>-dbg package" \
-		> $(DESTDIR)/boot/System.map-$(REAL_VERSION)
+# PS3: the real System.map (no -dbg package is built), and the kernel's boot arguments for
+# ps3-update-kboot (Petitboot's boot menu)
+	install -m644 $(DIR)/System.map $(DESTDIR)/boot/System.map-$(REAL_VERSION)
+	if [ -f debian/config/$(ARCH)/args.$(FLAVOUR) ]; then \
+		install -D -m644 debian/config/$(ARCH)/args.$(FLAVOUR) $(DESTDIR)/usr/lib/ps3/boot/$(REAL_VERSION).args; \
+	fi
 	rm $(DESTDIR)/lib/firmware -rf
 
 	dh_installdirs usr/share/bug/$(PACKAGE_NAME)
