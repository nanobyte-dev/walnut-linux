From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sat, 31 Oct 2026 19:08:31 +0200
Subject: ps3: ps3rsx's GART from a CMA area

The RSX reaches main memory through its context's IO window in 1 MiB
pages, and 1 MiB contiguous allocations are unreliable on a 256 MB
machine once it is up, so the memory for ps3rsx's GART (the RSX
driver, out of tree) is set aside at boot.

ps3rsx_cma=<size> declares a CMA area of that size and exports three
functions to ps3rsx: the area's size, an allocation of whole 1 MiB
chunks (1 MiB aligned, the GPU's IO page size) and their release.
ps3rsx backs an IO page with a chunk when a buffer object first needs
it and gives it back once it is idle, so between uses the area holds
ordinary movable pages and the GART costs RAM only while the GPU uses
it.

ps3rsx_gart=<size> reserves a fixed area instead, from memblock like
ps3fb's video memory, held for good; ps3rsx uses it in place of the CMA
area when it is set. It is the earlier scheme, kept as a fallback for
experiments. Its default is 0 (it was 64 MiB, so a command line without
ps3rsx_gart=0 reserved 64 MiB for good next to the CMA area). Without
either parameter ps3rsx has no GART and says so when it probes.

Both sizes are parsed with a ceiling (ps3rsx_gart= 128 MiB, ps3rsx_cma=
256 MiB): a larger number, or one that wrapped in memparse(), is clamped
with a warning, and a ps3rsx_gart= reservation memblock can't satisfy
turns the fixed GART off with a warning instead of panicking the boot.
The parameters are set once at boot and read-only afterwards.

diff --git a/arch/powerpc/include/asm/ps3.h b/arch/powerpc/include/asm/ps3.h
--- a/arch/powerpc/include/asm/ps3.h
+++ b/arch/powerpc/include/asm/ps3.h
@@ -450,6 +450,14 @@ struct ps3_prealloc {
 };
 
 extern struct ps3_prealloc ps3fb_videomemory;
+extern struct ps3_prealloc ps3rsx_gart;
+
+/* ps3rsx's GART from a CMA area (ps3rsx_cma=<size>): 1 MiB chunks taken and given back on demand,
+ * so the memory serves movable pages while the GPU doesn't use it */
+struct page;
+u64 ps3rsx_cma_size(void);
+struct page *ps3rsx_cma_alloc(unsigned int mib);
+void ps3rsx_cma_free(struct page *page, unsigned int mib);
 extern struct ps3_prealloc ps3flash_bounce_buffer;
 
 /* logical performance monitor */
diff --git a/arch/powerpc/platforms/ps3/setup.c b/arch/powerpc/platforms/ps3/setup.c
--- a/arch/powerpc/platforms/ps3/setup.c
+++ b/arch/powerpc/platforms/ps3/setup.c
@@ -13,6 +13,8 @@
 #include <linux/console.h>
 #include <linux/export.h>
 #include <linux/memblock.h>
+#include <linux/cma.h>
+#include <linux/sizes.h>
 #include <linux/of.h>
 
 #include <asm/machdep.h>
@@ -148,6 +150,164 @@ early_param("ps3fb", early_parse_ps3fb);
 #define prealloc_ps3fb_videomemory()	do { } while (0)
 #endif
 
+#if defined(CONFIG_FB_PS3) || defined(CONFIG_FB_PS3_MODULE)
+/*
+ * Main memory the RSX driver (ps3rsx, out of tree) maps into the GPU's IO window. The GPU maps
+ * main memory in 1 MiB pages, and 1 MiB contiguous allocations are unreliable once the system
+ * is up, so the GART's memory is set aside at boot: normally as the CMA area below
+ * (ps3rsx_cma=<size>), which costs RAM only while the GPU uses it. ps3rsx_gart=<size> instead
+ * reserves a fixed area, held for good; ps3rsx uses it in place of the CMA area. Default 0: none.
+ */
+struct ps3_prealloc ps3rsx_gart __ro_after_init = {
+	.name = "ps3rsx gart",
+	.size = 0,
+	.align = 1024*1024
+};
+EXPORT_SYMBOL_GPL(ps3rsx_gart);
+
+/* the most ps3rsx_gart= may hold for good: half of the console's 256 MiB */
+#define PS3RSX_GART_MAX		SZ_128M
+
+/*
+ * memparse() for a size with a ceiling: memparse() shifts the number by its suffix without a
+ * check, so "16384G" wrapped to 0 and a large number reached memblock unchecked. A number above
+ * max (or whose suffix would take it above max) is clamped to max, with a warning.
+ */
+static u64 __init ps3rsx_parse_size(const char *name, const char *arg, u64 max)
+{
+	char *end;
+	unsigned int shift = 0;
+	u64 n = simple_strtoull(arg, &end, 0);
+
+	switch (*end) {
+	case 'E':
+	case 'e':
+		shift += 10;
+		fallthrough;
+	case 'P':
+	case 'p':
+		shift += 10;
+		fallthrough;
+	case 'T':
+	case 't':
+		shift += 10;
+		fallthrough;
+	case 'G':
+	case 'g':
+		shift += 10;
+		fallthrough;
+	case 'M':
+	case 'm':
+		shift += 10;
+		fallthrough;
+	case 'K':
+	case 'k':
+		shift += 10;
+	}
+	if (n > (max >> shift)) {
+		pr_warn("%s=%s is more than %llu MiB, using %llu MiB\n", name, arg,
+			(unsigned long long)max >> 20, (unsigned long long)max >> 20);
+		return max;
+	}
+	return n << shift;
+}
+
+static int __init early_parse_ps3rsx_gart(char *p)
+{
+	if (!p)
+		return 1;
+
+	ps3rsx_gart.size = ALIGN(ps3rsx_parse_size("ps3rsx_gart", p, PS3RSX_GART_MAX),
+				 ps3rsx_gart.align);
+	return 0;
+}
+early_param("ps3rsx_gart", early_parse_ps3rsx_gart);
+
+/* like prealloc(), but a reservation that doesn't fit costs the GART, not the boot */
+static void __init prealloc_ps3rsx_gart(void)
+{
+	struct ps3_prealloc *p = &ps3rsx_gart;
+
+	if (!p->size)
+		return;
+
+	p->address = memblock_alloc(p->size, p->align);
+	if (!p->address) {
+		pr_warn("%s: no room for %lu bytes, going on without it\n", p->name, p->size);
+		p->size = 0;
+		return;
+	}
+
+	printk(KERN_INFO "%s: %lu bytes at %p\n", p->name, p->size, p->address);
+}
+#else
+#define prealloc_ps3rsx_gart()	do { } while (0)
+#endif
+
+#if defined(CONFIG_CMA) && (defined(CONFIG_FB_PS3) || defined(CONFIG_FB_PS3_MODULE))
+/*
+ * ps3rsx's GART as a CMA area: ps3rsx takes 1 MiB chunks when GPU buffers need them and gives
+ * them back when they're idle, and in between the area holds ordinary movable pages.
+ * ps3rsx_cma=<size> (default 0: no area, and ps3rsx has no GART unless ps3rsx_gart= is set).
+ */
+static struct cma *ps3rsx_cma __ro_after_init;
+static phys_addr_t ps3rsx_cma_req __initdata;
+
+/* the most ps3rsx_cma= may ask for: the console's whole 256 MiB (cma_declare_contiguous refuses what doesn't fit) */
+#define PS3RSX_CMA_MAX		SZ_256M
+
+static int __init early_parse_ps3rsx_cma(char *p)
+{
+	if (!p)
+		return 1;
+
+	ps3rsx_cma_req = ALIGN(ps3rsx_parse_size("ps3rsx_cma", p, PS3RSX_CMA_MAX), SZ_1M);
+	return 0;
+}
+early_param("ps3rsx_cma", early_parse_ps3rsx_cma);
+
+static void __init reserve_ps3rsx_cma(void)
+{
+	int ret;
+
+	if (!ps3rsx_cma_req)
+		return;
+	ret = cma_declare_contiguous(0, ps3rsx_cma_req, 0, SZ_1M, 0, false, "ps3rsx", &ps3rsx_cma);
+	if (ret) {
+		pr_err("ps3rsx: no CMA area of %llu MiB: %d\n",
+		       (unsigned long long)ps3rsx_cma_req >> 20, ret);
+		ps3rsx_cma = NULL;
+		return;
+	}
+	pr_info("ps3rsx: %llu MiB CMA area for the GART\n",
+		(unsigned long long)ps3rsx_cma_req >> 20);
+}
+
+u64 ps3rsx_cma_size(void)
+{
+	return ps3rsx_cma ? cma_get_size(ps3rsx_cma) : 0;
+}
+EXPORT_SYMBOL_GPL(ps3rsx_cma_size);
+
+/* mib physically contiguous MiB, 1 MiB aligned (the GPU's IO pages are 1 MiB), or NULL */
+struct page *ps3rsx_cma_alloc(unsigned int mib)
+{
+	if (!ps3rsx_cma)
+		return NULL;
+	return cma_alloc(ps3rsx_cma, (unsigned long)mib << (20 - PAGE_SHIFT), get_order(SZ_1M),
+			 true);
+}
+EXPORT_SYMBOL_GPL(ps3rsx_cma_alloc);
+
+void ps3rsx_cma_free(struct page *page, unsigned int mib)
+{
+	cma_release(ps3rsx_cma, page, (unsigned long)mib << (20 - PAGE_SHIFT));
+}
+EXPORT_SYMBOL_GPL(ps3rsx_cma_free);
+#else
+#define reserve_ps3rsx_cma()	do { } while (0)
+#endif
+
 #if defined(CONFIG_PS3_FLASH) || defined(CONFIG_PS3_FLASH_MODULE)
 struct ps3_prealloc ps3flash_bounce_buffer = {
 	.name = "ps3flash bounce buffer",
@@ -253,6 +413,8 @@ static void __init ps3_setup_arch(void)
 #endif
 
 	prealloc_ps3fb_videomemory();
+	prealloc_ps3rsx_gart();
+	reserve_ps3rsx_cma();
 	prealloc_ps3flash_bounce_buffer();
 
 	ppc_md.power_save = ps3_power_save;
