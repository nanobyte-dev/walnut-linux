+static int ps3_sm_fan_read(struct ps3_sm_hwmon *hw, u32 attr, long *val)
+{
+	struct ps3_sm_fan_reply f;
+	int policy = READ_ONCE(hw->fan_policy);
+
+	if (READ_ONCE(hw->fan_dead) && policy != PS3_SM_FAN_AUTO)
+		return -ENODATA;
