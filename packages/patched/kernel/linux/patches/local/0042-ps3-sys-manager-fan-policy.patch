+/* From the vuart work (or the final shutdown poll), header already read. */
+
+static int ps3_sm_fan_handle_reply(struct ps3_system_bus_device *dev,
+	const struct ps3_sys_manager_header *header)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+	unsigned long flags;
+	bool matched = false;
+	u8 kind, buf[16];
+	int result;
+
+	/* ps3_sys_manager_handle_msg() checked payload_size <= 16. */
+	if (header->payload_size) {
+		result = ps3_vuart_read(dev, buf, header->payload_size);
+		if (result) {
+			ps3_vuart_clear_rx_bytes(dev, header->payload_size);
+			return result;
+		}
+	}
+
+	if (!hw)
+		return 0;
+
+	kind = header->service_id < PS3_SM_SERVICE_ID_FAN_POLICY_GET ?
+		PS3_SM_REQ_FAN_SET : PS3_SM_REQ_FAN_GET;
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	if (hw->pending && hw->pending_kind == kind) {
+		memcpy(hw->fan_reply.buf, buf, header->payload_size);
+		hw->fan_reply.len = header->payload_size;
+		hw->fan_reply.sid = header->service_id;
+		hw->fan_reply.tag = header->request_tag;
+		hw->pending = false;
+		complete(&hw->done);
+		matched = true;
+	}
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+
+	if (!matched)
+		dev_info_ratelimited(&dev->core,
+			"fan: reply no request waits for (late?): service id %u, payload %u, tag %u: %*ph\n",
+			header->service_id, header->payload_size,
+			header->request_tag, (int)header->payload_size, buf);
+
+	return 0;
+}
