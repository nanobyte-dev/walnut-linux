+static int ps3_sm_fan_write(struct ps3_sm_hwmon *hw, u32 attr, long val)
+{
+	u8 duty;
+	int result;
+
+	/* With fan_dead, ps3_sm_fan_set() refuses all but automatic. */
+	switch (attr) {
+	case hwmon_pwm_enable:
+		switch (val) {
+		case 0:
+			return ps3_sm_fan_apply(hw, PS3_SM_FAN_FULL, 0);
+		case 1:
+			return ps3_sm_fan_apply(hw, PS3_SM_FAN_MANUAL,
+				hw->fan_duty);
+		case 2:
+			return ps3_sm_fan_apply(hw, PS3_SM_FAN_AUTO, 0);
+		default:
+			return -EINVAL;
+		}
+	case hwmon_pwm_input:
+		if (val < 0 || val > 255)
+			return -EINVAL;
+		duty = ps3_sm_fan_clamp(hw, val);
+		if (READ_ONCE(hw->fan_policy) == PS3_SM_FAN_MANUAL) {
+			result = ps3_sm_fan_apply(hw, PS3_SM_FAN_MANUAL, duty);
+			if (result)
+				return result;
+		}
+		/* Otherwise kept for pwm1_enable=1. */
+		hw->fan_duty = duty;
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
