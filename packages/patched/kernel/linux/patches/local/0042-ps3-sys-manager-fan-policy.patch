+static const char *ps3_sm_fan_policy_name(int policy)
+{
+	switch (policy) {
+	case PS3_SM_FAN_FULL: return "full speed";
+	case PS3_SM_FAN_AUTO: return "SYSCON automatic";
+	case PS3_SM_FAN_MANUAL: return "manual";
+	default: return "unknown";
+	}
+}
+
+static void ps3_sm_fan_set_init(struct ps3_sm_fan_set_msg *msg, u8 policy,
+	u8 duty)
+{
+	BUILD_BUG_ON(sizeof(*msg) != 24);
+
+	memset(msg, 0, sizeof(*msg));
+	msg->header.version = 1;
+	msg->header.size = 16;
+	msg->header.payload_size = 8;
+	msg->header.service_id = PS3_SM_SERVICE_ID_FAN_POLICY_SET;
+	msg->header.request_tag = 0;
+	msg->version = 1;
+	msg->id = 0;
+	msg->policy = policy;
+	msg->duty = duty;
+}
+
+static u8 ps3_sm_fan_clamp(struct ps3_sm_hwmon *hw, unsigned long duty)
+{
+	u8 d = clamp_val(duty, PS3_SM_FAN_DUTY_MIN, PS3_SM_FAN_DUTY_MAX);
+
+	if (d != duty)
+		dev_info(&hw->dev->core,
+			"fan: duty 0x%02lx raised/lowered to 0x%02x (safe range 0x%02x-0x%02x)\n",
+			duty, d, PS3_SM_FAN_DUTY_MIN, PS3_SM_FAN_DUTY_MAX);
+	return d;
+}
+
+/*
+ * One fan request, hw->lock held.  Returns 1 with the reply in @out, 0 when
+ * none came within @wait_ms, -EACCES for a REQUEST_ERROR, another negative
+ * errno when the write failed.
+ */
+
+static int ps3_sm_fan_request(struct ps3_sm_hwmon *hw, u8 kind,
+	const void *msg, unsigned int len, unsigned int wait_ms,
+	struct ps3_sm_raw_reply *out)
+{
+	unsigned long flags;
+	bool got, error;
+	int result;
+
+	lockdep_assert_held(&hw->lock);
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	hw->pending = true;
+	hw->reply_error = false;
+	hw->pending_kind = kind;
+	reinit_completion(&hw->done);
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+
+	/* One write, so header and payload stay together in the tx queue. */
+	result = ps3_vuart_write(hw->dev, msg, len);
+
+	if (!result)
+		wait_for_completion_timeout(&hw->done,
+			msecs_to_jiffies(wait_ms));
+
+	spin_lock_irqsave(&hw->reply_lock, flags);
+	got = !hw->pending;
+	error = hw->reply_error;
+	hw->pending = false;
+	if (got && !error)
+		*out = hw->fan_reply;
+	spin_unlock_irqrestore(&hw->reply_lock, flags);
+
+	if (got && error)
+		return -EACCES;
+	if (got)
+		return 1;
+	return result;
+}
+
+/*
+ * Set a policy, hw->lock held.  SYSCON automatic may always be sent until
+ * the device shuts down; full speed and manual not once an exit has begun.
+ * fan_dirty goes up before anything but automatic is sent and down only
+ * after automatic was sent, so the lockless exit paths know when they have
+ * to hand the fan back.
+ */
+
+static int ps3_sm_fan_set(struct ps3_sm_hwmon *hw, u8 policy, u8 duty)
+{
+	struct ps3_sm_fan_set_msg msg;
+	struct ps3_sm_raw_reply r;
+	int result;
+
+	lockdep_assert_held(&hw->lock);
+
+	/* Never a duty outside the safe range on the wire. */
+	if (policy > PS3_SM_FAN_MANUAL || (policy == PS3_SM_FAN_MANUAL &&
+		(duty < PS3_SM_FAN_DUTY_MIN || duty > PS3_SM_FAN_DUTY_MAX)))
+		return -EINVAL;
+	if (READ_ONCE(hw->fan_dead) && policy != PS3_SM_FAN_AUTO)
+		return -EIO;
+	if (policy == PS3_SM_FAN_MANUAL && READ_ONCE(hw->fan_alerts))
+		return -EBUSY;
+	if (READ_ONCE(hw->stopped))
+		return -ESHUTDOWN;
+	if (policy != PS3_SM_FAN_MANUAL)
+		duty = 0;
+	if (policy != PS3_SM_FAN_AUTO) {
+		WRITE_ONCE(hw->fan_dirty, true);
+		smp_mb();
+		if (READ_ONCE(hw->fan_final))
+			return -ESHUTDOWN;
+	}
+
+	ps3_sm_fan_set_init(&msg, policy, duty);
+	result = ps3_sm_fan_request(hw, PS3_SM_REQ_FAN_SET, &msg, sizeof(msg),
+		PS3_SM_FAN_SET_WAIT_MS, &r);
+
+	if (result == -EACCES) {
+		dev_warn(&hw->dev->core,
+			"fan: setting %s refused (REQUEST_ERROR): only SYSCON automatic from now on\n",
+			ps3_sm_fan_policy_name(policy));
+		WRITE_ONCE(hw->fan_dead, true);
+		/* Automatic refused too: sending it again on exit won't help. */
+		if (policy == PS3_SM_FAN_AUTO)
+			WRITE_ONCE(hw->fan_dirty, false);
+		return result;
+	}
+
+	if (result < 0) {
+		dev_warn(&hw->dev->core, "fan: %s not sent: %d\n",
+			ps3_sm_fan_policy_name(policy), result);
+		return -EIO;
+	}
+
+	if (result == 1 && !hw->fan_set_logged) {
+		hw->fan_set_logged = true;
+		dev_info(&hw->dev->core,
+			"fan: set reply: service id %u, payload %u, tag %u: %*ph\n",
+			r.sid, r.len, r.tag, r.len, r.buf);
+	} else if (result == 0 && !hw->fan_noreply_logged) {
+		hw->fan_noreply_logged = true;
+		dev_info(&hw->dev->core,
+			"fan: no reply to the set within %u ms (none is documented)\n",
+			PS3_SM_FAN_SET_WAIT_MS);
+	}
+
+	if (policy != READ_ONCE(hw->fan_policy) ||
+		(policy == PS3_SM_FAN_MANUAL && duty != hw->fan_duty)) {
+		if (policy == PS3_SM_FAN_MANUAL)
+			dev_info(&hw->dev->core,
+				"fan: manual, duty 0x%02x (%u%%)\n", duty,
+				duty * 100 / 255);
+		else
+			dev_info(&hw->dev->core, "fan: %s\n",
+				ps3_sm_fan_policy_name(policy));
+	}
+
+	if (policy == PS3_SM_FAN_MANUAL)
+		hw->fan_duty = duty;
+	WRITE_ONCE(hw->fan_policy, policy);
+	hw->fan_live_valid = false;
+	if (policy == PS3_SM_FAN_AUTO)
+		WRITE_ONCE(hw->fan_dirty, false);
+
+	return 0;
+}
+
+/*
+ * Read the policy, hw->lock held.  The payload size (> 0) with @f filled
+ * when the reply looks like the tentative layout (version 1, 6 bytes or
+ * more), -EPROTO when it doesn't (logged raw), another negative errno when
+ * there is none.
+ */
+
+static int ps3_sm_fan_get(struct ps3_sm_hwmon *hw, struct ps3_sm_fan_reply *f,
+	bool log)
+{
+	struct {
+		struct ps3_sys_manager_header header;
+		u8 version;
+		u8 id;
+		u8 reserved[2];
+	} msg;
+	struct ps3_sm_raw_reply r;
+	int result;
+
+	BUILD_BUG_ON(sizeof(msg) != 20);
+	lockdep_assert_held(&hw->lock);
+
+	if (READ_ONCE(hw->fan_dead) || hw->fan_get_dead)
+		return -ENODATA;
+	if (READ_ONCE(hw->stopped))
+		return -ESHUTDOWN;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.header.version = 1;
+	msg.header.size = 16;
+	msg.header.payload_size = 4;
+	msg.header.service_id = PS3_SM_SERVICE_ID_FAN_POLICY_GET;
+	msg.header.request_tag = 0;
+	msg.version = 1;
+	msg.id = 0;
+
+	result = ps3_sm_fan_request(hw, PS3_SM_REQ_FAN_GET, &msg, sizeof(msg),
+		PS3_SM_FAN_GET_TIMEOUT_MS, &r);
+
+	if (result == -EACCES) {
+		dev_warn(&hw->dev->core,
+			"fan: get refused (REQUEST_ERROR): policy reads off for this boot\n");
+		hw->fan_get_dead = true;
+		return -ENODATA;
+	}
+
+	if (result <= 0) {
+		result = result ? -EIO : -ETIMEDOUT;
+		if (++hw->fan_get_fails >= PS3_SM_TEMP_MAX_FAILS) {
+			dev_warn(&hw->dev->core,
+				"fan: %u gets unanswered (last %d): policy reads off for this boot\n",
+				hw->fan_get_fails, result);
+			hw->fan_get_dead = true;
+		} else if (log) {
+			dev_info(&hw->dev->core, "fan: get: no reply (%d)\n",
+				result);
+		}
+		return result;
+	}
+
+	hw->fan_get_fails = 0;
+
+	if (log)
+		dev_info(&hw->dev->core,
+			"fan: get reply: service id %u, payload %u, tag %u: %*ph\n",
+			r.sid, r.len, r.tag, r.len, r.buf);
+	else
+		dev_dbg(&hw->dev->core,
+			"fan: get reply: service id %u, payload %u: %*ph\n",
+			r.sid, r.len, r.len, r.buf);
+
+	if (r.len < sizeof(*f) || r.buf[0] != 1)
+		return -EPROTO;
+
+	memcpy(f, r.buf, sizeof(*f));
+	return r.len;
+}
+
+/*
+ * Set a policy and, once the get layout is confirmed, check it took; any
+ * failure with full speed or manual asked for hands the fan back to SYSCON.
+ */
+
+static int ps3_sm_fan_apply(struct ps3_sm_hwmon *hw, u8 policy, u8 duty)
+{
+	struct ps3_sm_fan_reply f;
+	int result;
+
+	result = ps3_sm_fan_set(hw, policy, duty);
+	if (result) {
+		/* Not sent at all (shutdown, range, alert): nothing to undo. */
+		if (policy != PS3_SM_FAN_AUTO && result != -ESHUTDOWN &&
+			result != -EINVAL && result != -EBUSY &&
+			READ_ONCE(hw->fan_dirty)) {
+			dev_warn(&hw->dev->core,
+				"fan: back to SYSCON automatic\n");
+			ps3_sm_fan_set(hw, PS3_SM_FAN_AUTO, 0);
+		}
+		return result;
+	}
+
+	if (!hw->fan_layout_ok || ps3_sm_fan_get(hw, &f, false) < 0)
+		return 0;
+
+	if (f.policy == policy)
+		return 0;
+
+	dev_warn(&hw->dev->core, "fan: policy reads %u after setting %u%s\n",
+		f.policy, policy, policy != PS3_SM_FAN_AUTO ?
+		": back to SYSCON automatic" : "");
+	if (policy != PS3_SM_FAN_AUTO)
+		ps3_sm_fan_set(hw, PS3_SM_FAN_AUTO, 0);
+	return -EIO;
+}
+
+/*
+ * At boot, from a work item (the replies come through the vuart work, so the
+ * probe doesn't wait for them): log the policy GameOS left, set SYSCON
+ * automatic (confirming the get layout with it), then full speed or the
+ * floor if asked for.
+ */
+
+static void ps3_sm_fan_boot_work(struct work_struct *work)
+{
+	struct ps3_sm_hwmon *hw = container_of(to_delayed_work(work),
+		struct ps3_sm_hwmon, fan_boot_work);
+	struct ps3_sm_fan_reply f;
+	int result;
+
+	mutex_lock(&hw->lock);
+
+	if (READ_ONCE(hw->fan_final))
+		goto out;
+
+	result = ps3_sm_fan_get(hw, &f, true);
+	if (result > 0)
+		dev_info(&hw->dev->core,
+			"fan: at boot (layout unconfirmed): status %u, policy %u (%s), speed 0x%02x, duty 0x%02x\n",
+			f.status, f.policy, ps3_sm_fan_policy_name(f.policy),
+			f.speed, f.duty);
+
+	if (hw->fan_boot == PS3_SM_FAN_BOOT_KEEP)
+		goto out;
+
+	if (ps3_sm_fan_set(hw, PS3_SM_FAN_AUTO, 0))
+		goto out;
+
+	if (ps3_sm_fan_get(hw, &f, true) >= 8 && f.id == 0 &&
+		f.policy == PS3_SM_FAN_AUTO) {
+		hw->fan_layout_ok = true;
+		dev_info(&hw->dev->core,
+			"fan: get layout confirmed (policy 1 after setting SYSCON automatic): speed 0x%02x\n",
+			f.speed);
+	} else {
+		dev_info(&hw->dev->core,
+			"fan: get layout not confirmed: policy reads are not used\n");
+	}
+
+	if (hw->fan_boot == PS3_SM_FAN_BOOT_FULL)
+		ps3_sm_fan_apply(hw, PS3_SM_FAN_FULL, 0);
+	else if (hw->fan_boot == PS3_SM_FAN_BOOT_FLOOR)
+		ps3_sm_fan_apply(hw, PS3_SM_FAN_MANUAL, hw->fan_duty);
+out:
+	mutex_unlock(&hw->lock);
+}
+
+/* A thermal alert with a fixed duty in force: SYSCON takes over again. */
+
+static void ps3_sm_fan_alert_work(struct work_struct *work)
+{
+	struct ps3_sm_hwmon *hw = container_of(work, struct ps3_sm_hwmon,
+		fan_alert_work);
+
+	mutex_lock(&hw->lock);
+	if (READ_ONCE(hw->fan_policy) == PS3_SM_FAN_MANUAL &&
+		!READ_ONCE(hw->fan_final)) {
+		/* Manual stays refused while a zone is in alert. */
+		dev_warn(&hw->dev->core,
+			"fan: thermal alert with a manual duty: back to SYSCON automatic\n");
+		ps3_sm_fan_set(hw, PS3_SM_FAN_AUTO, 0);
+	}
+	mutex_unlock(&hw->lock);
+}
+
+/*
+ * The lockless exit paths: a panic (notifier; on the PS3 ps3_panic(), a
+ * notifier at INT_MIN, never returns, so this is the only restore after a
+ * panic whatever panic_timeout says), the final power off and restart
+ * routines (after device shutdown normally, without it after an emergency
+ * restart).  All run after the other cpus were stopped; nothing may sleep.
+ * From here on only automatic is sent.  What can still fail: a write left
+ * queued in the tx list (tx interrupts masked) makes it give up with a
+ * "not sent" line.  A kdump kernel (crash_kexec before the notifiers) sets
+ * automatic itself when it probes.
+ */
+
+static void ps3_sm_fan_restore_atomic(const char *why)
+{
+	struct ps3_sm_hwmon *hw = READ_ONCE(ps3_sm_hwmon);
+	struct ps3_sm_fan_set_msg msg;
+	int result = -EBUSY;
+	unsigned int i;
+
+	if (!hw || !hw->fan_on)
+		return;
+
+	WRITE_ONCE(hw->fan_final, true);
+	smp_mb();
+
+	if (!READ_ONCE(hw->fan_dirty))
+		return;
+
+	ps3_sm_fan_set_init(&msg, PS3_SM_FAN_AUTO, 0);
+
+	for (i = 0; i < PS3_SM_FAN_ATOMIC_TRIES && result == -EBUSY; i++) {
+		result = ps3_vuart_write_atomic(hw->dev, &msg, sizeof(msg));
+		if (result == -EBUSY)
+			udelay(1000);
+	}
+
+	if (result) {
+		pr_emerg("PS3 fan: SYSCON automatic not sent (%s): %d\n", why,
+			result);
+		return;
+	}
+
+	WRITE_ONCE(hw->fan_dirty, false);
+	WRITE_ONCE(hw->fan_policy, PS3_SM_FAN_AUTO);
+	pr_emerg("PS3 fan: SYSCON automatic (%s)\n", why);
+}
+
+static int ps3_sm_fan_panic(struct notifier_block *nb, unsigned long event,
+	void *data)
+{
+	ps3_sm_fan_restore_atomic("panic");
+	return NOTIFY_DONE;
+}
