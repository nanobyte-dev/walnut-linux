+/**
+ * ps3_vuart_write_atomic - Write without sleeping or waiting for the tx lock.
+ * @dev: The struct ps3_system_bus_device instance.
+ * @buf: The bytes, one whole message.
+ * @bytes: How many.
+ *
+ * For the panic and final shutdown paths, where another cpu may have been
+ * stopped holding the tx lock and nothing may sleep: writes only when no
+ * earlier write is queued in the tx list.  When the HV takes only part, the
+ * rest is written in a bounded spin (a half message would desync the
+ * receiver).  Returns -EBUSY when the lock is held or a write is queued
+ * (the caller may try again), -EIO when the HV fails or doesn't take the
+ * rest within about 10 ms.
+ */
+
+int ps3_vuart_write_atomic(struct ps3_system_bus_device *dev, const void *buf,
+	unsigned int bytes)
+{
+	struct ps3_vuart_port_priv *priv = to_port_priv(dev);
+	unsigned long flags;
+	unsigned int tries = 0;
+	u64 bytes_written;
+	int result = 0;
+
+	if (!spin_trylock_irqsave(&priv->tx_list.lock, flags))
+		return -EBUSY;
+
+	if (!list_empty(&priv->tx_list.head)) {
+		spin_unlock_irqrestore(&priv->tx_list.lock, flags);
+		return -EBUSY;
+	}
+
+	while (bytes) {
+		bytes_written = 0;
+		result = ps3_vuart_raw_write(dev, buf, bytes, &bytes_written);
+		if (result || bytes_written > bytes)
+			break;
+		bytes -= bytes_written;
+		buf += bytes_written;
+		if (bytes && ++tries > 100) {
+			result = -EIO;
+			break;
+		}
+		if (bytes)
+			udelay(100);
+	}
+	spin_unlock_irqrestore(&priv->tx_list.lock, flags);
+
+	return (result || bytes) ? -EIO : 0;
+}
+EXPORT_SYMBOL_GPL(ps3_vuart_write_atomic);
