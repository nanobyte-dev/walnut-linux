+			if (!hw->fan_layout_ok || ps3_sm_fan_get(hw, &f, false))
+				return -ENODATA;
+			policy = f.policy;
+		}
+		switch (policy) {
+		case PS3_SM_FAN_FULL:
+			*val = 0;
+			return 0;
+		case PS3_SM_FAN_MANUAL:
+			*val = 1;
+			return 0;
+		case PS3_SM_FAN_AUTO:
+			*val = 2;
+			return 0;
+		default:
+			return -ENODATA;
+		}
+	case hwmon_pwm_input:
+		if (policy == PS3_SM_FAN_MANUAL) {
+			*val = hw->fan_duty;
+			return 0;
+		}
+		if (policy == PS3_SM_FAN_FULL) {
+			*val = 255;
+			return 0;
