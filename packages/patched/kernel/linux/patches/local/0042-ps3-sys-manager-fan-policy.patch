+			msecs_to_jiffies(PS3_SM_TEMP_CACHE_MS))) {
+			if (ps3_sm_fan_get(hw, &f, false))
+				return -ENODATA;
+			hw->fan_live = f.speed;
+			hw->fan_stamp = jiffies;
+			hw->fan_live_valid = true;
+		}
