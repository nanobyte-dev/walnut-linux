diff --git a/game_data_packager/progress_fd.py b/game_data_packager/progress_fd.py
new file mode 100644
--- /dev/null
+++ b/game_data_packager/progress_fd.py
@@ -0,0 +1,106 @@
+#!/usr/bin/python3
+# encoding=utf-8
+#
+# Copyright © 2026 Tiberiu Chibici <chibicitiberiu@gmail.com>
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+"""Machine-readable progress for a program that runs game-data-packager.
+
+With --progress-fd FD, one line per event is written to FD (UTF-8, each
+line flushed as it is written):
+
+  step <text>              what game-data-packager is doing now
+  file <name> <bytes>      a file being read: checked, identified or
+                           unpacked (the name may contain spaces, the
+                           size is the last word, -1 if unknown)
+  generated <path>         a package was built at <path>
+  error <kind> <text>      the run failed (exit status 1), one line,
+                           before it exits
+
+Error kinds:
+
+  not-found        none of the files a package needs were found
+  unknown-version  files were found but their checksums are not known
+  unsuitable       a file of a known release was found, but this release
+                   cannot be used; the text is "<file> <release>: <reason>"
+                   (the file is the known name without spaces, the reason
+                   is gdp's own, e.g. "Hexen 1.1 (registered) is required")
+  needs-download   a file is only available by download, and downloads
+                   are off (--no-download) or failed
+  no-space         a file system ran out of space
+  failed           anything else; the log on stderr says what
+
+Line breaks and other control characters in the text become spaces.
+The normal output on stdout and stderr is unchanged.  If the reader goes
+away, writing stops and the run carries on.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from typing import (TextIO)
+
+ERROR_KINDS = (
+    'not-found', 'unknown-version', 'unsuitable', 'needs-download', 'no-space', 'failed',
+)
+
+_CONTROL = {c: ' ' for c in range(32)}
+_CONTROL[127] = ' '
+
+
+class ProgressWriter:
+    def __init__(self) -> None:
+        self._file: TextIO | None = None
+        self.error_written = False
+
+    def open(self, fd: int) -> None:
+        """Write to the file descriptor fd (raises OSError if it is not
+        open for writing)."""
+        os.fstat(fd)
+        self._file = os.fdopen(
+            fd, 'w', encoding='utf-8', errors='replace',
+            buffering=1, closefd=False,
+        )
+
+    @property
+    def enabled(self) -> bool:
+        return self._file is not None
+
+    def _line(self, *words: object) -> None:
+        if self._file is None:
+            return
+        text = ' '.join(str(w) for w in words).translate(_CONTROL)
+        try:
+            # keep the order of our own output if FD is stdout or stderr
+            sys.stdout.flush()
+            sys.stderr.flush()
+            self._file.write(text + '\n')
+            self._file.flush()
+        except (OSError, ValueError):
+            # the reader went away: stop writing, keep running
+            f, self._file = self._file, None
+            try:
+                f.close()   # closefd=False: only our buffer goes
+            except (OSError, ValueError):
+                pass
+
+    def step(self, text: str) -> None:
+        self._line('step', text)
+
+    def file(self, name: str, size: int | None) -> None:
+        self._line('file', name, -1 if size is None else size)
+
+    def generated(self, path: str) -> None:
+        self._line('generated', path)
+
+    def error(self, kind: str, text: str) -> None:
+        assert kind in ERROR_KINDS, kind
+        if self.error_written:
+            return
+        self._line('error', kind, text)
+        self.error_written = True
+
+
+# The one writer, set up by command_line.py from --progress-fd.
+progress = ProgressWriter()
