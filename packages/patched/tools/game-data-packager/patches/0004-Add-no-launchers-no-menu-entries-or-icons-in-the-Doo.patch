From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiberiu Chibici <chibicitiberiu@gmail.com>
Date: Sat, 31 Oct 2026 19:12:07 +0200
Subject: Add --no-launchers: no menu entries or icons in the data packages

Some data packages bring their own launcher: the Doom family's
(doom-wad, doom2-wad, plutonia-wad, tnt-wad, heretic-wad, hexen-wad, ...)
write /usr/share/applications/<package>.desktop, a pixmap and hicolor
icons, each entry starting the engine their engine field names with
-iwad; a ScummVM game's package (dayofthetentacle-*-data, loom-*-data,
...) gets a .desktop link into game-data-packager-runtime's ScummVM
entries and a pixmap or hicolor icon (copied from gdp's data, a link to
the runtime's scummvm.svg, or with downloads on one fetched from
ScummVM's icon collection), and Recommends the runtime; and a package
made from a GOG.com setup_*.exe gets the installer's goggame-*.ico,
converted to /usr/share/pixmaps/gdp-PACKAGE.png when python3-pil is
installed, as an optional file of every package that isn't music or
documentation.

Walnut ships its own launcher per game (one engine, chosen settings, a
menu entry per game and edition), and a second entry per data package
would show up beside it; the runtime link would be broken without the
runtime, and the GOG icon is made on the fly, so nothing can know its
checksum beforehand (Walnut's import refused quake-rerelease from GOG's
Quake Enhanced installer over it). With --no-launchers the packages
carry the data files and the preinst only: no .desktop file, pixmap or
icon, no Recommends on the runtime, and the GOG icon is neither
extracted nor added. Without it nothing changes. Not covered: the few
other plugins that write a menu entry of their own (ecwolf_common,
z_code, dosbox, unreal).

Forwarded: no

diff --git a/data/bash-completion/game-data-packager b/data/bash-completion/game-data-packager
--- a/data/bash-completion/game-data-packager
+++ b/data/bash-completion/game-data-packager
@@ -20,7 +20,7 @@ _game_data_packager()
     if [ "${cur:0:1}" == "-" ]
     then
       local longopts
-      longopts='--compress --destination --help --install --no-compress --no-download --no-search --package --progress-fd --save-downloads --install-method --gain-root-command --target-format --target-distro'
+      longopts='--compress --destination --help --install --no-compress --no-download --no-launchers --no-search --package --progress-fd --save-downloads --install-method --gain-root-command --target-format --target-distro'
       COMPREPLY=( $( compgen -W "$longopts" -- $cur ) )
     elif [ "$prev" == '--install-method' ]
     then
diff --git a/doc/game-data-packager.6 b/doc/game-data-packager.6
--- a/doc/game-data-packager.6
+++ b/doc/game-data-packager.6
@@ -127,6 +127,13 @@ will not produce a package at all.
 \fB\-\-save\-downloads\fR \fIDIRECTORY\fR
 If files are downloaded, save them to \fIDIRECTORY\fR.
 .TP
+.B \-\-no\-launchers
+Do not put menu entries (.desktop files) or their icons into the packages.
+The Doom family (Doom, Heretic, Hexen and related games) and the ScummVM
+games write them, and any game made from a GOG.com setup_*.exe gets the
+installer's icon as /usr/share/pixmaps/gdp-PACKAGE.png; use this when another
+package provides the launchers.
+.TP
 \fB\-\-progress\-fd\fR \fIFD\fR
 Write machine-readable progress to file descriptor \fIFD\fR, one line per
 event:
diff --git a/game_data_packager/build.py b/game_data_packager/build.py
--- a/game_data_packager/build.py
+++ b/game_data_packager/build.py
@@ -233,6 +233,9 @@ class PackagingTask:
         # If true, be more verbose
         self.verbose: bool = False
 
+        # If false (--no-launchers), packages get no menu entries or icons
+        self.launchers: bool = True
+
         # None or an existing directory in which to save downloaded files.
         self.save_downloads: str | None = None
 
@@ -1436,7 +1439,9 @@ class PackagingTask:
                     extra_icon = None
                     basename = os.path.basename(found_name)
                     extension = os.path.splitext(basename)[1]
-                    if basename.startswith('setup_') and extension == '.exe':
+                    # --no-launchers: no menu icon from GOG's .ico either
+                    if (self.launchers and basename.startswith('setup_')
+                            and extension == '.exe'):
                         with InnoSetup(
                             os.path.abspath(found_name),
                             verbose=self.verbose,
@@ -2288,7 +2293,8 @@ class PackagingTask:
                 hf = HashedFile.from_file(icon_name, opened)
                 opened.close()
         for package in packages:
-            if package.data_type not in ('music', 'documentation'):
+            if (self.launchers
+                    and package.data_type not in ('music', 'documentation')):
                 icon_name = self.get_extra_icon_name(package)
                 wf = self.game.files[icon_name]
                 assert package.optional_files is not None
@@ -2361,6 +2367,7 @@ class PackagingTask:
             )
 
         self.verbose = getattr(args, 'verbose', False)
+        self.launchers = getattr(args, 'launchers', True)
 
         if self.packaging.__class__ is self.builder_packaging.__class__:
             preserve = (getattr(args, 'destination', None) is not None)
diff --git a/game_data_packager/command_line.py b/game_data_packager/command_line.py
--- a/game_data_packager/command_line.py
+++ b/game_data_packager/command_line.py
@@ -269,6 +269,14 @@ def run_command_line() -> None:
         ),
     )
 
+    game_parser.add_argument(
+        '--no-launchers', action='store_false', dest='launchers',
+        help=(
+            'do not put menu entries (.desktop files) or their icons in '
+            'the packages (the Doom family and the ScummVM games write them)'
+        ),
+    )
+
     group = game_parser.add_mutually_exclusive_group()
     group.add_argument(
         '--search', action='store_true',
@@ -401,6 +409,7 @@ def run_command_line() -> None:
             install=False,
             install_method='',
             gain_root_command='',
+            launchers=True,
             packages=[],
             progress_fd=None,
             save_downloads=None,
diff --git a/game_data_packager/games/doom_common.py b/game_data_packager/games/doom_common.py
--- a/game_data_packager/games/doom_common.py
+++ b/game_data_packager/games/doom_common.py
@@ -211,7 +211,11 @@ class DoomTask(PackagingTask):
         destdir = per_package_state.destdir
         assert isinstance(package, DoomPackage)
 
-        for main_wad, quirks in package.main_wads.items():
+        # --no-launchers: no .desktop file, pixmap or hicolor icon (the
+        # preinst below is not a launcher and stays)
+        for main_wad, quirks in (
+            package.main_wads.items() if self.launchers else ()
+        ):
             engine = self.packaging.substitute(
                 package.engine or self.game.engine, package.name,
             )
diff --git a/game_data_packager/games/scummvm_common.py b/game_data_packager/games/scummvm_common.py
--- a/game_data_packager/games/scummvm_common.py
+++ b/game_data_packager/games/scummvm_common.py
@@ -199,6 +199,12 @@ class ScummvmTask(PackagingTask):
 
         assert package.name.endswith('-data'), package.name
 
+        # --no-launchers: no menu entry (the .desktop link into
+        # game-data-packager-runtime), pixmap or icon, and no Recommends on
+        # the runtime that only those need
+        if not self.launchers:
+            return
+
         package.relations['recommends'].append(
             PackageRelation(
                 'game-data-packager-runtime (>= %s~)' % GAME_PACKAGE_VERSION
