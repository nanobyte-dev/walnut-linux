   doom2.wad?1.666g:
     unsuitable: Doom 2 v1.9 is required
-  doom2.wad?1.666:
-    unsuitable: Doom 2 v1.9 is required
   doom2.wad?1.7:
     unsuitable: Doom 2 v1.9 is required
   doom2.wad?1.7a:
@@ -268,5 +268,7 @@ sha1sums: |
