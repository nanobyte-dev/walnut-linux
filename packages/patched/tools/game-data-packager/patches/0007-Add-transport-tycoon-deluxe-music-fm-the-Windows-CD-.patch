--- /dev/null
+++ b/game_data_packager/games/ttd.py
@@ -0,0 +1,140 @@
+#!/usr/bin/python3
+# encoding=utf-8
+#
+# Copyright © 2026 Tiberiu Chibici <chibicitiberiu@gmail.com>
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+"""Transport Tycoon Deluxe: the FM music's own OpenTTD music set.
+
+OpenTTD finds a base music set by its .obm file, which lists the songs
+and their MD5s. Its original_windows set (orig_win.obm, in openttd-data)
+names the General MIDI arrangements, gm/gm_tt*.gm. The Windows CD's
+other arrangements, fm/9_tt*.fm, are Standard MIDI files too, in the
+same order, but no set lists them: transport-tycoon-deluxe-music-fm
+installs them with orig_win_fm.obm next to them, made here from the
+files' checksums in ttd.yaml. The FM files need no [timingtrim]: the
+theme starts on its first beat and Can't Get There From Here ends with
+its last bar.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from typing import (TYPE_CHECKING)
+
+from ..build import (PackagingTask)
+from ..game import (GameData)
+from ..util import (mkdir_p)
+
+if TYPE_CHECKING:
+    from typing import (Unpack)
+    from ..data import (Package)
+    from ..packaging import (PerPackageState, PackagingTaskArgs)
+
+logger = logging.getLogger(__name__)
+
+FM_PACKAGE = 'transport-tycoon-deluxe-music-fm'
+FM_SET_FILE = 'orig_win_fm.obm'
+
+# OpenTTD's slots in orig_win.obm's order, and its song names
+SLOTS = [
+    ('theme', 0),
+    ('old_0', 2), ('old_1', 6), ('old_2', 3), ('old_3', 12), ('old_4', 8),
+    ('old_5', 13), ('old_6', 14), ('old_7', 10), ('old_8', None),
+    ('old_9', None),
+    ('new_0', 4), ('new_1', 1), ('new_2', 5), ('new_3', 15), ('new_4', 11),
+    ('new_5', 16), ('new_6', 9), ('new_7', None), ('new_8', None),
+    ('new_9', None),
+    ('ezy_0', 18), ('ezy_1', 19), ('ezy_2', 21), ('ezy_3', 17),
+    ('ezy_4', 20), ('ezy_5', 7), ('ezy_6', None), ('ezy_7', None),
+    ('ezy_8', None), ('ezy_9', None),
+]
+NAMES = [
+    'Tycoon DELUXE Theme', 'Snarl Up', 'Easy Driver', 'Little Red Diesel',
+    'City Groove', 'Aliens Ate My Railway', 'Stoke It', "Don't Walk!",
+    "Sawyer's Tune", 'Fell Apart On Me', "Can't Get There From Here",
+    "Hard Drivin'", 'Road Hog', 'Hold That Train!', "Broomer's Oil Rag",
+    'Goss Groove', 'Small Town', 'Cruise Control', 'Stroll On',
+    'Funk Central', 'Jammit', "Movin' On",
+]
+
+
+def fm_name(n: int) -> str:
+    return '9_tt%02d.fm' % n
+
+
+class TTDGameData(GameData):
+    def construct_task(
+        self,
+        **kwargs: Unpack[PackagingTaskArgs]
+    ) -> TTDTask:
+        return TTDTask(self, **kwargs)
+
+    def generated_files(self, package: Package) -> dict[str, bytes]:
+        """{path relative to the package's install_to: contents} of the
+        files this plugin writes into the package"""
+        if package.name != FM_PACKAGE:
+            return {}
+        self.load_file_data()
+        lines = [
+            '; Transport Tycoon Deluxe for Windows\' music in its FM',
+            '; synthesizer arrangements (fm/9_tt*.fm on the CD), as',
+            '; game-data-packager packages it.',
+            '[metadata]',
+            'name        = original_windows_fm',
+            'shortname   = TTFM',
+            'version     = 1',
+            'description = Original Transport Tycoon Deluxe Windows '
+            'edition music, FM synthesizer arrangements.',
+            '',
+            '[files]',
+        ]
+        for slot, n in SLOTS:
+            lines.append(slot + ' =' + ('' if n is None else ' ' + fm_name(n)))
+        lines += ['', '[md5s]']
+        for n in range(len(NAMES)):
+            md5 = self.files[fm_name(n)].md5
+            assert md5, fm_name(n)
+            lines.append('%s = %s' % (fm_name(n), md5))
+        lines += ['', '[names]']
+        for n, title in enumerate(NAMES):
+            lines.append('%s = %s' % (fm_name(n), title))
+        lines += [
+            '',
+            '[origin]',
+            'default = You can find it on your Transport Tycoon Deluxe '
+            'CD-ROM, in its fm directory.',
+            '',
+        ]
+        return {FM_SET_FILE: '\n'.join(lines).encode('utf-8')}
+
+
+class TTDTask(PackagingTask):
+    def fill_extra_files(
+        self,
+        per_package_state: PerPackageState
+    ) -> None:
+        super().fill_extra_files(per_package_state)
+        package = per_package_state.package
+        assert isinstance(self.game, TTDGameData)
+        generated = self.game.generated_files(package)
+        if not generated:
+            return
+
+        install_to = self.packaging.substitute(package.install_to,
+                                               package.name)
+        destdir = per_package_state.destdir
+        datadir = os.path.join(destdir, install_to.strip('/'))
+        assert datadir.startswith(destdir + '/'), (datadir, destdir)
+        mkdir_p(datadir)
+
+        for name, contents in sorted(generated.items()):
+            path = os.path.join(datadir, name)
+            logger.debug('writing %s', path)
+            with open(path, 'wb') as f:
+                f.write(contents)
+            os.chmod(path, 0o644)
+
+
+GAME_DATA_SUBCLASS = TTDGameData
