+  transport-tycoon-deluxe-music-fm:
+    longname: Transport Tycoon Deluxe (FM music)
+    expansion_for: transport-tycoon-deluxe-data
+    # The Windows version's music in its FM synthesizer arrangements
+    # (fm/9_tt*.fm, Standard MIDI files): some copies have only these,
+    # not gm/gm_tt*.gm. OpenTTD's own music set (orig_win.obm) lists the
+    # gm files by MD5, so this package brings its own set file,
+    # orig_win_fm.obm (games/ttd.py).
+    install_to: $assets/openttd/baseset/fm
+    install:
+    - fm musics
+
