[Desktop Entry]
Type=Application
Name=Walnut Games
Comment=Browse, install and play the games that run on Walnut
Exec=walnut-games %u
Icon=walnut-games
Terminal=false
Categories=Game;PackageManager;
# the website's "Open in Walnut Games" links (walnut://game/<id>) open here
MimeType=x-scheme-handler/walnut;
# the store itself is no game: ps3-game-menu leaves it out of game mode
X-Walnut-GameMode=false
