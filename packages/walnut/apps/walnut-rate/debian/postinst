#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# The sudoers drop-in must parse, or it would break sudo for everyone (no sudo, no check: the file is inert)
	if command -v visudo >/dev/null && ! visudo -cf /etc/sudoers.d/walnut-rate >/dev/null; then
		echo "walnut-rate: /etc/sudoers.d/walnut-rate does not parse: removed" >&2
		rm -f /etc/sudoers.d/walnut-rate
	fi
fi
#DEBHELPER#
exit 0
