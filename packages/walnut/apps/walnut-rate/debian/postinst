#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# The sudoers drop-in must parse, or it would break sudo for everyone. If it doesn't (a sudo that
	# disagrees with the build's visudo check), it is renamed, not deleted: sudo skips names with a dot, and
	# dpkg (it is a conffile) would not put a deleted one back.
	if [ -e /etc/sudoers.d/walnut-rate ] && ! visudo -cf /etc/sudoers.d/walnut-rate >/dev/null; then
		mv -f /etc/sudoers.d/walnut-rate /etc/sudoers.d/walnut-rate.disabled
		echo "walnut-rate: /etc/sudoers.d/walnut-rate does not parse: moved to walnut-rate.disabled (sudo ignores it). Put it back with mv once it parses, or: apt install --reinstall -o Dpkg::Options::=--force-confmiss walnut-rate" >&2
	fi
fi
#DEBHELPER#
exit 0
