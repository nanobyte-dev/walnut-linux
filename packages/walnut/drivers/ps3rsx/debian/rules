#!/usr/bin/make -f
# Built against the kernel's headers package (linux-headers-<release>, a build dependency)
KREL := $(shell cat debian/kernel-release)
KOBJ ?= /lib/modules/$(KREL)/build
P := debian/ps3rsx-modules-$(KREL)
KMAKE := $(MAKE) -C $(KOBJ)
# a test build whose version says "testclear" (never published) gets the VRAM clear's off switch
DEB_VERSION := $(shell dpkg-parsechangelog -S Version)
TEST_CLEAR := $(if $(findstring testclear,$(DEB_VERSION)),PS3RSX_TEST_CLEAR=y)

%:
	dh $@

override_dh_auto_build:
	mkdir -p b/ps3rsx b/probes
	cp src/* b/ps3rsx/
	cp probes/* b/probes/
	$(KMAKE) M=$(CURDIR)/b/ps3rsx $(if $(findstring -debug,$(KREL)),PS3RSX_TEST_WEDGE=y) $(TEST_CLEAR) modules
	$(KMAKE) M=$(CURDIR)/b/probes modules

override_dh_auto_install:
	install -D -m 644 b/ps3rsx/ps3rsx.ko $(P)/lib/modules/$(KREL)/updates/ps3rsx.ko
	install -d $(P)/lib/modules/$(KREL)/extra
	install -m 644 b/probes/*.ko $(P)/lib/modules/$(KREL)/extra/
	install -d $(P)/usr/lib/modules-load.d
	echo ps3rsx > $(P)/usr/lib/modules-load.d/ps3rsx-$(KREL).conf

override_dh_auto_clean:
	rm -rf b
