obj-m := ps3rsx.o
# the recovery's wedge generator (test_allow_rt_enable_12): only in the debug kernel's module
ccflags-$(PS3RSX_TEST_WEDGE) += -DPS3RSX_TEST_WEDGE
# the VRAM clear's off switch (test_clear_off), for performance attribution: test builds only
ccflags-$(PS3RSX_TEST_CLEAR) += -DPS3RSX_TEST_CLEAR
ps3rsx-y := drv.o abi16.o mem.o gart.o exec.o validate.o submit.o kms.o shadow.o console.o vswap.o kcopy.o unwedge.o vclear.o vkeep.o
# the push dump (pushdump.c, test_push_dump): a corpus of real streams for the address checks'
# host tests, test builds only. It records what clients send, so the address checks only count in
# it (PS3RSX_P4_NO_ENFORCE: no test_p4_enforce, nothing refused that the stable rules allow)
ccflags-$(PS3RSX_PUSH_DUMP) += -DPS3RSX_PUSH_DUMP -DPS3RSX_P4_COUNT -DPS3RSX_P4_NO_ENFORCE
# the address checks counting instead of refusing (test_p4_enforce): test builds only
ccflags-$(PS3RSX_P4_COUNT) += -DPS3RSX_P4_COUNT
ps3rsx-$(PS3RSX_PUSH_DUMP) += pushdump.o
# the SPE client (spe.c, spe_run.c, spu/vseal.c's image), on kernels with local/0058's interface
# (SPU_KERNEL_API_VERSION 1 in asm/spu.h; spe.c refuses any other version)
PS3RSX_SPU_KERNEL := $(if $(shell grep -qsE '^.define[[:space:]]+SPU_KERNEL_API_VERSION[[:space:]]+1$$' \
	$(srctree)/arch/powerpc/include/asm/spu.h $(objtree)/arch/powerpc/include/asm/spu.h && echo y),y)
ccflags-$(PS3RSX_SPU_KERNEL) += -DPS3RSX_HAVE_SPU_KERNEL
ps3rsx-$(PS3RSX_SPU_KERNEL) += spe.o spe_run.o
# the SPE client's debugfs hook (spe_test.h, test_vseal): test builds only
ccflags-$(PS3RSX_VSEAL_TEST) += -DPS3RSX_VSEAL_TEST
