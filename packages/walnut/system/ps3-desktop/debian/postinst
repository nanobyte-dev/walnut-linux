#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# The sudoers drop-in must parse, or it would break sudo for everyone. If it doesn't (a sudo that
	# disagrees with the build's visudo check), it is renamed, not deleted: sudo skips names with a dot, and
	# dpkg (it is a conffile) would not put a deleted one back.
	if [ -e /etc/sudoers.d/ps3-desktop ] && ! visudo -cf /etc/sudoers.d/ps3-desktop >/dev/null; then
		mv -f /etc/sudoers.d/ps3-desktop /etc/sudoers.d/ps3-desktop.disabled
		echo "ps3-desktop: /etc/sudoers.d/ps3-desktop does not parse: moved to ps3-desktop.disabled (sudo ignores it). Put it back with mv once it parses, or: apt install --reinstall -o Dpkg::Options::=--force-confmiss ps3-desktop" >&2
	fi
	# Only a user logged in on a physical console (a VT: the tty1 autologin's startx) may start X, and an SSH
	# login may not; the legacy wrapper runs it with root rights (KMS, input)
	echo "xserver-xorg-legacy xserver-xorg-legacy/xwrapper/allowed_users select console" | debconf-set-selections
	if [ -e /etc/X11/Xwrapper.config ]; then
		sed -i 's/^allowed_users[[:space:]]*=.*/allowed_users=console/' /etc/X11/Xwrapper.config
		grep -q '^allowed_users=' /etc/X11/Xwrapper.config || echo allowed_users=console >> /etc/X11/Xwrapper.config
		grep -q '^needs_root_rights=' /etc/X11/Xwrapper.config &&
			sed -i 's/^needs_root_rights=.*/needs_root_rights=yes/' /etc/X11/Xwrapper.config ||
			echo needs_root_rights=yes >> /etc/X11/Xwrapper.config
	else
		printf 'allowed_users=console\nneeds_root_rights=yes\n' > /etc/X11/Xwrapper.config
	fi
	# the optical drive's udev rule on the running system too (a disc already in gets its new flags)
	if [ -d /run/udev ] && command -v udevadm >/dev/null; then
		udevadm control --reload 2>/dev/null || true
		udevadm trigger --action=change --subsystem-match=block --sysname-match='sr[0-9]*' 2>/dev/null || true
	fi
	# ps3_game_prefetch.py's byte code, so ps3-game-prefetch imports it instead of compiling it
	# (its game watcher would cost ~5 MB more); again with every python3 (runtime.d hook)
	if command -v py3compile >/dev/null 2>&1; then
		py3compile -p ps3-desktop /usr/lib/ps3/desktop
	else
		python3 -m compileall -q /usr/lib/ps3/desktop >/dev/null 2>&1 || true
	fi
	# the games' own menu entries this package diverted before 0.893 are ps3-games-integration's: its
	# preinst takes each one over; one still held here means it isn't installed (yet), so the entry is
	# given back (the game's own menu entry returns) until it comes and diverts it again
	held=$(dpkg-divert --list | sed -n 's/^diversion of \(.*\) to .* by ps3-desktop$/\1/p')
	for f in $held; do
		case $f in /usr/share/gvfs/remote-volume-monitors/*) continue ;; esac
		dpkg-divert --quiet --package ps3-desktop --rename --remove "$f" ||
			echo "ps3-desktop: could not give back the diversion of $f" >&2
	done
	rmdir /usr/share/ps3-desktop/diverted-menu /usr/share/ps3-desktop 2>/dev/null || true
	# RAM: blueman's privileged helper only on demand (first install only)
	if [ -z "$2" ]; then
		deb-systemd-helper disable blueman-mechanism.service >/dev/null 2>&1 || true
	fi
fi
#DEBHELPER#
exit 0
