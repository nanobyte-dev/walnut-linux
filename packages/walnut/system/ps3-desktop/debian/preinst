#!/bin/sh
# Diversions: gvfs's iPhone and online-accounts volume monitors (moved aside, ~1.3 MB each per session for nothing on a PS3).
# The games' own menu entries this
# package diverted before 0.893 are ps3-games-integration's now (its preinst takes them over; postinst
# gives back any it hasn't taken yet).
set -e
divert() {	# <file> <diverted name>: the file moves to the diverted name (a package installing it later lands there)
	f=$1 t=$2
	mkdir -p "$(dirname "$t")"
	if dpkg-divert --list "$f" | grep -q '^local diversion'; then
		dpkg-divert --quiet --local --rename --remove "$f"
	fi
	if [ "$(dpkg-divert --listpackage "$f")" = ps3-desktop ]; then
		# ours already, maybe to an older place (0.307: next to the file): moved by hand, since
		# --rename would refuse while the old package's own file is at <file>
		cur=$(dpkg-divert --truename "$f")
		[ "$cur" != "$t" ] || return 0
		dpkg-divert --quiet --package ps3-desktop --no-rename --remove "$f"
		[ ! -e "$cur" ] || mv "$cur" "$t"
		dpkg-divert --quiet --package ps3-desktop --no-rename --divert "$t" --add "$f"
	else
		dpkg-divert --quiet --package ps3-desktop --rename --divert "$t" --add "$f"
	fi
}
case "$1" in
install|upgrade)
	for m in afc goa; do
		divert /usr/share/gvfs/remote-volume-monitors/$m.monitor /usr/share/gvfs/remote-volume-monitors/$m.monitor.disabled
	done
	;;
esac
#DEBHELPER#
exit 0
