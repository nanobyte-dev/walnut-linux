#!/usr/bin/python3 -I
# ps3-game-prefetch (ps3-desktop): the desktop's files back when game mode ends (record, fetch) and
# a game's own files at its start (game-*); see ps3_game_prefetch.py beside it, which this imports
# so that its byte code comes from the cache (made at installation) instead of being compiled at
# every start: the game watcher lives while a game loads, and compiling costs it about 5 MB.
import os
import sys

sys.dont_write_bytecode = True   # nothing written beside the program (a user can't, root shouldn't)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ps3_game_prefetch  # noqa: E402

sys.exit(ps3_game_prefetch.main(sys.argv))
