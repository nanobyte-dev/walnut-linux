#!/bin/sh
# ps3-game <command...>: runs a game in game mode (ps3-desktop). The game runs in ps3-game.slice
# (memory.low: kept resident, like X in ps3-display.slice). While any game started this way runs,
# game mode is on: ps3-game-guard, a user service, gets the rest of the desktop out of the way
# before the game starts and brings it all back after the last game exits, however it exits
# (crash, kill, a killed launcher; see ps3-game-guard).
# PS3_GAME_MODE=pads: only the gamepads leave the pointer, nothing frozen or reclaimed (a
# baseline to measure against); off: not even that.
G=/usr/lib/ps3/desktop/ps3-game-guard
[ $# -gt 0 ] || { echo "usage: ps3-game <command...>" >&2; exit 2; }
# Started from the menu or the desktop, this script runs in ps3-desktop.slice, which game mode
# freezes: it moves into a scope of ps3-game.slice first. Without a user manager: the game alone.
if [ -z "${PS3_GAME_SCOPED:-}" ]; then
	export PS3_GAME_SCOPED=1
	if ! systemctl --user show-environment >/dev/null 2>&1; then
		echo "ps3-game: no user service manager: $1 runs without game mode" >&2
		exec "$@"
	fi
	exec systemd-run --user --scope --slice=ps3-game.slice --unit="ps3-game-$$" -q "$0" "$@"
fi
mode=${PS3_GAME_MODE:-on}
S=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ps3-game
me=$S/games/$$
mkdir -p "$S/games"
lock() { exec 9> "$S/lock"; flock 9; }
unlock() { flock -u 9; exec 9>&-; }
live() {	# the guard's service exists (its state files count only then)
	case $(systemctl --user show -P ActiveState ps3-game-mode.service 2>/dev/null) in
	active|activating|deactivating|reloading) return 0 ;;
	esac
	return 1
}
stale() {	# game mode's state left with no guard (one killed with its whole cgroup, whose
	# ExecStopPost was killed too): undone here, by the next game or the end of a running one
	if ! live && { [ -e "$S/frozen" ] || [ -e "$S/root" ] || [ -e "$S/pads" ]; }; then
		echo "ps3-game: game mode left behind by a guard that died: undoing it" >&2
		"$G" leave
	fi
}
start_guard() {
	env=
	for v in DISPLAY XAUTHORITY XDG_CONFIG_DIRS XDG_DATA_DIRS GDK_GL PS3_GAME_MODE; do
		eval "x=\${$v-}"; [ -n "$x" ] && env="$env --setenv=$v=$x"
	done
	# shellcheck disable=SC2086 # the values have no spaces
	systemd-run --user --unit=ps3-game-mode --slice=ps3-game.slice --collect -q \
		-p TimeoutStopSec=90 -p "ExecStopPost=$G leave" $env "$G" run
}
# join: registers this game; starts the guard if none runs; returns once game mode is on
join() {
	i=0
	while [ $i -lt 150 ]; do	# 30 s
		lock
		[ -e "$me" ] || echo $$ > "$me"
		if live; then
			[ -e "$S/entered" ] && { unlock; return 0; }
			# entering (wait for it) or leaving (wait until it is gone, then start anew)
		else
			stale
			rm -f "$S/entered" "$S/entering" "$S/leaving"	# stale: no guard
			: > "$S/entering"
			if ! start_guard && ! live; then
				rm -f "$S/entering"; unlock
				echo "ps3-game: game mode didn't start; the game starts without it" >&2
				return 1
			fi
		fi
		unlock
		sleep 0.2; i=$((i + 1))
	done
	echo "ps3-game: game mode not on after 30 s; the game starts anyway" >&2
	return 1
}
[ "$mode" = off ] || join
# A terminal of the frozen desktop stops reading, and a game writing to it would block: its
# output goes to a file then (not over SSH: sshd isn't frozen)
if [ "$mode" = on ] && [ -z "${SSH_TTY:-}" ] && { [ -t 1 ] || [ -t 2 ]; }; then
	out=${XDG_CACHE_HOME:-$HOME/.cache}/ps3-game
	mkdir -p "$out"; out=$out/${1##*/}.log
	echo "ps3-game: the terminal is frozen in game mode; the game's output goes to $out" >&2
	exec > "$out" 2>&1
fi
systemd-run --user --scope --slice=ps3-game.slice -q "$@" &
game=$!
[ "$mode" = off ] || { lock; echo $game >> "$me"; unlock; }
trap 'kill $game 2>/dev/null' INT TERM HUP
wait $game
ret=$?
while kill -0 $game 2>/dev/null; do wait $game; ret=$?; done	# a trapped signal ended the wait early
[ "$mode" = off ] || { lock; rm -f "$me"; stale; unlock; }	# the guard leaves within a second if it was the last
exit $ret
