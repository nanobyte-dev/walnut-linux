#!/bin/sh
# ps3-game-guard run|leave|join|add|quit (ps3-desktop): game mode's user side. Games come to game
# mode two ways: started through ps3-game (the menu's launchers), or noticed by ps3-game-detect
# (any fullscreen 3D program). Both register the game here with `join`; the first one starts
# `run` as the transient user service ps3-game-mode.service (in ps3-game.slice, so never frozen
# itself), with `leave` as its ExecStopPost.
#   join ID MODE [PID[:START]]...  registers game ID ($S/games/ID: one pid per line, with its
#          start time for a detected game) and returns once game mode is on (MODE: on or pads,
#          used when this join starts it), at most 30 s later. Exit status 1: game mode didn't come.
#   add ID PID   one more pid for game ID (ps3-game: the game's own, once it runs)
#   quit ID      unregisters game ID; undoes game mode left behind by a guard that died
#   run    enters game mode, then waits until no registered game is alive. A pid line counts
#          while that process runs in ps3-game.slice (ps3-game's launcher and game), or, with a
#          start time, while that very process runs anywhere and isn't a zombie (a detected game:
#          one started from outside the user manager can't be moved into ps3-game.slice). Two
#          games: game mode lasts until the last one is gone.
#   leave  brings everything back. systemd runs it however the service ends: the last game gone,
#          the guard killed, the user manager stopping. ps3-game-mode (root) has a watcher of
#          its own that thaws the system services even if this never runs.
# Entering, in order (a game in ps3-desktop.slice has been moved out of it before its join):
#   1. the gamepads off the X pointer (xinput), so the sticks don't move the cursor in the game
#   2. the PCManFM desktop off (pcmanfm --desktop-off): its window and wallpaper go, and with no
#      file manager window open the whole process exits. The root window gets a plain colour,
#      else X keeps the wallpaper (pcmanfm sets it as the root background too): 8 MB of picture
#      in VRAM or GART. leave starts pcmanfm --desktop again (icons and wallpaper come from its
#      configuration; nothing is saved or changed)
#   3. ps3-desktop.slice frozen (cgroup.freeze, like SIGSTOP: the panel, tray applets,
#      notifications, polkit agent, gvfs, file manager windows and terminals keep their state)
#      and its memory pushed out: anonymous pages to swap first, then its file pages
#   4. the user manager's own services (the user bus; app.slice, session.slice) keep running,
#      their anonymous memory pushed to swap; they fault back in what they use
#   5. root (sudo ps3-game-mode on): system services' share (see ps3-game-mode)
#   Before step 2, the desktop's files and which of their pages are in memory are recorded
#   (ps3-game-prefetch), and leave reads those back in one pass in disk order while the desktop
#   thaws: otherwise the thawed programs fault them in one by one from the hard disk.
# From the join that starts the guard (the game's environment):
#   PS3_GAME_MODE=pads: step 1 only, a baseline to measure against.
#   PS3_GAME_KICK=on|off|force: the 10 ms kicker for the lost-decrementer stalls (ps3-game-mode);
#   default: /etc/default/ps3-game-mode, else on (not while the kernel has the idle fix).
#   PS3_GAME_PREFETCH=on (default): record, reclaim all, fetch back on leave; off: no record, no
#   fetch (game mode as it was before the prefetch); keep: the desktop keeps its file pages (only its anonymous memory
#   goes to swap; the recorded size says what that costs), fetch what got evicted anyway.
# The games' own files (docs/STALLS.md "Game prefetch"; not with PS3_GAME_MODE=pads): once entered,
# `ps3-game-prefetch game-watch` claims each registered game ($S/gp/<id>.seen), has the files it
# used last time read in one pass in disk order at low I/O priority while it loads, and looks at
# it for its first minutes; it exits when no game is left to look at, and run starts another for a
# game registered later that none has claimed. leave, once the desktop is back, learns every
# record into its game's list (game-learn). Per game, from its environment:
# PS3_GAME_PREFETCH_GAME=on (default)|fetch|learn|off, PS3_GAME_PREFETCH_MB, _RESERVE_MB, _IO, _DIR
# (ps3_game_prefetch.py's header).
# State: $S (in the runtime directory: gone at logout); log: the user journal.
M=/usr/lib/ps3/sbin/ps3-game-mode
P=/usr/lib/ps3/desktop/ps3-game-prefetch
S=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ps3-game
log() { echo "ps3-game-guard: $*" >&2; }

slice_cg() {	# the cgroup directory of a user unit, if it has one
	p=$(systemctl --user show -P ControlGroup "$1" 2>/dev/null)
	[ -n "$p" ] && [ -d "/sys/fs/cgroup$p" ] && echo "/sys/fs/cgroup$p"
}

# reclaim CG: as much as it gives up. Anonymous pages first (swappiness=200: swap only): left to
# itself the kernel would rather drop file pages, the game's own code among them, and keep the
# frozen helpers' heaps. Then its file pages; pages others use stay (referenced pages survive).
reclaim() {
	cur=$(cat "$1/memory.current" 2>/dev/null) || return 0
	timeout 30 sh -c 'echo "$1 swappiness=200" > "$2/memory.reclaim"' - "$cur" "$1" 2>/dev/null
	cur=$(cat "$1/memory.current" 2>/dev/null) || return 0
	timeout 30 sh -c 'echo "$1" > "$2/memory.reclaim"' - "$cur" "$1" 2>/dev/null
	cur=$(cat "$1/memory.current" 2>/dev/null) && log "reclaimed ${1##*/}: $((cur / 1024)) kB left"
}

reclaim_anon() {	# anonymous memory only: running services, and the desktop with PS3_GAME_PREFETCH=keep
	anon=$(awk '$1 == "anon" { print $2 }' "$1/memory.stat" 2>/dev/null)
	[ -n "$anon" ] && timeout 30 sh -c 'echo "$1 swappiness=200" > "$2/memory.reclaim"' - "$anon" "$1" 2>/dev/null
	return 0
}

freeze() {	# freeze CG and wait (up to 5 s) until it is
	echo 1 > "$1/cgroup.freeze" 2>/dev/null || return 1
	i=0
	while [ $i -lt 50 ] && ! grep -q '^frozen 1' "$1/cgroup.events"; do sleep 0.1; i=$((i + 1)); done
}

# the desktop's PCManFM: the instance ps3-session started (exactly this command line; one
# started otherwise is left alone, both ways)
desktop() { pgrep -u "$(id -u)" -x -f '(/[^ ]*/)?pcmanfm --desktop' >/dev/null; }
desktop_off() {
	[ -n "${DISPLAY:-}" ] && desktop || return 0
	: > "$S/desktop"
	timeout 20 pcmanfm --desktop-off >/dev/null 2>&1
	i=0	# it exits within moments unless a file manager window keeps it
	while [ $i -lt 20 ] && desktop; do sleep 0.1; i=$((i + 1)); done
	xsetroot -solid '#14304d'
	xprop -root -remove _XROOTPMAP_ID 2>/dev/null; xprop -root -remove _XROOTMAP_ID 2>/dev/null
}
desktop_on() {
	[ -e "$S/desktop" ] || return 0
	rm -f "$S/desktop"
	# a scope in ps3-desktop.slice, as ps3-session starts it (apps opened from the desktop
	# outlive it). If the instance still runs (a file manager window), this one hands it the
	# --desktop and exits. Waited for until it has left this cgroup: systemd kills what an
	# ExecStopPost leaves behind.
	read -r me 2>/dev/null < /proc/self/cgroup
	GDK_GL=disable setsid systemd-run --user --scope --slice=ps3-desktop.slice -q \
		pcmanfm --desktop < /dev/null > /dev/null 2>&1 &
	p=$! i=0
	while [ $i -lt 100 ] && read -r c 2>/dev/null < "/proc/$p/cgroup" && [ "$c" = "$me" ]; do
		sleep 0.1; i=$((i + 1))
	done
	[ $i -lt 100 ] && log "leave: PCManFM desktop started" || log "pcmanfm --desktop didn't start"
}

procs() {	# the pids in the cgroups of the user units given
	for u in "$@"; do
		cg=$(slice_cg "$u") && find "$cg" -name cgroup.procs -exec cat {} + 2>/dev/null
	done
}
# record: the files the desktop has mapped and the pages of them in memory (ps3-game-prefetch),
# before game mode pushes them out; leave reads them back in one pass. The desktop and the
# display slices' programs, the user manager's (systemd's libraries: systemctl, systemd-run), the
# wallpaper (pcmanfm reads it again) and the programs leave runs.
record() {
	[ -x "$P" ] || return 0
	wp=
	for d in "${XDG_CONFIG_HOME:-$HOME/.config}" $(echo "${XDG_CONFIG_DIRS:-/etc/xdg}" | tr : ' '); do
		f=$d/pcmanfm/default/desktop-items-0.conf
		[ -r "$f" ] && wp=$(sed -n 's/^wallpaper=//p' "$f" | head -1) && break
	done
	set --
	[ -n "$wp" ] && set -- --file "$wp"
	for b in sudo systemctl systemd-run pcmanfm xinput xsetroot udevadm; do
		b=$(command -v $b) && set -- "$@" --file "$b"
	done
	# shellcheck disable=SC2046 # pids
	timeout 30 "$P" record "$S/prefetch" "$@" $(procs ps3-desktop.slice ps3-display.slice init.scope) ||
		rm -f "$S/prefetch"
}

pads() {	# X device ids of the gamepads (udev ID_INPUT_JOYSTICK) attached as pointers
	for d in /sys/class/input/event*; do
		udevadm info -q property "$d" 2>/dev/null | grep -q '^ID_INPUT_JOYSTICK=1' || continue
		name=$(cat "$d/device/name")
		xinput list 2>/dev/null | grep -F "$name" | grep 'slave  pointer' | sed 's/.*id=\([0-9]*\).*/\1/'
	done
}
pads_off() {
	[ -n "${DISPLAY:-}" ] || return 0
	pads > "$S/pads"
	for i in $(cat "$S/pads"); do xinput disable "$i"; done
}
pads_on() {
	[ -r "$S/pads" ] && for i in $(cat "$S/pads"); do xinput enable "$i" 2>/dev/null; done
	rm -f "$S/pads"
}

# proc PID: "<state> <start time>" of a process (fields 3 and 22 of its stat; the name before
# them may hold spaces and parentheses)
proc() {
	read -r st 2>/dev/null < "/proc/$1/stat" || return 1
	st=${st##*) }
	# shellcheck disable=SC2086 # the fields
	set -- $st
	echo "$1 ${20}"
}

alive() {	# alive FILE: one of its processes still runs (a reused pid wouldn't count)
	while read -r p t; do
		[ -n "$p" ] || continue
		if [ -n "$t" ]; then	# a detected game: that very process, not a zombie (its parent
			# may be frozen in ps3-desktop.slice, and reaps it only after leave)
			case $(proc "$p") in Z\ *|X\ *|'') ;; *" $t") return 0 ;; esac
			continue
		fi
		read -r c 2>/dev/null < "/proc/$p/cgroup" || continue
		case $c in *"/ps3-game.slice/"*) return 0 ;; esac
	done < "$1"
	return 1
}

enter() {
	log "entering game mode (${PS3_GAME_MODE:-on}, prefetch ${PS3_GAME_PREFETCH:-on})"
	pads_off
	[ "${PS3_GAME_MODE:-on}" = pads ] && return
	[ "${PS3_GAME_PREFETCH:-on}" = off ] || record
	desktop_off
	cg=$(slice_cg ps3-desktop.slice)
	if [ -n "$cg" ] && freeze "$cg"; then
		echo "$cg" > "$S/frozen"	# for leave: thawing needs no program then
		if [ "${PS3_GAME_PREFETCH:-on}" = keep ]; then
			reclaim_anon "$cg"
			cur=$(cat "$cg/memory.current" 2>/dev/null) && log "reclaimed ${cg##*/} (anonymous only): $((cur / 1024)) kB left"
		else
			reclaim "$cg"
		fi
	fi
	for u in app.slice session.slice; do
		cg=$(slice_cg $u) && reclaim_anon "$cg"
	done
	: > "$S/root"	# before the call: if the guard dies during it, leave still undoes it
	timeout 90 sudo -n $M on $$ ${PS3_GAME_KICK:-} || log "ps3-game-mode on failed"
}

# leave: what the user sees first. The desktop's files start coming back from the disk
# (ps3-game-prefetch fetch, beside the rest) and the desktop thaws (the cgroup from $S/frozen: no
# program to load from the disk first), then the gamepads and the PCManFM desktop, and the system
# side last. Each step is logged: the journal's times are the timeline.
leave() {
	log "leaving game mode (${SERVICE_RESULT:-}, ${EXIT_CODE:-} ${EXIT_STATUS:-})"
	pf=
	if [ -s "$S/prefetch" ] && [ "${PS3_GAME_PREFETCH:-on}" != off ]; then
		timeout 60 "$P" fetch "$S/prefetch" 9>&- & pf=$!
	fi
	cg=
	[ -e "$S/frozen" ] && read -r cg < "$S/frozen"
	[ -n "$cg" ] || cg=$(slice_cg ps3-desktop.slice)	# not entered this far
	if [ -n "$cg" ] && echo 0 > "$cg/cgroup.freeze" 2>/dev/null && [ -e "$S/frozen" ]; then
		log "leave: desktop thawed"
	fi
	rm -f "$S/frozen"
	pads_on
	desktop_on
	if [ -e "$S/root" ]; then
		timeout 60 sudo -n $M off && log "leave: system side done" || log "ps3-game-mode off failed"
	fi
	rm -f "$S/root"
	[ -n "$pf" ] && wait "$pf"
	rm -f "$S/prefetch" "$S/entered" "$S/entering" "$S/leaving"
	log "left game mode"
	# the games' records into their lists, with the desktop back (ps3-game-prefetch game-learn)
	set -- "$S"/gp/*.seen
	[ -e "$1" ] && [ -x "$P" ] && timeout 60 "$P" game-learn "$S" 9>&-
	return 0
}

# the games' prefetch (see the top): the watcher started once game mode is on (after
# ps3-game-mode's drop of the page cache), and again for a game no watcher has claimed; stopped
# (it saves its records) before leaving
W=
watch_start() {
	[ "${PS3_GAME_MODE:-on}" != pads ] && [ -x "$P" ] || return 0
	"$P" game-watch "$S" < /dev/null 9>&- & W=$!
}
watch_check() {	# a registered game without a record, and no watcher: one is started
	for f in "$S"/games/*; do
		case $f in *.new) continue ;; esac
		[ -e "$f" ] && [ ! -e "$S/gp/${f##*/}.seen" ] || continue
		if [ -n "$W" ]; then
			case $(proc "$W") in Z\ *|X\ *|'') wait "$W" 2>/dev/null; W= ;; *) return 0 ;; esac
		fi
		watch_start
		return 0
	done
}
watch_stop() {
	[ -n "$W" ] || return 0
	kill -TERM "$W" 2>/dev/null
	{ sleep 30; kill -KILL "$W"; } 2>/dev/null & k=$!
	wait "$W" 2>/dev/null
	kill "$k" 2>/dev/null
	W=
}

run() {
	mkdir -p "$S/games"
	echo $$ > "$S/guard"
	enter
	watch_start
	exec 9> "$S/lock"
	flock 9; rm -f "$S/entering"; : > "$S/entered"; flock -u 9
	while :; do
		sleep 1
		flock 9
		n=0
		for f in "$S"/games/*; do
			[ -e "$f" ] || continue
			if alive "$f"; then n=$((n + 1)); else rm -f "$f"; fi
		done
		if [ $n = 0 ]; then	# no game left: launchers arriving now wait for leave, then start anew
			rm -f "$S/entered"; : > "$S/leaving"
			flock -u 9
			watch_stop
			exit 0
		fi
		flock -u 9
		watch_check
	done
}

lock() { exec 9> "$S/lock"; flock 9; }
unlock() { flock -u 9; exec 9>&-; }
live() {	# the guard's service exists (its state files count only then)
	case $(systemctl --user show -P ActiveState ps3-game-mode.service 2>/dev/null) in
	active|activating|deactivating|reloading) return 0 ;;
	esac
	return 1
}
stale() {	# game mode's state left with no guard (one killed with its whole cgroup, whose
	# ExecStopPost was killed too): undone here, by the next join or quit
	if ! live && { [ -e "$S/frozen" ] || [ -e "$S/root" ] || [ -e "$S/pads" ] || [ -e "$S/desktop" ]; }; then
		log "game mode left behind by a guard that died: undoing it"
		"$0" leave 9>&-	# not the lock's descriptor: the pcmanfm it starts would hold the lock
	fi
}
start_guard() {	# MODE
	env="--setenv=PS3_GAME_MODE=$1"
	for v in DISPLAY XAUTHORITY XDG_CONFIG_DIRS XDG_DATA_DIRS GDK_GL PS3_GAME_PREFETCH PS3_GAME_KICK \
		PS3_GAME_PREFETCH_GAME PS3_GAME_PREFETCH_DIR PS3_GAME_PREFETCH_SAMPLE_S; do
		eval "x=\${$v-}"; [ -n "$x" ] && env="$env --setenv=$v=$x"
	done
	# shellcheck disable=SC2086 # the values have no spaces
	systemd-run --user --unit=ps3-game-mode --slice=ps3-game.slice --collect -q \
		-p TimeoutStopSec=90 -p "ExecStopPost=$0 leave" $env "$0" run
}

join() {	# ID MODE [PID[:START]]...
	me=$S/games/$1 mode=$2
	shift 2
	case $mode in pads) ;; *) mode=on ;; esac
	mkdir -p "$S/games"
	i=0
	while [ $i -lt 150 ]; do	# 30 s
		lock
		if [ ! -e "$me" ]; then
			for p in "$@"; do
				case $p in *:*) echo "${p%%:*} ${p#*:}" ;; *) echo "$p" ;; esac
			done > "$me.new"
			mv "$me.new" "$me"
		fi
		if live; then
			[ -e "$S/entered" ] && { unlock; return 0; }
			# entering (wait for it) or leaving (wait until it is gone, then start anew)
		else
			stale
			rm -f "$S/entered" "$S/entering" "$S/leaving"	# stale: no guard
			: > "$S/entering"
			if ! start_guard "$mode" && ! live; then
				rm -f "$S/entering"; unlock
				log "game mode didn't start"
				return 1
			fi
		fi
		unlock
		sleep 0.2; i=$((i + 1))
	done
	log "game mode not on after 30 s"
	return 1
}

case ${1:-} in
run) run ;;
leave) leave ;;
join)	[ $# -ge 3 ] || exit 2
	shift; join "$@" ;;
add)	[ $# = 3 ] || exit 2
	mkdir -p "$S/games"; lock; echo "$3" >> "$S/games/$2"; unlock ;;
quit)	[ $# = 2 ] || exit 2
	mkdir -p "$S/games"; lock; rm -f "$S/games/$2"; stale; unlock ;;
*) echo "usage: ps3-game-guard run|leave|join ID MODE [PID[:START]]...|add ID PID|quit ID" >&2; exit 2 ;;
esac
