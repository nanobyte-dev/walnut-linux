#!/bin/sh
# ps3-game-guard run|leave (ps3-desktop): game mode's user side. ps3-game starts `run` as the
# transient user service ps3-game-mode.service (in ps3-game.slice, so never frozen itself), with
# `leave` as its ExecStopPost.
#   run    enters game mode, then waits until no game started by ps3-game is alive. Each game is
#          registered in $S/games/<id>: its launcher's and its own pid, alive while either runs
#          in ps3-game.slice. Two games: game mode lasts until the last one exits.
#   leave  brings everything back. systemd runs it however the service ends: the last game gone,
#          the guard killed, the user manager stopping. ps3-game-mode (root) has a watcher of
#          its own that thaws the system services even if this never runs.
# Entering, in order; the game starts when it is done (at most 30 s later):
#   1. the gamepads off the X pointer (xinput), so the sticks don't move the cursor in the game
#   2. the PCManFM desktop off (pcmanfm --desktop-off): its window and wallpaper go, and with no
#      file manager window open the whole process exits. The root window gets a plain colour,
#      else X keeps the wallpaper (pcmanfm sets it as the root background too): 8 MB of picture
#      in VRAM or GART. leave starts pcmanfm --desktop again (icons and wallpaper come from its
#      configuration; nothing is saved or changed)
#   3. ps3-desktop.slice frozen (cgroup.freeze, like SIGSTOP: the panel, tray applets,
#      notifications, polkit agent, gvfs, file manager windows and terminals keep their state)
#      and its memory pushed out: anonymous pages to swap first, then its file pages
#   4. root (sudo ps3-game-mode on): system services' share (see ps3-game-mode)
# PS3_GAME_MODE=pads (from ps3-game): step 1 only, a baseline to measure against.
# State: $S (in the runtime directory: gone at logout); log: the user journal.
M=/usr/lib/ps3/sbin/ps3-game-mode
S=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ps3-game
log() { echo "ps3-game-guard: $*" >&2; }

slice_cg() {	# the cgroup directory of a user unit, if it has one
	p=$(systemctl --user show -P ControlGroup "$1" 2>/dev/null)
	[ -n "$p" ] && [ -d "/sys/fs/cgroup$p" ] && echo "/sys/fs/cgroup$p"
}

# reclaim CG: as much as it gives up. Anonymous pages first (swappiness=200: swap only): left to
# itself the kernel would rather drop file pages, the game's own code among them, and keep the
# frozen helpers' heaps. Then its file pages; pages others use stay (referenced pages survive).
reclaim() {
	cur=$(cat "$1/memory.current" 2>/dev/null) || return 0
	timeout 30 sh -c 'echo "$1 swappiness=200" > "$2/memory.reclaim"' - "$cur" "$1" 2>/dev/null
	cur=$(cat "$1/memory.current" 2>/dev/null) || return 0
	timeout 30 sh -c 'echo "$1" > "$2/memory.reclaim"' - "$cur" "$1" 2>/dev/null
	cur=$(cat "$1/memory.current" 2>/dev/null) && log "reclaimed ${1##*/}: $((cur / 1024)) kB left"
}

freeze() {	# freeze CG and wait (up to 5 s) until it is
	echo 1 > "$1/cgroup.freeze" 2>/dev/null || return 1
	i=0
	while [ $i -lt 50 ] && ! grep -q '^frozen 1' "$1/cgroup.events"; do sleep 0.1; i=$((i + 1)); done
}

# the desktop's PCManFM: the instance ps3-session started (exactly this command line; one
# started otherwise is left alone, both ways)
desktop() { pgrep -u "$(id -u)" -x -f '(/[^ ]*/)?pcmanfm --desktop' >/dev/null; }
desktop_off() {
	[ -n "${DISPLAY:-}" ] && desktop || return 0
	: > "$S/desktop"
	timeout 20 pcmanfm --desktop-off >/dev/null 2>&1
	i=0	# it exits within moments unless a file manager window keeps it
	while [ $i -lt 20 ] && desktop; do sleep 0.1; i=$((i + 1)); done
	xsetroot -solid '#14304d'
	xprop -root -remove _XROOTPMAP_ID 2>/dev/null; xprop -root -remove _XROOTMAP_ID 2>/dev/null
}
desktop_on() {
	[ -e "$S/desktop" ] || return 0
	rm -f "$S/desktop"
	# a scope in ps3-desktop.slice, as ps3-session starts it (apps opened from the desktop
	# outlive it). If the instance still runs (a file manager window), this one hands it the
	# --desktop and exits. Waited for until it has left this cgroup: systemd kills what an
	# ExecStopPost leaves behind.
	read -r me 2>/dev/null < /proc/self/cgroup
	GDK_GL=disable setsid systemd-run --user --scope --slice=ps3-desktop.slice -q \
		pcmanfm --desktop < /dev/null > /dev/null 2>&1 &
	p=$! i=0
	while [ $i -lt 100 ] && read -r c 2>/dev/null < "/proc/$p/cgroup" && [ "$c" = "$me" ]; do
		sleep 0.1; i=$((i + 1))
	done
	[ $i -lt 100 ] || log "pcmanfm --desktop didn't start"
}

pads() {	# X device ids of the gamepads (udev ID_INPUT_JOYSTICK) attached as pointers
	for d in /sys/class/input/event*; do
		udevadm info -q property "$d" 2>/dev/null | grep -q '^ID_INPUT_JOYSTICK=1' || continue
		name=$(cat "$d/device/name")
		xinput list 2>/dev/null | grep -F "$name" | grep 'slave  pointer' | sed 's/.*id=\([0-9]*\).*/\1/'
	done
}
pads_off() {
	[ -n "${DISPLAY:-}" ] || return 0
	pads > "$S/pads"
	for i in $(cat "$S/pads"); do xinput disable "$i"; done
}
pads_on() {
	[ -r "$S/pads" ] && for i in $(cat "$S/pads"); do xinput enable "$i" 2>/dev/null; done
	rm -f "$S/pads"
}

alive() {	# alive FILE: one of its pids still runs in ps3-game.slice (a reused pid wouldn't)
	while read -r p; do
		[ -n "$p" ] || continue
		read -r c 2>/dev/null < "/proc/$p/cgroup" || continue
		case $c in *"/ps3-game.slice/"*) return 0 ;; esac
	done < "$1"
	return 1
}

enter() {
	log "entering game mode (${PS3_GAME_MODE:-on})"
	pads_off
	[ "${PS3_GAME_MODE:-on}" = pads ] && return
	desktop_off
	cg=$(slice_cg ps3-desktop.slice)
	if [ -n "$cg" ] && freeze "$cg"; then
		: > "$S/frozen"
		reclaim "$cg"
	fi
	: > "$S/root"	# before the call: if the guard dies during it, leave still undoes it
	timeout 90 sudo -n $M on $$ || log "ps3-game-mode on failed"
}

leave() {
	log "leaving game mode (${SERVICE_RESULT:-}, ${EXIT_CODE:-} ${EXIT_STATUS:-})"
	cg=$(slice_cg ps3-desktop.slice)
	[ -n "$cg" ] && echo 0 > "$cg/cgroup.freeze"
	rm -f "$S/frozen"
	if [ -e "$S/root" ]; then timeout 60 sudo -n $M off || log "ps3-game-mode off failed"; fi
	rm -f "$S/root"
	pads_on
	desktop_on
	rm -f "$S/entered" "$S/entering" "$S/leaving"
}

run() {
	mkdir -p "$S/games"
	echo $$ > "$S/guard"
	enter
	exec 9> "$S/lock"
	flock 9; rm -f "$S/entering"; : > "$S/entered"; flock -u 9
	while :; do
		sleep 1
		flock 9
		n=0
		for f in "$S"/games/*; do
			[ -e "$f" ] || continue
			if alive "$f"; then n=$((n + 1)); else rm -f "$f"; fi
		done
		if [ $n = 0 ]; then	# no game left: launchers arriving now wait for leave, then start anew
			rm -f "$S/entered"; : > "$S/leaving"
			exit 0
		fi
		flock -u 9
	done
}

case ${1:-} in
run) run ;;
leave) leave ;;
*) echo "usage: ps3-game-guard run|leave (started by ps3-game)" >&2; exit 2 ;;
esac
