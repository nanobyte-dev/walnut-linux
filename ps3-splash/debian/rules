#!/usr/bin/make -f
T := debian/ps3-splash/usr/share/plymouth/themes/walnut

%:
	dh $@

# Everything is rendered from its SVG source at build time: the logo, the password-prompt images
# two-step requires, and the progress frames and desktop picture (art/make-frames.py) in frames/
override_dh_auto_build:
	mkdir -p frames
	rsvg-convert -w 360 -o frames/watermark.png art/walnut-logo-dark.svg
	for g in lock entry bullet; do rsvg-convert -o frames/$$g.png theme/glyphs/$$g.svg; done
	cp theme/glyphs/eq.svg theme/glyphs/dot.svg theme/glyphs/lbracket.svg \
		theme/glyphs/rbracket.svg art/walnut-mark.svg frames/
	python3 art/make-frames.py frames
	cd frames && for f in progress-*.svg desktop-splash.svg; do \
		rsvg-convert -o $${f%.svg}.png $$f || exit 1; done

override_dh_auto_install:
	install -d $(T)
	install -m 644 theme/walnut.plymouth frames/watermark.png frames/lock.png frames/entry.png \
		frames/bullet.png frames/progress-*.png $(T)/
	install -D -m 644 frames/desktop-splash.png debian/ps3-splash/usr/share/ps3-splash/desktop-splash.png
	install -D -m 644 debian/plymouth-quit-retain.conf \
		debian/ps3-splash/usr/lib/systemd/system/plymouth-quit.service.d/ps3-splash.conf

override_dh_auto_clean:
	rm -rf frames
