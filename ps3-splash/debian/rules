#!/usr/bin/make -f
T := debian/ps3-splash/usr/share/plymouth/themes/walnut

%:
	dh $@

# the logo is rendered from its SVG source at build time
override_dh_auto_build:
	rsvg-convert -w 360 -o walnut-logo.png art/walnut-logo-dark.svg

override_dh_auto_install:
	install -d $(T)
	install -m 644 theme/walnut.plymouth theme/walnut.script walnut-logo.png $(T)/

override_dh_auto_clean:
	rm -f walnut-logo.png
