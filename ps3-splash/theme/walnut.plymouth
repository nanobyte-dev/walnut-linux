[Plymouth Theme]
Name=Walnut Linux
Description=Walnut Linux: the logo with a rolling-walnut progress bar
ModuleName=two-step

# Prerendered images only (art/make-frames.py): the logo (watermark.png) and the bar with the
# walnut rolling along it (progress-NNNN.png, by boot progress). No text, so Plymouth needs no
# font renderer (its label plugin took 11 s to load from the USB disk) and no console viewer
# (its script plugin crashes without one). On 1080 lines the logo's top is 60 px above where
# a centred one would be, the bar 30 px under the logo: the alignments are the centres,
# 480/1080 and (300 + 360 + 30 + 34/2)/1080.
[two-step]
ImageDir=/usr/share/plymouth/themes/walnut
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.44444
HorizontalAlignment=.5
VerticalAlignment=.65463
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x14304d
BackgroundEndColor=0x14304d

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
