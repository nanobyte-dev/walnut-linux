# Walnut Linux boot splash (Plymouth script theme, ps3-splash).
# The logo on the desktop's blue and under it a progress bar made of small images (no text
# rendering: Plymouth's label plugin and its fonts took seconds to load from the USB disk):
# [=====@.......] with the walnut rolling (rotating) along at its head.

Window.SetBackgroundTopColor(0.078, 0.188, 0.302);      # #14304d, the desktop's blue
Window.SetBackgroundBottomColor(0.078, 0.188, 0.302);

logo.image = Image("walnut-logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 60;
logo.sprite.SetPosition(logo.x, logo.y, 1);

eq = Image("eq.png");
dot = Image("dot.png");
nut.image = Image("nut.png");
width = 32;                                              # cells between the brackets
cellw = eq.GetWidth();
cellh = eq.GetHeight();
x0 = Window.GetX() + Window.GetWidth() / 2 - (width + 2) * cellw / 2;
y0 = logo.y + logo.image.GetHeight() + 30;

lb = Sprite(Image("lbracket.png"));
lb.SetPosition(x0, y0, 2);
rb = Sprite(Image("rbracket.png"));
rb.SetPosition(x0 + (width + 1) * cellw, y0, 2);
i = 0;
while (i < width) {
	cell[i] = Sprite(dot);
	cell[i].SetPosition(x0 + (i + 1) * cellw, y0, 2);
	i++;
}
nut.sprite = Sprite(nut.image);

progress = 0;
shown = 0;                                               # cells already drawn as '='
angle = 0;

fun draw_bar() {
	filled = Math.Int(progress * width);
	if (filled > width - 1) filled = width - 1;
	while (shown < filled) {
		cell[shown].SetImage(eq);
		shown++;
	}
	rolled = nut.image.Rotate(angle);
	nut.sprite.SetImage(rolled);
	nut.sprite.SetPosition(x0 + (filled + 1) * cellw + cellw / 2 - rolled.GetWidth() / 2,
			       y0 + cellh / 2 - rolled.GetHeight() / 2, 3);
}

tick = 0;
fun refresh() {
	tick++;
	if (tick % 2 == 0) {
		angle += 0.13;                                   # about one turn every 2.4 s
		draw_bar();
	}
}
Plymouth.SetRefreshFunction(refresh);

fun boot_progress(duration, value) {
	if (value > progress) progress = value;
}
Plymouth.SetBootProgressFunction(boot_progress);

fun quit() {
	progress = 1;
	draw_bar();
}
Plymouth.SetQuitFunction(quit);
