[Unit]
Description=Show the shutdown's kernel and systemd messages on the console and netconsole
# Stopped (so ExecStop runs) when shutdown begins: from then on the console log level lets info
# messages through, systemd-shutdown's last steps included, which come after the journal has
# stopped. A shutdown that hangs then shows (and sends over netconsole) where it stopped.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/dmesg -n 7

[Install]
WantedBy=multi-user.target
