[Unit]
Description=Walnut First-Run Setup Wizard
ConditionPathExists=!/var/lib/walnut/firstboot-done
# getty waits for the wizard (Before=). No Conflicts= with getty: its stop job is queued even when the
# condition above skips the wizard, and then tty1 (the desktop's autologin) never starts.
Before=getty@tty1.service
After=plymouth-quit.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/ps3/sbin/walnut-firstboot
StandardInput=tty-force
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
