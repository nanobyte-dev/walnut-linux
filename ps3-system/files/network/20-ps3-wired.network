# The wired port on an NFS root only (ps3-system): otherwise NetworkManager has it (00-ps3.conf). DHCP;
# the kernel configured it already (ip=dhcp, the root over it): never drop the address, or the root
# filesystem disappears.
[Match]
Name=e*
KernelCommandLine=root=/dev/nfs

[Network]
DHCP=yes
KeepConfiguration=yes

[DHCPv4]
# Same client ID Petitboot's udhcpc sends (01:<MAC>). networkd's default (a DUID) made the
# router's DHCP server (Kea) see the .77 lease as another client's, so Petitboot kept getting
# a different address (ALLOC_ENGINE_V4_DISCOVER_ADDRESS_CONFLICT).
ClientIdentifier=mac
