#!/usr/bin/make -f
P := debian/sauerbraten

%:
	dh $@

override_dh_auto_install:
	install -D -m 755 files/sauerbraten $(P)/usr/games/sauerbraten
	install -D -m 644 files/sauerbraten.desktop $(P)/usr/share/applications/sauerbraten.desktop
	install -D -m 644 files/sauerbraten.svg $(P)/usr/share/icons/hicolor/scalable/apps/sauerbraten.svg
