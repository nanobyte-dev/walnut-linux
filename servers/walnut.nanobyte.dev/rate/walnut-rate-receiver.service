# walnut-rate's receiver (rate/walnut-rate-receiver): played sessions from testers into the quarantine,
# /data/nanobyte/Walnut/submissions (root:walnut-rate 2770; the maintainer's login is in group walnut-rate and
# pulls them with tools/gamedb/submissions.py). Behind the main proxy (rate/nginx-location.conf), which reaches it
# on mainproxy_net's gateway address: WALNUT_RATE_LISTEN in state/walnut-rate-receiver.env. Not installed yet:
# servers/README.md "walnut-rate's receiver" has the steps.
[Unit]
Description=Walnut: walnut-rate's receiver (testers' sessions into quarantine)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/data/nanobyte/Walnut/state/walnut-rate-receiver.env
ExecStart=/usr/bin/python3 -I /data/nanobyte/Walnut/bin/walnut-rate-receiver --listen ${WALNUT_RATE_LISTEN} --quarantine /data/nanobyte/Walnut/submissions --trust-proxy
Restart=on-failure
RestartSec=5

# no user of its own on the box, no home, nothing it may change but the quarantine
DynamicUser=yes
SupplementaryGroups=walnut-rate
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
# /data shows the quarantine and the program (read-only) and nothing else (systemd.exec's TemporaryFileSystem= example)
TemporaryFileSystem=/data:ro
BindPaths=/data/nanobyte/Walnut/submissions
BindReadOnlyPaths=/data/nanobyte/Walnut/bin/walnut-rate-receiver
ReadWritePaths=/data/nanobyte/Walnut/submissions
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# only the proxy's docker networks (and the box itself) may connect
IPAddressDeny=any
IPAddressAllow=localhost 172.16.0.0/12
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
