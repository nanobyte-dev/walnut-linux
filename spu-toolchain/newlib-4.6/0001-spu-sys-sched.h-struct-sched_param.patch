SPU's sys/sched.h replaces the generic one but lacks struct sched_param, which the generic
sys/_pthreadtypes.h (pulled in by sys/types.h) has used since newlib 3.x: every newlib file
fails to build for spu-elf ("field 'schedparam' has incomplete type").

--- a/newlib/libc/machine/spu/sys/sched.h
+++ b/newlib/libc/machine/spu/sys/sched.h
@@ -4,6 +4,14 @@
 extern "C" {
 #endif
 
+#define SCHED_OTHER    0
+#define SCHED_FIFO     1
+#define SCHED_RR       2
+
+struct sched_param {
+  int sched_priority;
+};
+
 int sched_yield(void);
 
 #ifdef __cplusplus
