The SPU libc and libm sources include their private headers relative to their own directory
("headers/vec_literal.h", <vec_literal.h>, "headers/fefpscr.h"), which the old per-directory
automake setup got from -I$(srcdir). The non-recursive makefiles of 4.x dropped that: 'No such
file or directory' in every libm file and in memcpy.c. Add the directory to the CPPFLAGS of
libc/machine/spu and libm/machine/spu. Makefile.in is edited by hand as well because it is
generated by automake 1.15.1 and shipped in the tarball (newlib builds in maintainer-mode-off).

--- a/newlib/libm/machine/spu/Makefile.inc
+++ b/newlib/libm/machine/spu/Makefile.inc
@@ -1,3 +1,5 @@
+libm_a_CPPFLAGS_%C% = -I$(srcdir)/%D%
+
 %C%_src = \
 	%D%/feclearexcept.c %D%/fe_dfl_env.c %D%/fegetenv.c %D%/fegetexceptflag.c \
 	%D%/fegetround.c %D%/feholdexcept.c %D%/feraiseexcept.c %D%/fesetenv.c \
--- a/newlib/libc/machine/spu/Makefile.inc
+++ b/newlib/libc/machine/spu/Makefile.inc
@@ -1,3 +1,5 @@
+libc_a_CPPFLAGS_%C% = -I$(srcdir)/%D%
+
 libc_a_SOURCES += \
 	%D%/setjmp.S %D%/assert.c %D%/clearerr.c %D%/creat.c %D%/fclose.c %D%/feof.c \
 	%D%/ferror.c %D%/fflush.c %D%/fgetc.c %D%/fgetpos.c %D%/fgets.c %D%/fileno.c %D%/fiprintf.S \
--- a/newlib/Makefile.in
+++ b/newlib/Makefile.in
@@ -4693,6 +4693,8 @@
 
 @HAVE_LIBC_MACHINE_MN10300_TRUE@libc_a_CCASFLAGS_libc_machine_mn10300 = -Wa,--gdwarf-2
 @HAVE_LIBC_MACHINE_POWERPC_TRUE@libc_a_CPPFLAGS_libc_machine_powerpc = -I$(srcdir)/libc/stdio -I$(srcdir)/libc/stdlib
+@HAVE_LIBC_MACHINE_SPU_TRUE@libc_a_CPPFLAGS_libc_machine_spu = -I$(srcdir)/libc/machine/spu
+@HAVE_LIBM_MACHINE_SPU_TRUE@libm_a_CPPFLAGS_libm_machine_spu = -I$(srcdir)/libm/machine/spu
 @HAVE_LIBC_MACHINE_XTENSA_TRUE@@XTENSA_ESP32_PSRAM_CACHE_FIX_TRUE@libc_a_CPPFLAGS_libc_machine_xtensa = \
 @HAVE_LIBC_MACHINE_XTENSA_TRUE@@XTENSA_ESP32_PSRAM_CACHE_FIX_TRUE@	-DXTENSA_ESP32_PSRAM_CACHE_FIX
 
