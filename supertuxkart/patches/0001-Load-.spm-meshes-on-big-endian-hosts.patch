diff --git a/lib/graphics_engine/include/ge_read_le.hpp b/lib/graphics_engine/include/ge_read_le.hpp
new file mode 100644
--- /dev/null
+++ b/lib/graphics_engine/include/ge_read_le.hpp
@@ -0,0 +1,58 @@
+#ifndef HEADER_GE_READ_LE_HPP
+#define HEADER_GE_READ_LE_HPP
+
+// Reading little-endian binary data (.spm meshes) on any host: each value
+// is read as stored, then its bytes are reversed in place on a big-endian
+// host. On little-endian hosts the conversions compile to nothing.
+
+#include <IReadFile.h>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace GE
+{
+
+inline bool isBigEndianHost()
+{
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__)
+    return __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__;
+#else
+    const uint16_t probe = 1;
+    return *(const uint8_t*)&probe == 0;
+#endif
+}
+
+// ----------------------------------------------------------------------------
+/** Converts count values of type T (2, 4 or 8 bytes each: integers, floats)
+ *  from little-endian to the host's byte order, in place. */
+template<typename T>
+inline void fromLE(T* data, size_t count = 1)
+{
+    if (sizeof(T) == 1 || !isBigEndianHost())
+        return;
+    uint8_t* p = (uint8_t*)data;
+    for (size_t i = 0; i < count; i++, p += sizeof(T))
+    {
+        for (size_t a = 0, b = sizeof(T) - 1; a < b; a++, b--)
+        {
+            uint8_t t = p[a];
+            p[a] = p[b];
+            p[b] = t;
+        }
+    }
+}
+
+// ----------------------------------------------------------------------------
+/** Reads count little-endian values of type T into dst, in host order. */
+template<typename T>
+inline irr::s32 readLE(irr::io::IReadFile* f, T* dst, size_t count = 1)
+{
+    irr::s32 n = f->read(dst, (irr::u32)(sizeof(T) * count));
+    fromLE(dst, count);
+    return n;
+}
+
+}
+
+#endif
