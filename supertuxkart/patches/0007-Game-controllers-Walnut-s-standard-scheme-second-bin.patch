@@ -187,9 +196,12 @@ void InputManager::handleJoystick(SDL_Event& event)
         }
         case SDL_JOYDEVICEREMOVED:
         {
-            m_gamepads_timer.erase(
-                m_sdl_controller.at(event.jdevice.which)->getInstanceID());
-            m_sdl_controller.erase(event.jdevice.which);
+            auto removed = m_sdl_controller.find(event.jdevice.which);
+            m_failed_joysticks.erase(event.jdevice.which);
+            if (removed == m_sdl_controller.end())
+                break;
+            m_gamepads_timer.erase(removed->second->getInstanceID());
+            m_sdl_controller.erase(removed);
             break;
         }
         case SDL_JOYAXISMOTION:
@@ -261,6 +273,34 @@ void InputManager::update(float dt)
 #ifndef SERVER_ONLY
     for (auto& controller : m_sdl_controller)
         controller.second->checkPowerLevel();
+
+    // Hot-plug: SDL's "added" event can be lost, or the pad can fail to open
+    // at that moment (its device node not yet readable). Look every 2 s for a
+    // pad SDL lists that we have not opened.
+    m_joystick_scan_timer -= dt;
+    if (m_joystick_scan_timer <= 0.0f)
+    {
+        m_joystick_scan_timer = 2.0f;
+        for (int i = 0; i < SDL_NumJoysticks(); i++)
+        {
+            SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(i);
+            if (id < 0 || m_sdl_controller.find(id) != m_sdl_controller.end())
+                continue;
+            try
+            {
+                std::unique_ptr<SDLController> c(new SDLController(i));
+                id = c->getInstanceID();
+                m_sdl_controller[id] = std::move(c);
+                m_failed_joysticks.erase(id);
+            }
+            catch (std::exception& e)
+            {
+                if (m_failed_joysticks.insert(id).second)
+                    Log::error("SDLController", "Cannot open pad %d: %s",
+                               i, e.what());
+            }
+        }
+    }
 #endif
 }
 
