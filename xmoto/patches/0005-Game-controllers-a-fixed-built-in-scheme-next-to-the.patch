diff --git a/src/xmoto/input/Input.cpp b/src/xmoto/input/Input.cpp
--- a/src/xmoto/input/Input.cpp
+++ b/src/xmoto/input/Input.cpp
@@ -37,18 +37,181 @@ Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
 
 Input::Input() {
   reset();
+  for (int p = 0; p < INPUT_NB_PLAYERS; p++) {
+    m_padChanged[p] = 0;
+    for (float &v : m_padBinding[p])
+      v = 0.0f;
+    for (float &v : m_padAction[p])
+      v = 0.0f;
+  }
+}
+
+/* The fixed controller scheme. One row per input: a button, or an axis read
+ * in the direction `sign` (triggers: +1; left stick X: -1 is left, +1 is
+ * right). Several rows may drive the same action. Change it here. */
+struct PadBinding {
+  bool axis;
+  int code; // SDL_GameControllerButton or SDL_GameControllerAxis
+  int sign;
+  INPUT_PLAYERKEYS action;
+};
+
+static const PadBinding padBindings[Input::PAD_NB_BINDINGS] = {
+  {true, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, +1, INPUT_DRIVE},
+  {false, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, 0, INPUT_DRIVE},
+  {true, SDL_CONTROLLER_AXIS_TRIGGERLEFT, +1, INPUT_BRAKE},
+  {false, SDL_CONTROLLER_BUTTON_LEFTSHOULDER, 0, INPUT_BRAKE},
+  {false, SDL_CONTROLLER_BUTTON_DPAD_LEFT, 0, INPUT_FLIPLEFT},
+  {true, SDL_CONTROLLER_AXIS_LEFTX, -1, INPUT_FLIPLEFT},
+  {false, SDL_CONTROLLER_BUTTON_DPAD_RIGHT, 0, INPUT_FLIPRIGHT},
+  {true, SDL_CONTROLLER_AXIS_LEFTX, +1, INPUT_FLIPRIGHT},
+  {false, SDL_CONTROLLER_BUTTON_A, 0, INPUT_CHANGEDIR},
+};
+
+/* Controller buttons for global actions, any pad. (Start pauses, and the
+ * menus take the d-pad, A and B, in the states themselves.) */
+struct PadGlobalBinding {
+  int button;
+  INPUT_GLOBALKEYS key;
+};
+
+static const PadGlobalBinding padGlobalBindings[] = {
+  {SDL_CONTROLLER_BUTTON_Y, INPUT_RESTARTLEVEL},
+  {SDL_CONTROLLER_BUTTON_X, INPUT_RESTARTCHECKPOINT},
+};
+
+bool Input::isGlobalKey(unsigned int INPUT_key, const XMKey &i_xmkey) const {
+  if (i_xmkey == m_globalControls[INPUT_key].key)
+    return true;
+  for (const PadGlobalBinding &b : padGlobalBindings) {
+    if (b.key == INPUT_key && i_xmkey.getJoyButton() == b.button)
+      return true;
+  }
+  return false;
+}
+
+int Input::padSlot(SDL_JoystickID i_id) const {
+  for (unsigned int i = 0; i < m_joysticks.size(); i++) {
+    if (m_joysticks[i].handle != NULL && m_joysticks[i].id == i_id)
+      return i;
+  }
+  return -1;
+}
+
+void Input::padEvent(const SDL_Event &i_event) {
+  bool isAxis = i_event.type == SDL_CONTROLLERAXISMOTION;
+  int slot = padSlot(isAxis ? i_event.caxis.which : i_event.cbutton.which);
+  if (slot < 0 || slot >= INPUT_NB_PLAYERS)
+    return;
+  int code = isAxis ? i_event.caxis.axis : i_event.cbutton.button;
+
+  for (int i = 0; i < PAD_NB_BINDINGS; i++) {
+    const PadBinding &b = padBindings[i];
+    if (b.axis != isAxis || b.code != code)
+      continue;
+    float v;
+    if (isAxis) {
+      float raw = i_event.caxis.value * b.sign;
+      v = raw > JOYSTICK_DEADZONE_BASE
+            ? (raw - JOYSTICK_DEADZONE_BASE) /
+                (JOYSTICK_MAX_VALUE - JOYSTICK_DEADZONE_BASE)
+            : 0.0f;
+      if (v > 1.0f)
+        v = 1.0f;
+    } else {
+      v = i_event.type == SDL_CONTROLLERBUTTONDOWN ? 1.0f : 0.0f;
+    }
+    m_padBinding[slot][i] = v;
+  }
+
+  for (int a = 0; a < INPUT_NB_PLAYERKEYS; a++) {
+    float v = 0.0f;
+    for (int i = 0; i < PAD_NB_BINDINGS; i++) {
+      if (padBindings[i].action == a && m_padBinding[slot][i] > v)
+        v = m_padBinding[slot][i];
+    }
+    if (v != m_padAction[slot][a]) {
+      m_padAction[slot][a] = v;
+      m_padChanged[slot] |= 1u << a;
+    }
+  }
+}
+
+float Input::getPadAction(int i_player, unsigned int INPUT_key) const {
+  return m_padAction[i_player][INPUT_key];
+}
+
+unsigned int Input::takePadChanges(int i_player) {
+  unsigned int v = m_padChanged[i_player];
+  m_padChanged[i_player] = 0;
+  return v;
+}
+
+/* Hot-plug: a slot of m_joysticks stays (handle NULL) when its pad is
+ * unplugged, so the other pads keep their player and the next pad takes the
+ * first free slot. */
+void Input::padAdded(int i_deviceIndex) {
+  if (!SDL_IsGameController(i_deviceIndex))
+    return;
+  SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(i_deviceIndex);
+  if (padSlot(id) >= 0)
+    return; // opened at start-up, SDL reports it again
+
+  SDL_GameController *pad = SDL_GameControllerOpen(i_deviceIndex);
+  if (!pad) {
+    LogWarning("Failed to open controller %d: %s", i_deviceIndex, SDL_GetError());
+    return;
+  }
+  Joystick joy{pad, SDL_GameControllerName(pad), id};
+
+  unsigned int slot = 0;
+  while (slot < m_joysticks.size() && m_joysticks[slot].handle != NULL)
+    slot++;
+  if (slot == m_joysticks.size()) {
+    m_joysticks.push_back(joy);
+    JoystickInput::instance()->init(1);
+  } else {
+    m_joysticks[slot] = joy;
+    JoystickInput::instance()->resetJoyAxes();
+  }
+  LogInfo("Controller connected: %s (player %d)", joy.name.c_str(), slot + 1);
+}
+
+void Input::padRemoved(SDL_JoystickID i_id) {
+  int slot = padSlot(i_id);
+  if (slot < 0)
+    return;
+  LogInfo("Controller disconnected: %s", m_joysticks[slot].name.c_str());
+  SDL_GameControllerClose(m_joysticks[slot].handle);
+  m_joysticks[slot].handle = NULL;
+  m_joysticks[slot].id = -1;
+  JoystickInput::instance()->resetJoyAxes();
+
+  if (slot < INPUT_NB_PLAYERS) {
+    // let go of everything the pad held
+    for (float &v : m_padBinding[slot])
+      v = 0.0f;
+    for (int a = 0; a < INPUT_NB_PLAYERKEYS; a++) {
+      if (m_padAction[slot][a] != 0.0f)
+        m_padChanged[slot] |= 1u << a;
+      m_padAction[slot][a] = 0.0f;
+    }
+  }
 }
 
 void Input::reset() {
   resetScriptKeyHooks();
 }
 
+/* Controller events are always on, so the fixed pad scheme works whatever
+ * "Enable joysticks" says; the option is only remembered. */
 bool Input::areJoysticksEnabled() const {
-  return SDL_GameControllerEventState(SDL_QUERY) == SDL_ENABLE;
+  return m_joysticksEnabled;
 }
 
 void Input::enableJoysticks(bool i_value) {
-  SDL_GameControllerEventState(i_value ? SDL_ENABLE : SDL_IGNORE);
+  m_joysticksEnabled = i_value;
+  SDL_GameControllerEventState(SDL_ENABLE);
 }
 
