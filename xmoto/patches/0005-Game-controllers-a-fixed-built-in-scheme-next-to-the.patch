+/* The fixed controller scheme (Input::padEvent): controller N drives player N.
+ * onlyChanged: apply what changed since the last call, so a pad doesn't
+ * override a key that is held; otherwise apply what the pad holds now. */
+static void applyPad(Biker *i_biker, int p, bool onlyChanged) {
+  Input *in = Input::instance();
+  unsigned int changed = in->takePadChanges(p);
+  bool mirror = XMSession::instance()->mirrorMode();
+
+  if (!onlyChanged) {
+    changed = 0;
+    for (unsigned int a = 0; a < INPUT_NB_PLAYERKEYS; a++) {
+      if (in->getPadAction(p, a) != 0.0f)
+        changed |= 1u << a;
+    }
+  }
+  if (changed & (1u << INPUT_DRIVE))
+    i_biker->getControler()->setThrottle(in->getPadAction(p, INPUT_DRIVE));
+  if (changed & (1u << INPUT_BRAKE))
+    i_biker->getControler()->setBreak(in->getPadAction(p, INPUT_BRAKE));
+  if (changed & ((1u << INPUT_FLIPLEFT) | (1u << INPUT_FLIPRIGHT))) {
+    float pull =
+      in->getPadAction(p, INPUT_FLIPLEFT) - in->getPadAction(p, INPUT_FLIPRIGHT);
+    i_biker->getControler()->setPull(mirror ? -pull : pull);
+  }
+  if (onlyChanged && (changed & (1u << INPUT_CHANGEDIR)) &&
+      in->getPadAction(p, INPUT_CHANGEDIR) > 0.0f)
+    i_biker->getControler()->setChangeDir(true);
+}
